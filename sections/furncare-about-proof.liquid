{{ 'furncare-about.css' | asset_url | stylesheet_tag }}
<script src="{{ 'furncare-about.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign reveal_class = ''
  if section.settings.enable_reveal
    assign reveal_class = ' fa-reveal'
  endif
-%}
{%- capture furncare_selector -%}#FurncareAboutProof-{{ section.id }}{%- endcapture -%}
{% style %}
  {% render 'furncare-about-style-vars', selector: furncare_selector, section_settings: section.settings %}
  {{ furncare_selector }} {
    --fa-stat-number-color: {{ section.settings.stat_number_color }};
    --fa-stat-label-color: {{ section.settings.stat_label_color }};
    --fa-stat-number-size: {{ section.settings.stat_number_size }}px;
    --fa-stat-number-weight: {{ section.settings.stat_number_weight }};
    --fa-stat-label-size: {{ section.settings.stat_label_size }}px;
    --fa-stat-label-margin-top: {{ section.settings.stat_label_margin_top }}px;
    --fa-stat-copy-margin-top: {{ section.settings.stat_copy_margin_top }}px;
  }
{% endstyle %}

<section id="FurncareAboutProof-{{ section.id }}" class="fa-page-section fa-pad">
  <div class="fa-wrap">
    <div class="fa-section-header fa-content-box{{ reveal_class }}">
      {%- if section.settings.eyebrow != blank -%}
        <p class="fa-section-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="fa-heading-md">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
    </div>

    <div class="fa-stats-grid">
      {%- for block in section.blocks -%}
        <article class="fa-card fa-stat-card{{ reveal_class }}" {{ block.shopify_attributes }}>
          {%- if block.settings.number != blank -%}
            <p class="fa-stat-number">{{ block.settings.number | escape }}</p>
          {%- endif -%}

          {%- if block.settings.label != blank -%}
            <p class="fa-stat-label">{{ block.settings.label | escape }}</p>
          {%- endif -%}

          {%- if block.settings.copy != blank -%}
            <p class="fa-stat-copy">{{ block.settings.copy }}</p>
          {%- endif -%}
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

