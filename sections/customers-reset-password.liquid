<div class="customers__container container container--xsmall">
  <h1 class="customers__title title-display">
    {{ "customer.reset.title" | t }}
  </h1>

  {% form "reset_customer_password", class: "form-group" %}

    {% if form.errors %}
      <div class="notification notification--error">
        {{ form.errors | default_errors }}
      </div>
    {% endif %}

    <div class="form-group__input-wrapper">
      <label for="password">{{ "forms.new_password" | t }}</label>
      <input
        type="password"
        name="customer[password]"
        id="password"
        placeholder="{{ "forms.new_password" | t }}"
      >
    </div>

    <div class="form-group__input-wrapper">
      <label for="passwordConfirm">{{ "forms.confirm_new_password" | t }}</label>
      <input
        type="password"
        name="customer[password_confirmation]"
        id="passwordConfirm"
        placeholder="{{ "forms.confirm_new_password" | t }}"
      >
    </div>

    <button
      class="button button--primary"
      type="submit"
    >
      {{ "customer.reset.submit_button" | t }}
    </button>
  {% endform %}
</div>

{% schema %}
{
  "name": "Reset Password",
  "tag": "section",
  "class": "customers",
  "settings": []
}
{% endschema %}
