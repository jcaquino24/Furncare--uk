{%- style -%}
  .slider-{{ section.id }} {
    padding: {{ section.settings.padding_v }}px 0;
    background-color: {{ section.settings.bg_color }};
    overflow: hidden;
  }

  .slider-header {
    text-align: center;
    margin-bottom: 40px;
    padding: 0 20px;
  }

  .slider-heading {
    color: {{ section.settings.text_color }};
    font-size: 2.5rem;
    text-transform: capitalize;
    margin: 0;
  }

  .slider-wrapper {
    position: relative;
    max-width: {{ section.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 60px; /* Space for arrows */
  }

  .slider-container {
    display: flex;
    gap: 20px;
    overflow-x: auto;
    scroll-behavior: smooth;
    scrollbar-width: none; /* Firefox */
    -ms-overflow-style: none; /* IE/Edge */
    padding: 10px 0;
  }

  .slider-container::-webkit-scrollbar { display: none; }

  .slider-card {
    flex: 0 0 85%; /* Mobile width */
    background: {{ section.settings.card_bg }};
    border-radius: 12px;
    padding: 20px;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    transition: transform 0.3s ease;
  }

  @media screen and (min-width: 750px) {
    .slider-card { flex: 0 0 calc(33.333% - 14px); }
  }

  .card-image-box {
    width: 100%;
    aspect-ratio: 1/1;
    background: #e9ecef;
    border-radius: 8px;
    margin-bottom: 20px;
    overflow: hidden;
  }

  .card-image-box img, .card-image-box svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .card-title {
    color: {{ section.settings.text_color }};
    font-size: 1.2rem;
    font-weight: bold;
    text-transform: uppercase;
    margin: 0 0 10px 0;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .card-desc {
    color: {{ section.settings.text_color }};
    opacity: 0.7;
    font-size: 0.9rem;
    line-height: 1.5;
    margin: 0;
  }

 /* Arrows Updated */
  .slider-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 44px;
    height: 44px;
    background: #ffffff; /* White circle background */
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 10;
    border: none;
    transition: background 0.3s ease, transform 0.2s ease;
    box-shadow: 0 4px 15px rgba(0,0,0,0.5);
  }

  .slider-nav:hover {
    background: #f0f0f0;
    transform: translateY(-50%) scale(1.1);
  }

  /* Force the arrow icon to be visible and black on the white circle */
  .slider-nav svg { 
    width: 24px; 
    height: 24px; 
    stroke: #000000; 
    stroke-width: 2.5px;
    display: block;
  }

  .prev-btn { left: 0px; }
  .next-btn { right: 0px; }

  /* Hide arrows on mobile to allow natural swiping */
  @media screen and (max-width: 749px) {
    .slider-nav { display: none; }
    .slider-wrapper { padding: 0 20px; }
  }
{%- endstyle -%}

<section class="slider-{{ section.id }}">
  <div class="slider-header">
    <h2 class="slider-heading">{{ section.settings.heading }}</h2>
  </div>

  <div class="slider-wrapper">
    <button class="slider-nav prev-btn" aria-label="Previous" onclick="document.getElementById('Slider-{{ section.id }}').scrollBy({left: -350, behavior: 'smooth'})">
      <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M15 19l-7-7 7-7" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>
    
    <div class="slider-container" id="Slider-{{ section.id }}">
      {%- for block in section.blocks -%}
        <div class="slider-card" {{ block.shopify_attributes }}>
          <div class="card-image-box">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 600 | image_tag }}
            {%- else -%}
              {{ 'image' | placeholder_svg_tag }}
            {%- endif -%}
          </div>
          <h3 class="card-title">{{ block.settings.title }}</h3>
          <p class="card-desc">{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>

   <button class="slider-nav next-btn" aria-label="Next" onclick="document.getElementById('Slider-{{ section.id }}').scrollBy({left: 350, behavior: 'smooth'})">
      <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M9 5l7 7-7 7" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>
  </div>
</section>

{% schema %}
{
  "name": "Multi Column",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Our Parts in action" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#0b0b0b" },
    { "type": "color", "id": "card_bg", "label": "Card Background", "default": "#222222" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#ffffff" },
    { "type": "number", "id": "container_width", "label": "Max Width", "default": 1200 },
    { "type": "range", "id": "padding_v", "label": "Vertical Padding", "min": 0, "max": 100, "step": 2, "default": 60 }
  ],
  "blocks": [
    {
      "type": "part",
      "name": "Part Card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title", "default": "SLIDERS" },
        { "type": "textarea", "id": "text", "label": "Description", "default": "RS320 Large - GD Subaru Seat Base Mount" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Multi-Column",
      "blocks": [
        { "type": "part" },
        { "type": "part" },
        { "type": "part" },
        { "type": "part" }
      ]
    }
  ]
}
{% endschema %}