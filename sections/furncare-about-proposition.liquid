{{ 'furncare-about.css' | asset_url | stylesheet_tag }}
<script src="{{ 'furncare-about.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign reveal_class = ''
  if section.settings.enable_reveal
    assign reveal_class = ' fa-reveal'
  endif
-%}
{%- capture furncare_selector -%}#FurncareAboutProposition-{{ section.id }}{%- endcapture -%}
{% style %}
  {% render 'furncare-about-style-vars', selector: furncare_selector, section_settings: section.settings %}
  {{ furncare_selector }} {
    --fa-panel-title-size: {{ section.settings.panel_title_size }}px;
    --fa-panel-title-margin-top: {{ section.settings.panel_title_margin_top }}px;
    --fa-panel-copy-margin-top: {{ section.settings.panel_copy_margin_top }}px;
    --fa-panel-padding: {{ section.settings.panel_padding }}px;
  }
{% endstyle %}

<section id="FurncareAboutProposition-{{ section.id }}" class="fa-page-section fa-pad">
  <div class="fa-wrap">
    <div class="fa-section-header fa-content-box{{ reveal_class }}">
      {%- if section.settings.eyebrow != blank -%}
        <p class="fa-section-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="fa-heading-lg">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
    </div>

    <div class="fa-dual">
      <div class="fa-dual__panel{{ reveal_class }}" style="--fa-panel-bg: {{ section.settings.left_panel_bg }}; --fa-panel-text-color: {{ section.settings.left_panel_text }}; --fa-panel-title-color: {{ section.settings.left_title_color }}; --fa-panel-copy-color: {{ section.settings.left_copy_color }}; --fa-icon-bg: {{ section.settings.left_icon_background }}; --fa-icon-color: {{ section.settings.left_icon_color }};">
        {% render 'furncare-icon', icon: section.settings.left_icon %}

        {%- if section.settings.left_title != blank -%}
          <h3 class="fa-dual__title">{{ section.settings.left_title | escape }}</h3>
        {%- endif -%}

        {%- if section.settings.left_copy != blank -%}
          <p class="fa-dual__copy">{{ section.settings.left_copy }}</p>
        {%- endif -%}
      </div>

      <div class="fa-dual__panel{{ reveal_class }}" style="--fa-panel-bg: {{ section.settings.right_panel_bg }}; --fa-panel-text-color: {{ section.settings.right_panel_text }}; --fa-panel-title-color: {{ section.settings.right_title_color }}; --fa-panel-copy-color: {{ section.settings.right_copy_color }}; --fa-icon-bg: {{ section.settings.right_icon_background }}; --fa-icon-color: {{ section.settings.right_icon_color }};">
        {% render 'furncare-icon', icon: section.settings.right_icon %}

        {%- if section.settings.right_title != blank -%}
          <h3 class="fa-dual__title">{{ section.settings.right_title | escape }}</h3>
        {%- endif -%}

        {%- if section.settings.right_copy != blank -%}
          <p class="fa-dual__copy">{{ section.settings.right_copy }}</p>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

