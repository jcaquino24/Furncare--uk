<section class="cart-print{% if section.settings.pdf_logo_1 != blank or section.settings.pdf_logo_2 != blank %} has-pdf-logos{% endif %}">
  {%- if section.settings.pdf_logo_1 != blank or section.settings.pdf_logo_2 != blank -%}
    <div class="cart-print__pdf-logos">
      {%- if section.settings.pdf_logo_1 != blank -%}
        {{ section.settings.pdf_logo_1 | image_url: width: 600 | image_tag: loading: 'eager', alt: shop.name, class: 'cart-print__pdf-logo' }}
      {%- endif -%}
      {%- if section.settings.pdf_logo_2 != blank -%}
        {{ section.settings.pdf_logo_2 | image_url: width: 600 | image_tag: loading: 'eager', alt: '', class: 'cart-print__pdf-logo' }}
      {%- endif -%}
    </div>
  {%- endif -%}

  <header class="cart-print__header">
    <h1 class="cart-print__title">{{ section.settings.title }}</h1>
  </header>

  <p class="cart-print__meta">{{ 'now' | date: '%d %b %Y' }}</p>

  <div class="cart-print__layout">
    <div class="cart-print__main">
      <p class="cart-print__error cart-print__no-print" role="alert" hidden data-cart-print-error></p>

      <div data-cart-print-items>
        {% if cart.item_count == 0 %}
          <p>Your basket is empty.</p>
        {% else %}
          <table class="cart-print__table">
            <thead>
              <tr>
                <th>Product</th>
                <th>Room Number</th>
                <th class="num">Price</th>
                <th class="num">Qty</th>
                <th class="num">Total</th>
                <th class="cart-print__no-print cart-print__remove-col"><span class="visually-hidden">Remove</span></th>
              </tr>
            </thead>
            <tbody>
              {% for item in cart.items %}
                <tr data-line-key="{{ item.key }}">
                  <td>
                    <div class="cart-print__product">
                      {% if item.image %}
                        <img
                          src="{{ item.image | image_url: width: 160 }}"
                          alt="{{ item.image.alt | escape }}"
                          width="80"
                          height="80"
                          loading="eager"
                        >
                      {% endif %}
                      <div>
                        <strong>{{ item.product.title | split: '|' | first }}</strong>
                        {% unless item.product.has_only_default_variant %}
                          <div class="cart-print__variant">{{ item.variant.title }}</div>
                        {% endunless %}
                        {% if item.sku != blank %}<div class="cart-print__variant">SKU: {{ item.sku }}</div>{% endif %}
                      </div>
                    </div>
                  </td>
                  <td>{{ item.properties['Room Number'] | default: '—' }}</td>
                  <td class="num">{{ item.final_price | money }}</td>
                  <td class="num">
                    <span class="cart-print__qty-print">{{ item.quantity }}</span>
                    <div class="cart-print__qty cart-print__no-print">
                      <button type="button" class="cart-print__qty-btn" data-qty-change="-1" data-quantity="{{ item.quantity }}" aria-label="Decrease quantity">&minus;</button>
                      <span class="cart-print__qty-value" aria-live="polite">{{ item.quantity }}</span>
                      <button type="button" class="cart-print__qty-btn" data-qty-change="1" data-quantity="{{ item.quantity }}" aria-label="Increase quantity">+</button>
                    </div>
                  </td>
                  <td class="num">{{ item.final_line_price | money }}</td>
                  <td class="cart-print__no-print cart-print__remove-col">
                    <button type="button" class="cart-print__remove" data-remove-line aria-label="Remove {{ item.product.title | split: '|' | first | escape }}">&times;</button>
                  </td>
                </tr>
              {% endfor %}
            </tbody>
            <tfoot>
              <tr>
                <td colspan="4" class="num"><strong>Subtotal</strong></td>
                <td class="num"><strong>{{ cart.total_price | money }}</strong></td>
                <td class="cart-print__no-print cart-print__remove-col"></td>
              </tr>
            </tfoot>
          </table>
        {% endif %}
      </div>
    </div>

    <aside class="cart-print__delivery">
      <form class="cart-print__form" onsubmit="return false" data-delivery-form autocomplete="on">
        <h2 class="cart-print__form-title">{{ section.settings.delivery_title }}</h2>

        <div class="cart-print__row">
          <label class="cart-print__field">
            <span>First name</span>
            <input type="text" required name="first_name" autocomplete="given-name">
          </label>
          <label class="cart-print__field">
            <span>Last name</span>
            <input type="text" required name="last_name" autocomplete="family-name">
          </label>
        </div>

        <div class="cart-print__row">
          <label class="cart-print__field">
            <span>Email</span>
            <input type="email" required name="email" autocomplete="email">
          </label>
          <label class="cart-print__field">
            <span>Phone</span>
            <input type="tel" required name="phone" autocomplete="tel">
          </label>
        </div>

        <div class="cart-print__row cart-print__row--single">
          <label class="cart-print__field">
            <span>Address line 1</span>
            <input type="text" required name="address1" autocomplete="address-line1">
          </label>
        </div>

        <div class="cart-print__row">
          <label class="cart-print__field">
            <span>City</span>
            <input type="text" required name="city" autocomplete="address-level2">
          </label>
          <label class="cart-print__field">
            <span>Zip code</span>
            <input type="text" required name="zip" autocomplete="postal-code">
          </label>
        </div>

        <div class="cart-print__no-print">
          <button type="button" class="cart-print__btn cart-print__btn--full" data-save-pdf>
            {{ section.settings.pdf_label }}
          </button>
        </div>
      </form>
    </aside>
  </div>
</section>

<script>
  (function () {
    var LIB = 'https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js';

    function loadLib() {
      if (window.html2pdf) return Promise.resolve();
      return new Promise(function (resolve, reject) {
        var s = document.createElement('script');
        s.src = LIB;
        s.onload = resolve;
        s.onerror = function () { reject(new Error('Could not load PDF library')); };
        document.head.appendChild(s);
      });
    }

    var ITEMS = '[data-cart-print-items]';
    var STORE_KEY = 'cartPrintDelivery';

    (function initDeliveryForm() {
      var form = document.querySelector('[data-delivery-form]');
      if (!form) return;
      try {
        var saved = JSON.parse(localStorage.getItem(STORE_KEY) || '{}');
        Object.keys(saved).forEach(function (name) {
          if (form.elements[name]) form.elements[name].value = saved[name];
        });
      } catch (e) {}
      form.addEventListener('input', function () {
        var data = {};
        Array.prototype.forEach.call(form.elements, function (el) {
          if (el.name) data[el.name] = el.value;
        });
        try { localStorage.setItem(STORE_KEY, JSON.stringify(data)); } catch (e) {}
      });
    })();

    function showError(text) {
      var el = document.querySelector('[data-cart-print-error]');
      if (!el) return;
      el.textContent = text || '';
      el.hidden = !text;
    }

    async function updateLine(key, quantity) {
      var wrap = document.querySelector(ITEMS);
      if (!wrap) return;
      wrap.classList.add('is-loading');
      showError('');

      try {
        var response = await fetch('{{ routes.cart_change_url }}.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({ id: key, quantity: quantity })
        });
        var result = await response.json();
        if (!response.ok) {
          showError(result.description || result.message || 'Could not update the quote.');
        }

        // Re-render the table from the server so totals stay correct
        var html = await (await fetch(window.location.href, { cache: 'no-store' })).text();
        var fresh = new DOMParser().parseFromString(html, 'text/html').querySelector(ITEMS);
        if (fresh) {
          wrap.innerHTML = fresh.innerHTML;
        } else {
          window.location.reload();
        }
      } catch (err) {
        window.location.reload();
      } finally {
        wrap.classList.remove('is-loading');
      }
    }

    document.addEventListener('click', function (event) {
      var qtyBtn = event.target.closest('[data-qty-change]');
      if (qtyBtn) {
        var row = qtyBtn.closest('[data-line-key]');
        var next = parseInt(qtyBtn.dataset.quantity, 10) + parseInt(qtyBtn.dataset.qtyChange, 10);
        if (row) updateLine(row.dataset.lineKey, Math.max(0, next));
        return;
      }

      var removeBtn = event.target.closest('[data-remove-line]');
      if (removeBtn) {
        var line = removeBtn.closest('[data-line-key]');
        if (line) updateLine(line.dataset.lineKey, 0);
        return;
      }
    });

    // Copy of the section with the PDF layout (summary on top, form below).
    // The class is applied BEFORE html2pdf measures the page, so page breaks
    // are calculated on the stacked layout and the form is never cut off.
    function buildPdfSource(section) {
      var clone = section.cloneNode(true);
      clone.classList.add('is-pdf');

      var from = section.querySelectorAll('input');
      var to = clone.querySelectorAll('input');
      from.forEach(function (input, i) {
        if (to[i]) to[i].setAttribute('value', input.value);
      });

      return clone;
    }

    document.addEventListener('click', function (event) {
      var btn = event.target.closest('[data-save-pdf]');
      if (!btn) return;

      var form = btn.closest('form');
      if (form && !form.reportValidity()) return;
      if (!document.querySelector('[data-line-key]')) {
        showError('Your quote is empty. Add at least one product first.');
        return;
      }
      showError('');

      var target = btn.closest('.cart-print');
      var pdfSource = buildPdfSource(target);
      var label = btn.textContent;
      btn.disabled = true;
      btn.textContent = 'Preparing PDF…';

      loadLib()
        .then(function () {
          return window.html2pdf()
            .set({
              margin: 10,
              filename: 'quote-' + new Date().toISOString().slice(0, 10) + '.pdf',
              image: { type: 'jpeg', quality: 0.95 },
              html2canvas: {
                scale: 2,
                useCORS: true
              },
              jsPDF: { unit: 'mm', format: 'a4', orientation: 'portrait' },
              pagebreak: { mode: ['css', 'legacy'], avoid: ['tr', '.cart-print__form'] }
            })
            .from(pdfSource)
            .save();
        })
        .catch(function () {
          // Fallback: browser print dialog (choose "Save as PDF")
          window.print();
        })
        .finally(function () {
          btn.disabled = false;
          btn.textContent = label;
        });
    });
  })();
</script>

{% style %}
  .cart-print { max-width: 1280px; margin: 0 auto; padding: 24px 16px; }
  .cart-print__layout { display: grid; grid-template-columns: 70% 30%; gap: 0; align-items: start; }
  .cart-print__main { min-width: 0; padding-inline-end: 24px; }
  .cart-print__delivery { min-width: 0; }
  .cart-print__form { border: 1px solid #c3c0b0; background: #F9F7F0; padding: 20px; }
  .cart-print__form-title { margin: 0 0 16px; font-size: 1.125rem; }
  .cart-print__row { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-block-end: 12px; }
  .cart-print__row--single { grid-template-columns: 1fr; }
  .cart-print__field { display: flex; flex-direction: column; gap: 4px; min-width: 0; font-size: 0.85em; }
  .cart-print__field input {
    width: 100%; padding: 10px 12px; border: 1px solid #d9dde3; background: #fff; font: inherit; font-size: 1rem;
  }
  .cart-print__field input:focus-visible { outline: 2px solid #243a53; outline-offset: 1px; }
  @media (max-width: 900px) {
    .cart-print__layout { grid-template-columns: 1fr; gap: 24px; }
    .cart-print__main { padding-inline-end: 0; }
  }
  .cart-print__header { display: flex; justify-content: space-between; align-items: center; gap: 16px; }
  .cart-print__title { margin: 0; }
  .cart-print__logo { display: flex; align-items: center; justify-content: flex-end; }
  .cart-print__logo-img { width: auto; max-width: 100%; height: {{ section.settings.logo_height }}px; object-fit: contain; }
  .cart-print__logo-text { font-weight: 700; font-size: 1.25rem; }
  .cart-print__meta { color: #666; margin-block: 8px 24px; }
  .cart-print__actions { display: flex; gap: 8px; flex-wrap: wrap; margin-block-start: 16px; }
  .cart-print__btn {
    padding: 12px 20px; background: #243222; color: #fff;
    font: inherit; cursor: pointer; text-decoration: none;
  }
  .cart-print__btn--ghost { background: #fff; color: #243222; }
  .cart-print__btn--full { width: 100%; margin-block-start: 4px; }
  .cart-print__btn:disabled { opacity: 0.6; cursor: progress; }
  .cart-print__field:has(input:required) > span::after { content: " *"; }
  .cart-print__table { width: 100%; border-collapse: collapse; }
  .cart-print__table th, .cart-print__table td { padding: 12px 8px; border-bottom: 1px solid #d9dde3; text-align: left; vertical-align: middle; }
  .cart-print__table .num { text-align: right; white-space: nowrap; }
  .cart-print__product { display: flex; align-items: center; gap: 12px; }
  [data-cart-print-items].is-loading { opacity: 0.5; pointer-events: none; transition: opacity 0.15s; }
  .cart-print__error { color: #b42318; font-weight: 600; margin-block: 0 12px; }
  .cart-print__qty-print { display: none; }
  .cart-print__qty { display: inline-flex; align-items: center; border: 1px solid #d9dde3; }
  .cart-print__qty-btn {
    width: 32px; height: 32px; border: 0; background: #fff; font: inherit; font-size: 18px;
    line-height: 1; cursor: pointer; color: #1f3854;
  }
  .cart-print__qty-btn:hover { background: #f1f3f6; }
  .cart-print__qty-value { min-width: 32px; text-align: center; }
  .cart-print__remove-col { width: 40px; text-align: right !important; }
  .cart-print__remove {
    width: 32px; height: 32px; border: 0; background: none; font-size: 22px; line-height: 1;
    cursor: pointer; color: #666;
  }
  .cart-print__remove:hover { color: #b42318; }
  .cart-print__product img { width: 80px; height: 80px; object-fit: cover; }
  .cart-print__variant { font-size: 0.85em; color: #666; }

  /* Logo strip: hidden on screen (the site header shows the logos), shown in PDF and print */
  .cart-print__pdf-logos { display: none; align-items: center; justify-content: center; gap: 32px; margin-block-end: 24px; }
  .cart-print__pdf-logo { width: auto; max-width: 45%; height: {{ section.settings.pdf_logo_height }}px; object-fit: contain; }
  .cart-print.is-pdf .cart-print__pdf-logos { display: flex; }
  .cart-print.has-pdf-logos.is-pdf .cart-print__logo { display: none; }

  /* PDF-only layout (applied to the off-screen copy used for the PDF) */
  .cart-print.is-pdf { max-width: none; padding: 0; }
  .cart-print.is-pdf .cart-print__layout { grid-template-columns: 1fr; gap: 24px; }
  .cart-print.is-pdf .cart-print__main { padding-inline-end: 0; }
  .cart-print.is-pdf .cart-print__no-print { display: none !important; }
  .cart-print.is-pdf .cart-print__qty-print { display: inline !important; }
  .cart-print.is-pdf .cart-print__table th:nth-child(3),
  .cart-print.is-pdf .cart-print__table td:nth-child(3) { display: table-cell !important; }
  .cart-print.is-pdf .cart-print__form { break-inside: avoid; page-break-inside: avoid; }

  @media (max-width: 640px) {
    .cart-print__table th:nth-child(3), .cart-print__table td:nth-child(3) { display: none; }
  }

  @media print {
    header, footer, nav, .breadcrumbs, [id*="header"], [id*="footer"], .cart-print__actions { display: none !important; }
    .cart-print__no-print { display: none !important; }
    .cart-print__pdf-logos { display: flex !important; }
    .cart-print.has-pdf-logos .cart-print__logo { display: none; }
    .cart-print__qty-print { display: inline !important; }
    .cart-print { max-width: none; padding: 0; }
    .cart-print__table tr { break-inside: avoid; }
    .cart-print__table th:nth-child(3), .cart-print__table td:nth-child(3) { display: table-cell; }
    * { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  }
{% endstyle %}

{% schema %}
{
  "name": "Cart print",
  "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "Order Summary" },
    { "type": "image_picker", "id": "logo", "label": "Store logo", "info": "Shown on the right of the title. Falls back to the store name." },
    { "type": "range", "id": "logo_height", "label": "Logo height", "min": 24, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "header", "content": "PDF / print logos" },
    { "type": "image_picker", "id": "pdf_logo_1", "label": "PDF logo 1 (e.g. Furncare)", "info": "Use PNG or JPG. Shown centred at the top of the PDF and printout only." },
    { "type": "image_picker", "id": "pdf_logo_2", "label": "PDF logo 2 (e.g. Care UK)" },
    { "type": "range", "id": "pdf_logo_height", "label": "PDF logo height", "min": 24, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "text", "id": "delivery_title", "label": "Delivery form title", "default": "Delivery details" },
    { "type": "text", "id": "pdf_label", "label": "Save as PDF button label", "default": "Save as PDF" }
  ],
  "presets": [{ "name": "Cart print" }]
}
{% endschema %}
