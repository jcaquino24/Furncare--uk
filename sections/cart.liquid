<script>
  function setupCartUpsells() {
    const upsellsEl = document.querySelector('.cart-form__upsells');
    if (upsellsEl) {
      const upsellsHtml = upsellsEl.innerHTML;
      window.shopifyCartUpsells = upsellsHtml;

      // Immediately set the attribute on minicart if it exists on this page
      const minicart = document.querySelector('uwp-minicart');
      if (minicart) {
        minicart.setAttribute('minicart-upsells', upsellsHtml);
      }
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupCartUpsells);
  } else {
    setupCartUpsells();
  }
</script>

{% javascript %}
  class CartUpsellSlider extends HTMLElement {
    connectedCallback() {
      this.viewport = this.querySelector('[data-cart-upsell-viewport]');
      this.previousButton = this.querySelector('[data-cart-upsell-previous]');
      this.nextButton = this.querySelector('[data-cart-upsell-next]');
      this.handlePrevious = this.scrollPrevious.bind(this);
      this.handleNext = this.scrollNext.bind(this);
      this.handleUpdate = this.update.bind(this);

      if (!this.viewport) return;

      this.previousButton?.addEventListener('click', this.handlePrevious);
      this.nextButton?.addEventListener('click', this.handleNext);
      this.viewport.addEventListener('scroll', this.handleUpdate, { passive: true });
      window.addEventListener('resize', this.handleUpdate);

      if ('ResizeObserver' in window) {
        this.resizeObserver = new ResizeObserver(this.handleUpdate);
        this.resizeObserver.observe(this.viewport);
      }

      requestAnimationFrame(this.handleUpdate);
    }

    disconnectedCallback() {
      this.previousButton?.removeEventListener('click', this.handlePrevious);
      this.nextButton?.removeEventListener('click', this.handleNext);
      this.viewport?.removeEventListener('scroll', this.handleUpdate);
      window.removeEventListener('resize', this.handleUpdate);
      this.resizeObserver?.disconnect();
    }

    scrollPrevious() {
      this.scrollByDirection(-1);
    }

    scrollNext() {
      this.scrollByDirection(1);
    }

    scrollByDirection(direction) {
      if (!this.viewport) return;
      this.viewport.scrollBy({
        left: this.viewport.clientWidth * direction,
        behavior: 'smooth'
      });
    }

    update() {
      if (!this.viewport) return;
      const maxScroll = this.viewport.scrollWidth - this.viewport.clientWidth;
      const isScrollable = maxScroll > 2;
      this.classList.toggle('is-scrollable', isScrollable);

      if (this.previousButton) {
        this.previousButton.disabled = !isScrollable || this.viewport.scrollLeft <= 2;
      }

      if (this.nextButton) {
        this.nextButton.disabled = !isScrollable || this.viewport.scrollLeft >= maxScroll - 2;
      }
    }
  }

  if (!customElements.get('uwp-cart-upsell-slider')) {
    customElements.define('uwp-cart-upsell-slider', CartUpsellSlider);
  }
