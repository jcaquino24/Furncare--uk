<div class="customers__container container container--xsmall">  

  <h1 class="title-display customers__title">
    {{ "customer.activate.title" | t }}
  </h1>

  {% form 'activate_customer_password', class: "form-group" %}

    <div class="form-group__input-wrapper">
      <label
        for="password"
      >
        {{ "forms.password" | t }}
      </label>

      <input
        type="password"
        name="customer[password]"
        id="password"
        autocomplete="new-password"
        placeholder="{{ "forms.password" | t }}"
      >
    </div>

    <div class="form-group__input-wrapper">
      <label
        for="password_confirmation"
      >
        {{ "forms.confirm_password" | t }}
      </label>

      <input
        type="password"
        name="customer[password_confirmation]"
        id="password_confirmation"
        autocomplete="new-password"
        placeholder="{{ "forms.confirm_password" | t }}"
      >
    </div>

    <button
      type="submit"
      class="button button--primary"
    >
      {{ "customer.activate.submit_button" | t }}
    </button>

  {% endform %}
</div>

{% schema %}
{
  "name": "Account Activation",
  "tag": "section",
  "class": "customers"
}
{% endschema %}
