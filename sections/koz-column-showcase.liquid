{% comment %}
  Section: KOZ 4-Column Grid
  Layout: Alternating 2/3 and 1/3 image grid with bottom-left text overlays.
{% endcomment %}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Bebas+Neue&display=swap');

  .koz-grid-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .koz-container {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 {{ section.settings.padding_horizontal }}px;
  }

  .koz-4-grid {
    display: grid;
    /* Creates a 3-column grid to allow the 2/3 and 1/3 spans */
    grid-template-columns: repeat(3, 1fr);
    gap: {{ section.settings.grid_gap }}px;
  }

  .koz-grid-item {
    position: relative;
    width: 100%;
    /* Controls the height of the rows */
    min-height: {{ section.settings.row_height }}px;
    overflow: hidden;
    background-color: #111;
  }

  /* Structural Spans for the specific layout */
  .koz-item-1 { grid-column: span 2; } /* Top Left: Large */
  .koz-item-2 { grid-column: span 1; } /* Top Right: Small */
  .koz-item-3 { grid-column: span 1; } /* Bottom Left: Small */
  .koz-item-4 { grid-column: span 2; } /* Bottom Right: Large */

  .koz-grid-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease;
  }

  .koz-grid-item:hover .koz-grid-image {
    transform: scale(1.03);
  }

  /* Gradient overlay for text readability */
  .koz-grid-item::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 50%;
    background: linear-gradient(to top, rgba(0,0,0,0.8) 0%, transparent 100%);
    pointer-events: none;
    z-index: 1;
  }

  .koz-overlay-text {
    position: absolute;
    bottom: 20px;
    left: 20px;
    color: #ffffff;
    font-family: 'Bebas Neue', Impact, sans-serif; /* Matches the tall, condensed look */
    font-size: clamp(20px, 2.5vw, 28px);
    line-height: 1;
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    z-index: 2;
    text-shadow: 0 2px 4px rgba(0,0,0,0.5);
  }

  /* Mobile Layout - Stacks all images evenly */
  @media (max-width: 768px) {
    .koz-4-grid {
      grid-template-columns: 1fr;
    }
    .koz-grid-item {
      grid-column: span 1 !important;
      min-height: {{ section.settings.row_height | divided_by: 1.5 }}px;
    }
  }
</style>

<div class="koz-grid-section-{{ section.id }}">
  <div class="koz-container">
    <div class="koz-4-grid">
      
      <div class="koz-grid-item koz-item-1">
        {% if section.settings.image_1 != blank %}
          {{ section.settings.image_1 | image_url: width: 1200 | image_tag: class: 'koz-grid-image', alt: section.settings.text_1 }}
        {% else %}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'koz-grid-image' }}
        {% endif %}
        {% if section.settings.text_1 != blank %}
          <h3 class="koz-overlay-text">{{ section.settings.text_1 }}</h3>
        {% endif %}
      </div>

      <div class="koz-grid-item koz-item-2">
        {% if section.settings.image_2 != blank %}
          {{ section.settings.image_2 | image_url: width: 800 | image_tag: class: 'koz-grid-image', alt: section.settings.text_2 }}
        {% else %}
          {{ 'product-1' | placeholder_svg_tag: 'koz-grid-image' }}
        {% endif %}
        {% if section.settings.text_2 != blank %}
          <h3 class="koz-overlay-text">{{ section.settings.text_2 }}</h3>
        {% endif %}
      </div>

      <div class="koz-grid-item koz-item-3">
        {% if section.settings.image_3 != blank %}
          {{ section.settings.image_3 | image_url: width: 800 | image_tag: class: 'koz-grid-image', alt: section.settings.text_3 }}
        {% else %}
          {{ 'product-2' | placeholder_svg_tag: 'koz-grid-image' }}
        {% endif %}
        {% if section.settings.text_3 != blank %}
          <h3 class="koz-overlay-text">{{ section.settings.text_3 }}</h3>
        {% endif %}
      </div>

      <div class="koz-grid-item koz-item-4">
        {% if section.settings.image_4 != blank %}
          {{ section.settings.image_4 | image_url: width: 1200 | image_tag: class: 'koz-grid-image', alt: section.settings.text_4 }}
        {% else %}
          {{ 'lifestyle-2' | placeholder_svg_tag: 'koz-grid-image' }}
        {% endif %}
        {% if section.settings.text_4 != blank %}
          <h3 class="koz-overlay-text">{{ section.settings.text_4 }}</h3>
        {% endif %}
      </div>

    </div>
  </div>
</div>

{% schema %}
{
  "name": "KOZ Column showcase",
  "settings": [
    {
      "type": "header",
      "content": "Layout Settings"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 1000,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "label": "Max Container Width",
      "default": 1400
    },
    {
      "type": "range",
      "id": "row_height",
      "min": 250,
      "max": 600,
      "step": 10,
      "unit": "px",
      "label": "Row Height",
      "default": 350
    },
    {
      "type": "range",
      "id": "grid_gap",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Grid Gap (Spacing)",
      "default": 10
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background Color",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding Top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Side Padding",
      "default": 20
    },
    {
      "type": "header",
      "content": "Image 1 (Top Left - Large)"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "text_1",
      "label": "Overlay Text",
      "default": "SIDE PROFILE PRECISION"
    },
    {
      "type": "header",
      "content": "Image 2 (Top Right - Small)"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "text_2",
      "label": "Overlay Text",
      "default": "ARTISAN STITCHING"
    },
    {
      "type": "header",
      "content": "Image 3 (Bottom Left - Small)"
    },
    {
      "type": "image_picker",
      "id": "image_3",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "text_3",
      "label": "Overlay Text",
      "default": "3K CARBON WEAVE"
    },
    {
      "type": "header",
      "content": "Image 4 (Bottom Right - Large)"
    },
    {
      "type": "image_picker",
      "id": "image_4",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "text_4",
      "label": "Overlay Text",
      "default": "DIRECT FRONTAL IMPACT"
    }
  ],
  "presets": [
    {
      "name": "KOZ Column showcase"
    }
  ]
}
{% endschema %}