{%- liquid
  assign section_padding_top = section.settings.padding_top
  assign section_padding_bottom = section.settings.padding_bottom
  assign section_padding_left = section.settings.padding_left
  assign section_padding_right = section.settings.padding_right

  assign pad_top_mobile = section.settings.padding_top_mobile
  if pad_top_mobile == blank
    assign pad_top_mobile = section.settings.padding_top
  endif
  assign pad_bottom_mobile = section.settings.padding_bottom_mobile
  if pad_bottom_mobile == blank
    assign pad_bottom_mobile = section.settings.padding_bottom
  endif
  assign pad_left_mobile = section.settings.padding_left_mobile
  if pad_left_mobile == blank
    assign pad_left_mobile = section.settings.padding_left
  endif
  assign pad_right_mobile = section.settings.padding_right_mobile
  if pad_right_mobile == blank
    assign pad_right_mobile = section.settings.padding_right
  endif

  assign pad_h_desktop = section_padding_left
  if section_padding_right > pad_h_desktop
    assign pad_h_desktop = section_padding_right
  endif

  assign pad_h_mobile = pad_left_mobile
  if pad_right_mobile > pad_h_mobile
    assign pad_h_mobile = pad_right_mobile
  endif
  
  assign content_width = section.settings.content_width
  assign image_width = 100 | minus: content_width

  assign has_media = false
  if section.settings.center_content_mode == false
    if section.settings.image != blank or section.settings.video != blank or section.settings.video_url != blank
      assign has_media = true
    endif
  endif
  
  assign invert_class = ""
  if section.settings.desktop_layout_invert
    assign invert_class = "flexible-content__wrapper--inverted"
  endif

  # Background Logic
  assign has_bg_video = false
  if section.settings.bg_video != blank
    assign has_bg_video = true
  endif

  assign has_bg_image = false
  if section.settings.bg_image != blank
    assign has_bg_image = true
  endif

  assign layout_bottom = false
  if section.settings.image_position == 'bottom'
    assign layout_bottom = true
  endif

  assign heading_tag = section.settings.heading_size | default: 'h2'
  if heading_tag != 'h1' and heading_tag != 'h2' and heading_tag != 'h3' and heading_tag != 'h4' and heading_tag != 'h5' and heading_tag != 'h6'
    assign heading_tag = 'h2'
  endif

  assign show_icon_list = false
  for block in section.blocks
    if block.type == 'list_item'
      assign show_icon_list = true
    endif
  endfor
-%}

<style>
  /* Base section — symmetric horizontal inset (padding-inline matches left & right exactly) */
  #shopify-section-{{ section.id }} .section-{{ section.id }}-padding {
    position: relative;
    overflow: clip;
    padding-top: {{ pad_top_mobile }}px;
    padding-bottom: {{ pad_bottom_mobile }}px;
    padding-inline: max({{ pad_h_mobile }}px, var(--flex-content-gutter));
    background-color: {{ section.settings.section_bg_color }};
    --flex-content-gutter: var(--container-gutter, 1.25rem);
    --flex-inner-max: min(87.5rem, var(--container-xl-max-width, 85rem));
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .section-{{ section.id }}-padding {
      padding-top: {{ section_padding_top }}px;
      padding-bottom: {{ section_padding_bottom }}px;
      padding-inline: max({{ pad_h_desktop }}px, var(--flex-content-gutter));
    }
  }

  /* --- BACKGROUND MEDIA STYLING --- */
  #shopify-section-{{ section.id }} .section-bg-media {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .section-bg-media img,
  #shopify-section-{{ section.id }} .section-bg-media video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #shopify-section-{{ section.id }} .section-bg-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    background: rgba(0,0,0, {{ section.settings.bg_overlay_opacity | divided_by: 100.0 }});
  }

  #shopify-section-{{ section.id }} .section-{{ section.id }}-padding .page-width {
    position: relative;
    z-index: 2;
    box-sizing: border-box;
    width: 100%;
    max-width: var(--flex-inner-max);
    margin-inline: auto;
    min-width: 0;
  }

  #shopify-section-{{ section.id }} .flexible-content__wrapper {
    max-width: var(--flex-inner-max);
    margin-inline: auto;
    width: 100%;
    min-width: 0;
    box-sizing: border-box;
  }

  @media screen and (max-width: 1199px) {
    #shopify-section-{{ section.id }} .flexible-content__wrapper:not(.flexible-content__wrapper--centered) {
      display: flex;
      flex-direction: column;
      gap: {{ section.settings.stack_gap_tablet | default: 32 }}px;
    }
  }

  #shopify-section-{{ section.id }} .flexible-content__content {
    display: flex;
    flex-direction: column;
    gap: {{ section.settings.content_gap }}px !important; 
    text-align: {{ section.settings.content_alignment }};
    align-items: {% if section.settings.content_alignment == 'center' %}center{% elsif section.settings.content_alignment == 'right' %}flex-end{% else %}flex-start{% endif %};
  }

  #shopify-section-{{ section.id }} .flexible-content__subheading {
    font-size: {{ section.settings.subheading_size }}px;
    font-weight: {{ section.settings.subheading_weight }};
    color: {{ section.settings.color_subheading }};
    text-transform: uppercase;
    letter-spacing: 1px;
    margin: 0;
  }

  #shopify-section-{{ section.id }} .flexible-content__heading {
    font-size: {{ section.settings.heading_font_size }}px;
    font-weight: {{ section.settings.heading_weight }};
    color: {{ section.settings.color_heading }};
    line-height: 1.2;
    margin: 0;
  }

  #shopify-section-{{ section.id }} .flexible-content__text {
    font-size: {{ section.settings.text_size }}px;
    font-weight: {{ section.settings.text_weight | default: '400' }};
    color: {{ section.settings.color_text }};
    line-height: 1.6;
    margin: 0;
  }

  #shopify-section-{{ section.id }} .flexible-content__wrapper--centered {
    display: flex !important;
    flex-direction: column;
    align-items: center;
    text-align: center;
    max-width: {{ section.settings.cta_max_width }}px;
    margin: 0 auto;
  }

  #shopify-section-{{ section.id }} .flexible-content__wrapper--bottom {
    display: flex !important;
    flex-direction: column;
    gap: {{ section.settings.stack_gap_tablet | default: 32 }}px;
  }
  #shopify-section-{{ section.id }} .flexible-content__wrapper--bottom .flexible-content__content { order: 1; }
  #shopify-section-{{ section.id }} .flexible-content__wrapper--bottom .flexible-content__media-wrapper { order: 2; }

  #shopify-section-{{ section.id }} .flexible-content__icon-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    width: 100%;
    max-width: 100%;
  }
  #shopify-section-{{ section.id }} .flexible-content__icon-list-item {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    text-align: inherit;
  }
  #shopify-section-{{ section.id }} .flexible-content__icon-list-icon {
    flex-shrink: 0;
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: inherit;
  }
  #shopify-section-{{ section.id }} .flexible-content__icon-list-icon svg {
    width: 24px;
    height: 24px;
    display: block;
  }
  #shopify-section-{{ section.id }} .flexible-content__icon-list-body { min-width: 0; }
  #shopify-section-{{ section.id }} .flexible-content__icon-list-title {
    margin: 0 0 0.25rem;
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.35;
    color: inherit;
  }
  #shopify-section-{{ section.id }} .flexible-content__icon-list-text {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.5;
    opacity: 0.92;
  }

  @media screen and (min-width: 1200px) {
    {% if has_media and layout_bottom == false %}
      #shopify-section-{{ section.id }} .flexible-content__wrapper {
        display: grid !important;
        gap: clamp(2rem, 5vw, 6rem);
        align-items: center;
      }
      #shopify-section-{{ section.id }} .flexible-content__media-wrapper {
        grid-area: media;
        min-width: 0;
        overflow: clip;
      }
      #shopify-section-{{ section.id }} .flexible-content__content {
        grid-area: content;
        min-width: 0;
      }
      #shopify-section-{{ section.id }} .flexible-content__wrapper--left {
        grid-template-areas: "media content";
      }
      #shopify-section-{{ section.id }} .flexible-content__wrapper--right {
        grid-template-areas: "content media";
      }
    {% elsif has_media and layout_bottom %}
      #shopify-section-{{ section.id }} .flexible-content__wrapper {
        display: flex !important;
      }
    {% else %}
      #shopify-section-{{ section.id }} .flexible-content__wrapper {
        display: block;
        max-width: {{ section.settings.cta_max_width }}px;
        margin: 0 auto;
      }
    {% endif %}
  }

  #shopify-section-{{ section.id }} .flexible-content__media-wrapper video, 
  #shopify-section-{{ section.id }} .flexible-content__media-wrapper img,
  #shopify-section-{{ section.id }} .flexible-content__media-wrapper iframe {
    width: 100%;
    height: auto;
    border-radius: 20px;
    display: block;
  }

  #shopify-section-{{ section.id }} .flexible-content__button-group {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    justify-content: {{ section.settings.content_alignment }};
    margin-top: {{ section.settings.button_margin_top }}px;
  }

  #shopify-section-{{ section.id }} .flexible-content__button .button {
    display: inline-flex;
    align-items: center;
    padding: 12px 35px;
    border-radius: 50px;
    text-decoration: none;
    font-weight: 600;
    transition: all 0.2s ease;
  }

  #shopify-section-{{ section.id }} .button--primary {
    background: {{ section.settings.button_bg_color }};
    color: {{ section.settings.button_text_color }};
    border: 1px solid {{ section.settings.button_bg_color }};
  }

  #shopify-section-{{ section.id }} .button--secondary {
    background: transparent;
    color: {{ section.settings.button_secondary_text_color | default: section.settings.button_bg_color }};
    border: 1px solid {{ section.settings.button_secondary_border_color | default: '#e5e8f0' }};
  }

  #shopify-section-{{ section.id }} .button:hover { transform: translateY(-2px); opacity: 0.9; }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .flexible-content__subheading {
      font-size: {{ section.settings.subheading_size_mobile | default: section.settings.subheading_size }}px;
      font-weight: {{ section.settings.subheading_weight_mobile | default: section.settings.subheading_weight }};
      color: {{ section.settings.color_subheading_mobile | default: section.settings.color_subheading }};
    }
    #shopify-section-{{ section.id }} .flexible-content__heading {
      font-size: {{ section.settings.heading_font_size_mobile | default: section.settings.heading_font_size }}px;
      font-weight: {{ section.settings.heading_weight_mobile | default: section.settings.heading_weight }};
      color: {{ section.settings.color_heading_mobile | default: section.settings.color_heading }};
    }
    #shopify-section-{{ section.id }} .flexible-content__text {
      font-size: {{ section.settings.text_size_mobile | default: section.settings.text_size }}px;
      font-weight: {{ section.settings.text_weight_mobile | default: section.settings.text_weight | default: '400' }};
      color: {{ section.settings.color_text_mobile | default: section.settings.color_text }};
    }
    #shopify-section-{{ section.id }} .flexible-content__content {
      gap: {{ section.settings.content_gap_mobile | default: section.settings.content_gap }}px !important;
      text-align: {{ section.settings.content_alignment_mobile | default: 'center' }};
      align-items: {% assign cam = section.settings.content_alignment_mobile | default: 'center' %}{% if cam == 'center' %}center{% elsif cam == 'right' %}flex-end{% else %}flex-start{% endif %};
    }
    #shopify-section-{{ section.id }} .flexible-content__button-group {
      justify-content: {% assign cam2 = section.settings.content_alignment_mobile | default: 'center' %}{% if cam2 == 'center' %}center{% elsif cam2 == 'right' %}flex-end{% else %}flex-start{% endif %};
      width: 100%;
      margin-top: {{ section.settings.button_margin_top_mobile | default: section.settings.button_margin_top }}px;
    }
    #shopify-section-{{ section.id }} .flexible-content__button { width: 100%; }
    #shopify-section-{{ section.id }} .flexible-content__button .button { width: 100%; justify-content: center; }
    #shopify-section-{{ section.id }} .button--primary {
      background: {{ section.settings.button_bg_color_mobile | default: section.settings.button_bg_color }};
      color: {{ section.settings.button_text_color_mobile | default: section.settings.button_text_color }};
      border-color: {{ section.settings.button_bg_color_mobile | default: section.settings.button_bg_color }};
    }
    #shopify-section-{{ section.id }} .button--secondary {
      color: {{ section.settings.button_secondary_text_color_mobile | default: section.settings.button_secondary_text_color }};
      border-color: {{ section.settings.button_secondary_border_color_mobile | default: section.settings.button_secondary_border_color }};
    }
  }
</style>

<div class="flexible-content-section section-{{ section.id }}-padding {{ section.settings.custom_class }}">
  
  {%- if has_bg_video -%}
    <div class="section-bg-media">
      {{ section.settings.bg_video | video_tag: autoplay: true, loop: true, muted: true, controls: false }}
    </div>
  {%- elsif has_bg_image -%}
    <div class="section-bg-media">
      {{ section.settings.bg_image | image_url: width: 3000 | image_tag: loading: 'lazy' }}
    </div>
  {%- endif -%}

  {%- if section.settings.bg_overlay_opacity > 0 -%}
    <div class="section-bg-overlay"></div>
  {%- endif -%}

  <div class="page-width">
    {%- capture wrapper_classes -%}
      flexible-content__wrapper 
      {% if section.settings.center_content_mode or has_media == false %}
        flexible-content__wrapper--centered
      {% elsif layout_bottom %}
        flexible-content__wrapper--bottom
      {% else %}
        flexible-content__wrapper--{{ section.settings.image_position }}
      {% endif %}
      {{ invert_class }}
    {%- endcapture -%}
    
    <div class="{{ wrapper_classes }}">
      {%- if has_media -%}
        <div class="flexible-content__media-wrapper">
          {%- if section.settings.video != blank -%}
            {{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: false }}
          {%- elsif section.settings.video_url != blank -%}
             <div class="external-video">
               {%- if section.settings.video_url.type == 'youtube' -%}
                <iframe src="https://www.youtube.com/embed/{{ section.settings.video_url.id }}?autoplay=1&mute=1&loop=1" frameborder="0" allow="autoplay; encrypted-media" allowfullscreen></iframe>
              {%- else -%}
                <iframe src="https://player.vimeo.com/video/{{ section.settings.video_url.id }}?autoplay=1&muted=1&loop=1" frameborder="0" allow="autoplay; encrypted-media" allowfullscreen></iframe>
              {%- endif -%}
             </div>
          {%- else -%}
            {{ section.settings.image | image_url: width: 1500 | image_tag: loading: 'lazy' }}
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="flexible-content__content">
        {%- if section.settings.subheading != blank -%}
          <p class="flexible-content__subheading">{{ section.settings.subheading }}</p>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <{{ heading_tag }} class="flexible-content__heading">{{ section.settings.heading }}</{{ heading_tag }}>
        {%- endif -%}

        {%- if section.settings.text != blank -%}
          <div class="flexible-content__text rte">{{ section.settings.text }}</div>
        {%- endif -%}

        {%- if show_icon_list -%}
          <ul class="flexible-content__icon-list">
            {%- for block in section.blocks -%}
              {%- if block.type == 'list_item' -%}
                <li class="flexible-content__icon-list-item" {{ block.shopify_attributes }}>
                  {%- if block.settings.icon != blank -%}
                    <span class="flexible-content__icon-list-icon">{{ block.settings.icon }}</span>
                  {%- endif -%}
                  <div class="flexible-content__icon-list-body">
                    {%- if block.settings.title != blank -%}
                      <p class="flexible-content__icon-list-title">{{ block.settings.title }}</p>
                    {%- endif -%}
                    {%- if block.settings.text != blank -%}
                      <div class="flexible-content__icon-list-text rte">{{ block.settings.text }}</div>
                    {%- endif -%}
                  </div>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- if section.settings.button_label != blank or section.settings.button_label_2 != blank -%}
          <div class="flexible-content__button-group">
            {%- if section.settings.button_label != blank -%}
              <div class="flexible-content__button">
                <a href="{{ section.settings.button_link }}" class="button {% if section.settings.button_style_secondary %}button--secondary{% else %}button--primary{% endif %}">
                  {{ section.settings.button_label }}
                  {% if section.settings.show_button_arrow %} <span style="margin-left:8px;">&rarr;</span> {% endif %}
                </a>
              </div>
            {%- endif -%}

            {%- if section.settings.button_label_2 != blank -%}
              <div class="flexible-content__button">
                <a href="{{ section.settings.button_link_2 }}" class="button button--secondary">
                  {{ section.settings.button_label_2 }}
                  {% if section.settings.show_button_arrow_2 %} <span style="margin-left:8px;">&rarr;</span> {% endif %}
                </a>
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Flexible Media & CTA",
  "settings": [
    { "type": "header", "content": "Layout Mode" },
    { "type": "checkbox", "id": "center_content_mode", "label": "Enable Centered CTA Mode (Hides Media)", "default": false },
    { "type": "range", "id": "cta_max_width", "min": 400, "max": 1400, "step": 50, "unit": "px", "label": "Max Width (No-Media Mode)", "default": 800 },
    { "type": "text", "id": "custom_class", "label": "Custom CSS classes", "info": "Added on the section wrapper for page-specific styling." },
    { "type": "select", "id": "heading_size", "label": "Heading tag", "options": [{"value":"h1","label":"H1"},{"value":"h2","label":"H2"},{"value":"h3","label":"H3"},{"value":"h4","label":"H4"},{"value":"h5","label":"H5"},{"value":"h6","label":"H6"}], "default": "h2" },
    { "type": "checkbox", "id": "button_style_secondary", "label": "Primary button uses secondary (outline) style", "default": false },
    
    { "type": "header", "content": "Section Background" },
    { "type": "color", "id": "section_bg_color", "label": "Background Color", "default": "#ffffff" },
    { "type": "image_picker", "id": "bg_image", "label": "Background Image" },
    { "type": "video", "id": "bg_video", "label": "Background Video (Priority)" },
    { "type": "range", "id": "bg_overlay_opacity", "min": 0, "max": 90, "step": 5, "unit": "%", "label": "Background Overlay Opacity", "default": 0 },

    { "type": "header", "content": "Media Settings" },
    { "type": "video", "id": "video", "label": "Shopify Hosted Video" },
    { "type": "video_url", "id": "video_url", "label": "External Video URL", "accept": ["youtube", "vimeo"] },
    { "type": "image_picker", "id": "image", "label": "Fallback Image" },
    { "type": "select", "id": "image_position", "label": "Desktop Media Position", "options": [{"value":"left","label":"Left"},{"value":"right","label":"Right"},{"value":"bottom","label":"Image below text"}], "default": "left" },
    { "type": "checkbox", "id": "desktop_layout_invert", "label": "Swap Media/Text Sides", "default": false },
    { "type": "range", "id": "content_width", "min": 30, "max": 70, "step": 5, "unit": "%", "label": "Desktop Text Width", "default": 50 },
    
    { "type": "header", "content": "Typography" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Custom Section Heading" },
    { "type": "color", "id": "color_heading", "label": "Heading Color", "default": "#4a5486" },
    { "type": "range", "id": "heading_font_size", "min": 20, "max": 100, "step": 2, "unit": "px", "label": "Heading Size", "default": 40 },
    { "type": "select", "id": "heading_weight", "label": "Heading Weight", "options": [{"value":"400","label":"Normal"},{"value":"700","label":"Bold"}], "default": "700" },
    { "type": "text", "id": "subheading", "label": "Subheading" },
    { "type": "color", "id": "color_subheading", "label": "Subheading Color", "default": "#8e94a7" },
    { "type": "range", "id": "subheading_size", "min": 12, "max": 24, "unit": "px", "label": "Subheading Size", "default": 14 },
    { "type": "select", "id": "subheading_weight", "label": "Subheading Weight", "options": [{"value":"400","label":"Normal"},{"value":"600","label":"Semi-bold"}], "default": "600" },
    { "type": "richtext", "id": "text", "label": "Description" },
    { "type": "color", "id": "color_text", "label": "Description Color", "default": "#7a7a7a" },
    { "type": "range", "id": "text_size", "min": 14, "max": 24, "unit": "px", "label": "Description Size", "default": 18 },
    { "type": "select", "id": "text_weight", "label": "Description Weight", "options": [{"value":"400","label":"Normal"},{"value":"500","label":"Medium"},{"value":"600","label":"Semi-bold"}], "default": "400" },
    { "type": "select", "id": "content_alignment", "label": "Text Alignment", "options": [{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}], "default": "left" },

    { "type": "header", "content": "Tablet layout (stacked, under 1200px)" },
    { "type": "range", "id": "stack_gap_tablet", "min": 0, "max": 80, "step": 4, "unit": "px", "label": "Gap between image and text (stacked view)", "default": 32 },

    { "type": "header", "content": "Mobile typography (under 750px)" },
    { "type": "paragraph", "content": "Adjust type and buttons on small screens. Colors default to desktop values until changed." },
    { "type": "range", "id": "heading_font_size_mobile", "min": 18, "max": 64, "step": 2, "unit": "px", "label": "Heading size", "default": 28 },
    { "type": "color", "id": "color_heading_mobile", "label": "Heading color", "default": "#4a5486" },
    { "type": "select", "id": "heading_weight_mobile", "label": "Heading weight", "options": [{"value":"400","label":"Normal"},{"value":"700","label":"Bold"}], "default": "700" },
    { "type": "range", "id": "subheading_size_mobile", "min": 10, "max": 20, "unit": "px", "label": "Subheading size", "default": 12 },
    { "type": "color", "id": "color_subheading_mobile", "label": "Subheading color", "default": "#8e94a7" },
    { "type": "select", "id": "subheading_weight_mobile", "label": "Subheading weight", "options": [{"value":"400","label":"Normal"},{"value":"600","label":"Semi-bold"}], "default": "600" },
    { "type": "range", "id": "text_size_mobile", "min": 14, "max": 22, "unit": "px", "label": "Description size", "default": 16 },
    { "type": "color", "id": "color_text_mobile", "label": "Description color", "default": "#7a7a7a" },
    { "type": "select", "id": "text_weight_mobile", "label": "Description weight", "options": [{"value":"400","label":"Normal"},{"value":"500","label":"Medium"},{"value":"600","label":"Semi-bold"}], "default": "400" },
