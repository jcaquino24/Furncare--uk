{% comment %}
  Custom section replicating the layout from image_085448.jpg
  Includes header text, contact links, video slot, and a custom HubSpot embed form block.
{% endcomment %}

<div class="show-van-section" id="show-van-{{ section.id }}">
  <div class="show-van-container">
    
    <!-- Header Area -->
    <div class="show-van-header">
      {%- if section.settings.subtitle != blank -%}
        <span class="show-van-subtitle eyebrow-sm">{{ section.settings.subtitle }}</span>
      {%- endif -%}
      
      {%- if section.settings.title != blank -%}
        <h2 class="show-van-title">{{ section.settings.title }}</h2>
      {%- endif -%}
      
      {%- if section.settings.description != blank -%}
        <div class="show-van-description">
          {{ section.settings.description }}
        </div>
      {%- endif -%}

      <!-- Contact and Socials -->
      <div class="show-van-meta">
        {%- if section.settings.phone != blank -%}
          <a href="tel:{{ section.settings.phone | replace: ' ', '' }}" class="eyebrow-sm meta-link">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            {{ section.settings.phone }}
          </a>
        {%- endif -%}
        
        {%- if section.settings.email != blank -%}
          <a href="mailto:{{ section.settings.email }}" class="eyebrow-sm meta-link">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            {{ section.settings.email }}
          </a>
        {%- endif -%}

        <!-- Social Icons (Matching image_085448.jpg) -->
        <div class="meta-socials">
          {%- if section.settings.facebook_url != blank -%}
            <a href="{{ section.settings.facebook_url }}" target="_blank"><svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg></a>
          {%- endif -%}
          {%- if section.settings.instagram_url != blank -%}
            <a href="{{ section.settings.instagram_url }}" target="_blank"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg></a>
          {%- endif -%}
          {%- if section.settings.linkedin_url != blank -%}
            <a href="{{ section.settings.linkedin_url }}" target="_blank"><svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6zM2 9h4v12H2z"/><circle cx="4" cy="4" r="2"/></svg></a>
          {%- endif -%}
        </div>
      </div>
    </div>

    <!-- Main Content Grid Layout -->
    <div class="show-van-grid">
      
      <!-- Left Column: Video Element -->
      <div class="show-van-media-col">
        <div class="video-wrapper">
          {%- if section.settings.video_hosted != blank -%}
            {{ section.settings.video_hosted | video_tag: controls: true, autoplay: true, loop: true, class: 'native-video' }}
          {%- elsif section.settings.external_video_url != blank -%}
            {%- if section.settings.external_video_url.type == 'youtube' -%}
              <iframe src="https://www.youtube.com/embed/{{ section.settings.external_video_url.id }}" frameborder="0" allowfullscreen></iframe>
            {%- else -%}
              <iframe src="https://player.vimeo.com/video/{{ section.settings.external_video_url.id }}" frameborder="0" allowfullscreen></iframe>
            {%- endif -%}
          {%- else -%}
            <!-- Fallback placeholder image matching the structure of image_085448.jpg -->
            {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </div>
      </div>

      <!-- Right Column: Form Embed Box -->
      <div class="show-van-form-col">
        <div class="form-embed-card">
          {%- if section.settings.form_embed_code != blank -%}
            {{ section.settings.form_embed_code }}
          {%- else -%}
            <div class="form-placeholder" style="text-align: center; padding: 40px 20px; color: #777;">
              <p><strong>HubSpot Form Slot</strong></p>
              <p style="font-size: 13px;">Paste your HubSpot embed script within the section settings sidebar to display the live form here.</p>
            </div>
          {%- endif -%}
        </div>
      </div>
      
    </div>
  </div>
</div>

<style>
  #show-van-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    padding: {{ section.settings.padding_top }}px 20px {{ section.settings.padding_bottom }}px 20px;
  .show-van-container {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
  }
  .show-van-header {
    text-align: center;
    max-width: 800px;
    margin: 0 auto 50px auto;
  }
  .show-van-subtitle {
    display: block;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: #555;
    margin-bottom: 12px;
    font-weight: 500;
  }
  .show-van-title {
    font-size: calc(2rem + 1.5vw);
    font-weight: 400;
    line-height: 1.2;
    margin: 0 0 20px 0;
    color: #1c2b24;
  }
  .show-van-description {
    font-size: 14px;
    line-height: 1.6;
    color: #4a4a4a;
    margin-bottom: 25px;
  }
  .show-van-meta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }
  .meta-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: #4a4a4a;
    text-decoration: none;
    transition: opacity 0.2s;
  }
  .meta-link:hover {
    opacity: 0.7;
  }
  .meta-socials {
    display: flex;
    gap: 15px;
    margin-top: 5px;
    color: #000;
  }
  .meta-socials a {
    color: inherit;
    text-decoration: none;
    transition: transform 0.2s;
  }
  .meta-socials a:hover {
    transform: scale(1.1);
  }

  /* Grid Layout */
  .show-van-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 30px;
    align-items: start;
  }
  .show-van-media-col {
    width: 100%;
  }
  .video-wrapper {
    position: relative;
    width: 100%;
    border-radius: 12px;
    overflow: hidden;
    background: #000;
    aspect-ratio: 16 / 10; /* Clean ratio similar to image_085448.jpg */
    box-shadow: 0 4px 20px rgba(0,0,0,0.05);
  }
  .video-wrapper video.native-video,
  .video-wrapper iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border: none;
  }
  .placeholder-svg {
    width: 100%;
    height: 100%;
    background: #e5e5e5;
  }

  /* Right-Side Card styling for the form */
  .show-van-form-col {
    width: 100%;
  }
  .form-embed-card {
    background: #ffffff;
    border-radius: 8px;
    padding: 30px;
    box-shadow: 0 4px 30px rgba(0, 0, 0, 0.03);
    min-height: 400px;
  }

  /* Mobile Responsive adjustments */
  @media (max-width: 991px) {
    .show-van-grid {
      grid-template-columns: 1fr;
      gap: 30px;
    }
    .video-wrapper {
      aspect-ratio: 16 / 9;
    }
  }
</style>

{% schema %}
{
  "name": "Video & Form",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#f9f6f0"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 1000,
      "max": 2600,
      "step": 50,
      "unit": "px",
      "label": "Container Maximum Width",
      "default": 1250
    },
    {
      "type": "header",
      "content": "Header Text Content"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "BOOK YOURS TODAY"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading Title",
      "default": "The Show Van Experience"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description Paragraph",
      "default": "<p>Our Show Van service allows you and your residents to see, touch and test samples of our furniture without leaving your care facility.</p>"
    },
    {
      "type": "header",
      "content": "Contact Details & Social Links"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone Number",
      "default": "01603 561433"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email Address",
      "default": "sales@furncare.co.uk"
    },
    {
      "type": "url",
      "id": "facebook_url",
      "label": "Facebook URL"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram URL"
    },
    {
      "type": "url",
      "id": "linkedin_url",
      "label": "LinkedIn URL"
    },
    {
      "type": "header",
      "content": "Media Configuration (Left Column)"
    },
    {
      "type": "video",
      "id": "video_hosted",
      "label": "Shopify-hosted Native Video (Recommended)"
    },
    {
      "type": "video_url",
      "id": "external_video_url",
      "label": "Or External Video URL (YouTube/Vimeo)",
      "accept": ["youtube", "vimeo"]
    },
    {
      "type": "header",
      "content": "Form Integration (Right Column)"
    },
    {
      "type": "html",
      "id": "form_embed_code",
      "label": "HubSpot Form Embed Code",
      "info": "Paste your complete <script> snippet from HubSpot here."
    },
    {
      "type": "header",
      "content": "Section Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 120,
      "step": 5,
      "unit": "px",
      "label": "Padding Top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 120,
      "step": 5,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "Video & Form"
    }
  ]
}
{% endschema %}