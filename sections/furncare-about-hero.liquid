{{ 'furncare-about.css' | asset_url | stylesheet_tag }}
<script src="{{ 'furncare-about.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign words = section.settings.animated_words | newline_to_br | split: '<br />'
  assign reveal_class = ''
  if section.settings.enable_reveal
    assign reveal_class = ' fa-reveal'
  endif
-%}
{%- capture furncare_selector -%}#FurncareAboutHero-{{ section.id }}{%- endcapture -%}
{% style %}
  {% render 'furncare-about-style-vars', selector: furncare_selector, section_settings: section.settings %}
{% endstyle %}

<section
  id="FurncareAboutHero-{{ section.id }}"
  class="fa-page-section fa-hero"
  {% if section.settings.enable_parallax %}data-fa-parallax{% endif %}
>
  <div class="fa-hero__media" {% if section.settings.enable_parallax %}data-fa-parallax-target{% endif %}></div>

  <div class="fa-wrap">
    <div class="fa-hero__content">
      <div class="fa-content-box{{ reveal_class }}">
        {%- if section.settings.eyebrow != blank -%}
          <p class="fa-section-eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h1 class="fa-heading-xl">{{ section.settings.heading | escape }}</h1>
        {%- endif -%}

        {%- if section.settings.copy != blank -%}
          <p class="fa-lede">{{ section.settings.copy }}</p>
        {%- endif -%}

        {%- if section.settings.primary_label != blank or section.settings.secondary_label != blank -%}
          <div class="fa-buttons">
            {%- if section.settings.primary_label != blank -%}
              <a class="fa-button fa-button--primary" href="{{ section.settings.primary_link | default: '#' }}">
                {{ section.settings.primary_label | escape }}
                <svg class="fa-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
              </a>
            {%- endif -%}

            {%- if section.settings.secondary_label != blank -%}
              <a class="fa-button fa-button--secondary" href="{{ section.settings.secondary_link | default: '#' }}">
                {{ section.settings.secondary_label | escape }}
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if section.settings.show_rotator -%}
          <div class="fa-helper-line">
            {%- if section.settings.animated_prefix != blank -%}
              <span>{{ section.settings.animated_prefix | escape }}</span>
            {%- endif -%}

            <span class="fa-rotator" data-fa-rotator>
              {%- for word in words -%}
                {%- assign clean_word = word | strip -%}
                {%- if clean_word != blank -%}
                  <span class="fa-rotator__word{% if forloop.first %} is-active{% endif %}">{{ clean_word | escape }}</span>
                {%- endif -%}
              {%- endfor -%}
            </span>

            {%- if section.settings.animated_suffix != blank -%}
              <span>{{ section.settings.animated_suffix | escape }}</span>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

