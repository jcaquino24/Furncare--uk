{% liquid
  # Get products from metafield
  assign metafield_products = article.metafields.custom.products.value

  # Don't render section if metafield is empty
  if metafield_products == blank or metafield_products.count == 0
    continue
  endif

  # Fallback section ID for navigation
  assign fallback_section_id = section.id | default: 'article-products'
  if fallback_section_id == blank or fallback_section_id == empty
    assign fallback_section_id = 'article-products'
  endif

  # Check if we should show navigation
  assign show_nav = false
  if metafield_products.count > 4
    assign show_nav = true
  endif

  render 'vite-tag' with '@sections/content-blocks.ts'
%}

<uwp-content-blocks
  class="content-blocks article-products colour-scheme--{{ section.settings.colour_scheme }} {% if show_nav %}content-blocks--has-swiper{% endif %}"
  style="--section-padding: var({{ section.settings.section_padding }});"
  role="region"
  aria-label="Article products"
  aria-roledescription="region"
>
  <div class="container">
    <div class="content-blocks__header">
      {% render 'title-with-nav',
        title: section.settings.title,
        heading_level: 'h2',
        heading_style: 'eyebrow-sm',
        show_nav: show_nav,
        nav_class: 'hide-on-mobile title-with-nav__nav',
        section_id: fallback_section_id
      %}
    </div>

    <div class="content-blocks__content">
      <div class="content-blocks__tab is-active">
        {% if metafield_products.count > 0 and metafield_products.count > 4 %}
          <swiper-container
            class="content-blocks__swiper"
            slides-per-view="2"
            space-between="12"
            breakpoints='
              {
                "768": {
                  "spaceBetween": 20,
                  "slidesPerView": 4
                }
              }
            '
            navigation-prev-el="#swiper-button-prev-{{ fallback_section_id }}"
            navigation-next-el="#swiper-button-next-{{ fallback_section_id }}"
            role="region"
            aria-label="Product carousel"
          >
            {% for product in metafield_products limit: 8 %}
              <swiper-slide class="content-blocks__slide">
                {% render 'product-card', product: product %}
              </swiper-slide>
            {% endfor %}
          </swiper-container>
          {% if show_nav %}
            {% render 'swiper-nav',
              class: 'hide-on-desktop content-blocks__swiper-nav',
              section_id: fallback_section_id
            %}
          {% endif %}
        {% elsif metafield_products.count > 0 %}
          <div class="content-blocks__grid">
            {% for product in metafield_products %}
              {% render 'product-card', product: product %}
            {% endfor %}
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</uwp-content-blocks>

{% schema %}
{
  "name": "Article Products",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Product in this story"
    },
    {
      "type": "select",
      "id": "section_padding",
      "label": "Section padding",
      "default": "--spacing-2xl",
      "options": [
        {
          "value": "--spacing-md",
          "label": "Narrow"
        },
        {
          "value": "--spacing-2xl",
          "label": "Default"
        },
        {
          "value": "--spacing-4xl",
          "label": "Wide"
        }
      ]
    },
    {
      "type": "select",
      "id": "colour_scheme",
      "label": "Colour scheme",
      "default": "base-white-01",
      "options": [
        {
          "value": "base-white-01",
          "label": "Base white 01"
        },
        {
          "value": "base-white-02",
          "label": "Base white 02"
        },
        {
          "value": "warm-stone",
          "label": "Warm stone"
        },
        {
          "value": "duck-egg",
          "label": "Duck Egg"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Article Products",
      "settings": {
        "title": "Related Products",
        "section_padding": "--spacing-2xl",
        "colour_scheme": "base-white-01"
      }
    }
  ]
}
{% endschema %}
