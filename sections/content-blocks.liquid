{% liquid
  assign tab1_images = section.blocks | where: 'type', 'tab1'
  assign tab2_images = section.blocks | where: 'type', 'tab2'
  assign has_tabs = false

  assign fallback_section_id = section.id | default: 'content-blocks'
  if fallback_section_id == blank or fallback_section_id == empty
    assign fallback_section_id = 'content-blocks'
  endif

  if tab1_images.size > 0 and tab2_images.size > 0 and section.settings.tab1_title != blank and section.settings.tab1_handle != blank and section.settings.tab2_title != blank and section.settings.tab2_handle != blank
    assign has_tabs = true
  endif

  render 'vite-tag' with '@sections/content-blocks.ts'
%}

{% capture tabs_html %}
  {% if has_tabs %}

    {% assign attributes = 'js-content-blocks="tab-trigger" data-tab="tab1" data-colour-scheme="' | append: section.settings.tab1_colour_scheme | append: '"' %}
    {% render 'button',
      class: 'is-active',
      label: section.settings.tab1_title,
      style: 'underline',
      scheme: section.settings.tab1_colour_scheme,
      attributes: attributes
    %}
    
    {% assign attributes = 'js-content-blocks="tab-trigger" data-tab="tab2" data-colour-scheme="' | append: section.settings.tab2_colour_scheme | append: '"' %}
    {% render 'button',
      label: section.settings.tab2_title,
      style: 'underline',
      scheme: section.settings.tab2_colour_scheme,
      attributes: attributes
    %}
  {% endif %}
{% endcapture %}

{% assign show_nav = false %}
{% if tab1_images.size > 4 or tab2_images.size > 4 %}
  {% assign show_nav = true %}
{% endif %}

{% assign title_classes = 'title-with-nav__nav' %}
{% if show_nav and tabs_html != blank %}
  {% assign title_classes = 'hide-on-mobile title-with-nav__nav' %}
{% endif %}

<uwp-content-blocks
  class="content-blocks--{{ template | handleize}} content-blocks colour-scheme--{{ section.settings.tab1_colour_scheme }} {% if show_nav %}content-blocks--has-swiper{% endif %}"
  style="--section-padding: var({{ section.settings.section_padding }});"
  role="region"
  aria-label="Content blocks"
  aria-roledescription="region"
>
  <div class="container">
    <div class="content-blocks__header">
      <div class="title-with-nav {% if tabs_html == blank %}title-with-nav--no-tabs{% endif %}">
        <div class="title-with-nav__row">
          {% if section.settings.title != blank %}
            <h2 class="eyebrow-sm title-with-nav__title">
              {{ section.settings.title }}
            </h2>
          {% endif %}

          {% if tabs_html != blank %}
            <div class="title-with-nav__tabs">
              {{ tabs_html }}
            </div>
          {% endif %}
        </div>

        {% if show_nav %}
          {% render 'swiper-nav', class: title_classes, section_id: fallback_section_id %}
        {% endif %}
      </div>
    </div>

    <div class="content-blocks__content">
      <!-- Tab 1 Content -->
      {% if tab1_images.size > 0 %}
        <div
          class="content-blocks__tab is-active"
          js-content-blocks="tab-content"
          data-tab="tab1"
        >
          {% if tab1_images.size > 4 %}
            <swiper-container
              class="content-blocks__swiper"
              slides-per-view="auto"
              space-between="12"
              breakpoints='
                {
                  "768": {
                    "spaceBetween": 20
                  }
                }
              '
              navigation-prev-el="#swiper-button-prev-{{ fallback_section_id }}-tab1"
              navigation-next-el="#swiper-button-next-{{ fallback_section_id }}-tab1"
              role="region"
              aria-label="Content blocks carousel"
              aria-roledescription="carousel"
            >
              {% for block in tab1_images %}
                {% if block.settings.image != blank %}
                  <swiper-slide class="content-blocks__slide">
                    {% render 'content-block-item',
                      image: block.settings.image,
                      image_mobile: block.settings.image_mobile,
                      video: block.settings.video,
                      video_mobile: block.settings.video_mobile,
                      text: block.settings.text,
                      richtext: block.settings.richtext,
                      richtext_color: block.settings.richtext_color,
                      richtext_font_size: block.settings.richtext_font_size,
                      richtext_font_weight: block.settings.richtext_font_weight,
                      richtext_text_transform: block.settings.richtext_text_transform,
                      richtext_letter_spacing: block.settings.richtext_letter_spacing,
                      link: block.settings.link,
                      gradient_overlay: block.settings.gradient_overlay,
                      block_id: block.id,
                      image_index: forloop.index
                    %}
                  </swiper-slide>
                {% endif %}
              {% endfor %}
            </swiper-container>
            {% if tabs_html != blank %}
              {% assign section_id_with_tab = fallback_section_id
                | append: '-tab1'
              %}
              {% render 'swiper-nav',
                class: 'hide-on-desktop content-blocks__swiper-nav',
                section_id: section_id_with_tab
              %}
            {% endif %}
          {% else %}
            <div class="content-blocks__grid content-blocks__grid--{{ tab1_images.size }}">
              {% for block in tab1_images %}
                {% if block.settings.image != blank %}
                  {% render 'content-block-item',
                    image: block.settings.image,
                    image_mobile: block.settings.image_mobile,
                    video: block.settings.video,
                    video_mobile: block.settings.video_mobile,
                    text: block.settings.text,
                    richtext: block.settings.richtext,
                    richtext_color: block.settings.richtext_color,
                    richtext_font_size: block.settings.richtext_font_size,
                    richtext_font_weight: block.settings.richtext_font_weight,
                    richtext_text_transform: block.settings.richtext_text_transform,
                    richtext_letter_spacing: block.settings.richtext_letter_spacing,
                    link: block.settings.link,
                    gradient_overlay: block.settings.gradient_overlay,
                    block_id: block.id,
                    image_index: forloop.index
                  %}
                {% endif %}
              {% endfor %}
            </div>
          {% endif %}
        </div>
      {% endif %}

      <!-- Tab 2 Content -->
      {% if tab2_images.size > 0 %}
        <div
          class="content-blocks__tab{% unless has_tabs %} is-active{% endunless %}"
          js-content-blocks="tab-content"
          data-tab="tab2"
        >
          {% if tab2_images.size > 4 %}
            <swiper-container
              class="content-blocks__swiper"
              space-between="20"
              slides-per-view="auto"
              navigation-prev-el="#swiper-button-prev-{{ fallback_section_id }}-tab2"
              navigation-next-el="#swiper-button-next-{{ fallback_section_id }}-tab2"
              role="region"
              aria-label="Content blocks carousel"
              aria-roledescription="carousel"
            >
              {% for block in tab2_images %}
                {% if block.settings.image != blank %}
                  <swiper-slide class="content-blocks__slide">
                    {% render 'content-block-item',
                      image: block.settings.image,
                      image_mobile: block.settings.image_mobile,
                      video: block.settings.video,
                      video_mobile: block.settings.video_mobile,
                      text: block.settings.text,
                      richtext: block.settings.richtext,
                      richtext_color: block.settings.richtext_color,
                      richtext_font_size: block.settings.richtext_font_size,
                      richtext_font_weight: block.settings.richtext_font_weight,
                      richtext_text_transform: block.settings.richtext_text_transform,
                      richtext_letter_spacing: block.settings.richtext_letter_spacing,
                      link: block.settings.link,
                      gradient_overlay: block.settings.gradient_overlay,
                      block_id: block.id,
                      image_index: forloop.index
                    %}
                  </swiper-slide>
                {% endif %}
              {% endfor %}
            </swiper-container>

            {% if tabs_html != blank %}
              {% assign section_id_with_tab = fallback_section_id
                | append: '-tab2'
              %}
              {% render 'swiper-nav',
                class: 'hide-on-desktop content-blocks__swiper-nav',
                section_id: section_id_with_tab
              %}
            {% endif %}
          {% else %}
            <div class="content-blocks__grid content-blocks__grid--{{ tab2_images.size }}">
              {% for block in tab2_images %}
                {% if block.settings.image != blank %}
                  {% render 'content-block-item',
                    image: block.settings.image,
                    image_mobile: block.settings.image_mobile,
                    video: block.settings.video,
                    video_mobile: block.settings.video_mobile,
                    text: block.settings.text,
                    richtext: block.settings.richtext,
                    richtext_color: block.settings.richtext_color,
                    richtext_font_size: block.settings.richtext_font_size,
                    richtext_font_weight: block.settings.richtext_font_weight,
                    richtext_text_transform: block.settings.richtext_text_transform,
                    richtext_letter_spacing: block.settings.richtext_letter_spacing,
                    link: block.settings.link,
                    gradient_overlay: block.settings.gradient_overlay,
                    block_id: block.id,
                    image_index: forloop.index
                  %}
                {% endif %}
              {% endfor %}
            </div>
          {% endif %}
        </div>
      {% endif %}
    </div>
  </div>
</uwp-content-blocks>

