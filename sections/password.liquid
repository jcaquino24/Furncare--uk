{% comment %}
  Password Page Section
  Simple, modern design for Shopify storefront password page
{% endcomment %}

<section class="password-page">
  <div class="password-page__inner container">
    <h1 class="password-page__title">{{ 'password_page.title' | t: shop_name: shop.name }}</h1>
    <p class="password-page__message">{{ 'password_page.message' | t }}</p>

    <form method="post" action="/password" class="password-page__form" id="password-form">
      <label for="password" class="visually-hidden">{{ 'password_page.login_form_password_label' | t }}</label>
      <input
        type="password"
        name="password"
        id="password"
        class="password-page__input"
        placeholder="{{ 'password_page.login_form_password_placeholder' | t }}"
      >
      <button type="submit" class="password-page__button button">
        {{ 'password_page.login_form_submit' | t }}
      </button>
    </form>
  </div>
</section>

{% schema %}
{
  "name": "Password page",
  "settings": [
  ]
}
{% endschema %}

<style>
.password-page {
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 100vh;
  text-align: center;
}
.password-page__inner {
  max-width: 400px;
}
.password-page__input {
  width: 100%;
  margin: 0.5rem 0;
  padding: 0.8rem;
  border: 1px solid #ccc;
  border-radius: 4px;
}
.password-page__button {
  width: 100%;
  padding: 0.8rem;
  background: #000;
  color: #fff;
  border: none;
  border-radius: 4px;
  cursor: pointer;
}
.password-page__button:hover {
  background: #333;
}
</style>