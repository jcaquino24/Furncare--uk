<section
  class="portal-tabs"
  id="portal-tabs-{{ section.id }}"
  data-portal-tabs
  style="--section-padding: var({{ section.settings.section_padding }})"
>
  <div class="portal-tabs__inner">
    {%- if section.settings.heading != blank -%}
      <h1 class="portal-tabs__heading">
        {{- section.settings.heading -}}
        {%- if customer.first_name != blank %}, {{ customer.first_name | escape }}{% endif -%}
        {%- if customer.current_company.name != blank %}, {{ customer.current_company.name | escape }}{% endif -%}
      </h1>
    {%- endif -%}

    <ul class="portal-tabs__list" role="tablist" aria-label="{{ section.settings.heading | escape }}">
      {%- for block in section.blocks -%}
        <li role="presentation" {{ block.shopify_attributes }}>
          {%- if block.type == 'link' -%}
            <a class="portal-tabs__tab" href="{{ block.settings.link | default: '#' }}">
              {{- block.settings.title -}}
            </a>
          {%- else -%}
            <button
              type="button"
              role="tab"
              class="portal-tabs__tab{% if forloop.first %} is-active{% endif %}"
              id="portal-tab-{{ block.id }}"
              data-portal-tab="{{ block.id }}"
              aria-controls="portal-panel-{{ block.id }}"
              aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
              tabindex="{% if forloop.first %}0{% else %}-1{% endif %}"
            >
              {{- block.settings.title -}}
            </button>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>

    {%- for block in section.blocks -%}
      {%- if block.type == 'link' -%}
        {%- continue -%}
      {%- endif -%}

      <div
        class="portal-tabs__panel"
        role="tabpanel"
        id="portal-panel-{{ block.id }}"
        aria-labelledby="portal-tab-{{ block.id }}"
        {% unless forloop.first %}hidden{% endunless %}
      >
        {%- case block.type -%}
          {%- when 'catalogs' -%}
            {%- if block.settings.collections.size > 0 -%}
              <div data-portal-catalog-list>
                <ul class="list-collections__list">
                  {%- for collection in block.settings.collections -%}
                    <li class="list-collections__item">
                      {% render 'content-block',
                        blocks_size: 4,
                        title: collection.title,
                        image: collection.image,
                        url: collection.url
                      %}
                    </li>
                  {%- endfor -%}
                </ul>
              </div>
              <div data-portal-catalog-results hidden>
                <button type="button" class="button button--secondary portal-tabs__back" data-portal-back>
                  &larr; Back to catalogs
                </button>
                <div data-portal-results-body aria-live="polite"></div>
              </div>
            {%- else -%}
              <p>No catalogs available.</p>
            {%- endif -%}

          {%- when 'products' -%}
            {%- assign panel_collection = block.settings.collection | default: collections.all -%}
            {%- if panel_collection.products.size > 0 -%}
              <div class="portal-tabs__products">
                {%- for product in panel_collection.products limit: block.settings.product_limit -%}
                  {% render 'product-card', product: product, loading: 'lazy' %}
                {%- endfor -%}
              </div>
            {%- else -%}
              <p>No products available.</p>
            {%- endif -%}

          {%- when 'contact' -%}
            <div class="portal-tabs__contact rte">
              {{ block.settings.text }}
              {%- if block.settings.button_link != blank and block.settings.button_label != blank -%}
                <a class="button button--primary" href="{{ block.settings.button_link }}">
                  {{- block.settings.button_label -}}
                </a>
              {%- endif -%}
            </div>
        {%- endcase -%}
      </div>
    {%- endfor -%}
  </div>
</section>

<script>
  (function () {
    if (window.__portalTabsInit) return;
    window.__portalTabsInit = true;

    function activate(root, id, focus) {
      var tabs = root.querySelectorAll('[data-portal-tab]');
      var found = false;
      tabs.forEach(function (tab) {
        var active = tab.getAttribute('data-portal-tab') === id;
        found = found || active;
        tab.classList.toggle('is-active', active);
        tab.setAttribute('aria-selected', active ? 'true' : 'false');
        tab.setAttribute('tabindex', active ? '0' : '-1');
        var panel = document.getElementById(tab.getAttribute('aria-controls'));
        if (panel) panel.hidden = !active;
        if (active && focus) tab.focus();
      });
      return found;
    }

    function fromHash(root) {
      var id = (window.location.hash || '').replace('#portal-tab-', '');
      if (id) activate(root, id, false);
    }

    // Catalog card: load that collection's products into the same panel.
    var catalogCache = {};

    function showCatalogList(panel) {
      panel.querySelector('[data-portal-catalog-list]').hidden = false;
      panel.querySelector('[data-portal-catalog-results]').hidden = true;
    }

    function openCatalog(panel, url) {
      var list = panel.querySelector('[data-portal-catalog-list]');
      var results = panel.querySelector('[data-portal-catalog-results]');
      var body = results.querySelector('[data-portal-results-body]');
      list.hidden = true;
      results.hidden = false;
      body.textContent = 'Loading...';
      results.scrollIntoView({ behavior: 'smooth', block: 'start' });

      var request = catalogCache[url] || (catalogCache[url] = fetch(url.split('?')[0] + '?sections=portal-collection-products', { credentials: 'same-origin' })
        .then(function (response) {
          if (!response.ok) throw new Error('Request failed');
          return response.json();
        })
        .then(function (data) {
          var html = data['portal-collection-products'];
          if (!html) throw new Error('Empty response');
          return html;
        }));

      request.then(function (html) {
        body.innerHTML = html;
      }).catch(function () {
        delete catalogCache[url];
        window.location.href = url;
      });
    }

    document.addEventListener('click', function (event) {
      var back = event.target.closest('[data-portal-back]');
      if (back) {
        showCatalogList(back.closest('.portal-tabs__panel'));
        return;
      }

      var link = event.target.closest('[data-portal-catalog-list] a');
      if (!link || event.metaKey || event.ctrlKey || event.shiftKey || event.button !== 0) return;
      event.preventDefault();
      openCatalog(link.closest('.portal-tabs__panel'), link.href);
    });

    document.addEventListener('click', function (event) {
      var tab = event.target.closest('[data-portal-tab]');
      if (!tab) return;
      var root = tab.closest('[data-portal-tabs]');
      var id = tab.getAttribute('data-portal-tab');
      activate(root, id, false);
      try {
        history.replaceState(null, '', '#portal-tab-' + id);
      } catch (e) {}
    });

    document.addEventListener('keydown', function (event) {
      var tab = event.target.closest('[data-portal-tab]');
      if (!tab) return;
      var keys = { ArrowRight: 1, ArrowLeft: -1, Home: 'first', End: 'last' };
      if (!(event.key in keys)) return;
      var root = tab.closest('[data-portal-tabs]');
      var tabs = Array.prototype.slice.call(root.querySelectorAll('[data-portal-tab]'));
      var index = tabs.indexOf(tab);
      var next = keys[event.key];
      if (next === 'first') index = 0;
      else if (next === 'last') index = tabs.length - 1;
      else index = (index + next + tabs.length) % tabs.length;
      event.preventDefault();
      activate(root, tabs[index].getAttribute('data-portal-tab'), true);
    });

    // Theme editor: open the tab whose block is selected.
    document.addEventListener('shopify:block:select', function (event) {
      var tab = event.target.querySelector && event.target.querySelector('[data-portal-tab]');
      var root = event.target.closest && event.target.closest('[data-portal-tabs]');
      if (tab && root) activate(root, tab.getAttribute('data-portal-tab'), false);
    });

    function initAll() {
      document.querySelectorAll('[data-portal-tabs]').forEach(fromHash);
    }
    document.addEventListener('DOMContentLoaded', initAll);
    document.addEventListener('shopify:section:load', initAll);
  })();
</script>

{% stylesheet %}
  .portal-tabs {
    padding: var(--section-padding, 4rem) var(--spacing-lg, 1.5rem);
  }
  .portal-tabs__inner {
    max-width: 1400px;
    margin: 0 auto;
  }
  .portal-tabs__list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--spacing-lg, 1.5rem);
    margin: var(--spacing-2xl, 3rem) 0 var(--spacing-2xl, 3rem);
    padding: 0;
    list-style: none;
  }
  .portal-tabs__tab {
    display: flex;
    align-items: center;
    width: 100%;
    min-height: 5.25rem;
    padding: var(--spacing-lg, 1.5rem);
    border: 1px solid rgb(0 0 0 / 15%);
    background: transparent;
    color: inherit;
    font: inherit;
    text-align: left;
    text-decoration: none;
    cursor: pointer;
  }
  .portal-tabs__tab:hover,
  .portal-tabs__tab.is-active {
    border-color: currentcolor;
  }
  .portal-tabs__tab.is-active {
    background: #fff;
  }
  .portal-tabs__panel[hidden],
  .portal-tabs [hidden] {
    display: none;
  }
  .portal-tabs__back {
    margin-bottom: var(--spacing-lg, 1.5rem);
  }
  .portal-tabs__results-title {
    margin: 0 0 var(--spacing-lg, 1.5rem);
  }
  .portal-tabs__products {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: var(--spacing-lg, 1.5rem);
  }
  .portal-tabs__contact {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--spacing-lg, 1.5rem);
    max-width: 720px;
  }
  @media (width < 768px) {
    .portal-tabs__list {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--spacing-sm, 1rem);
    }
    .portal-tabs__tab {
      min-height: 4rem;
      padding: var(--spacing-sm, 1rem);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Portal tabs",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Welcome" },
    {
      "type": "select",
      "id": "section_padding",
      "label": "Section padding",
      "options": [
        { "value": "--spacing-md", "label": "Small" },
        { "value": "--spacing-2xl", "label": "Medium" },
        { "value": "--spacing-4xl", "label": "Large" }
      ],
      "default": "--spacing-2xl"
    }
  ],
  "blocks": [
    {
      "type": "catalogs",
      "name": "Tab: Catalog cards",
      "settings": [
        { "type": "text", "id": "title", "label": "Tab title", "default": "My Schemes" },
        {
          "type": "collection_list",
          "id": "collections",
          "label": "Collections",
          "limit": 50,
          "info": "Shown as cards when this tab is open."
        }
      ]
    },
    {
      "type": "products",
      "name": "Tab: Products",
      "settings": [
        { "type": "text", "id": "title", "label": "Tab title", "default": "All Products" },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection",
          "info": "Leave empty to show every product visible to the company's B2B catalog."
        },
        {
          "type": "range",
          "id": "product_limit",
          "label": "Maximum products",
          "min": 8,
          "max": 50,
          "step": 2,
          "default": 24,
          "info": "All products load on the same page, so a high number can slow it down."
        }
      ]
    },
    {
      "type": "contact",
      "name": "Tab: Contact",
      "settings": [
        { "type": "text", "id": "title", "label": "Tab title", "default": "Contact Account Manager" },
        { "type": "richtext", "id": "text", "label": "Information" },
        { "type": "text", "id": "button_label", "label": "Button label" },
        { "type": "url", "id": "button_link", "label": "Button link" }
      ]
    },
    {
      "type": "link",
      "name": "Tab: Link",
      "settings": [
        { "type": "text", "id": "title", "label": "Tab title", "default": "Portal Settings" },
        { "type": "url", "id": "link", "label": "Link", "info": "Opens another page instead of showing a panel." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Portal tabs",
      "blocks": [
        { "type": "catalogs" },
        { "type": "products" },
        { "type": "contact" }
      ]
    }
  ]
}
{% endschema %}
