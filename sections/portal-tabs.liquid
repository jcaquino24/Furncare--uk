<section
  class="portal-tabs"
  id="portal-tabs-{{ section.id }}"
  data-portal-tabs
  style="--section-padding: var({{ section.settings.section_padding }}); --portal-tab-font-size: {{ section.settings.tab_font_size }}px; --portal-tab-font-weight: {{ section.settings.tab_font_weight }}; --portal-tab-padding-x: {{ section.settings.tab_padding_x }}px; --portal-tab-padding-y: {{ section.settings.tab_padding_y }}px"
>
  <div class="portal-tabs__inner">
    {%- if section.settings.heading != blank -%}
      <h1 class="portal-tabs__heading">
        {{- section.settings.heading -}}
        {%- if customer.first_name != blank %}, {{ customer.first_name | escape }}{% endif -%}
        {%- if customer.current_company.name != blank %}, {{ customer.current_company.name | escape }}{% endif -%}
      </h1>
    {%- endif -%}

      {%- assign first_tab_index = 0 -%}
      {%- for block in section.blocks -%}
        {%- if block.type != 'link' and block.type != 'catalog_node' and first_tab_index == 0 -%}
          {%- assign first_tab_index = forloop.index -%}
        {%- endif -%}
      {%- endfor -%}

    <ul class="portal-tabs__list" role="tablist" aria-label="{{ section.settings.heading | escape }}">
      {%- for block in section.blocks -%}
        {%- if block.type == 'catalog_node' -%}
          {%- continue -%}
        {%- endif -%}
        <li role="presentation" {{ block.shopify_attributes }}>
          {%- if block.type == 'link' -%}
            <a class="portal-tabs__tab" href="{{ block.settings.link | default: '#' }}">
              {{- block.settings.title -}}
            </a>
          {%- else -%}
            <button
              type="button"
              role="tab"
              class="portal-tabs__tab{% if forloop.index == first_tab_index %} is-active{% endif %}"
              id="portal-tab-{{ block.id }}"
              data-portal-tab="{{ block.id }}"
              aria-controls="portal-panel-{{ block.id }}"
              aria-selected="{% if forloop.index == first_tab_index %}true{% else %}false{% endif %}"
              tabindex="{% if forloop.index == first_tab_index %}0{% else %}-1{% endif %}"
              {% if block.type == 'catalog_hierarchy' %}data-portal-hierarchy-tab{% endif %}
            >
              {{- block.settings.title -}}
            </button>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>

    {%- for block in section.blocks -%}
      {%- if block.type == 'link' -%}
        {%- continue -%}
      {%- endif -%}
      {%- if block.type == 'catalog_node' -%}
        {%- continue -%}
      {%- endif -%}

      <div
        class="portal-tabs__panel"
        role="tabpanel"
        id="portal-panel-{{ block.id }}"
        aria-labelledby="portal-tab-{{ block.id }}"
        {% unless forloop.index == first_tab_index %}hidden{% endunless %}
      >
        {%- case block.type -%}
          {%- when 'catalog_hierarchy' -%}
            {%- assign catalog_nodes = section.blocks | where: 'type', 'catalog_node' -%}
            {%- if catalog_nodes.size > 0 -%}
              <div class="portal-tabs__hierarchy" data-portal-hierarchy>
                <div data-hierarchy-root>
                  <ul class="portal-tabs__scheme-list" style="--scheme-columns-desktop: {{ section.settings.scheme_columns_desktop }}; --scheme-columns-mobile: {{ section.settings.scheme_columns_mobile }}; --scheme-card-gap: 24px; --scheme-card-padding: 24px; --scheme-card-border-width: 1px; --scheme-card-border-color: #d0d0d0; --scheme-card-radius: 8px; --scheme-title-font: var(--font-heading-family); --scheme-title-size: 24px; --scheme-title-weight: 500; --scheme-title-style: normal; --scheme-eyebrow-size: 12px">
                    {%- for node in catalog_nodes -%}
                      {%- if node.settings.parent_id != blank -%}
                        {%- continue -%}
                      {%- endif -%}
                      {%- assign node_id = node.settings.node_id | default: node.settings.catalog_id | default: node.id -%}
                      {%- assign node_image = node.settings.card_image -%}
                      {%- if node_image == blank and node.settings.collections.size > 0 -%}
                        {%- assign first_collection = node.settings.collections | first -%}
                        {%- assign node_image = first_collection.image -%}
                      {%- endif -%}
                      {%- assign node_has_children = false -%}
                      {%- for child in catalog_nodes -%}
                        {%- assign child_parent_id = child.settings.parent_id -%}
                        {%- if child_parent_id == node_id -%}
                          {%- assign node_has_children = true -%}
                        {%- endif -%}
                      {%- endfor -%}
                      <li data-hierarchy-node-block {{ node.shopify_attributes }}>
                        {%- if node_has_children or node.settings.collections.size > 0 or node.settings.link_url == blank -%}
                          <button class="portal-tabs__scheme-card portal-tabs__scheme-card--button" type="button" data-hierarchy-open="{{ node.id }}" aria-controls="portal-hierarchy-panel-{{ node.id }}" aria-expanded="false">
                            {%- if node_image != blank -%}
                              {{ node_image | image_url: width: 1000 | image_tag: class: 'portal-tabs__scheme-image', loading: 'lazy', alt: node.settings.title }}
                            {%- endif -%}
                            <span class="portal-tabs__scheme-overlay" aria-hidden="true"></span>
                            <span class="portal-tabs__scheme-copy">
                              <span class="portal-tabs__scheme-title">{{ node.settings.title | escape }}</span>
                            </span>
                          </button>
                        {%- else -%}
                          <a class="portal-tabs__scheme-card" href="{{ node.settings.link_url }}">
                            {%- if node_image != blank -%}
                              {{ node_image | image_url: width: 1000 | image_tag: class: 'portal-tabs__scheme-image', loading: 'lazy', alt: node.settings.title }}
                            {%- endif -%}
                            <span class="portal-tabs__scheme-overlay" aria-hidden="true"></span>
                            <span class="portal-tabs__scheme-copy">
                              <span class="portal-tabs__scheme-title">{{ node.settings.title | escape }}</span>
                            </span>
                          </a>
                        {%- endif -%}
                      </li>
                    {%- endfor -%}
                  </ul>
                </div>
                <nav class="breadcrumbs portal-tabs__breadcrumbs" aria-label="Catalog breadcrumb" data-hierarchy-breadcrumbs hidden>
                  <ol class="breadcrumbs__list"></ol>
                </nav>

                {%- for node in catalog_nodes -%}
                  {%- assign node_id = node.settings.node_id | default: node.settings.catalog_id | default: node.id -%}
                  {%- assign parent_panel_id = '' -%}
                  {%- for candidate in catalog_nodes -%}
                    {%- assign candidate_node_id = candidate.settings.node_id | default: candidate.settings.catalog_id | default: candidate.id -%}
                    {%- if candidate_node_id == node.settings.parent_id -%}
                      {%- assign parent_panel_id = candidate.id -%}
                      {%- break -%}
                    {%- endif -%}
                  {%- endfor -%}
                  {%- assign node_has_children = false -%}
                  {%- for child in catalog_nodes -%}
                    {%- if child.settings.parent_id == node_id -%}
                      {%- assign node_has_children = true -%}
                    {%- endif -%}
                  {%- endfor -%}
                  <div class="portal-tabs__hierarchy-panel" id="portal-hierarchy-panel-{{ node.id }}" data-hierarchy-panel="{{ node.id }}" data-hierarchy-parent="{{ parent_panel_id }}" hidden>
                    <h3 class="portal-tabs__results-title">{{ node.settings.title | escape }}</h3>
                    {%- if node.settings.link_url != blank -%}
                      <p><a href="{{ node.settings.link_url }}">Open {{ node.settings.title | escape }}</a></p>
                    {%- endif -%}

                    {%- if node_has_children -%}
                      <ul class="portal-tabs__scheme-list" style="--scheme-columns-desktop: {{ section.settings.scheme_columns_desktop }}; --scheme-columns-mobile: {{ section.settings.scheme_columns_mobile }}; --scheme-card-gap: 24px; --scheme-card-padding: 24px; --scheme-card-border-width: 1px; --scheme-card-border-color: #d0d0d0; --scheme-card-radius: 8px; --scheme-title-font: var(--font-heading-family); --scheme-title-size: 24px; --scheme-title-weight: 500; --scheme-title-style: normal; --scheme-eyebrow-size: 12px">
                        {%- for child in catalog_nodes -%}
                          {%- if child.settings.parent_id != node_id -%}
                            {%- continue -%}
                          {%- endif -%}
                          {%- assign child_id = child.settings.node_id | default: child.settings.catalog_id | default: child.id -%}
                          {%- assign child_image = child.settings.card_image -%}
                          {%- if child_image == blank and child.settings.collections.size > 0 -%}
                            {%- assign first_collection = child.settings.collections | first -%}
                            {%- assign child_image = first_collection.image -%}
                          {%- endif -%}
                          {%- assign child_has_children = false -%}
                          {%- for grandchild in catalog_nodes -%}
                            {%- if grandchild.settings.parent_id == child_id -%}
                              {%- assign child_has_children = true -%}
                            {%- endif -%}
                          {%- endfor -%}
                          <li data-hierarchy-node-block {{ child.shopify_attributes }}>
                            {%- if child_has_children or child.settings.collections.size > 0 or child.settings.link_url == blank -%}
                              <button class="portal-tabs__scheme-card portal-tabs__scheme-card--button" type="button" data-hierarchy-open="{{ child.id }}" aria-controls="portal-hierarchy-panel-{{ child.id }}" aria-expanded="false">
                                {%- if child_image != blank -%}
                                  {{ child_image | image_url: width: 1000 | image_tag: class: 'portal-tabs__scheme-image', loading: 'lazy', alt: child.settings.title }}
                                {%- endif -%}
                                <span class="portal-tabs__scheme-overlay" aria-hidden="true"></span>
                                <span class="portal-tabs__scheme-copy">
                                  <span class="portal-tabs__scheme-title">{{ child.settings.title | escape }}</span>
                                </span>
                              </button>
                            {%- else -%}
                              <a class="portal-tabs__scheme-card" href="{{ child.settings.link_url }}">
                                {%- if child_image != blank -%}
                                  {{ child_image | image_url: width: 1000 | image_tag: class: 'portal-tabs__scheme-image', loading: 'lazy', alt: child.settings.title }}
                                {%- endif -%}
                                <span class="portal-tabs__scheme-overlay" aria-hidden="true"></span>
                                <span class="portal-tabs__scheme-copy">
                                  <span class="portal-tabs__scheme-title">{{ child.settings.title | escape }}</span>
                                </span>
                              </a>
                            {%- endif -%}
                          </li>
                        {%- endfor -%}
                      </ul>
                    {%- endif -%}

                    {%- if node.settings.collections.size > 0 -%}
                      <div data-portal-catalog-context>
                        <div data-portal-catalog-list>
                          <ul class="portal-tabs__scheme-list portal-tabs__hierarchy-collections" style="--scheme-columns-desktop: {{ section.settings.scheme_columns_desktop }}; --scheme-columns-mobile: {{ section.settings.scheme_columns_mobile }}; --scheme-card-gap: 24px; --scheme-card-padding: 24px; --scheme-card-border-width: 1px; --scheme-card-border-color: #d0d0d0; --scheme-card-radius: 8px; --scheme-title-font: var(--font-heading-family); --scheme-title-size: 24px; --scheme-title-weight: 500; --scheme-title-style: normal; --scheme-eyebrow-size: 12px">
                            {%- for collection in node.settings.collections -%}
                              <li>
                                <a class="portal-tabs__scheme-card" href="{{ collection.url }}">
                                  {%- if collection.image != blank -%}
                                    {{ collection.image | image_url: width: 1000 | image_tag: class: 'portal-tabs__scheme-image', loading: 'lazy', alt: collection.title }}
                                  {%- endif -%}
                                  <span class="portal-tabs__scheme-overlay" aria-hidden="true"></span>
                                  <span class="portal-tabs__scheme-copy">
                                    <span class="portal-tabs__scheme-title">{{ collection.title | escape }}</span>
                                  </span>
                                </a>
                              </li>
                            {%- endfor -%}
                          </ul>
                        </div>
                        <div data-portal-catalog-results hidden>
                          <nav class="breadcrumbs portal-tabs__breadcrumbs" aria-label="Catalog breadcrumb" data-catalog-breadcrumbs>
                            <ol class="breadcrumbs__list"></ol>
                          </nav>
                          <div data-portal-results-body aria-live="polite"></div>
                        </div>
                      </div>
                    {%- elsif node_has_children == false and node.settings.link_url == blank -%}
                      <p>No catalogs available.</p>
                    {%- endif -%}
                  </div>
                {%- endfor -%}
              </div>
            {%- else -%}
              <p>No catalogs available.</p>
            {%- endif -%}

          {%- when 'catalogs' -%}
            {%- if block.settings.collections.size > 0 -%}
              {%- liquid
                assign scheme_title_font = 'var(--font-heading-family)'
                if block.settings.title_font_family == 'body'
                  assign scheme_title_font = 'var(--font-body-family)'
                elsif block.settings.title_font_family == 'theme'
                  assign scheme_title_font = 'inherit'
                endif
              -%}
              <div data-portal-catalog-context>
                <div data-portal-catalog-list>
                <ul
                  class="portal-tabs__scheme-list"
                  style="--scheme-columns-desktop: {{ section.settings.scheme_columns_desktop }}; --scheme-columns-mobile: {{ section.settings.scheme_columns_mobile }}; --scheme-card-gap: {{ block.settings.card_gap }}px; --scheme-card-height: {% if block.settings.card_height > 0 %}{{ block.settings.card_height }}px{% else %}auto{% endif %}; --scheme-card-padding: {{ block.settings.card_padding }}px; --scheme-card-border-width: {{ block.settings.card_border_width }}px; --scheme-card-border-color: {{ block.settings.card_border_color }}; --scheme-card-radius: {{ block.settings.card_border_radius }}px; --scheme-title-font: {{ scheme_title_font }}; --scheme-title-size: {{ block.settings.title_font_size }}px; --scheme-title-weight: {{ block.settings.title_font_weight }}; --scheme-title-style: {{ block.settings.title_font_style }}; --scheme-eyebrow-size: {{ block.settings.eyebrow_font_size }}px"
                >
                  {%- for collection in block.settings.collections -%}
                    <li>
                      <a class="portal-tabs__scheme-card" href="{{ collection.url }}">
                        {%- if collection.image != blank -%}
                          {{ collection.image | image_url: width: 1000 | image_tag: class: 'portal-tabs__scheme-image', loading: 'lazy', alt: collection.title }}
                        {%- endif -%}
                        <span class="portal-tabs__scheme-overlay" aria-hidden="true"></span>
                        <span class="portal-tabs__scheme-copy">
                          {%- if block.settings.card_eyebrow != blank -%}
                            <span class="portal-tabs__scheme-eyebrow">{{ block.settings.card_eyebrow | escape }}</span>
                          {%- endif -%}
                          <span class="portal-tabs__scheme-title">{{ collection.title | escape }}</span>
                        </span>
                      </a>
                    </li>
                  {%- endfor -%}
                </ul>
                </div>
                <div data-portal-catalog-results hidden>
                  <nav class="breadcrumbs portal-tabs__breadcrumbs" aria-label="Catalog breadcrumb" data-catalog-breadcrumbs>
                    <ol class="breadcrumbs__list"></ol>
                  </nav>
                  <div data-portal-results-body aria-live="polite"></div>
                </div>
              </div>
            {%- else -%}
              <p>No catalogs available.</p>
            {%- endif -%}

          {%- when 'products' -%}
            {%- assign panel_collection = block.settings.collection | default: collections.all -%}
            {%- if panel_collection.products.size > 0 -%}
              <div class="portal-tabs__products" style="--products-columns-desktop: {{ section.settings.products_columns_desktop }}; --products-columns-mobile: {{ section.settings.products_columns_mobile }}">
                {%- for product in panel_collection.products limit: block.settings.product_limit -%}
                  {% render 'product-card', product: product, loading: 'lazy' %}
                {%- endfor -%}
              </div>
            {%- else -%}
              <p>No products available.</p>
            {%- endif -%}

          {%- when 'contact' -%}
            <div class="portal-tabs__contact rte">
              {{ block.settings.custom_html }}
              {%- if block.settings.button_link != blank and block.settings.button_label != blank -%}
                <a class="button button--primary" href="{{ block.settings.button_link }}">
                  {{ block.settings.button_label }}
                </a>
              {%- endif -%}
            </div>
        {%- endcase -%}
      </div>
    {%- endfor -%}
  </div>
</section>

<script>
  (function () {
    if (window.__portalTabsInit) return;
    window.__portalTabsInit = true;

    function activate(root, id, focus) {
      var tabs = root.querySelectorAll('[data-portal-tab]');
      var found = false;
      tabs.forEach(function (tab) {
        var active = tab.getAttribute('data-portal-tab') === id;
        found = found || active;
        tab.classList.toggle('is-active', active);
        tab.setAttribute('aria-selected', active ? 'true' : 'false');
        tab.setAttribute('tabindex', active ? '0' : '-1');
        var panel = document.getElementById(tab.getAttribute('aria-controls'));
        if (panel) panel.hidden = !active;
        if (active && focus) tab.focus();
      });
      return found;
    }

    function fromHash(root) {
      var id = (window.location.hash || '').replace('#portal-tab-', '');
      if (id) activate(root, id, false);
    }

    // Catalog card: load that collection's products into the same panel.
    var catalogCache = {};

    function showCatalogList(panel) {
      panel.querySelector('[data-portal-catalog-list]').hidden = false;
      panel.querySelector('[data-portal-catalog-results]').hidden = true;
      var hierarchy = panel.closest('[data-portal-hierarchy]');
      var hierarchyPanel = panel.closest('[data-hierarchy-panel]');
      if (hierarchy && hierarchyPanel) {
        renderHierarchyBreadcrumbs(hierarchy, hierarchyPanel.getAttribute('data-hierarchy-panel'));
      }
    }

    function findHierarchyTrail(hierarchy, panelId) {
      var panels = Array.prototype.slice.call(hierarchy.querySelectorAll('[data-hierarchy-panel]'));
      var trail = [];
      var currentId = panelId;
      var remaining = panels.length;

      while (currentId && remaining > 0) {
        var currentPanel = null;
        for (var index = 0; index < panels.length; index += 1) {
          if (panels[index].getAttribute('data-hierarchy-panel') === currentId) {
            currentPanel = panels[index];
            break;
          }
        }
        if (!currentPanel) break;

        var heading = currentPanel.querySelector('.portal-tabs__results-title');
        trail.unshift({ id: currentId, title: heading ? heading.textContent.trim() : '' });
        currentId = currentPanel.getAttribute('data-hierarchy-parent');
        remaining -= 1;
      }

      return trail;
    }

    function getBreadcrumbList(nav) {
      return nav.querySelector('.breadcrumbs__list') || nav;
    }

    function addBreadcrumbSeparator(list) {
      var item = document.createElement('li');
      item.className = 'breadcrumbs__item';
      var separator = document.createElement('span');
      separator.className = 'breadcrumbs__separator';
      separator.setAttribute('aria-hidden', 'true');
      separator.textContent = '›';
      item.appendChild(separator);
      list.appendChild(item);
    }

    function addBreadcrumbButton(list, title, attribute, value) {
      var item = document.createElement('li');
      item.className = 'breadcrumbs__item';
      var button = document.createElement('button');
      button.type = 'button';
      button.className = 'breadcrumbs__link eyebrow-2xs';
      button.textContent = title;
      button.setAttribute(attribute, value);
      item.appendChild(button);
      list.appendChild(item);
    }

    function addBreadcrumbCurrent(list, title) {
      var item = document.createElement('li');
      item.className = 'breadcrumbs__item';
      var current = document.createElement('span');
      current.className = 'breadcrumbs__link eyebrow-2xs';
      current.textContent = title;
      current.setAttribute('aria-current', 'page');
      item.appendChild(current);
      list.appendChild(item);
    }

    function renderHierarchyBreadcrumbs(hierarchy, panelId) {
      var nav = hierarchy.querySelector('[data-hierarchy-breadcrumbs]');
      if (!nav) return;
      var list = getBreadcrumbList(nav);
      list.replaceChildren();
      nav.hidden = !panelId;
      if (!panelId) return;

      addBreadcrumbButton(list, 'All catalogs', 'data-hierarchy-target', '');
      findHierarchyTrail(hierarchy, panelId).forEach(function (item, index, trail) {
        addBreadcrumbSeparator(list);
        if (index === trail.length - 1) {
          addBreadcrumbCurrent(list, item.title);
        } else {
          addBreadcrumbButton(list, item.title, 'data-hierarchy-target', item.id);
        }
      });
    }

    function renderCatalogBreadcrumbs(panel, results, collectionTitle) {
      var nav = results.querySelector('[data-catalog-breadcrumbs]');
      if (!nav) return;
      var list = getBreadcrumbList(nav);
      list.replaceChildren();

      var hierarchy = panel.closest('[data-portal-hierarchy]');
      var hierarchyPanel = panel.closest('[data-hierarchy-panel]');
      if (hierarchy && hierarchyPanel) {
        var panelId = hierarchyPanel.getAttribute('data-hierarchy-panel');
        addBreadcrumbButton(list, 'All catalogs', 'data-hierarchy-target', '');
        findHierarchyTrail(hierarchy, panelId).forEach(function (item, index, trail) {
          addBreadcrumbSeparator(list);
          if (index === trail.length - 1) {
            addBreadcrumbButton(list, item.title, 'data-portal-back', '');
          } else {
            addBreadcrumbButton(list, item.title, 'data-hierarchy-target', item.id);
          }
        });
      } else {
        addBreadcrumbButton(list, 'All catalogs', 'data-portal-back', '');
      }

      addBreadcrumbSeparator(list);
      addBreadcrumbCurrent(list, collectionTitle);
    }

    function openCatalog(panel, url, collectionTitle) {
      var list = panel.querySelector('[data-portal-catalog-list]');
      var results = panel.querySelector('[data-portal-catalog-results]');
      var body = results.querySelector('[data-portal-results-body]');
      list.hidden = true;
      results.hidden = false;
      body.textContent = 'Loading...';
      renderCatalogBreadcrumbs(panel, results, collectionTitle);
      var hierarchy = panel.closest('[data-portal-hierarchy]');
      if (hierarchy) {
        var hierarchyBreadcrumbs = hierarchy.querySelector('[data-hierarchy-breadcrumbs]');
        if (hierarchyBreadcrumbs) hierarchyBreadcrumbs.hidden = true;
      }
      results.scrollIntoView({ behavior: 'smooth', block: 'start' });

      var request = catalogCache[url] || (catalogCache[url] = fetch(url.split('?')[0] + '?view=portal-products', { credentials: 'same-origin' })
        .then(function (response) {
          if (!response.ok) throw new Error('Request failed: ' + response.status);
          return response.text();
        })
        .then(function (html) {
          if (html.indexOf('portal-tabs__results') === -1) throw new Error('Unexpected response (portal-products template not found)');
          return html;
        }));

      request.then(function (html) {
        body.innerHTML = html;
      }).catch(function (error) {
        delete catalogCache[url];
        body.textContent = '';
        console.error('Portal catalog load failed:', error);
      });
    }

    function showHierarchyNode(hierarchy, panelId) {
      var rootPanel = hierarchy.querySelector('[data-hierarchy-root]');
      rootPanel.hidden = panelId !== '';
      hierarchy.querySelectorAll('[data-portal-catalog-context]').forEach(function (context) {
        context.querySelector('[data-portal-catalog-list]').hidden = false;
        context.querySelector('[data-portal-catalog-results]').hidden = true;
      });
      hierarchy.querySelectorAll('[data-hierarchy-panel]').forEach(function (panel) {
        panel.hidden = panel.getAttribute('data-hierarchy-panel') !== panelId;
      });
      renderHierarchyBreadcrumbs(hierarchy, panelId);
      hierarchy.querySelectorAll('[data-hierarchy-open]').forEach(function (button) {
        button.setAttribute('aria-expanded', button.getAttribute('data-hierarchy-open') === panelId ? 'true' : 'false');
      });
    }

    document.addEventListener('click', function (event) {
      var hierarchyOpen = event.target.closest('[data-hierarchy-open]');
      if (hierarchyOpen) {
        var hierarchy = hierarchyOpen.closest('[data-portal-hierarchy]');
        if (hierarchy) showHierarchyNode(hierarchy, hierarchyOpen.getAttribute('data-hierarchy-open'));
        return;
      }

      var hierarchyTarget = event.target.closest('[data-hierarchy-target]');
      if (hierarchyTarget) {
        var hierarchy = hierarchyTarget.closest('[data-portal-hierarchy]');
        if (hierarchy) showHierarchyNode(hierarchy, hierarchyTarget.getAttribute('data-hierarchy-target') || '');
        return;
      }

      var back = event.target.closest('[data-portal-back]');
      if (back) {
        var catalogContext = back.closest('[data-portal-catalog-context]') || back.closest('.portal-tabs__panel');
        showCatalogList(catalogContext);
        return;
      }

      var link = event.target.closest('[data-portal-catalog-list] a');
      if (!link || event.metaKey || event.ctrlKey || event.shiftKey || event.button !== 0) return;
      event.preventDefault();
      var catalogContext = link.closest('[data-portal-catalog-context]') || link.closest('.portal-tabs__panel');
      var cardTitle = link.querySelector('.portal-tabs__scheme-title');
      openCatalog(catalogContext, link.href, cardTitle ? cardTitle.textContent.trim() : link.textContent.trim());
    });

    document.addEventListener('click', function (event) {
      var tab = event.target.closest('[data-portal-tab]');
      if (!tab) return;
      var root = tab.closest('[data-portal-tabs]');
      var id = tab.getAttribute('data-portal-tab');
      activate(root, id, false);
      try {
        history.replaceState(null, '', '#portal-tab-' + id);
      } catch (e) {}
    });

    document.addEventListener('keydown', function (event) {
      var tab = event.target.closest('[data-portal-tab]');
      if (!tab) return;
      var keys = { ArrowRight: 1, ArrowLeft: -1, Home: 'first', End: 'last' };
      if (!(event.key in keys)) return;
      var root = tab.closest('[data-portal-tabs]');
      var tabs = Array.prototype.slice.call(root.querySelectorAll('[data-portal-tab]'));
      var index = tabs.indexOf(tab);
      var next = keys[event.key];
      if (next === 'first') index = 0;
      else if (next === 'last') index = tabs.length - 1;
      else index = (index + next + tabs.length) % tabs.length;
      event.preventDefault();
      activate(root, tabs[index].getAttribute('data-portal-tab'), true);
    });

    // Theme editor: open the tab whose block is selected.
    document.addEventListener('shopify:block:select', function (event) {
      var tab = event.target.querySelector && event.target.querySelector('[data-portal-tab]');
      var root = event.target.closest && event.target.closest('[data-portal-tabs]');
      if (!tab && root && event.target.closest('[data-hierarchy-node-block]')) {
        tab = root.querySelector('[data-portal-hierarchy-tab]');
      }
      if (tab && root) activate(root, tab.getAttribute('data-portal-tab'), false);
    });

    function initAll() {
      document.querySelectorAll('[data-portal-tabs]').forEach(fromHash);
    }
    document.addEventListener('DOMContentLoaded', initAll);
    document.addEventListener('shopify:section:load', initAll);
  })();
</script>

{% stylesheet %}
  .portal-tabs {
    padding: var(--section-padding, 4rem) var(--spacing-lg, 1.5rem);
  }
  .portal-tabs__inner {
    max-width: 1400px;
    margin: 0 auto;
  }
  .portal-tabs__list {
    display: flex;
    align-items: stretch;
    gap: var(--spacing-2xs, 8px);
    margin: var(--spacing-xl, 2rem) 0 var(--spacing-2xl, 3rem);
    padding: 0;
    list-style: none;
    border-bottom: 1px solid var(--color-border-secondary, #e5e5e5);
  }
  .portal-tabs__list li {
    flex: 0 0 auto;
  }
  .portal-tabs__tab {
    display: flex;
    align-items: center;
    width: auto;
    min-height: 3.75rem;
    padding: var(--portal-tab-padding-y, 14px) var(--portal-tab-padding-x, 20px);
    border: 0;
    border-bottom: 3px solid transparent;
    margin-bottom: -1px;
    background: transparent;
    color: inherit;
    font-family: var(--font-body-family);
    font-size: var(--portal-tab-font-size, 16px);
    font-weight: var(--portal-tab-font-weight, 500);
    line-height: 1.25;
    text-align: center;
    text-decoration: none;
    cursor: pointer;
    white-space: nowrap;
    transition: background-color 160ms ease, border-color 160ms ease;
  }
  .portal-tabs__tab:hover {
    background: #ededed;
  }
  .portal-tabs__tab.is-active {
    border-bottom-color: #1457d9;
    color: #1457d9;
    background: transparent;
  }
  .portal-tabs__tab:focus-visible {
    outline: 2px solid currentcolor;
    outline-offset: -2px;
  }
  .portal-tabs__panel[hidden],
  .portal-tabs [hidden] {
    display: none;
  }
  .portal-tabs__back {
    margin-bottom: var(--spacing-lg, 1.5rem);
  }
  .portal-tabs__breadcrumbs {
    width: fit-content;
    max-width: 100%;
    margin: 0 0 var(--spacing-lg, 1.5rem);
  }
  .portal-tabs__breadcrumbs button {
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    text-decoration: inherit;
    cursor: pointer;
  }
  .portal-tabs__breadcrumbs .breadcrumbs__separator {
    text-decoration: none;
  }
  .portal-tabs__breadcrumbs button:focus-visible {
    outline: 2px solid currentcolor;
    outline-offset: 3px;
  }
  .portal-tabs__breadcrumbs [aria-current='page'] {
    font-weight: 600;
  }
  .portal-tabs__hierarchy-collections {
    margin-top: var(--spacing-xl, 2rem);
  }
  .portal-tabs__tree,
  .portal-tabs__tree-children {
    display: grid;
    gap: var(--spacing-sm, 12px);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .portal-tabs__tree-children {
    margin: var(--spacing-sm, 12px) 0 0 var(--spacing-lg, 1.5rem);
  }
  .portal-tabs__tree summary,
  .portal-tabs__tree a,
  .portal-tabs__tree-label {
    color: inherit;
    font-weight: 500;
  }
  .portal-tabs__tree summary {
    cursor: pointer;
  }
  .portal-tabs__tree a {
    text-underline-offset: 0.2em;
  }
  .portal-tabs__results-title {
    margin: 0 0 var(--spacing-lg, 1.5rem);
  }
  .portal-tabs__scheme-list {
    display: grid;
    grid-template-columns: repeat(var(--scheme-columns-desktop, 4), minmax(0, 1fr));
    gap: var(--scheme-card-gap, 24px);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .portal-tabs__scheme-card {
    position: relative;
    display: block;
    width: 100%;
    min-width: 0;
    box-sizing: border-box;
    aspect-ratio: 1.6;
    height: var(--scheme-card-height, auto);
    overflow: hidden;
    border: var(--scheme-card-border-width, 1px) solid var(--scheme-card-border-color, #d0d0d0);
    border-radius: var(--scheme-card-radius, 8px);
    color: #fff;
    background: #454744;
    text-decoration: none;
  }
  .portal-tabs__scheme-card--button {
    padding: 0;
    font: inherit;
    text-align: left;
    cursor: pointer;
  }
  .portal-tabs__scheme-card:focus-visible {
    outline: 2px solid currentcolor;
    outline-offset: 3px;
  }
  .portal-tabs__scheme-image,
  .portal-tabs__scheme-overlay {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .portal-tabs__scheme-image {
    object-fit: cover;
    transition: transform 240ms ease;
  }
  .portal-tabs__scheme-card:hover .portal-tabs__scheme-image {
    transform: scale(1.03);
  }
  .portal-tabs__scheme-overlay {
    background: linear-gradient(180deg, rgb(0 0 0 / 0) 25%, rgb(0 0 0 / 58%) 100%);
  }
  .portal-tabs__scheme-copy {
    position: absolute;
    z-index: 1;
    inset-inline: var(--scheme-card-padding, 24px);
    bottom: var(--scheme-card-padding, 24px);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
  }
  .portal-tabs__scheme-eyebrow {
    font-size: var(--scheme-eyebrow-size, 12px);
    font-weight: 600;
    line-height: 1.2;
    text-transform: uppercase;
  }
  .portal-tabs__scheme-title {
    font-family: var(--scheme-title-font, var(--font-heading-family));
    font-size: var(--scheme-title-size, 28px);
    font-weight: var(--scheme-title-weight, 500);
    font-style: var(--scheme-title-style, normal);
    line-height: 1.15;
  }
  .portal-tabs__products {
    display: grid;
    grid-template-columns: repeat(var(--products-columns-desktop, 4), minmax(0, 1fr));
    gap: var(--spacing-lg, 1.5rem);
  }
  .portal-tabs__contact {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--spacing-lg, 1.5rem);
    max-width: 720px;
  }
  @media (width < 768px) {
    .portal-tabs__scheme-list {
      grid-template-columns: repeat(var(--scheme-columns-mobile, 2), minmax(0, 1fr));
    }
    .portal-tabs__products {
      grid-template-columns: repeat(var(--products-columns-mobile, 2), minmax(0, 1fr));
    }
    .portal-tabs__tab {
      min-height: 3.25rem;
    }
  }
{% endstylesheet %}

{% schema %}
