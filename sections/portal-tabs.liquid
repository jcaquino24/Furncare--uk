<section
  class="portal-tabs"
  id="portal-tabs-{{ section.id }}"
  data-portal-tabs
  style="--section-padding: var({{ section.settings.section_padding }})"
>
  <div class="portal-tabs__inner">
    {%- if section.settings.heading != blank -%}
      <h1 class="portal-tabs__heading">
        {{- section.settings.heading -}}
        {%- if customer.first_name != blank %}, {{ customer.first_name | escape }}{% endif -%}
        {%- if customer.current_company.name != blank %}, {{ customer.current_company.name | escape }}{% endif -%}
      </h1>
    {%- endif -%}

    <ul class="portal-tabs__list" role="tablist" aria-label="{{ section.settings.heading | escape }}">
      {%- for block in section.blocks -%}
        <li role="presentation" {{ block.shopify_attributes }}>
          {%- if block.type == 'link' -%}
            <a class="portal-tabs__tab" href="{{ block.settings.link | default: '#' }}">
              {{- block.settings.title -}}
            </a>
          {%- else -%}
            <button
              type="button"
              role="tab"
              class="portal-tabs__tab{% if forloop.first %} is-active{% endif %}"
              id="portal-tab-{{ block.id }}"
              data-portal-tab="{{ block.id }}"
              aria-controls="portal-panel-{{ block.id }}"
              aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
              tabindex="{% if forloop.first %}0{% else %}-1{% endif %}"
            >
              {{- block.settings.title -}}
            </button>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>

    {%- for block in section.blocks -%}
      {%- if block.type == 'link' -%}
        {%- continue -%}
      {%- endif -%}

      <div
        class="portal-tabs__panel"
        role="tabpanel"
        id="portal-panel-{{ block.id }}"
        aria-labelledby="portal-tab-{{ block.id }}"
        {% unless forloop.first %}hidden{% endunless %}
      >
        {%- case block.type -%}
          {%- when 'catalogs' -%}
            {%- if block.settings.collections.size > 0 -%}
              {%- liquid
                assign scheme_title_font = 'var(--font-heading-family)'
                if block.settings.title_font_family == 'body'
                  assign scheme_title_font = 'var(--font-body-family)'
                elsif block.settings.title_font_family == 'theme'
                  assign scheme_title_font = 'inherit'
                endif
              -%}
              <div data-portal-catalog-list>
                <ul
                  class="portal-tabs__scheme-list"
                  style="--scheme-columns-desktop: {{ block.settings.columns_desktop }}; --scheme-columns-mobile: {{ block.settings.columns_mobile }}; --scheme-card-gap: {{ block.settings.card_gap }}px; --scheme-card-height: {% if block.settings.card_height > 0 %}{{ block.settings.card_height }}px{% else %}auto{% endif %}; --scheme-card-padding: {{ block.settings.card_padding }}px; --scheme-card-border-width: {{ block.settings.card_border_width }}px; --scheme-card-border-color: {{ block.settings.card_border_color }}; --scheme-card-radius: {{ block.settings.card_border_radius }}px; --scheme-title-font: {{ scheme_title_font }}; --scheme-title-size: {{ block.settings.title_font_size }}px; --scheme-title-weight: {{ block.settings.title_font_weight }}; --scheme-title-style: {{ block.settings.title_font_style }}; --scheme-eyebrow-size: {{ block.settings.eyebrow_font_size }}px"
                >
                  {%- for collection in block.settings.collections -%}
                    <li>
                      <a class="portal-tabs__scheme-card" href="{{ collection.url }}">
                        {%- if collection.image != blank -%}
                          {{ collection.image | image_url: width: 1000 | image_tag: class: 'portal-tabs__scheme-image', loading: 'lazy', alt: collection.title }}
                        {%- endif -%}
                        <span class="portal-tabs__scheme-overlay" aria-hidden="true"></span>
                        <span class="portal-tabs__scheme-copy">
                          {%- if block.settings.card_eyebrow != blank -%}
                            <span class="portal-tabs__scheme-eyebrow">{{ block.settings.card_eyebrow | escape }}</span>
                          {%- endif -%}
                          <span class="portal-tabs__scheme-title">{{ collection.title | escape }}</span>
                        </span>
                      </a>
                    </li>
                  {%- endfor -%}
                </ul>
              </div>
              <div data-portal-catalog-results hidden>
                <button type="button" class="button button--secondary portal-tabs__back" data-portal-back>
                  &larr; Back to catalogs
                </button>
                <div data-portal-results-body aria-live="polite"></div>
              </div>
            {%- else -%}
              <p>No catalogs available.</p>
            {%- endif -%}

          {%- when 'products' -%}
            {%- assign panel_collection = block.settings.collection | default: collections.all -%}
            {%- if panel_collection.products.size > 0 -%}
              <div class="portal-tabs__products" style="--products-columns-desktop: {{ block.settings.columns_desktop }}; --products-columns-mobile: {{ block.settings.columns_mobile }}">
                {%- for product in panel_collection.products limit: block.settings.product_limit -%}
                  {% render 'product-card', product: product, loading: 'lazy' %}
                {%- endfor -%}
              </div>
            {%- else -%}
              <p>No products available.</p>
            {%- endif -%}

          {%- when 'contact' -%}
            <div class="portal-tabs__contact rte">
              {{ block.settings.text }}
              {%- if block.settings.button_link != blank and block.settings.button_label != blank -%}
                <a class="button button--primary" href="{{ block.settings.button_link }}">
                  {{- block.settings.button_label -}}
                </a>
              {%- endif -%}
            </div>
        {%- endcase -%}
      </div>
    {%- endfor -%}
  </div>
</section>

<script>
  (function () {
    if (window.__portalTabsInit) return;
    window.__portalTabsInit = true;

    function activate(root, id, focus) {
      var tabs = root.querySelectorAll('[data-portal-tab]');
      var found = false;
      tabs.forEach(function (tab) {
        var active = tab.getAttribute('data-portal-tab') === id;
        found = found || active;
        tab.classList.toggle('is-active', active);
        tab.setAttribute('aria-selected', active ? 'true' : 'false');
        tab.setAttribute('tabindex', active ? '0' : '-1');
        var panel = document.getElementById(tab.getAttribute('aria-controls'));
        if (panel) panel.hidden = !active;
        if (active && focus) tab.focus();
      });
      return found;
    }

    function fromHash(root) {
      var id = (window.location.hash || '').replace('#portal-tab-', '');
      if (id) activate(root, id, false);
    }

    // Catalog card: load that collection's products into the same panel.
    var catalogCache = {};

    function showCatalogList(panel) {
      panel.querySelector('[data-portal-catalog-list]').hidden = false;
      panel.querySelector('[data-portal-catalog-results]').hidden = true;
    }

    function openCatalog(panel, url) {
      var list = panel.querySelector('[data-portal-catalog-list]');
      var results = panel.querySelector('[data-portal-catalog-results]');
      var body = results.querySelector('[data-portal-results-body]');
      list.hidden = true;
      results.hidden = false;
      body.textContent = 'Loading...';
      results.scrollIntoView({ behavior: 'smooth', block: 'start' });

      var request = catalogCache[url] || (catalogCache[url] = fetch(url.split('?')[0] + '?view=portal-products', { credentials: 'same-origin' })
        .then(function (response) {
          if (!response.ok) throw new Error('Request failed: ' + response.status);
          return response.text();
        })
        .then(function (html) {
          if (html.indexOf('portal-tabs__results') === -1) throw new Error('Unexpected response (portal-products template not found)');
          return html;
        }));

      request.then(function (html) {
        body.innerHTML = html;
      }).catch(function (error) {
        delete catalogCache[url];
        body.textContent = '';
        console.error('Portal catalog load failed:', error);
      });
    }

    document.addEventListener('click', function (event) {
      var back = event.target.closest('[data-portal-back]');
      if (back) {
        showCatalogList(back.closest('.portal-tabs__panel'));
        return;
      }

      var link = event.target.closest('[data-portal-catalog-list] a');
      if (!link || event.metaKey || event.ctrlKey || event.shiftKey || event.button !== 0) return;
      event.preventDefault();
      openCatalog(link.closest('.portal-tabs__panel'), link.href);
    });

    document.addEventListener('click', function (event) {
      var tab = event.target.closest('[data-portal-tab]');
      if (!tab) return;
      var root = tab.closest('[data-portal-tabs]');
      var id = tab.getAttribute('data-portal-tab');
      activate(root, id, false);
      try {
        history.replaceState(null, '', '#portal-tab-' + id);
      } catch (e) {}
    });

    document.addEventListener('keydown', function (event) {
      var tab = event.target.closest('[data-portal-tab]');
      if (!tab) return;
      var keys = { ArrowRight: 1, ArrowLeft: -1, Home: 'first', End: 'last' };
      if (!(event.key in keys)) return;
      var root = tab.closest('[data-portal-tabs]');
      var tabs = Array.prototype.slice.call(root.querySelectorAll('[data-portal-tab]'));
      var index = tabs.indexOf(tab);
      var next = keys[event.key];
      if (next === 'first') index = 0;
      else if (next === 'last') index = tabs.length - 1;
      else index = (index + next + tabs.length) % tabs.length;
      event.preventDefault();
      activate(root, tabs[index].getAttribute('data-portal-tab'), true);
    });

    // Theme editor: open the tab whose block is selected.
    document.addEventListener('shopify:block:select', function (event) {
      var tab = event.target.querySelector && event.target.querySelector('[data-portal-tab]');
      var root = event.target.closest && event.target.closest('[data-portal-tabs]');
      if (tab && root) activate(root, tab.getAttribute('data-portal-tab'), false);
    });

    function initAll() {
      document.querySelectorAll('[data-portal-tabs]').forEach(fromHash);
    }
    document.addEventListener('DOMContentLoaded', initAll);
    document.addEventListener('shopify:section:load', initAll);
  })();
</script>

{% stylesheet %}
  .portal-tabs {
    padding: var(--section-padding, 4rem) var(--spacing-lg, 1.5rem);
  }
  .portal-tabs__inner {
    max-width: 1400px;
    margin: 0 auto;
  }
  .portal-tabs__list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--spacing-lg, 1.5rem);
    margin: var(--spacing-2xl, 3rem) 0 var(--spacing-2xl, 3rem);
    padding: 0;
    list-style: none;
  }
  .portal-tabs__tab {
    display: flex;
    align-items: center;
    width: 100%;
    min-height: 5.25rem;
    padding: var(--spacing-lg, 1.5rem);
    border: 1px solid rgb(0 0 0 / 15%);
    background: transparent;
    color: inherit;
    font: inherit;
    text-align: left;
    text-decoration: none;
    cursor: pointer;
  }
  .portal-tabs__tab:hover,
  .portal-tabs__tab.is-active {
    border-color: currentcolor;
  }
  .portal-tabs__tab.is-active {
    background: #fff;
  }
  .portal-tabs__panel[hidden],
  .portal-tabs [hidden] {
    display: none;
  }
  .portal-tabs__back {
    margin-bottom: var(--spacing-lg, 1.5rem);
  }
  .portal-tabs__results-title {
    margin: 0 0 var(--spacing-lg, 1.5rem);
  }
  .portal-tabs__scheme-list {
    display: grid;
    grid-template-columns: repeat(var(--scheme-columns-desktop, 4), minmax(0, 1fr));
    gap: var(--scheme-card-gap, 24px);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .portal-tabs__scheme-card {
    position: relative;
    display: block;
    width: 100%;
    min-width: 0;
    box-sizing: border-box;
    aspect-ratio: 1.6;
    height: var(--scheme-card-height, auto);
    overflow: hidden;
    border: var(--scheme-card-border-width, 1px) solid var(--scheme-card-border-color, #d0d0d0);
    border-radius: var(--scheme-card-radius, 8px);
    color: #fff;
    background: #454744;
    text-decoration: none;
  }
  .portal-tabs__scheme-card:focus-visible {
    outline: 2px solid currentcolor;
    outline-offset: 3px;
  }
  .portal-tabs__scheme-image,
  .portal-tabs__scheme-overlay {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .portal-tabs__scheme-image {
    object-fit: cover;
    transition: transform 240ms ease;
  }
  .portal-tabs__scheme-card:hover .portal-tabs__scheme-image {
    transform: scale(1.03);
  }
  .portal-tabs__scheme-overlay {
    background: linear-gradient(180deg, rgb(0 0 0 / 0) 25%, rgb(0 0 0 / 58%) 100%);
  }
  .portal-tabs__scheme-copy {
    position: absolute;
    z-index: 1;
    inset-inline: var(--scheme-card-padding, 24px);
    bottom: var(--scheme-card-padding, 24px);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
  }
  .portal-tabs__scheme-eyebrow {
    font-size: var(--scheme-eyebrow-size, 12px);
    font-weight: 600;
    line-height: 1.2;
    text-transform: uppercase;
  }
  .portal-tabs__scheme-title {
    font-family: var(--scheme-title-font, var(--font-heading-family));
    font-size: var(--scheme-title-size, 28px);
    font-weight: var(--scheme-title-weight, 500);
    font-style: var(--scheme-title-style, normal);
    line-height: 1.15;
  }
  .portal-tabs__products {
    display: grid;
    grid-template-columns: repeat(var(--products-columns-desktop, 4), minmax(0, 1fr));
    gap: var(--spacing-lg, 1.5rem);
  }
  .portal-tabs__contact {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--spacing-lg, 1.5rem);
    max-width: 720px;
  }
  @media (width < 768px) {
    .portal-tabs__scheme-list {
      grid-template-columns: repeat(var(--scheme-columns-mobile, 2), minmax(0, 1fr));
    }
    .portal-tabs__products {
      grid-template-columns: repeat(var(--products-columns-mobile, 2), minmax(0, 1fr));
    }
    .portal-tabs__list {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--spacing-sm, 1rem);
    }
    .portal-tabs__tab {
      min-height: 4rem;
      padding: var(--spacing-sm, 1rem);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Portal tabs",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Welcome" },
    {
      "type": "select",
      "id": "section_padding",
      "label": "Section padding",
      "options": [
        { "value": "--spacing-md", "label": "Small" },
        { "value": "--spacing-2xl", "label": "Medium" },
        { "value": "--spacing-4xl", "label": "Large" }
      ],
      "default": "--spacing-2xl"
    }
  ],
  "blocks": [
    {
      "type": "catalogs",
      "name": "Tab: Catalog cards",
      "settings": [
        { "type": "text", "id": "title", "label": "Tab title", "default": "My Schemes" },
        { "type": "text", "id": "card_eyebrow", "label": "Card eyebrow", "default": "Scheme" },
        { "type": "range", "id": "columns_desktop", "label": "Cards per row (desktop)", "min": 1, "max": 6, "step": 1, "default": 4 },
        { "type": "range", "id": "columns_mobile", "label": "Cards per row (mobile)", "min": 1, "max": 2, "step": 1, "default": 2 },
        {
          "type": "collection_list",
          "id": "collections",
          "label": "Collections",
          "limit": 50,
          "info": "Shown as cards when this tab is open."
        },
        {
          "type": "select",
          "id": "title_font_family",
          "label": "Card title font family",
          "default": "heading",
          "options": [
            { "value": "theme", "label": "Theme default" },
            { "value": "body", "label": "Body font" },
            { "value": "heading", "label": "Heading font" }
          ]
        },
        { "type": "range", "id": "title_font_size", "label": "Card title font size", "min": 16, "max": 48, "step": 1, "unit": "px", "default": 28 },
        { "type": "range", "id": "eyebrow_font_size", "label": "Card eyebrow font size", "min": 8, "max": 24, "step": 1, "unit": "px", "default": 12 },
        { "type": "select", "id": "title_font_weight", "label": "Card title font weight", "default": "500", "options": [ { "value": "400", "label": "Regular" }, { "value": "500", "label": "Medium" }, { "value": "600", "label": "Semi-bold" }, { "value": "700", "label": "Bold" }, { "value": "800", "label": "Extra-bold" } ] },
        { "type": "select", "id": "title_font_style", "label": "Card title font style", "default": "normal", "options": [ { "value": "normal", "label": "Normal" }, { "value": "italic", "label": "Italic" } ] },
        { "type": "range", "id": "card_padding", "label": "Text inset", "min": 0, "max": 64, "step": 2, "unit": "px", "default": 24 },
        { "type": "range", "id": "card_border_width", "label": "Card border width", "min": 0, "max": 8, "step": 1, "unit": "px", "default": 1 },
        { "type": "color", "id": "card_border_color", "label": "Card border color", "default": "#d0d0d0" },
        { "type": "range", "id": "card_border_radius", "label": "Card corner radius", "min": 0, "max": 32, "step": 2, "unit": "px", "default": 8 },
        { "type": "range", "id": "card_gap", "label": "Gap between cards", "min": 8, "max": 48, "step": 2, "unit": "px", "default": 24 },
        { "type": "range", "id": "card_height", "label": "Card height", "min": 0, "max": 600, "step": 10, "unit": "px", "default": 0, "info": "0 keeps the current proportional height." }
      ]
    },
    {
      "type": "products",
      "name": "Tab: Products",
      "settings": [
        { "type": "text", "id": "title", "label": "Tab title", "default": "All Products" },
        { "type": "range", "id": "columns_desktop", "label": "Products per row (desktop)", "min": 1, "max": 6, "step": 1, "default": 4 },
        { "type": "range", "id": "columns_mobile", "label": "Products per row (mobile)", "min": 1, "max": 2, "step": 1, "default": 2 },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection",
          "info": "Leave empty to show every product visible to the company's B2B catalog."
        },
        {
          "type": "range",
          "id": "product_limit",
          "label": "Maximum products",
          "min": 8,
          "max": 50,
          "step": 2,
          "default": 24,
          "info": "All products load on the same page, so a high number can slow it down."
        }
      ]
    },
    {
      "type": "contact",
      "name": "Tab: Contact",
      "settings": [
        { "type": "text", "id": "title", "label": "Tab title", "default": "Contact Account Manager" },
        { "type": "richtext", "id": "text", "label": "Information" },
        { "type": "text", "id": "button_label", "label": "Button label" },
        { "type": "url", "id": "button_link", "label": "Button link" }
      ]
    },
    {
      "type": "link",
      "name": "Tab: Link",
      "settings": [
        { "type": "text", "id": "title", "label": "Tab title", "default": "Portal Settings" },
        { "type": "url", "id": "link", "label": "Link", "info": "Opens another page instead of showing a panel." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Portal tabs",
      "blocks": [
        { "type": "catalogs" },
        { "type": "products" },
        { "type": "contact" }
      ]
    }
  ]
}
{% endschema %}
