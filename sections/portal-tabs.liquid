<section
  class="portal-tabs"
  id="portal-tabs-{{ section.id }}"
  data-portal-tabs
  style="--section-padding: var({{ section.settings.section_padding }}); --portal-tab-font-size: {{ section.settings.tab_font_size }}px; --portal-tab-font-weight: {{ section.settings.tab_font_weight }}; --portal-tab-padding-x: {{ section.settings.tab_padding_x }}px; --portal-tab-padding-y: {{ section.settings.tab_padding_y }}px"
>
  <div class="portal-tabs__inner">
    {%- if section.settings.heading != blank -%}
      <h1 class="portal-tabs__heading">
        {{- section.settings.heading -}}
        {%- if customer.first_name != blank %}, {{ customer.first_name | escape }}{% endif -%}
        {%- if customer.current_company.name != blank %}, {{ customer.current_company.name | escape }}{% endif -%}
      </h1>
    {%- endif -%}

    <ul class="portal-tabs__list" role="tablist" aria-label="{{ section.settings.heading | escape }}">
      {%- for block in section.blocks -%}
        <li role="presentation" {{ block.shopify_attributes }}>
          {%- if block.type == 'link' -%}
            <a class="portal-tabs__tab" href="{{ block.settings.link | default: '#' }}">
              {{- block.settings.title -}}
            </a>
          {%- else -%}
            <button
              type="button"
              role="tab"
              class="portal-tabs__tab{% if forloop.first %} is-active{% endif %}"
              id="portal-tab-{{ block.id }}"
              data-portal-tab="{{ block.id }}"
              aria-controls="portal-panel-{{ block.id }}"
              aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
              tabindex="{% if forloop.first %}0{% else %}-1{% endif %}"
            >
              {{- block.settings.title -}}
            </button>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>

    {%- for block in section.blocks -%}
      {%- if block.type == 'link' -%}
        {%- continue -%}
      {%- endif -%}

      <div
        class="portal-tabs__panel"
        role="tabpanel"
        id="portal-panel-{{ block.id }}"
        aria-labelledby="portal-tab-{{ block.id }}"
        {% unless forloop.first %}hidden{% endunless %}
      >
        {%- case block.type -%}
          {%- when 'catalogs' -%}
            {%- liquid
              assign scheme_title_font = 'var(--font-heading-family)'
              if block.settings.title_font_family == 'body'
                assign scheme_title_font = 'var(--font-body-family)'
              elsif block.settings.title_font_family == 'theme'
                assign scheme_title_font = 'inherit'
              endif
            -%}
            <div data-portal-catalog-browser data-current-parent="" data-trail="[]">
              <div class="portal-tabs__catalog-breadcrumb" data-catalog-breadcrumb hidden>
                <button type="button" class="button button--secondary" data-catalog-up>&larr; Back</button>
                <span data-catalog-trail></span>
              </div>
              <div
                style="--scheme-columns-desktop: {{ section.settings.scheme_columns_desktop }}; --scheme-columns-mobile: {{ section.settings.scheme_columns_mobile }}; --scheme-card-gap: {{ block.settings.card_gap }}px; --scheme-card-height: {% if block.settings.card_height > 0 %}{{ block.settings.card_height }}px{% else %}auto{% endif %}; --scheme-card-padding: {{ block.settings.card_padding }}px; --scheme-card-border-width: {{ block.settings.card_border_width }}px; --scheme-card-border-color: {{ block.settings.card_border_color }}; --scheme-card-radius: {{ block.settings.card_border_radius }}px; --scheme-title-font: {{ scheme_title_font }}; --scheme-title-size: {{ block.settings.title_font_size }}px; --scheme-title-weight: {{ block.settings.title_font_weight }}; --scheme-title-style: {{ block.settings.title_font_style }}; --scheme-eyebrow-size: {{ block.settings.eyebrow_font_size }}px"
              >
                <ul class="portal-tabs__scheme-list" data-portal-node-list>
                  {%- for node in section.blocks -%}
                    {%- if node.type != 'catalog_node' -%}{%- continue -%}{%- endif -%}
                    {%- liquid
                      assign node_id = node.settings.catalog_id | strip
                      assign node_parent_id = node.settings.parent_id | strip
                      assign node_link_url = node.settings.link_url
                      assign node_collection = blank
                      if node_link_url contains '/collections/'
                        assign node_collection_handle = node_link_url | split: '/collections/' | last | split: '?' | first | split: '#' | first
                        assign node_collection = collections[node_collection_handle]
                      endif
                      assign node_title = node.settings.title | default: node_collection.title
                      assign node_image = node.settings.image | default: node_collection.image
                      assign node_has_children = false
                      if node_id != blank
                        for child_node in section.blocks
                          assign child_parent_id = child_node.settings.parent_id | strip
                          if child_node.type == 'catalog_node' and child_parent_id == node_id
                            assign node_has_children = true
                            break
                          endif
                        endfor
                      endif
                    -%}
                    {%- if node_link_url != blank or node_has_children -%}
                      <li data-portal-catalog-node data-node-id="{{ node_id | escape }}" data-parent-id="{{ node_parent_id | escape }}" hidden>
                        {%- if node_link_url != blank -%}
                          <a class="portal-tabs__scheme-card" href="{{ node_link_url }}" data-catalog-link data-catalog-title="{{ node_title | escape }}">
                            {%- if node_image != blank -%}{{ node_image | image_url: width: 1000 | image_tag: class: 'portal-tabs__scheme-image', loading: 'lazy', alt: node_title }}{%- endif -%}
                            <span class="portal-tabs__scheme-overlay" aria-hidden="true"></span>
                            <span class="portal-tabs__scheme-copy">
                              {%- if block.settings.card_eyebrow != blank -%}<span class="portal-tabs__scheme-eyebrow">{{ block.settings.card_eyebrow | escape }}</span>{%- endif -%}
                              <span class="portal-tabs__scheme-title">{{ node_title | escape }}</span>
                            </span>
                          </a>
                        {%- elsif node_has_children -%}
                          <button type="button" class="portal-tabs__scheme-card" data-catalog-drill data-node-id="{{ node_id | escape }}" data-node-title="{{ node_title | escape }}">
                            {%- if node_image != blank -%}{{ node_image | image_url: width: 1000 | image_tag: class: 'portal-tabs__scheme-image', loading: 'lazy', alt: node_title }}{%- endif -%}
                            <span class="portal-tabs__scheme-overlay" aria-hidden="true"></span>
                            <span class="portal-tabs__scheme-copy">
                              {%- if block.settings.card_eyebrow != blank -%}<span class="portal-tabs__scheme-eyebrow">{{ block.settings.card_eyebrow | escape }}</span>{%- endif -%}
                              <span class="portal-tabs__scheme-title">{{ node_title | escape }}</span>
                            </span>
                          </button>
                        {%- endif -%}
                      </li>
                    {%- endif -%}
                  {%- endfor -%}
                </ul>
              </div>
            </div>
            <div data-portal-catalog-results hidden>
              <button type="button" class="button button--secondary portal-tabs__back" data-portal-back>
                &larr; Back to catalogs
              </button>
              <div data-portal-results-body aria-live="polite"></div>
            </div>

          {%- when 'products' -%}
            {%- assign panel_collection = block.settings.collection | default: collections.all -%}
            {%- if panel_collection.products.size > 0 -%}
              <div class="portal-tabs__products" style="--products-columns-desktop: {{ section.settings.products_columns_desktop }}; --products-columns-mobile: {{ section.settings.products_columns_mobile }}">
                {%- for product in panel_collection.products limit: block.settings.product_limit -%}
                  {% render 'product-card', product: product, loading: 'lazy' %}
                {%- endfor -%}
              </div>
            {%- else -%}
              <p>No products available.</p>
            {%- endif -%}

          {%- when 'contact' -%}
            <div class="portal-tabs__contact rte">
              {{ block.settings.text }}
              {%- if block.settings.button_link != blank and block.settings.button_label != blank -%}
                <a class="button button--primary" href="{{ block.settings.button_link }}">
                  {{- block.settings.button_label -}}
                </a>
              {%- endif -%}
            </div>
        {%- endcase -%}
      </div>
    {%- endfor -%}
  </div>
</section>

<script>
  (function () {
    if (window.__portalTabsInit) return;
    window.__portalTabsInit = true;

    function activate(root, id, focus) {
      var tabs = root.querySelectorAll('[data-portal-tab]');
      var found = false;
      tabs.forEach(function (tab) {
        var active = tab.getAttribute('data-portal-tab') === id;
        found = found || active;
        tab.classList.toggle('is-active', active);
        tab.setAttribute('aria-selected', active ? 'true' : 'false');
        tab.setAttribute('tabindex', active ? '0' : '-1');
        var panel = document.getElementById(tab.getAttribute('aria-controls'));
        if (panel) panel.hidden = !active;
        if (active && focus) tab.focus();
      });
      return found;
    }

    function fromHash(root) {
      var id = (window.location.hash || '').replace('#portal-tab-', '');
      if (id) activate(root, id, false);
    }

    var catalogCache = {};

    function catalogTrail(browser) {
      try {
        return JSON.parse(browser.dataset.trail || '[]');
      } catch (error) {
        return [];
      }
    }

    function renderCatalogBrowser(browser) {
      var parentId = browser.dataset.currentParent || '';
      var trail = catalogTrail(browser);
      var nodeList = browser.querySelector('[data-portal-node-list]');
      var visibleNodes = 0;

      nodeList.querySelectorAll('[data-portal-catalog-node]').forEach(function (node) {
        var visible = (node.dataset.parentId || '') === parentId;
        node.hidden = !visible;
        if (visible) visibleNodes += 1;
      });
      nodeList.hidden = visibleNodes === 0;

      var breadcrumb = browser.querySelector('[data-catalog-breadcrumb]');
      breadcrumb.hidden = trail.length === 0;
      breadcrumb.querySelector('[data-catalog-trail]').textContent = trail.map(function (item) {
        return item.title;
      }).join(' / ');
    }

    function showCatalogList(panel) {
      var browser = panel.querySelector('[data-portal-catalog-browser]');
      browser.hidden = false;
      panel.querySelector('[data-portal-catalog-results]').hidden = true;
      renderCatalogBrowser(browser);
    }

    function openCatalog(panel, url, title) {
      var browser = panel.querySelector('[data-portal-catalog-browser]');
      var results = panel.querySelector('[data-portal-catalog-results]');
      var body = results.querySelector('[data-portal-results-body]');
      browser.hidden = true;
      results.hidden = false;
      body.textContent = 'Loading...';
      var resultsTitle = results.querySelector('[data-portal-results-title]');
      if (resultsTitle && title) resultsTitle.textContent = title;
      results.scrollIntoView({ behavior: 'smooth', block: 'start' });

      var request = catalogCache[url] || (catalogCache[url] = fetch(url.split('?')[0] + '?view=portal-products', { credentials: 'same-origin' })
        .then(function (response) {
          if (!response.ok) throw new Error('Request failed: ' + response.status);
          return response.text();
        })
        .then(function (html) {
          if (html.indexOf('portal-tabs__results') === -1) throw new Error('Unexpected response (portal-products template not found)');
          return html;
        }));

      request.then(function (html) {
        body.innerHTML = html;
      }).catch(function (error) {
        delete catalogCache[url];
        body.textContent = '';
        console.error('Portal catalog load failed:', error);
      });
    }

    document.addEventListener('click', function (event) {
      var up = event.target.closest('[data-catalog-up]');
      if (up) {
        var browser = up.closest('[data-portal-catalog-browser]');
        var trail = catalogTrail(browser);
        var current = trail.pop();
        browser.dataset.trail = JSON.stringify(trail);
        browser.dataset.currentParent = current ? current.parentId : '';
        renderCatalogBrowser(browser);
        return;
      }

      var back = event.target.closest('[data-portal-back]');
      if (back) {
        showCatalogList(back.closest('.portal-tabs__panel'));
        return;
      }

      var drill = event.target.closest('[data-catalog-drill]');
      if (drill) {
        var drillBrowser = drill.closest('[data-portal-catalog-browser]');
        var drillTrail = catalogTrail(drillBrowser);
        drillTrail.push({
          nodeId: drill.dataset.nodeId,
          parentId: drillBrowser.dataset.currentParent || '',
          title: drill.dataset.nodeTitle || ''
        });
        drillBrowser.dataset.currentParent = drill.dataset.nodeId;
        drillBrowser.dataset.trail = JSON.stringify(drillTrail);
        renderCatalogBrowser(drillBrowser);
        return;
      }

      var catalogLink = event.target.closest('[data-catalog-link]');
      if (!catalogLink || event.metaKey || event.ctrlKey || event.shiftKey || event.button !== 0) return;
      var destination = new URL(catalogLink.href, window.location.origin);
      if (destination.pathname.indexOf('/collections/') !== -1) {
        event.preventDefault();
        openCatalog(
          catalogLink.closest('.portal-tabs__panel'),
          catalogLink.href,
          catalogLink.dataset.catalogTitle
        );
      }
    });

    document.addEventListener('click', function (event) {
      var tab = event.target.closest('[data-portal-tab]');
      if (!tab) return;
      var root = tab.closest('[data-portal-tabs]');
      var id = tab.getAttribute('data-portal-tab');
      activate(root, id, false);
      try {
        history.replaceState(null, '', '#portal-tab-' + id);
      } catch (e) {}
    });

    document.addEventListener('keydown', function (event) {
      var tab = event.target.closest('[data-portal-tab]');
      if (!tab) return;
      var keys = { ArrowRight: 1, ArrowLeft: -1, Home: 'first', End: 'last' };
      if (!(event.key in keys)) return;
      var root = tab.closest('[data-portal-tabs]');
      var tabs = Array.prototype.slice.call(root.querySelectorAll('[data-portal-tab]'));
      var index = tabs.indexOf(tab);
      var next = keys[event.key];
      if (next === 'first') index = 0;
      else if (next === 'last') index = tabs.length - 1;
      else index = (index + next + tabs.length) % tabs.length;
      event.preventDefault();
      activate(root, tabs[index].getAttribute('data-portal-tab'), true);
    });

    // Theme editor: open the tab whose block is selected.
    document.addEventListener('shopify:block:select', function (event) {
      var tab = event.target.querySelector && event.target.querySelector('[data-portal-tab]');
      var root = event.target.closest && event.target.closest('[data-portal-tabs]');
      if (tab && root) activate(root, tab.getAttribute('data-portal-tab'), false);
    });

    function initAll() {
      document.querySelectorAll('[data-portal-tabs]').forEach(function (root) {
        fromHash(root);
        root.querySelectorAll('[data-portal-catalog-browser]').forEach(renderCatalogBrowser);
      });
    }
    initAll();
    document.addEventListener('DOMContentLoaded', initAll);
    document.addEventListener('shopify:section:load', initAll);
  })();
</script>

{% stylesheet %}
  .portal-tabs {
    padding: var(--section-padding, 4rem) var(--spacing-lg, 1.5rem);
  }
  .portal-tabs__inner {
    max-width: 1400px;
    margin: 0 auto;
  }
  .portal-tabs__list {
    display: flex;
    align-items: stretch;
    gap: var(--spacing-2xs, 8px);
    margin: var(--spacing-xl, 2rem) 0 var(--spacing-2xl, 3rem);
    padding: 0;
    list-style: none;
    border-bottom: 1px solid var(--color-border-secondary, #e5e5e5);
  }
  .portal-tabs__list li {
    flex: 0 0 auto;
  }
  .portal-tabs__tab {
    display: flex;
    align-items: center;
    width: auto;
    min-height: 3.75rem;
    padding: var(--portal-tab-padding-y, 14px) var(--portal-tab-padding-x, 20px);
    border: 0;
    border-bottom: 3px solid transparent;
    margin-bottom: -1px;
    background: transparent;
    color: inherit;
    font-family: var(--font-body-family);
    font-size: var(--portal-tab-font-size, 16px);
    font-weight: var(--portal-tab-font-weight, 500);
    line-height: 1.25;
    text-align: center;
    text-decoration: none;
    cursor: pointer;
    white-space: nowrap;
    transition: background-color 160ms ease, border-color 160ms ease;
  }
  .portal-tabs__tab:hover {
    background: #ededed;
  }
  .portal-tabs__tab.is-active {
    border-bottom-color: #1457d9;
    color: #1457d9;
    background: transparent;
  }
  .portal-tabs__tab:focus-visible {
    outline: 2px solid currentcolor;
    outline-offset: -2px;
  }
  .portal-tabs__panel[hidden],
  .portal-tabs [hidden] {
    display: none;
  }
  .portal-tabs__back {
    margin-bottom: var(--spacing-lg, 1.5rem);
  }
  .portal-tabs__catalog-breadcrumb {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm, 12px);
    margin-bottom: var(--spacing-lg, 1.5rem);
  }
  .portal-tabs__catalog-breadcrumb[hidden] {
    display: none;
  }
  .portal-tabs__results-title {
    margin: 0 0 var(--spacing-lg, 1.5rem);
  }
  .portal-tabs__scheme-list {
    display: grid;
    grid-template-columns: repeat(var(--scheme-columns-desktop, 4), minmax(0, 1fr));
    gap: var(--scheme-card-gap, 24px);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .portal-tabs__scheme-card {
    position: relative;
    display: block;
    width: 100%;
    min-width: 0;
    box-sizing: border-box;
    aspect-ratio: 1.6;
    height: var(--scheme-card-height, auto);
    overflow: hidden;
    border: var(--scheme-card-border-width, 1px) solid var(--scheme-card-border-color, #d0d0d0);
    border-radius: var(--scheme-card-radius, 8px);
    color: #fff;
    background: #454744;
    text-decoration: none;
  }
  .portal-tabs__scheme-card:focus-visible {
    outline: 2px solid currentcolor;
    outline-offset: 3px;
  }
  .portal-tabs__scheme-image,
  .portal-tabs__scheme-overlay {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .portal-tabs__scheme-image {
    object-fit: cover;
    transition: transform 240ms ease;
  }
  .portal-tabs__scheme-card:hover .portal-tabs__scheme-image {
    transform: scale(1.03);
  }
  .portal-tabs__scheme-overlay {
    background: linear-gradient(180deg, rgb(0 0 0 / 0) 25%, rgb(0 0 0 / 58%) 100%);
  }
  .portal-tabs__scheme-copy {
    position: absolute;
    z-index: 1;
    inset-inline: var(--scheme-card-padding, 24px);
    bottom: var(--scheme-card-padding, 24px);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
  }
  .portal-tabs__scheme-eyebrow {
    font-size: var(--scheme-eyebrow-size, 12px);
    font-weight: 600;
    line-height: 1.2;
    text-transform: uppercase;
  }
  .portal-tabs__scheme-title {
    font-family: var(--scheme-title-font, var(--font-heading-family));
    font-size: var(--scheme-title-size, 28px);
    font-weight: var(--scheme-title-weight, 500);
    font-style: var(--scheme-title-style, normal);
    line-height: 1.15;
  }
  .portal-tabs__products {
    display: grid;
    grid-template-columns: repeat(var(--products-columns-desktop, 4), minmax(0, 1fr));
    gap: var(--spacing-lg, 1.5rem);
  }
  .portal-tabs__contact {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--spacing-lg, 1.5rem);
    max-width: 720px;
  }
  @media (width < 768px) {
    .portal-tabs__scheme-list {
      grid-template-columns: repeat(var(--scheme-columns-mobile, 2), minmax(0, 1fr));
    }
    .portal-tabs__products {
      grid-template-columns: repeat(var(--products-columns-mobile, 2), minmax(0, 1fr));
    }
    .portal-tabs__tab {
      min-height: 3.25rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Portal tabs",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Welcome" },
    {
      "type": "select",
      "id": "section_padding",
      "label": "Section padding",
      "options": [
        { "value": "--spacing-md", "label": "Small" },
        { "value": "--spacing-2xl", "label": "Medium" },
        { "value": "--spacing-4xl", "label": "Large" }
      ],
      "default": "--spacing-2xl"
    },
    { "type": "header", "content": "Tab appearance" },
    { "type": "range", "id": "tab_font_size", "label": "Tab font size", "min": 12, "max": 24, "step": 1, "unit": "px", "default": 16 },
    { "type": "select", "id": "tab_font_weight", "label": "Tab font weight", "default": "500", "options": [ { "value": "400", "label": "Regular" }, { "value": "500", "label": "Medium" }, { "value": "600", "label": "Semi-bold" }, { "value": "700", "label": "Bold" } ] },
    { "type": "range", "id": "tab_padding_x", "label": "Tab horizontal padding", "min": 8, "max": 40, "step": 2, "unit": "px", "default": 20 },
    { "type": "range", "id": "tab_padding_y", "label": "Tab vertical padding", "min": 8, "max": 32, "step": 2, "unit": "px", "default": 14 },
    { "type": "header", "content": "Scheme grid" },
    { "type": "range", "id": "scheme_columns_desktop", "label": "Cards per row (desktop)", "min": 1, "max": 6, "step": 1, "default": 4 },
    { "type": "range", "id": "scheme_columns_mobile", "label": "Cards per row (mobile)", "min": 1, "max": 3, "step": 1, "default": 2 },
    { "type": "header", "content": "Products grid" },
    { "type": "range", "id": "products_columns_desktop", "label": "Products per row (desktop)", "min": 1, "max": 6, "step": 1, "default": 4 },
    { "type": "range", "id": "products_columns_mobile", "label": "Products per row (mobile)", "min": 1, "max": 3, "step": 1, "default": 2 }
  ],
  "blocks": [
    {
      "type": "catalogs",
      "name": "Tab: Catalog cards",
      "settings": [
        { "type": "text", "id": "title", "label": "Tab title", "default": "My Schemes" },
        { "type": "text", "id": "card_eyebrow", "label": "Card eyebrow", "default": "Scheme" },
        {
          "type": "select",
          "id": "title_font_family",
          "label": "Card title font family",
          "default": "heading",
          "options": [
            { "value": "theme", "label": "Theme default" },
            { "value": "body", "label": "Body font" },
            { "value": "heading", "label": "Heading font" }
          ]
        },
        { "type": "range", "id": "title_font_size", "label": "Card title font size", "min": 16, "max": 48, "step": 1, "unit": "px", "default": 28 },
        { "type": "range", "id": "eyebrow_font_size", "label": "Card eyebrow font size", "min": 8, "max": 24, "step": 1, "unit": "px", "default": 12 },
        { "type": "select", "id": "title_font_weight", "label": "Card title font weight", "default": "500", "options": [ { "value": "400", "label": "Regular" }, { "value": "500", "label": "Medium" }, { "value": "600", "label": "Semi-bold" }, { "value": "700", "label": "Bold" }, { "value": "800", "label": "Extra-bold" } ] },
        { "type": "select", "id": "title_font_style", "label": "Card title font style", "default": "normal", "options": [ { "value": "normal", "label": "Normal" }, { "value": "italic", "label": "Italic" } ] },
        { "type": "range", "id": "card_padding", "label": "Text inset", "min": 0, "max": 64, "step": 2, "unit": "px", "default": 24 },
        { "type": "range", "id": "card_border_width", "label": "Card border width", "min": 0, "max": 8, "step": 1, "unit": "px", "default": 1 },
