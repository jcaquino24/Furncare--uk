{% liquid
  assign fallback_section_id = section.id | default: 'product-blocks'

  if fallback_section_id == blank
    assign fallback_section_id = 'product-blocks'
  endif

  assign has_tabs = false
  if section.blocks.size >= 2 and section.blocks[0].settings.title != blank and section.blocks[1].settings.title != blank
    assign has_tabs = true
  endif

  render 'vite-tag' with '@sections/content-blocks.ts'
%}

{% capture tabs_html %}
  {% if has_tabs %}
    {% for block in section.blocks %}
      {% assign tab_name = 'tab' | append: forloop.index %}
      {% assign button_class = '' %}
      {% if forloop.first %}
        {% assign button_class = 'is-active' %}
      {% endif %}

      {% assign attributes = 'js-content-blocks="tab-trigger" data-tab="' | append: tab_name | append: '"' %}

      {% render 'button',
        class: button_class,
        label: block.settings.title,
        style: 'underline',
        attributes: attributes
      %}
    {% endfor %}
  {% endif %}
{% endcapture %}

<uwp-content-blocks
  class="content-blocks product-blocks"
  style="--section-padding: var({{ section.settings.section_padding }});"
>
  <div class="container">

    <div class="content-blocks__header">
      {% render 'title-with-nav',
        title: section.settings.title,
        heading_level: 'h2',
        tabs: tabs_html,
        show_nav: true,
        section_id: fallback_section_id
      %}
    </div>

    <div class="content-blocks__content">

      {% for block in section.blocks %}
        {% assign tab_name = 'tab' | append: forloop.index %}
        {% assign tab_classes = 'content-blocks__tab' %}

        {% if forloop.first %}
          {% assign tab_classes = tab_classes | append: ' is-active' %}
        {% endif %}

        <!-- ✅ FIX 1: Correct product_id per block -->
        {% assign local_product_id = false %}
        {% if block.settings.use_current_product and product %}
          {% assign local_product_id = product.id %}
        {% elsif block.settings.seed_product %}
          {% assign local_product_id = block.settings.seed_product.id %}
        {% endif %}

        <!-- ✅ FIX 2: Get products properly -->
        {% assign block_products = blank %}

        {% case block.settings.product_feed_source %}
          {% when 'product_list' %}
            {% assign block_products = block.settings.products %}

          {% when 'collection' %}
            {% if block.settings.collection != blank %}
              {% assign block_products = block.settings.collection.products %}
            {% endif %}

          {% when 'recommendations' %}
            {% assign block_products = recommendations.products %}
        {% endcase %}

        <div
          class="{{ tab_classes }}"
          js-content-blocks="tab-content"
          data-tab="{{ tab_name }}"
        >

          <!-- ✅ SWIPER if many products -->
          {% if block_products != blank and block_products.size > 4 %}


            <swiper-container
              class="content-blocks__swiper"
              slides-per-view="2"
              space-between="12"
              breakpoints='{"768":{"slidesPerView":4,"spaceBetween":20}}'
            >

              <!-- ✅ FIX 3: STRONG duplicate filter -->
              {% assign rendered_ids = '' %}
              {% assign count = 0 %}

              {% for item in block_products %}

                {% assign id_str = item.id | append: '' %}

                {% unless rendered_ids contains id_str or item.id == local_product_id %}

                  <swiper-slide class="content-blocks__slide">
                    {% render 'product-card', product: item %}
                  </swiper-slide>

                  {% assign rendered_ids = rendered_ids | append: id_str | append: ',' %}
                  {% assign count = count | plus: 1 %}
                {% endunless %}

                {% if count >= 8 %}
                  {% break %}
                {% endif %}

              {% endfor %}

              <!-- ✅ FIX 4: fallback if recommendations are bad -->
              {% if count < 4 %}
                {% for p in collections['all'].products %}
                  {% unless rendered_ids contains p.id or p.id == local_product_id %}
                    <swiper-slide class="content-blocks__slide">
                      {% render 'product-card', product: p %}
                    </swiper-slide>
                  {% endunless %}

                  {% assign count = count | plus: 1 %}
                  {% if count >= 8 %}
                    {% break %}
                  {% endif %}
                {% endfor %}
              {% endif %}

            </swiper-container>

          {% elsif block_products != blank and block_products.size > 0 %}

            <!-- ✅ GRID layout -->
            <div class="content-blocks__grid">

              {% assign rendered_ids = '' %}

              {% for item in block_products %}
                {% assign id_str = item.id | append: '' %}

                {% unless rendered_ids contains id_str or item.id == local_product_id %}
                  {% render 'product-card', product: item %}
                  {% assign rendered_ids = rendered_ids | append: id_str | append: ',' %}
                {% endunless %}
              {% endfor %}

            </div>

          {% else %}

            <!-- ✅ loading state -->
            <div class="content-blocks__grid">
              {% for i in (1..8) %}
                {% render 'product-card', is_loading: true %}
              {% endfor %}
            </div>

          {% endif %}

        </div>

      {% endfor %}

    </div>
  </div>
</uwp-content-blocks>

{% schema %}
{
  "name": "Product blocks",
  "tag": "section",
  "max_blocks": 2,
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Featured Products"
    }
  ],
  "blocks": [
    {
      "type": "product_block",
      "name": "Product block",
      "settings": [
        { "type": "text", "id": "title", "label": "Title" },

        {
          "type": "select",
          "id": "product_feed_source",
          "label": "Product source",
          "default": "product_list",
          "options": [
            { "value": "product_list", "label": "Manual" },
            { "value": "collection", "label": "Collection" },
            { "value": "recommendations", "label": "Recommendations" }
          ]
        },

        { "type": "product_list", "id": "products", "label": "Products" },
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "product", "id": "seed_product", "label": "Seed product" },

        {
          "type": "checkbox",
          "id": "use_current_product",
          "label": "Use current product",
          "default": true
        }
      ]
    }
  ]
}
{% endschema %}
