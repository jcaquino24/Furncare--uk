{% liquid
  assign products_per_row = section.settings.products_per_row | default: 4
  assign max_products = section.settings.max_products | default: 8
  assign recommendations_limit = max_products | at_most: 10

  assign fallback_section_id = section.id | default: 'product-blocks'
  if fallback_section_id == blank or fallback_section_id == empty
    assign fallback_section_id = 'product-blocks'
  endif

  # Check if we should show tabs - be more lenient
  assign has_tabs = false
  if section.blocks.size >= 2 and section.blocks[0].settings.title != blank and section.blocks[1].settings.title != blank
    assign has_tabs = true
  endif

  render 'vite-tag' with '@sections/content-blocks.ts'
%}

{% capture tabs_html %}
  {% if has_tabs %}
    {% for block in section.blocks %}
      {% assign tab_name = 'tab' | append: forloop.index %}
      {% assign button_class = '' %}
      {% if forloop.first %}
        {% assign button_class = 'is-active' %}
      {% endif %}
      
      {% assign attributes = 'js-content-blocks="tab-trigger" data-tab="' | append: tab_name | append: '" data-colour-scheme="' | append: block.settings.colour_scheme | append: '"' %}
      {% render 'button',
        class: button_class,
        label: block.settings.title,
        style: 'underline',
        scheme: block.settings.colour_scheme,
        attributes: attributes
      %}
    {% endfor %}
  {% endif %}
{% endcapture %}

{% assign show_nav = true %}
{% assign title_classes = 'title-with-nav__nav' %}
{% if show_nav and tabs_html != blank %}
  {% assign title_classes = 'hide-on-mobile title-with-nav__nav' %}
{% endif %}

{% liquid
  # Build recommendation URLs for each block if needed
  assign block1_rec_url = ''
  assign block2_rec_url = ''

  if section.blocks[0].settings.product_feed_source == 'recommendations' and section.blocks[0].settings.use_custom_collection != true and section.blocks[0].settings.match_similar_names != true
    assign product_id_1 = false
    if section.blocks[0].settings.use_current_product and product
      assign product_id_1 = product.id
    elsif section.blocks[0].settings.seed_product != blank
      assign product_id_1 = section.blocks[0].settings.seed_product.id
    endif
    if product_id_1
      assign block1_rec_url = routes.product_recommendations_url | append: '?section_id=' | append: section.id | append: '&product_id=' | append: product_id_1 | append: '&limit=' | append: recommendations_limit | append: '&intent=' | append: section.blocks[0].settings.recommendation_intent
    endif
  endif

  if section.blocks[1].settings.product_feed_source == 'recommendations' and section.blocks[1].settings.use_custom_collection != true and section.blocks[1].settings.match_similar_names != true
    assign product_id_2 = false
    if section.blocks[1].settings.use_current_product and product
      assign product_id_2 = product.id
    elsif section.blocks[1].settings.seed_product != blank
      assign product_id_2 = section.blocks[1].settings.seed_product.id
    endif
    if product_id_2
      assign block2_rec_url = routes.product_recommendations_url | append: '?section_id=' | append: section.id | append: '&product_id=' | append: product_id_2 | append: '&limit=' | append: recommendations_limit | append: '&intent=' | append: section.blocks[1].settings.recommendation_intent
    endif
  endif
%}

<uwp-content-blocks
  class="content-blocks product-blocks colour-scheme--{{ section.blocks[0].settings.colour_scheme }} {% if show_nav %}content-blocks--has-swiper{% endif %}"
  style="--section-padding: var({{ section.settings.section_padding }});"
  {% if block1_rec_url != blank %}
    data-block1-rec-url="{{ block1_rec_url }}"
  {% endif %}
  {% if block2_rec_url != blank %}
    data-block2-rec-url="{{ block2_rec_url }}"
  {% endif %}
  role="region"
  aria-label="Product blocks"
  aria-roledescription="region"
>
  <div class="container">
    <div class="content-blocks__header">
      <div class="title-with-nav {% if tabs_html == blank %}title-with-nav--no-tabs{% endif %}">
        <div class="title-with-nav__row">
          {% if section.settings.title != blank %}
            <h2 class="eyebrow-sm title-with-nav__title">
              {{ section.settings.title }}
            </h2>
          {% endif %}

          {% if tabs_html != blank %}
            <div class="title-with-nav__tabs">
              {{ tabs_html }}
            </div>
          {% endif %}
        </div>

        {% if show_nav %}
          {% render 'swiper-nav', class: title_classes, section_id: fallback_section_id %}
        {% endif %}
      </div>
    </div>

    <div class="content-blocks__content">
      {% for block in section.blocks %}
        {% assign tab_name = 'tab' | append: forloop.index %}
        {% assign tab_classes = 'content-blocks__tab' %}
        {% assign slides_per_view = '2' %}

        {% if forloop.first %}
          {% assign tab_classes = tab_classes | append: ' is-active' %}
        {% elsif forloop.index == 2 and has_tabs == false %}
          {% assign tab_classes = tab_classes | append: ' is-active' %}
        {% endif %}

        {% if forloop.index == 2 %}
          {% assign slides_per_view = '1.75' %}
        {% endif %}

        {% render 'product-block-tab',
          block: block,
          tab_name: tab_name,
          tab_classes: tab_classes,
          slides_per_view: slides_per_view,
          products_per_row: products_per_row,
          max_products: max_products,
          fallback_section_id: fallback_section_id,
          has_tabs: has_tabs,
          product: product,
          recommendations: recommendations
        %}
      {% endfor %}
    </div>
  </div>
</uwp-content-blocks>

<style>
  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} .content-blocks__grid {
      grid-template-columns: repeat({{ products_per_row }}, minmax(0, 1fr));
    }
  }
</style>

{% schema %}
{
  "name": "Product blocks",
  "tag": "section",
  "max_blocks": 2,

  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Featured Products"
    },
    {
      "type": "range",
      "id": "products_per_row",
      "label": "Products visible per row (desktop)",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4,
      "info": "A slider is used when there are more products than this."
    },
    {
      "type": "range",
      "id": "max_products",
      "label": "Maximum products to display",
      "min": 4,
      "max": 24,
      "step": 1,
      "default": 8,
      "info": "Recommendations are capped at 10 by Shopify."
    },
    {
      "type": "select",
      "id": "section_padding",
      "label": "Section padding",
      "default": "--spacing-2xl",
      "options": [
        {
          "value": "--spacing-md",
          "label": "Narrow"
        },
        {
          "value": "--spacing-2xl",
          "label": "Default"
        },
        {
          "value": "--spacing-4xl",
          "label": "Wide"
        }
      ]
    }
  ],
  "blocks": [
    {
      "type": "product_block",
      "name": "Product block",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "text",
          "id": "handle",
          "label": "Handle"
        },
        {
          "type": "select",
          "id": "product_feed_source",
          "label": "Product feed source",
          "default": "product_list",
          "options": [
            {
              "value": "product_list",
              "label": "Product list"
            },
            {
              "value": "collection",
              "label": "Collection"
            },
            {
              "value": "recommendations",
              "label": "Recommendations"
            },
            {
              "value": "custom_collection",
              "label": "Custom collection (custom.collection)"
            },
            {
              "value": "similar_names",
              "label": "Similar names (e.g. Linetta)"
            }
          ]
        },
        {
          "type": "checkbox",
          "id": "use_custom_collection",
          "label": "Use custom.collection metafield",
          "default": false,
          "info": "Display products from the custom.collection metafield when set to Recommendations or Custom collection"
        },
        {
          "type": "checkbox",
          "id": "match_similar_names",
          "label": "Match similar names / family",
          "default": false,
          "info": "Show products that share the base name prefix (e.g. 'Linetta') from the product's collection or store"
        },
        {
          "type": "product_list",
          "id": "products",
          "label": "Products",
          "limit": 24,
          "info": "Used when Product feed source is set to 'Product list'"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection",
          "info": "Products from this collection, up to the section's maximum products setting"
        },
        {
          "type": "product",
          "id": "seed_product",
          "label": "Seed product",
          "info": "Product to base recommendations on"
        },
        {
          "type": "checkbox",
          "id": "use_current_product",
          "label": "Use current product as seed",
          "default": false,
          "info": "Only works on product pages"
        },

        {
          "type": "select",
          "id": "recommendation_intent",
          "label": "Recommendation type",
          "default": "related",
          "options": [
            {
              "value": "related",
              "label": "Similar products (You may also like)"
            },
            {
              "value": "complementary",
              "label": "Complementary products (Pair it with)"
            }
          ],
          "info": "Type of product recommendations to show"
        },
        {
          "type": "select",
          "id": "colour_scheme",
          "label": "Colour scheme",
          "default": "base-white-01",
          "options": [
            {
              "value": "base-white-01",
              "label": "Base white 01"
            },
            {
              "value": "base-white-02",
              "label": "Base white 02"
            },
            {
              "value": "warm-stone",
              "label": "Warm stone"
            },
            {
              "value": "duck-egg",
              "label": "Duck Egg"
            }
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product blocks",
      "settings": {
        "title": "Featured Products",
        "section_padding": "--spacing-2xl"
      },
      "blocks": [
        {
          "type": "product_block",
          "settings": {
            "title": "New Arrivals",
            "handle": "new-arrivals",
            "product_feed_source": "product_list",
            "recommendation_intent": "related",
            "colour_scheme": "base-white-01"
          }
        },
        {
          "type": "product_block",
          "settings": {
            "title": "Best Sellers",
            "handle": "best-sellers",
            "product_feed_source": "product_list",
            "recommendation_intent": "related",
            "colour_scheme": "warm-stone"
          }
        }
      ]
    }
  ]
}
{% endschema %}
