{% schema %}
{
  "name": "AI Recommendations (Auto)",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "You May Also Like"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Number of products",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 4
    }
  ],
  "presets": [
    {
      "name": "AI Recommendations Auto"
    }
  ]
}
{% endschema %}

<section class="ai-recommendations">
  <h2>{{ section.settings.title }}</h2>

  <div id="recommendations-{{ section.id }}" class="grid"></div>
</section>

<script>
    
document.addEventListener("DOMContentLoaded", () => {
  const container = document.getElementById("recommendations-{{ section.id }}");
  const limit = {{ section.settings.limit }};

  let productId = {{ product.id | json }};

  // ✅ If NOT on product page → use a fallback product
  if (!productId) {
    console.warn("No product context → using fallback");
    
    fetch(`/products.json?limit=${limit}`)
      .then(res => res.json())
      .then(data => renderProducts(data.products));
    return;
  }

  // ✅ Use Shopify AI recommendations
  fetch(`/recommendations/products.json?product_id=${productId}&limit=${limit}`)
    .then(res => res.json())
    .then(data => {
      if (!data.products.length) {
        console.warn("No recommendations → fallback triggered");

        return fetch(`/products.json?limit=${limit}`)
          .then(res => res.json())
          .then(data => renderProducts(data.products));
      }

      renderProducts(data.products);
    })
    .catch(() => {
      console.warn("Error → fallback triggered");

      fetch(`/products.json?limit=${limit}`)
        .then(res => res.json())
        .then(data => renderProducts(data.products));
    });

  function renderProducts(products) {
    if (!products || !products.length) {
      container.innerHTML = "<p>No recommendations found.</p>";
      return;
    }

    container.innerHTML = products.map(p => `
      <div class="product-card">
        <a href="${p       <img src="${p.images?.[0]?.src ||  <h3>${p.title}</h3>
          <p>$${(p.variants?.[0]?.price || '0.00')}</p>
        </a>
      </div>
    `).join("");
  }
});

</script>


<style>
.ai-recommendations {
  padding: 40px 20px;
}

.ai-recommendations h2 {
  text-align: center;
  margin-bottom: 20px;
}

.grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 20px;
}

.product-card {
  border: 1px solid #eee;
  padding: 10px;
  border-radius: 10px;
  text-align: center;
}

.product-card img {
  width: 100%;
  border-radius: 8px;
}

.product-card h3 {
  font-size: 16px;
  margin: 10px 0;
}
</style>