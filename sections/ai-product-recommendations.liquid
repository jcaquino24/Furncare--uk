{% schema %}
{
  "name": "AI Recommendations (Auto)",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "You May Also Like"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Number of products",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 4
    }
  ],
  "presets": [
    {
      "name": "AI Recommendations Auto"
    }
  ]
}
{% endschema %}

<section class="ai-recommendations">
  <h2>{{ section.settings.title }}</h2>

  <div id="recommendations-{{ section.id }}" class="grid"></div>
</section>

<script>
document.addEventListener("DOMContentLoaded", () => {
  const container = document.getElementById("recommendations-{{ section.id }}");

  // Detect current product (if on product page)
  const productId = {{ product.id | default: 'null' }};
  const limit = {{ section.settings.limit }};

  let url = "";

  // If on product page → use related recommendations
  if (productId) {
    url = `/recommendations/products.json?product_id=${productId}&limit=${limit}`;
  } else {
    // fallback (homepage etc.)
    url = `/products.json?limit=${limit}`;
  }

  fetch(url)
    .then(res => res.json())
    .then(data => {
      const products = data.products || [];

      products.forEach(p => {
        const html = `
          <div class="product-card">
            <{p.url}
              <img src="${p.images[0]?.src || ''   <h3>${p.title}</h3>
              <p>$${(p.variants[0].price)}</p>
            </a>
          </div>
        `;
        container.innerHTML += html;
      });
    })
    .catch(err => {
      console.error("Recommendation error:", err);
    });
});
</script>

<style>
.ai-recommendations {
  padding: 40px 20px;
}

.ai-recommendations h2 {
  text-align: center;
  margin-bottom: 20px;
}

.grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 20px;
}

.product-card {
  border: 1px solid #eee;
  padding: 10px;
  border-radius: 10px;
  text-align: center;
}

.product-card img {
  width: 100%;
  border-radius: 8px;
}

.product-card h3 {
  font-size: 16px;
  margin: 10px 0;
}
</style>