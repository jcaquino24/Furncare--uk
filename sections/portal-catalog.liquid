{%- assign portal_collection = section.settings.collection | default: collections.all -%}
{%- paginate portal_collection.products by section.settings.products_per_page -%}
  <section class="portal-catalog" style="--section-padding: var({{ section.settings.section_padding }})">
    <div class="portal-catalog__inner">
      <h1>{{ section.settings.heading }}</h1>

      {%- if portal_collection.products.size == 0 -%}
        <p>No products available.</p>
      {%- else -%}
        <ul class="portal-catalog__grid">
          {%- for product in portal_collection.products -%}
            <li>
              <a href="{{ product.url }}">
                {%- if product.featured_image -%}
                  {{ product.featured_image | image_url: width: 500 | image_tag: loading: 'lazy', widths: '250, 500', alt: product.title }}
                {%- endif -%}
                <strong>{{ product.title }}</strong>
                <span>{{ product.price | money }}</span>
              </a>
            </li>
          {%- endfor -%}
        </ul>

        {%- if paginate.pages > 1 -%}
          <nav class="portal-catalog__pagination" aria-label="Pagination">
            {%- if paginate.previous -%}
              <a href="{{ paginate.previous.url }}">Previous</a>
            {%- endif -%}
            <span>{{ paginate.current_page }} / {{ paginate.pages }}</span>
            {%- if paginate.next -%}
              <a href="{{ paginate.next.url }}">Next</a>
            {%- endif -%}
          </nav>
        {%- endif -%}
      {%- endif -%}
    </div>
  </section>
{%- endpaginate -%}

{% stylesheet %}
  .portal-catalog {
    padding: var(--section-padding, 4rem) var(--spacing-lg, 1.5rem);
  }
  .portal-catalog__inner {
    max-width: 1400px;
    margin: 0 auto;
  }
  .portal-catalog__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: var(--spacing-lg, 1.5rem);
    margin: var(--spacing-xl, 2rem) 0 0;
    padding: 0;
    list-style: none;
  }
  .portal-catalog__grid a {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    color: inherit;
    text-decoration: none;
  }
  .portal-catalog__grid img {
    width: 100%;
    height: auto;
  }
  .portal-catalog__pagination {
    display: flex;
    justify-content: center;
    gap: var(--spacing-lg, 1.5rem);
    margin-top: var(--spacing-2xl, 3rem);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Portal catalog",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your catalog" },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Leave empty to list every product visible to the company's B2B catalog."
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Products per page",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 24
    },
    {
      "type": "select",
      "id": "section_padding",
      "label": "Section padding",
      "options": [
        { "value": "--spacing-md", "label": "Small" },
        { "value": "--spacing-2xl", "label": "Medium" },
        { "value": "--spacing-4xl", "label": "Large" }
      ],
      "default": "--spacing-2xl"
    }
  ],
  "presets": [{ "name": "Portal catalog" }]
}
{% endschema %}
