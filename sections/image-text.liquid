{{ 'furncare-about.css' | asset_url | stylesheet_tag }}
<script src="{{ 'furncare-about.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign reveal_class = ''
  if section.settings.enable_reveal
    assign reveal_class = ' fa-reveal'
  endif

  assign drawer_id = 'image-text-contact-drawer-' | append: section.id
  assign has_contact_form = false
  if section.settings.contact_form_html != blank
    assign has_contact_form = true
  endif

  assign show_contact_drawer = false
  for block in section.blocks
    if block.type == 'content' and block.settings.button_action == 'contact_drawer' and has_contact_form
      assign show_contact_drawer = true
    endif
  endfor
-%}
{%- capture furncare_selector -%}#FurncareAboutHero-{{ section.id }}{%- endcapture -%}
{% style %}
  {% render 'furncare-about-style-vars', selector: furncare_selector, section_settings: section.settings %}
{% endstyle %}
{%- liquid
  assign colour_scheme = section.settings.colour_scheme
-%}
<section id="FurncareAbouttext-{{ section.id }}">
<div
  class="image-text colour-scheme--{{ colour_scheme }}"
  style="--section-padding: var({{ section.settings.section_padding }});"
>
  <div class="container">
    <div class="image-text__grid {{ reveal_class }}">
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'images' %}
            {%- liquid
              if block.settings.image_two != blank
                assign has_two_images = ' has-two-images'
              endif
            -%}
            <div
              class="image-text__images{{ has_two_images }}"
              data-index="{{ forloop.index }}"
              {{ block.shopify_attributes }}
            >
              <div class="image-text__image">
                {%- if block.settings.image_one != blank -%}
                  {%- assign image_one = block.settings.image_one -%}
                  {%- render 'responsive-image',
                    image: image_one,
                    sizes: '(min-width: 1024px) 60vw, 100vw',
                    widths: '375, 550, 750, 1100, 1500, 1780, 2000',
                    preload: true,
                    aspect_ratio: image_one.aspect_ratio
                  -%}
                {%- endif -%}
              </div>
              <div class="image-text__image">
                {%- if block.settings.image_two != blank -%}
                  {%- assign image_two = block.settings.image_two -%}
                  {%- render 'responsive-image',
                    image: image_two,
                    sizes: '(min-width: 1024px) 60vw, 100vw',
                    widths: '375, 550, 750, 1100, 1500, 1780, 2000',
                    preload: true,
                    aspect_ratio: image_two.aspect_ratio
                  -%}
                {%- endif -%}
              </div>
            </div>
          {% when 'content' %}
            <div
              class="image-text__content {% if block.settings.button_text == blank and block.settings.text == blank %}image-text__content--only-heading{% endif %}"
              data-index="{{ forloop.index }}"
              {{ block.shopify_attributes }}
            >
              {% if block.settings.title != blank %}
                <uwp-text-animation
                  role="region"
                  aria-label="Image text title"
                  aria-roledescription="region"
                >
                  <div class="richtext__content">
                    <h2 class="image-text__title heading__text title-{{ block.settings.title_size }}">
                      {{ block.settings.title }}
                    </h2>
                  </div>
                </uwp-text-animation>
              {% endif %}
              {% if block.settings.text != blank %}
                <p class="image-text__text body-md">
                  {{ block.settings.text }}
                </p>
              {% endif %}
              {% if block.settings.button_text != blank %}
                {% if block.settings.button_action == 'contact_drawer' and has_contact_form %}
                  {%- capture drawer_trigger_attributes %} data-furncare-drawer-trigger data-drawer-trigger="{{ drawer_id }}"{% endcapture -%}
                  {%- render 'button',
                    label: block.settings.button_text,
                    style: block.settings.button_style,
                    icon: 'arrow-right',
                    scheme: section.settings.colour_scheme,
                    attributes: drawer_trigger_attributes
                  -%}
                {% else %}
                  {%- render 'button',
                    label: block.settings.button_text,
                    style: block.settings.button_style,
                    link: block.settings.button_url,
                    icon: 'arrow-right',
                    scheme: section.settings.colour_scheme
                  -%}
                {% endif %}
              {% endif %}
            </div>
        {% endcase %}
      {% endfor %}
    </div>
  </div>
</div>
</section>

{% if show_contact_drawer %}
  <div id="image-text-contact-form-drawer-template-{{ section.id }}" style="display: none;">
    <uwp-drawer
      modal-name="{{ drawer_id }}"
      drawer-direction="right"
      class="drawer"
      aria-hidden="true"
      role="region"
      aria-label="Contact form drawer"
      aria-roledescription="drawer"
    >
      <div class="modal__overlay" tabindex="-1" data-close-drawer></div>

      <aside
        class="drawer__container"
        role="dialog"
        aria-modal="true"
        js-uwp-modal="modal"
        aria-labelledby="ImageTextDrawerTitle-{{ section.id }}"
      >
        <div class="drawer__header">
          <div class="drawer__header-title-wrapper">
            {% render 'icons', icon: 'chat' %}

            <h2 id="ImageTextDrawerTitle-{{ section.id }}" class="drawer__title body-lg body-lg--bold">
              {{ 'product.actions.contact_us' | t }}
            </h2>
          </div>
          <button
            type="button"
            class="drawer__close"
            data-close-drawer
            aria-label="{{ 'general.close' | t }}"
          >
            {% render 'icons', icon: 'close' %}
          </button>
        </div>

        <div class="drawer__body">
          <div class="drawer__description">
            <p class="body-md">{{ 'product.actions.contact_description' | t }}</p>
          </div>
          <div class="contact-form-content">
            {{ section.settings.contact_form_html }}
          </div>
        </div>
      </aside>
    </uwp-drawer>
  </div>

  {% style %}
    uwp-drawer[modal-name="{{ drawer_id }}"] .drawer__container {
      padding-block: var(--spacing-3xs);
      padding-inline: var(--spacing-sm);
    }
    @media (width <= 1023px) {
      uwp-drawer[modal-name="{{ drawer_id }}"] .drawer__container {
        max-width: calc(100vw - var(--spacing-md));
        max-height: calc(100dvh - var(--spacing-md));
        margin: 0 auto;
        left: 0;
        top: var(--spacing-2xs);
      }
    }
    uwp-drawer[modal-name="{{ drawer_id }}"] .drawer__header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding-block: 12px;
    }
    uwp-drawer[modal-name="{{ drawer_id }}"] .contact-form-content {
      margin-block-start: var(--spacing-lg);
    }
    uwp-drawer[modal-name="{{ drawer_id }}"] .drawer__header-title-wrapper {
      display: flex;
      align-items: center;
      gap: var(--spacing-3xs);
    }
    uwp-drawer[modal-name="{{ drawer_id }}"] .drawer__close {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 24px;
      height: 24px;
      padding: 0;
      background: none;
      border: none;
      color: var(--color-text-primary);
      cursor: pointer;
      transition: opacity var(--duration-short) ease;
      flex-shrink: 0;
    }
    uwp-drawer[modal-name="{{ drawer_id }}"] .drawer__close:hover {
      opacity: 0.6;
    }
    uwp-drawer[modal-name="{{ drawer_id }}"] .drawer__close svg {
      width: 24px;
      height: 24px;
    }
    uwp-drawer[modal-name="{{ drawer_id }}"] .drawer__body {
      flex: 1;
      overflow-y: auto;
      padding-block-end: 40px;
    }
    uwp-drawer[modal-name="{{ drawer_id }}"] .drawer__title {
      font-family: var(--font-body-family);
    }
    uwp-drawer[modal-name="{{ drawer_id }}"] .shopify-section {
      padding: 0;
      margin: 0;
    }
    @media (width >= 1024px) {
      uwp-drawer[modal-name="{{ drawer_id }}"] .drawer__container {
        padding-inline: var(--spacing-md);
      }
      uwp-drawer[modal-name="{{ drawer_id }}"] .drawer__header {
        padding-block: var(--spacing-md);
      }
    }
  {% endstyle %}

  <script>
    (function () {
      var sectionRoot = document.getElementById('FurncareAbouttext-{{ section.id }}');
      var drawerTemplate = document.getElementById('image-text-contact-form-drawer-template-{{ section.id }}');
      var hubspotScriptSrc = 'https://js-eu1.hsforms.net/forms/embed/145723791.js';

      function mountDrawer() {
        var globalDrawers = document.getElementById('global-drawers');
        if (!drawerTemplate || !globalDrawers) return;
        if (globalDrawers.querySelector('[modal-name="{{ drawer_id }}"]')) return;

        var drawerElement = drawerTemplate.querySelector('uwp-drawer');
        if (!drawerElement) return;

        globalDrawers.appendChild(drawerElement);
      }

      function ensureDrawer(drawerName) {
        mountDrawer();
        var globalDrawers = document.getElementById('global-drawers');
        if (globalDrawers) {
          return globalDrawers.querySelector('[modal-name="' + drawerName + '"]');
        }
        return document.querySelector('[modal-name="' + drawerName + '"]');
      }

      function loadHubSpotScript(onReady) {
        if (window.hbspt && window.hbspt.forms && typeof window.hbspt.forms.create === 'function') {
          onReady();
          return;
        }

        var existingScript = document.querySelector('script[data-furncare-hsforms]');
        if (existingScript) {
          existingScript.addEventListener('load', onReady, { once: true });
          return;
        }

        var script = document.createElement('script');
        script.src = hubspotScriptSrc;
        script.defer = true;
        script.setAttribute('data-furncare-hsforms', 'true');
        script.addEventListener('load', onReady, { once: true });
        document.head.appendChild(script);
      }

      function initHubSpotForms(drawer) {
        if (!drawer) return;

        var frames = drawer.querySelectorAll('.hs-form-frame[data-form-id][data-portal-id]');
        if (!frames.length) return;

        function renderForms() {
          if (!window.hbspt || !window.hbspt.forms || typeof window.hbspt.forms.create !== 'function') return;

          frames.forEach(function (frame, index) {
            if (frame.getAttribute('data-hs-initialized') === 'true') return;
            if (frame.querySelector('iframe, form')) {
              frame.setAttribute('data-hs-initialized', 'true');
              return;
            }

            var targetId = frame.id;
            if (!targetId) {
              targetId = 'hs-form-{{ section.id }}-' + index;
              frame.id = targetId;
            }

            window.hbspt.forms.create({
              region: frame.getAttribute('data-region') || 'eu1',
              portalId: frame.getAttribute('data-portal-id'),
              formId: frame.getAttribute('data-form-id'),
              target: '#' + targetId
            });

            frame.setAttribute('data-hs-initialized', 'true');
          });
        }

        if (window.hbspt && window.hbspt.forms && typeof window.hbspt.forms.create === 'function') {
          renderForms();
          return;
        }

        loadHubSpotScript(renderForms);
      }

      function openDrawer(drawer, drawerName) {
        if (typeof drawer.showDrawer === 'function') {
          drawer.showDrawer();
          return;
        }
        document.dispatchEvent(new CustomEvent('modal:show:' + drawerName));

        if (window.customElements && typeof window.customElements.whenDefined === 'function') {
          window.customElements.whenDefined('uwp-drawer').then(function () {
            var upgradedDrawer = document.querySelector('[modal-name="' + drawerName + '"]');
            if (upgradedDrawer && typeof upgradedDrawer.showDrawer === 'function') {
              upgradedDrawer.showDrawer();
            }
          });
        }
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', mountDrawer, { once: true });
      } else {
        mountDrawer();
      }

      if (!sectionRoot) return;

      sectionRoot.addEventListener('click', function (event) {
        var trigger = event.target.closest('[data-furncare-drawer-trigger]');
        if (!trigger) return;

        event.preventDefault();

        var drawerName = trigger.getAttribute('data-drawer-trigger');
        if (!drawerName) return;

        var drawer = ensureDrawer(drawerName);
        if (!drawer) return;

        initHubSpotForms(drawer);
        openDrawer(drawer, drawerName);
      });
    })();
  </script>
{% endif %}
{% schema %}
{
  "name": "Image - Text",
  "class": "image-text__wrapper",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "header",
      "content": "Styles"
    },
    {
      "type": "select",
      "id": "colour_scheme",
      "label": "Colour scheme",
      "default": "base-white-01",
      "options": [
        {
          "value": "base-white-01",
          "label": "Base white 01"
        },
        {
          "value": "base-white-02",
          "label": "Base white 02"
        },
        {
          "value": "warm-stone",
          "label": "Warm stone"
        },
        {
          "value": "green-01",
          "label": "Green 01"
        },
        {
          "value": "green-02",
          "label": "Green 02"
        }
      ]
    },
    {
      "type": "select",
      "id": "section_padding",
      "label": "Section Padding",
      "default": "--spacing-2xl",
      "options": [
        {
          "value": "--spacing-md",
          "label": "Narrow"
        },
        {
          "value": "--spacing-2xl",
          "label": "Default"
        },
        {
          "value": "--spacing-4xl",
          "label": "Wide"
        }
      ]
    },
    {
      "type": "header",
      "content": "Contact drawer"
    },
    {
      "type": "textarea",
      "id": "contact_form_html",
      "label": "Contact form HTML",
      "info": "Used when a button's action is set to Open contact form drawer. Paste form embed HTML here (e.g. HubSpot embed code)."
    },
    {
      "type": "header",
      "content": "Animation"
    },
    {
      "type": "checkbox",
      "id": "enable_reveal",
      "label": "Enable reveal animation",
      "default": true
    },
    {
      "type": "range",
      "id": "reveal_distance",
      "label": "Reveal distance",
      "min": 0,
      "max": 80,
      "step": 4,
      "default": 32,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "reveal_duration",
      "label": "Reveal duration",
      "min": 200,
      "max": 1400,
      "step": 20,
      "default": 760,
      "unit": "ms"
    }
  ],
  "blocks": [
    {
      "type": "images",
      "name": "Images",
      "settings": [
        {
          "type": "image_picker",
          "id": "image_one",
          "label": "Image one"
        },
        {
          "type": "image_picker",
          "id": "image_two",
          "label": "Image two"
        }
      ]
    },
    {
      "type": "content",
      "name": "Text",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "select",
          "id": "title_size",
          "label": "Title size",
          "options": [
            {
              "value": "display",
              "label": "Display"
            },
            {
              "value": "xl",
              "label": "X-Large"
            }
          ],
          "default": "xl"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "select",
          "id": "button_style",
          "label": "Button style",
          "options": [
            {
              "value": "primary",
              "label": "Primary"
            },
            {
              "value": "secondary",
              "label": "Secondary"
            },
            {
              "value": "underline",
              "label": "Underline"
            }
          ],
          "default": "primary"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button text",
          "default": "More about us"
        },
        {
          "type": "select",
          "id": "button_action",
          "label": "Button action",
          "default": "link",
          "options": [
            {
              "value": "link",
              "label": "Link (page or external URL)"
            },
            {
              "value": "contact_drawer",
              "label": "Open contact form drawer"
            }
          ]
        },
        {
          "type": "url",
          "id": "button_url",
          "label": "Button URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image - Text",
      "blocks": [
        {
          "type": "images"
        },
        {
          "type": "content",
          "settings": {
            "title": "Image with Text",
            "text": "Display an image alongside text content to highlight key information about your brand or products.",
            "button_text": "Learn more",
            "button_style": "primary"
          }
        }
      ]
    }
  ]
}
{% endschema %}
