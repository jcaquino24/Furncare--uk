{{ 'furncare-about.css' | asset_url | stylesheet_tag }}
<script src="{{ 'furncare-about.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign reveal_class = ''
  if section.settings.enable_reveal
    assign reveal_class = ' fa-reveal'
  endif
-%}
{%- capture furncare_selector -%}#FurncareAboutProcess-{{ section.id }}{%- endcapture -%}
{% style %}
  {% render 'furncare-about-style-vars', selector: furncare_selector, section_settings: section.settings %}
  {{ furncare_selector }} {
    --fa-process-card-bg: {{ section.settings.process_card_background }};
    --fa-process-card-border: {{ section.settings.process_card_border }};
    --fa-process-number-color: {{ section.settings.process_number_color }};
    --fa-process-title-color: {{ section.settings.process_title_color }};
    --fa-process-copy-color: {{ section.settings.process_copy_color }};
    --fa-process-line-color: {{ section.settings.process_line_color }};
    --fa-process-number-size: {{ section.settings.process_number_size }}px;
    --fa-process-title-size: {{ section.settings.process_title_size }}px;
    --fa-process-card-blur: {{ section.settings.process_card_blur }}px;
  }
{% endstyle %}

<section id="FurncareAboutProcess-{{ section.id }}" class="fa-page-section fa-pad">
  <div class="fa-wrap">
    <div class="fa-section-header fa-content-box{{ reveal_class }}">
      {%- if section.settings.eyebrow != blank -%}
        <p class="fa-section-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="fa-heading-lg">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
    </div>

    <div class="fa-process-list">
      {%- for block in section.blocks -%}
        <article class="fa-process-card{{ reveal_class }}" {{ block.shopify_attributes }}>
          {%- if block.settings.number != blank -%}
            <div class="fa-process-number">{{ block.settings.number | escape }}</div>
          {%- endif -%}

          {%- if block.settings.title != blank -%}
            <h3 class="fa-process-title">{{ block.settings.title | escape }}</h3>
          {%- endif -%}

          {%- if block.settings.copy != blank -%}
            <p class="fa-process-copy">{{ block.settings.copy }}</p>
          {%- endif -%}
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

