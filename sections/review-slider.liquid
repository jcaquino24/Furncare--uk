{%- style -%}
  .reviews-{{ section.id }} {
    padding: {{ section.settings.padding_v }}px 0;
    background-color: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
  }

  .rev-header {
    text-align: center;
    margin-bottom: 40px;
  }

  .rev-heading {
    font-size: 2.2rem;
    margin-bottom: 10px;
    font-weight: bold;
  }

  .rev-summary {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-size: 1.1rem;
  }

  .stars { color: #ffffff; letter-spacing: 2px; }

  .rev-slider-wrapper {
    position: relative;
    max-width: {{ section.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 60px;
  }

  .rev-container {
    display: flex;
    gap: 20px;
    overflow-x: auto;
    scroll-behavior: smooth;
    scrollbar-width: none;
    padding: 20px 0;
  }
  .rev-container::-webkit-scrollbar { display: none; }

  .rev-card {
    flex: 0 0 85%;
    background: {{ section.settings.card_bg }};
    border-radius: 20px;
    padding: 40px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 250px;
  }

  @media screen and (min-width: 750px) {
    .rev-card { flex: 0 0 calc(50% - 10px); } /* 2 cards per view as per screenshot */
  }

  .rev-stars { margin-bottom: 20px; font-size: 1.2rem; }

  .rev-text {
    font-size: 1.1rem;
    line-height: 1.6;
    margin-bottom: 30px;
    opacity: 0.9;
  }

  .rev-author {
    display: flex;
    align-items: center;
    gap: 15px;
  }

  .author-img {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    background: #d1d5db;
    object-fit: cover;
  }

  .author-name { font-weight: 500; font-size: 1rem; }

  /* Navigation Arrows */
  .rev-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 44px;
    height: 44px;
    background: #fff;
    border-radius: 50%;
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 5;
    box-shadow: 0 4px 10px rgba(0,0,0,0.3);
  }
  .rev-nav svg { width: 20px; height: 20px; stroke: #000; stroke-width: 3px; }
  .rev-prev { left: 5px; }
  .rev-next { right: 5px; }

  @media screen and (max-width: 749px) {
    .rev-nav { display: none; }
    .rev-slider-wrapper { padding: 0 20px; }
  }
{%- endstyle -%}

<section class="reviews-{{ section.id }}">
  <div class="rev-header">
    <h2 class="rev-heading">{{ section.settings.heading }}</h2>
    <div class="rev-summary">
      <span class="stars">★★★★★</span>
      <span>{{ section.settings.rating_text }}</span>
    </div>
  </div>

  <div class="rev-slider-wrapper">
    <button class="rev-nav rev-prev" onclick="document.getElementById('RevSlider-{{ section.id }}').scrollBy({left: -400, behavior: 'smooth'})">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M15 19l-7-7 7-7"/></svg>
    </button>

    <div class="rev-container" id="RevSlider-{{ section.id }}">
      {%- for block in section.blocks -%}
        <div class="rev-card" {{ block.shopify_attributes }}>
          <div>
            <div class="rev-stars">★★★★★</div>
            <p class="rev-text">{{ block.settings.text }}</p>
          </div>
          <div class="rev-author">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 100 | image_tag: class: 'author-img' }}
            {%- else -%}
              <div class="author-img" style="display:flex; align-items:center; justify-content:center; background:#444;">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="#888"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>
              </div>
            {%- endif -%}
            <span class="author-name">{{ block.settings.author }}</span>
          </div>
        </div>
      {%- endfor -%}
    </div>

    <button class="rev-nav rev-next" onclick="document.getElementById('RevSlider-{{ section.id }}').scrollBy({left: 400, behavior: 'smooth'})">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M9 5l7 7-7 7"/></svg>
    </button>
  </div>
</section>

{% schema %}
{
  "name": "Review Slider",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Reviews from people like you" },
    { "type": "text", "id": "rating_text", "label": "Rating Score", "default": "4.9" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#111111" },
    { "type": "color", "id": "card_bg", "label": "Card Background", "default": "#222222" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#ffffff" },
    { "type": "number", "id": "container_width", "label": "Max Width", "default": 1100 },
    { "type": "range", "id": "padding_v", "label": "Vertical Padding", "min": 0, "max": 100, "step": 2, "default": 60 }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "textarea", "id": "text", "label": "Review Text", "default": "Lorem ipsum dolor sit amet, consectetur adipiscing elit." },
        { "type": "text", "id": "author", "label": "Author Name", "default": "John Doe" },
        { "type": "image_picker", "id": "image", "label": "Author Avatar" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Reviews Slider",
      "blocks": [
        { "type": "review" },
        { "type": "review" },
        { "type": "review" }
      ]
    }
  ]
}
{% endschema %}