{{ 'furncare-about.css' | asset_url | stylesheet_tag }}
<script src="{{ 'furncare-about.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign reveal_class = ''
  if section.settings.enable_reveal
    assign reveal_class = ' fa-reveal'
  endif
-%}
{%- capture furncare_selector -%}#FurncareAboutAudience-{{ section.id }}{%- endcapture -%}
{% style %}
  {% render 'furncare-about-style-vars', selector: furncare_selector, section_settings: section.settings %}
{% endstyle %}

<section id="FurncareAboutAudience-{{ section.id }}" class="fa-page-section fa-pad">
  <div id="{{ section.settings.id_anchor }}" class="fa-wrap">
    <div class="fa-section-header fa-content-box{{ reveal_class }}">
      {%- if section.settings.eyebrow != blank -%}
        <p class="fa-section-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="fa-heading-md">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
    </div>

    <div class="fa-card-grid">
      {%- for block in section.blocks -%}
        <article class="fa-card fa-audience-card{{ reveal_class }}" {{ block.shopify_attributes }}>
          {% render 'furncare-icon', icon: block.settings.icon %}

          {%- if block.settings.title != blank -%}
            <h3 class="fa-card-title">{{ block.settings.title | escape }}</h3>
          {%- endif -%}

          {%- if block.settings.copy != blank -%}
            <p class="fa-card-copy">{{ block.settings.copy }}</p>
          {%- endif -%}
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

