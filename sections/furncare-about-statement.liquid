{{ 'furncare-about.css' | asset_url | stylesheet_tag }}
<script src="{{ 'furncare-about.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign reveal_class = ''
  if section.settings.enable_reveal
    assign reveal_class = ' fa-reveal'
  endif
  assign statement_columns = '1.05fr 0.95fr'
  case section.settings.column_layout
    when 'equal'
      assign statement_columns = '1fr 1fr'
    when 'copy_wider'
      assign statement_columns = '0.9fr 1.1fr'
    when 'heading_narrow'
      assign statement_columns = '0.8fr 1.2fr'
  endcase
  assign statement_align = 'center'
  case section.settings.vertical_alignment
    when 'start'
      assign statement_align = 'start'
    when 'end'
      assign statement_align = 'end'
  endcase
-%}
{%- capture furncare_selector -%}#FurncareAboutStatement-{{ section.id }}{%- endcapture -%}
{% style %}
  {% render 'furncare-about-style-vars', selector: furncare_selector, section_settings: section.settings %}
  {{ furncare_selector }} {
    --fa-statement-columns: {{ statement_columns }};
    --fa-statement-align: {{ statement_align }};
  }
{% endstyle %}

<section id="FurncareAboutStatement-{{ section.id }}" class="fa-page-section fa-pad">
  <div class="fa-wrap">
    <div class="fa-statement-grid">
      <div class="fa-content-box{{ reveal_class }}">
        {%- if section.settings.eyebrow != blank -%}
          <p class="fa-section-eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="fa-heading-lg">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
      </div>

      <div class="fa-statement__panel{{ reveal_class }}">
        {%- if section.settings.copy != blank -%}
          <div class="fa-richtext fa-copy">{{ section.settings.copy }}</div>
        {%- endif -%}

        {%- if section.settings.second_copy != blank -%}
          <div class="fa-richtext fa-copy">{{ section.settings.second_copy }}</div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

