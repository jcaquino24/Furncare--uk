{% liquid
  assign similar_source_collection = section.settings.collection
  if similar_source_collection == blank and product and product.collections.size > 0
    assign similar_source_collection = product.collections.first
  endif
  if similar_source_collection == blank
    assign similar_source_collection = collections['all']
  endif
%}

{% if product and similar_source_collection != blank %}
  <section
    id="SimilarNameRecommendation-{{ section.id }}"
    class="similar-name-recommendation colour-scheme--{{ section.settings.colour_scheme }}"
    style="--section-padding: var({{ section.settings.section_padding }});"
    data-similar-name-recommendation
    data-product-id="{{ product.id }}"
    data-product-title="{{ product.title | escape }}"
    data-limit="{{ section.settings.products_to_show }}"
    aria-labelledby="SimilarNameRecommendationHeading-{{ section.id }}"
    hidden
  >
    <div class="container">
      {% if section.settings.heading != blank %}
        <h2 id="SimilarNameRecommendationHeading-{{ section.id }}" class="eyebrow-sm">
          {{ section.settings.heading | escape }}
        </h2>
      {% endif %}

      <div class="similar-name-recommendation__grid" data-similar-name-grid>
        {% for candidate in similar_source_collection.products %}
          {% unless candidate.id == product.id %}
            <div
              class="similar-name-recommendation__item"
              data-similar-name-item
              data-product-id="{{ candidate.id }}"
              data-product-title="{{ candidate.title | escape }}"
              hidden
            >
              {% render 'product-card', product: candidate %}
            </div>
          {% endunless %}
        {% endfor %}
      </div>
    </div>
  </section>
{% endif %}

{% style %}
  #SimilarNameRecommendation-{{ section.id }} {
    padding-block: var(--section-padding, var(--spacing-2xl));
  }

  #SimilarNameRecommendation-{{ section.id }} .similar-name-recommendation__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--spacing-md);
  }

  @media (min-width: 768px) {
    #SimilarNameRecommendation-{{ section.id }} .similar-name-recommendation__grid {
      grid-template-columns: repeat({{ section.settings.products_per_row }}, minmax(0, 1fr));
      gap: var(--spacing-lg);
    }
  }
{% endstyle %}

<script>
  (() => {
    const initializeSimilarNames = (scope = document) => {
      const sections = [];
      if (scope.matches?.('[data-similar-name-recommendation]')) sections.push(scope);
      sections.push(...(scope.querySelectorAll?.('[data-similar-name-recommendation]') || []));

      sections.forEach((container) => {
        if (container.dataset.initialized === 'true') return;
        container.dataset.initialized = 'true';

        const firstWord = container.dataset.productTitle
          ?.split('|')[0]
          .trim()
          .split(/\s+/)[0]
          ?.toLocaleLowerCase();
        const currentProductId = container.dataset.productId;
        const limit = Number.parseInt(container.dataset.limit, 10) || 8;
        if (!firstWord) return;

        let visibleCount = 0;
        container.querySelectorAll('[data-similar-name-item]').forEach((item) => {
          const title = item.dataset.productTitle?.toLocaleLowerCase() || '';
          const isMatch = item.dataset.productId !== currentProductId && title.includes(firstWord);
          if (isMatch && visibleCount < limit) {
            item.hidden = false;
            visibleCount += 1;
          }
        });

        if (visibleCount > 0) container.hidden = false;
      });
    };

    initializeSimilarNames();
    document.addEventListener('shopify:section:load', (event) => initializeSimilarNames(event.target));
  })();
</script>

{% schema %}
{
  "name": "Similar name products",
  "tag": "section",
  "class": "section-similar-name-recommendation",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "More in this range"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Product source collection",
      "info": "If blank, uses the current product's first collection, then the all-products collection."
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "products_per_row",
      "label": "Products per row on desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "section_padding",
      "label": "Section padding",
      "default": "--spacing-2xl",
      "options": [
        { "value": "--spacing-md", "label": "Narrow" },
        { "value": "--spacing-2xl", "label": "Default" },
        { "value": "--spacing-4xl", "label": "Wide" }
      ]
    },
    {
      "type": "select",
      "id": "colour_scheme",
      "label": "Colour scheme",
      "default": "base-white-01",
      "options": [
        { "value": "base-white-01", "label": "Base white 01" },
        { "value": "base-white-02", "label": "Base white 02" },
        { "value": "warm-stone", "label": "Warm stone" },
        { "value": "duck-egg", "label": "Duck Egg" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Similar name products"
    }
  ]
}
{% endschema %}