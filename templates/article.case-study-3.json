    "image_text_Rr8iJJ": {
      "type": "image-text",
      "blocks": {
        "images_NXFXtC": {
          "type": "images",
          "settings": {
            "image_one": "shopify://shop_images/Untitled_-_2025-10-02T072427.794.png"
          }
        },
        "content_c9CaD6": {
          "type": "content",
          "disabled": true,
          "settings": {
            "title": "Key Features",
            "title_size": "xl",
            "text": "All furniture supplied by Furncare is specifically designed and manufactured for the care home and later living sector. Aesthetics are fundamental, but never at the expense of safety and ease of use.<br>\n<br>\nFrom supportive, stylish seating to carefully specified bedroom and dining furniture, every element has been crafted to meet the everyday needs of care home residents. The result is furniture that caters to every requirement of the care home, keeping residents safe - but most importantly, comfortable.  <br>\n<br>",
            "button_style": "underline",
            "button_text": "Browse our best sellers",
            "button_url": "https://www.furncare.co.uk/collections/best-sellers"
          }
        }
      },
      "block_order": [
        "images_NXFXtC",
        "content_c9CaD6"
      ],
      "disabled": true,
      "name": "Image - Text",
      "settings": {
        "colour_scheme": "base-white-01",
        "section_padding": "--spacing-4xl",
        "enable_reveal": true,
        "reveal_distance": 32,
        "reveal_duration": 760
      }
    },
    "image_text_EcgCq3": {
      "type": "image-text",
      "blocks": {
        "content_T8P7Ff": {
          "type": "content",
          "settings": {
            "title": "Custom Interiors",
            "title_size": "xl",
            "text": "Bright Bay Design expertly balanced the high-quality design aesthetic with \nrobust interiors which meet the complex demands of a care home, creating a \nstylish, comfortable and tranquil atmosphere conducive to both relaxation \nand functionality. <br>\n<br>\nBy integrating durable materials with a cohesive and contemporary scheme, the result is care home furniture that feels both sophisticated and welcoming. Fabrics are selected for heavy contract use, furniture is engineered for strength and stability, and circulation spaces are planned to support both residents and care teams. These practical decisions sit alongside a confident, contemporary design approach, ensuring the home feels considered and well executed. <br>\n<br>\nThe result is a care home interior that works as hard as the people in it - robust, compliant and designed specifically for the realities of later living.",
            "button_style": "underline",
            "button_text": "",
            "button_url": "https://brightbaydesign.co.uk/elm-lodge/"
          }
        },
        "images_FmKCDq": {
          "type": "images",
          "settings": {
            "image_one": "shopify://shop_images/Untitled_-_2025-10-02T072427.794.png"
          }
        }
      },
      "block_order": [
        "content_T8P7Ff",
        "images_FmKCDq"
      ],
      "name": "Image - Text",
      "settings": {
        "colour_scheme": "base-white-01",
        "section_padding": "--spacing-2xl",
        "enable_reveal": true,
        "reveal_distance": 32,
        "reveal_duration": 760
      }
    },
    "image_text_WEHwQN": {
      "type": "image-text",
      "blocks": {
        "images_KiHPCK": {
          "type": "images",
          "settings": {
            "image_one": "shopify://shop_images/PREG2521_43611857-db5c-4df2-81f3-ba46fda7cbe2.jpg"
          }
        },
        "content_LAejLn": {
          "type": "content",
          "settings": {
            "title": "Durability and Sustainability",
            "title_size": "xl",
            "text": "Furncare’s commitment to sustainability underpins every stage of the project. Responsibly sourced materials and carefully selected finishes ensure Elm Lodge’s interiors are environmentally conscious while meeting the rigorous demands of a care home setting.<br>\n<br>\nBuilt to withstand daily use, the furniture and fittings are designed for long-term performance in later living environments. This focus on quality and responsible procurement ensures the interiors remain both visually impressive and operationally effective for years to come, reducing the need for replacement and ongoing material waste and supporting operational efficiency - also lowering the environmental impact of the project. <br>\n<br>\nBy combining robust specification with considered procurement, the result is a care home interior that performs consistently, supports sustainable principles and is built to last.",
            "button_style": "primary",
            "button_text": "",
            "button_url": ""
          }
        }
      },
      "block_order": [
        "images_KiHPCK",
        "content_LAejLn"
      ],
      "name": "Image - Text",
      "settings": {
