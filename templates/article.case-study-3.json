    "image_text_t4XjPt": {
      "type": "image-text",
      "blocks": {
        "images_C43ggB": {
          "type": "images",
          "settings": {
            "image_one": "shopify://shop_images/P1044835_088e3767-c0b6-42f9-bf62-2da4b15c6049.jpg"
          }
        },
        "content_pCkh7R": {
          "type": "content",
          "settings": {
            "title": "Location",
            "title_size": "xl",
            "text": "Elm Lodge is a state-of-the-art, 60-bed luxury residential care home nestled in \nthree acres of beautiful grounds in the picturesque Hampshire \ncountryside. As part of the Forest Care group, it offers residents over 43 years of dedicated care experience and five-star hospitality, all guided by residents' \npreferences. This brand-new, eco-friendly facility creates a genuinely welcoming place to live. From the cosy lounge areas to the stylish yet practical restaurant and café bar, every detail has been designed with care.",
            "button_style": "primary",
            "button_text": "",
            "button_url": ""
          }
        }
      },
      "block_order": [
        "images_C43ggB",
        "content_pCkh7R"
      ],
      "name": "Image - Text",
      "settings": {
        "colour_scheme": "base-white-01",
        "section_padding": "--spacing-2xl",
        "enable_reveal": true,
        "reveal_distance": 32,
        "reveal_duration": 760
      }
    },
    "richtext_EW6cqY": {
      "type": "richtext",
      "blocks": {
        "heading_C9ihxn": {
          "type": "heading",
          "settings": {
            "text": "“Bright Bay Design’s involvement across the full project process, from initial building design through to final fit-out, enabled us to create a care home that stands out in so many ways, and we were delighted to include Furncare’s specialist furniture which, with their excellent service, helped us realise our and Forest Care’s vision for Elm Lodge.”",
            "heading_level": "h2",
            "heading_style": "title-lg"
          },
          "blocks": {}
        },
        "tagline_JPEfFQ": {
          "type": "tagline",
          "settings": {
            "content": "Alexandra Ledger, Director at Bright Bay Design",
            "tagline_style": "body-md"
          },
          "blocks": {}
        },
