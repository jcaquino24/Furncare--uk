    "image_text_Rr8iJJ": {
      "type": "image-text",
      "blocks": {
        "images_NXFXtC": {
          "type": "images",
          "settings": {
            "image_one": "shopify://shop_images/Pub_-_Chapel_View_21_of_40.jpg",
            "image_two": "shopify://shop_images/Cinema_Room_-_Chapel_View_27_of_28.jpg"
          }
        },
        "content_c9CaD6": {
          "type": "content",
          "settings": {
            "title": "Special Projects Team",
            "title_size": "xl",
            "text": "In their most recent refurbishment project, ‘Chapel View’ in South Yorkshire has been refreshed and upgraded. The Furncare Special Projects Team oversaw the project, led by Arnie Goodenough and Jade Eaglen. Although not a dedicated dementia unit itself, Chapel View compliments nearby Group dementia care homes Riverside and Field View, with support and respite care services.\n\nHaving measured up and taken a comprehensive client brief during a site visit with owner and Director Andrew Wood and his father in February 2024, Furncare Project Design Manager Jade set about turning their ‘vision’ into a stylish, functional and homely care home.\n\nWith the help of Molly Tinker, one of over 20 staff based at the Furncare Head Office, floorplans, room layouts, mood boards and costings were then developed. Originally inspired by bold, distinctive wall coverings in another Wood Care Group home, the final designs help to create a suitably confident yet stylish environment.",
            "button_style": "underline",
            "button_text": "",
            "button_url": ""
          }
        }
      },
      "block_order": [
        "images_NXFXtC",
        "content_c9CaD6"
      ],
      "name": "Image - Text",
      "settings": {
        "colour_scheme": "base-white-01",
        "section_padding": "--spacing-4xl",
        "enable_reveal": true,
        "reveal_distance": 32,
        "reveal_duration": 760
      }
    },
    "image_text_MWUrUE": {
      "type": "image-text",
      "blocks": {
        "content_zq6UEN": {
          "type": "content",
          "settings": {
            "title": "Tactile & Organic",
            "title_size": "xl",
            "text": "New customer lighting was factored in to ensure maximum benefit was achieved. For the seating, rather than opt for stock upholstery fabrics, bespoke faux leather was utilised extensively to provide a more tactile and organic feel. The Overton dining room cabinets featured Mountain Oak natural wood surfaces and a Mussel paint finish. Just days after the designs were submitted, they were reviewed and given an emphatic ‘thumbs up’ by Andrew Wood.",
            "button_style": "underline",
            "button_text": "",
            "button_url": ""
          }
        },
        "images_yNWAEq": {
          "type": "images",
          "settings": {
            "image_one": "shopify://shop_images/Dining_Room_-_Chapel_View_42_of_60.jpg"
          }
        }
      },
      "block_order": [
        "content_zq6UEN",
        "images_yNWAEq"
      ],
      "name": "Image - Text",
      "settings": {
        "colour_scheme": "base-white-01",
        "section_padding": "--spacing-2xl",
        "enable_reveal": true,
        "reveal_distance": 32,
        "reveal_duration": 760
      }
    },
    "image_text_n3pjU3": {
      "type": "image-text",
      "blocks": {
        "images_RQ74Gb": {
          "type": "images",
          "settings": {
            "image_one": "shopify://shop_images/Cinema_Room_-_Chapel_View_9_of_28.jpg"
          }
        },
        "content_9BRRFm": {
          "type": "content",
          "settings": {
            "title": "It's all in the detail",
            "title_size": "xl",
            "text": "With only minor adjustments left to address, most of which were to accommodate new lighting plans, the order was signed off. Despite the bespoke requirements and tailor-made upholstery, Andrew and his sister Jenny greeted Jade and the Furncare ‘White Glove’ Team just a few weeks later when they delivered and installed the interiors – cabinet furniture, seating, curtains, blinds and soft furnishings. Delivery was scheduled by the Logistics Team and the Furncare National Distribution Centre to synchronise with the customers construction team so had to be flexible and ‘on-call’ to ensure the seamless completion of the project.\n\nStill able to accommodate further last-minute adjustments on site, the team were able to deliver and install all the lounges, the ‘Pub’, cinema and dining room in full and on schedule.",
            "button_style": "underline",
            "button_text": "",
            "button_url": ""
          }
        }
      },
      "block_order": [
        "images_RQ74Gb",
        "content_9BRRFm"
      ],
      "name": "Image - Text",
      "settings": {
        "colour_scheme": "base-white-01",
        "section_padding": "--spacing-2xl",
        "enable_reveal": true,
        "reveal_distance": 32,
