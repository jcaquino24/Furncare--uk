    "richtext_EW6cqY": {
      "type": "richtext",
      "blocks": {
        "tagline_bUpPLb": {
          "type": "tagline",
          "settings": {
            "content": "The exclusive BUPA Richmond Villages Letcombe Regis Care Home was designed by Vogue Living. It is located in the heart of the Oxfordshire countryside and incorporates private ensuite bedrooms, an indoor swimming pool, gym, restaurant and licensed bar, library, lounges and accessible grounds. The dedicated dementia unit has been designed and furnished sensitively, whilst the nursing care home provides highly personalised accommodation and premium care. Letcombe Regis also provides respite care so is an ideal place to recuperate or convalesce.",
            "tagline_style": "body-xl"
          },
          "blocks": {}
        },
        "tagline_xQFxgp": {
          "type": "tagline",
          "settings": {
            "content": "The beautiful interiors throughout have been sensitively designed and furnished to create a warm, luxurious and comfortable environment for residents. The upholstery colours and designs pair seamlessly with the furniture shapes and designs, transforming the spaces into a luxurious, opulent and homely environment.",
            "tagline_style": "body-xl"
          },
          "blocks": {}
        }
      },
      "block_order": [
        "tagline_bUpPLb",
        "tagline_xQFxgp"
      ],
      "name": "Rich Text",
      "settings": {
        "id_anchor": "",
        "max_width_desktop": 100,
        "section_padding": "--spacing-4xl",
        "text_alignment": "center",
        "colour_scheme": "warm-stone",
        "enable_animation": false,
