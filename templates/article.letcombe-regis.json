    "image_text_Rr8iJJ": {
      "type": "image-text",
      "blocks": {
        "images_NXFXtC": {
          "type": "images",
          "settings": {
            "image_one": "shopify://shop_images/Untitled_-_2025-10-02T072427.794.png",
            "image_two": "shopify://shop_images/Untitled_-_2025-10-02T072641.731.png"
          }
        },
        "content_c9CaD6": {
          "type": "content",
          "settings": {
            "title": "Key Features",
            "title_size": "xl",
            "text": "Resident-Focused Furniture:\nAll furniture supplied by Furncare prioritises safety and ease of use, without compromising on aesthetics. Comfortable & stylish seating, as well as bedroom and dining furniture have been crafted to meet the specific needs of care home residents.\n\nCustom Interiors: \nBright Bay Design expertly balanced the high-quality design aesthetic with robust interiors which meet the complex demands of a care home, creating a stylish, comfortable and tranquil atmosphere conducive to both relaxation and community.\n\nDurability and Sustainability: \nFurncare’s commitment to sustainability is reflected in their use of responsibly sourced materials, ensuring Elm Lodge’s interiors are environmentally conscious, fit for purpose and long-lasting.",
            "button_style": "underline",
            "button_text": "Elm Lodge Virtual Tour",
            "button_url": ""
          }
        }
      },
