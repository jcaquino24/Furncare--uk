        "heading_mYLH3K": {
          "type": "heading",
          "settings": {
            "text": "Furncare Teams Up with Bright Bay Design to Furnish Stunning New Care Home in Hampshire",
            "heading_level": "h2",
            "heading_style": "title-xl"
          },
          "blocks": {}
        },
        "tagline_LFtXUT": {
          "type": "tagline",
          "settings": {
            "content": "<a href=\"http://www.furncare.co.uk/\" target=\"_blank\">Furncare</a>, a leading provider of high-quality care home furniture for over 20 years, is proud to announce its collaboration with <a href=\"https://brightbaydesign.co.uk/\" target=\"_blank\">Bright Bay Design</a> in furnishing the newly launched <a href=\"https://www.forestcare.co.uk/homes/elm-lodge/\" target=\"_blank\">Forest Care Elm Lodge</a>, a state-of-the-art care home that promises to set a new benchmark in residential care.",
            "tagline_style": "body-lg"
          },
          "blocks": {}
        },
        "tagline_AtLUnj": {
          "type": "tagline",
          "settings": {
            "content": "The project brought together Furncare’s expertise in crafting furniture tailored for comfort, safety, and durability with Bright Bay Design’s innovative approach to interior aesthetics, which has resulted in an elegant, welcoming environment designed to enhance residents’ quality of life.",
            "tagline_style": "body-lg"
          },
          "blocks": {}
        },
        "button_GqjYpW": {
