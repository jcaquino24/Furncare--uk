    "richtext_7UE3tm": {
      "type": "richtext",
      "blocks": {
        "heading_XaPUGL": {
          "type": "heading",
          "disabled": true,
          "settings": {
            "text": "We design furniture and interiors that are practical, safe, and welcoming. Our focus is creating spaces that support both residents and caregivers.",
            "heading_level": "h2",
            "heading_style": "title-xs"
          },
          "blocks": {}
        },
        "tagline_CQ9Qpi": {
          "type": "tagline",
          "settings": {
            "content": "Willow Lodge represents one of our largest and most detailed projects to date. Developed by Zephyr X and operated by EQ Care Group, the interior design for the home was led by Stylesmith Interiors. We became involved while the first moodboards were being developed, working alongside the wider team to turn the interior specification into a coordinated furniture and furnishings package ready for installation.",
            "tagline_style": "body-md"
          },
          "blocks": {}
        },
        "tagline_r4mfBx": {
          "type": "tagline",
          "settings": {
            "content": "With thousands of individual items, hundreds of new product styles and a large number of bespoke elements, this home required detailed planning across product development, manufacturing, procurement, logistics and installation – a project that demonstrated not only the scale Furncare can deliver, but the level of coordination required behind the scenes to bring a detailed interior specification to site successfully.",
            "tagline_style": "body-md"
          },
          "blocks": {}
        },
        "button_YCRkd3": {
          "type": "button",
          "disabled": true,
          "settings": {
            "style": "primary",
            "text": "Button",
            "url": "#",
            "new_tab": false
          },
          "blocks": {}
        }
      },
      "block_order": [
        "heading_XaPUGL",
        "tagline_CQ9Qpi",
        "tagline_r4mfBx",
        "button_YCRkd3"
      ],
      "name": "Rich Text",
      "settings": {
        "id_anchor": "",
        "max_width_desktop": 95,
        "section_padding": "--spacing-4xl",
        "text_alignment": "left",
        "colour_scheme": "base-white-01",
        "enable_animation": false,
        "optional_richtext": "",
        "small_container": false,
        "enable_see_more": false,
        "see_more_max_height": 400
      }
    },
    "image_text_zXnynf": {
      "type": "image-text",
      "blocks": {
        "content_bWjPrR": {
          "type": "content",
          "settings": {
            "title": "",
            "title_size": "display",
            "text": "Our involvement began while Stylesmith Interiors were developing the initial moodboards for Willow Lodge.\nThe designers established the creative vision for Willow Lodge, defining the schemes across the home. Our role in this was to turn that specification into a tangible furniture package, ensuring the final furniture closely reflected the designers’ original specification while meeting the practical requirements of a care environment. <br> <br> \nAcross a project of this size, even relatively small specification changes could have an impact across multiple rooms or product types. By the time the final specification had been built, more than 400 new product styles had been created for Willow Lodge alone.\nThese covered different furniture configurations, fabrics, finishes and bespoke details, allowing each item to fit perfectly into its intended space.\nThe result was a final schedule comprising 2,319 individual items.",
            "button_style": "primary",
            "button_text": "",
            "button_action": "link",
            "button_url": ""
          }
        },
