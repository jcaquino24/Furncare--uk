    "richtext_7UE3tm": {
      "type": "richtext",
      "blocks": {
        "heading_XaPUGL": {
          "type": "heading",
          "disabled": true,
          "settings": {
            "text": "We design furniture and interiors that are practical, safe, and welcoming. Our focus is creating spaces that support both residents and caregivers.",
            "heading_level": "h2",
            "heading_style": "title-xs"
          },
          "blocks": {}
        },
        "tagline_CQ9Qpi": {
          "type": "tagline",
          "settings": {
            "content": "A project developed by Zephyr X, operated by EQ Care Group, and designed by Stylesmith Interiors. Our involvement began while Stylesmith Interiors were developing the initial moodboards for Willow Lodge - the designers established the creative vision for Willow Lodge, defining the schemes across the home. Our role in this was to turn that specification into a tangible furniture package, ensuring the final furniture closely reflected the designers’ original specification while meeting the practical requirements of a care environment.",
            "tagline_style": "body-md"
          },
          "blocks": {}
        },
        "tagline_r4mfBx": {
          "type": "tagline",
          "settings": {
            "content": "With thousands of individual items, hundreds of new product styles and a large number of bespoke elements, this home required detailed planning across product development, manufacturing, procurement, logistics and installation – a project that demonstrated not only the scale Furncare can deliver, but the level of coordination required behind the scenes to bring a detailed interior specification to site successfully.",
            "tagline_style": "body-md"
          },
          "blocks": {}
        },
        "button_YCRkd3": {
          "type": "button",
          "disabled": true,
          "settings": {
            "style": "primary",
            "text": "Button",
            "url": "#",
            "new_tab": false
          },
          "blocks": {}
        }
      },
