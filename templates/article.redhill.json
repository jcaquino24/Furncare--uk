    "image_text_zXnynf": {
      "type": "image-text",
      "blocks": {
        "images_Qdr4kx": {
          "type": "images",
          "settings": {
            "image_one": "shopify://shop_images/Willow_Lodge_Vol_4-25_706e3189-1970-46de-b03e-77d22b4df093.jpg"
          }
        },
        "content_bWjPrR": {
          "type": "content",
          "settings": {
            "title": "Our Approach",
            "title_size": "display",
            "text": "When Willow Lodge was presented to us, it was still in the early stages of construction - this gave us plenty of time to work alongside StyleSmiths, to ensure no detail was missed in the specification. Shaping interiors that support everyday living and balance the practical demands of care takes time and precision. \n<br>\n<br>\nWorking closely with the project team, we delivered a complete FF&E package designed to support wellbeing and daily living across the home. Every element was chosen with comfort, durability and purpose in mind, ensuring bedrooms, lounges and dining spaces function seamlessly while still feeling warm and homely.\n<br>\n<br>\nThrough thoughtful, purposeful solutions, we helped these care environments feel more homely, supportive and uplifting, balancing practical requirements with warmth and familiarity. In doing so, we delivered on our commitment to transforming spaces and elevating lives, shaping environments that support wellbeing, dignity and everyday comfort within care settings.",
            "button_style": "primary",
            "button_text": "",
            "button_action": "link",
            "button_url": ""
          }
        }
      },
      "block_order": [
        "images_Qdr4kx",
        "content_bWjPrR"
      ],
      "name": "Image - Text",
      "settings": {
        "colour_scheme": "base-white-01",
        "section_padding": "--spacing-2xl",
        "contact_form_html": "",
        "enable_reveal": true,
        "reveal_distance": 32,
        "reveal_duration": 760
      }
    },
    "image_text_nRYrfd": {
      "type": "image-text",
      "blocks": {
        "content_6rxGTr": {
          "type": "content",
          "settings": {
            "title": "What We Delivered",
            "title_size": "display",
            "text": "<div style=\"white-space: pre-wrap; white-space: pre-line;\">◦ Fully furnished bedrooms, including cabinet furniture, seating, and soft furnishings.\n\n◦ Lounge and dining spaces designed for comfort, social interaction, and ease of movement.\n\n◦ Reception, staff, and office areas fitted out for daily use.\n\n◦ Curtains and drapes adding warmth and style throughout the home.\n\n◦ Finishing touches including artwork, accessories, and even eating utensils to bring Manor Park to life.</div>",
            "button_style": "primary",
            "button_text": "",
            "button_action": "link",
            "button_url": ""
          }
        },
        "images_gHUjBg": {
          "type": "images",
          "settings": {
            "image_one": "shopify://shop_images/Cafe_with_blinds.png"
          }
