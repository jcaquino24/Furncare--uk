    "richtext_iHxNi7": {
      "type": "richtext",
      "blocks": {
        "heading_Vwggf4": {
          "type": "heading",
          "settings": {
            "text": "\"Stylesmith Interiors had a good experience working with Furncare on our recent care home project. The communication throughout the project has been key and our dedicated project manager has been responsive and helpful at each turn. The team work throughout the process made the process run smoothly and gave us confidence at each stage. The fit out team were professional and a pleasure to work with, nothing was too much trouble and they approached each adjustment and request positively and with a solutions focused attitude. We will be working with Furncare again!\"",
            "heading_level": "h2",
            "heading_style": "title-sm"
          },
          "blocks": {}
        },
        "tagline_BmC8Uy": {
          "type": "tagline",
          "settings": {
            "content": "JUSTINE KIRKHAM, DESIGN DIRECTOR AT STYLESMITH INTERIORS",
            "tagline_style": "body-sm"
          },
          "blocks": {}
        }
      },
