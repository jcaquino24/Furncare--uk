    "faqs_WTbyFt": {
      "type": "faqs",
      "blocks": {
        "faq_LEwFFA": {
          "type": "faq",
          "settings": {
            "question": "When should we start thinking about furniture for a new-build care facility?",
            "answer": "<p>The earlier the better. Involving Furncare during the planning or specification stage can help you make more confident decisions around room layouts, furniture choices, finishes, budgets and project timelines.</p>"
          }
        },
        "faq_XRN9fG": {
          "type": "faq",
          "settings": {
            "question": "Can you help before we know exactly what furniture we need?",
            "answer": "<p>Yes. Many new-build projects begin with an outline brief, floor plans or simply just a vision. Our team can help you understand what may be needed across bedrooms, lounges, dining areas, communal spaces and other key areas of the home.</p>"
          }
        },
        "faq_NyG9mB": {
          "type": "faq",
          "settings": {
            "question": "Can you work with our interior designer?",
            "answer": "<p>Yes. We regularly support wider project teams by helping with furniture selection, specification details, product guidance and practical considerations for care environments.</p>"
          }
        },
