            "container_width": 1600,
            "column_gap": 60,
            "section_padding_top": 60,
            "section_padding_bottom": 60,
            "embed_url": "",
            "embed_code": "<script src=\"https://js-eu1.hsforms.net/forms/embed/145723791.js\" defer></script>\n<div class=\"hs-form-frame\" data-region=\"eu1\" data-form-id=\"4b643ffe-2b73-47b6-96c2-c0694276b3e6\" data-portal-id=\"145723791\"></div>",
            "form_min_height": 500,
            "form_background_color": "#f9f7f0",
            "form_border_radius": 8,
            "heading": "<h1>Let us know what you're planning</h1>",
            "heading_font": "red_hat_display_n4",
            "heading_size": 60,
            "heading_color": "#243222",
            "heading_spacing": 32,
            "body_text": "<p></p><p>We'd love to know what you have planned! </p><p>Complete the form and we will be in touch to guide you towards your next steps.</p><p></p><p>If you'd rather contact us another way, you can:</p><p>- Call us on <a href=\"tel:01603 664900\" title=\"tel:01603 664900\"><strong>01603 664900</strong></a><br/>- Email our team on <a href=\"mailto:sales@furncare.co.uk\" title=\"mailto:sales@furncare.co.uk\"><strong>sales@furncare.co.uk<br/></strong></a>- Click on the live chat option on the bottom right of the page</p><p></p><p>We look forward to hearing from you!</p>",
            "body_size": 16,
            "body_color": "#243222",
            "body_spacing": 42,
