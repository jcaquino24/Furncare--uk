{%- layout none -%}
{%- assign is_portal_private_collection = false -%}
{%- for private_collection in settings.portal_private_collections -%}
  {%- if private_collection.id == collection.id -%}
    {%- assign is_portal_private_collection = true -%}
    {%- break -%}
  {%- endif -%}
{%- endfor -%}
{%- assign portal_company_names = settings.portal_company_name | default: 'Furncare Test' | split: ',' -%}
{%- assign current_company_name = customer.current_company.name | downcase | strip -%}
{%- assign is_portal_company = false -%}
{%- if request.design_mode -%}
  {%- assign is_portal_company = true -%}
{%- else -%}
  {%- for portal_company_name in portal_company_names -%}
    {%- assign normalized_company_name = portal_company_name | downcase | strip -%}
    {%- if current_company_name != blank and current_company_name == normalized_company_name -%}
      {%- assign is_portal_company = true -%}
      {%- break -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}
{%- if is_portal_private_collection and is_portal_company == false -%}
  <p>This collection is not available.</p>
{%- else -%}
<div class="portal-tabs__results">
  <h2 class="portal-tabs__results-title">{{ collection.title }}</h2>

  {%- if collection.products.size > 0 -%}
    <div class="portal-tabs__products">
      {%- for product in collection.products limit: 48 -%}
        {% render 'product-card', product: product, loading: 'lazy' %}
      {%- endfor -%}
    </div>
  {%- else -%}
    <p>No products available.</p>
  {%- endif -%}
</div>
{%- endif -%}
