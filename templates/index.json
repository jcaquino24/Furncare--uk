    "image_text_cqfzwp": {
      "type": "image-text",
      "blocks": {
        "images_TdUbCb": {
          "type": "images",
          "settings": {
            "image_one": "shopify://shop_images/PREG2451_94e26ec3-27c4-48f2-af68-5bc1057a2950.jpg",
            "image_two": "shopify://shop_images/Dining_Room_-_Chapel_View_46_of_60.jpg"
          }
        },
        "content_Y6iyFn": {
          "type": "content",
          "settings": {
            "title": "Care Home Furniture Suppliers",
            "title_size": "xl",
            "text": "Our experienced team builds relationships with customers to create long-lasting partnerships that help deliver outstanding care through ergonomically designed, contract-standard furniture. Our customers know we can support them with repeat orders and larger projects, including complete room refurbishment and full fit-outs.\n\nWe work with owners, managers, interior designers and staff of residential care homes, dementia care, nursing homes, mental health, and supported living services to deliver a wide range of furniture for care homes, including care home chairs, fire-retardant curtains, bedroom furniture, and care home beds, as well as complete pre-designed bedroom packages.",
            "button_style": "primary",
            "button_text": "",
            "button_url": ""
          }
        }
      },
      "block_order": [
        "images_TdUbCb",
        "content_Y6iyFn"
      ],
      "name": "Image - Text",
      "settings": {
        "colour_scheme": "base-white-01",
        "section_padding": "--spacing-2xl",
        "enable_reveal": true,
        "reveal_distance": 32,
        "reveal_duration": 760
      }
    },
    "image_text_V4HwxM": {
      "type": "image-text",
      "blocks": {
        "content_tzYwRN": {
          "type": "content",
          "settings": {
            "title": "Care Home Furniture",
            "title_size": "xl",
            "text": "Furncare specialises in the design, manufacture, and installation of distinctive care home furniture and interiors. With the widest range of furniture for care homes and the shortest lead times on the market, our 5 working-day delivery promise has revolutionised turnaround times, helping care homes maintain their occupancy rates and deliver excellent care.",
            "button_style": "primary",
            "button_text": "",
            "button_url": ""
          }
        },
        "content_QErGBb": {
          "type": "content",
          "settings": {
            "title": "Safety First",
            "title_size": "xl",
            "text": "We manufacture our chairs and fabrics to meet care industry standards, and continually work with our customers to develop inspirational ranges. \n\n\nEvery care is taken to ensure the finish and longevity of our unique furniture. Crafted to meet contract standards, our customers know that they can count on us for durable, well-finished furniture.",
            "button_style": "primary",
            "button_text": "",
            "button_url": ""
          }
        }
      },
      "block_order": [
        "content_tzYwRN",
        "content_QErGBb"
      ],
      "name": "Image - Text",
      "settings": {
        "colour_scheme": "base-white-02",
        "section_padding": "--spacing-2xl",
        "enable_reveal": true,
        "reveal_distance": 32,
        "reveal_duration": 760
      }
    },
    "image_text_aYpUjc": {
      "type": "image-text",
      "blocks": {
        "content_qim3KV": {
          "type": "content",
          "settings": {
            "title": "Furncare's Mission",
            "title_size": "xl",
            "text": "Since being founded in 2004, Furncare's focus has been on quality and delivery. It is our mission to support architects and interior designers working on large-scale care home projects so they can develop their ideas knowing they have a robust, creative furniture supplier.\nOur customers know that they can rely on us, time and time again, to help them deliver superb-quality furnishings for their homes and care facilities. If you would like to discuss a project with Furncare, please contact us.",
            "button_style": "primary",
            "button_text": "",
            "button_url": ""
          }
        },
        "images_DmXTEf": {
          "type": "images",
