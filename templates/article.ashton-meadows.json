    "richtext_MbPqHF": {
      "type": "richtext",
      "blocks": {
        "heading_FhVTAz": {
          "type": "heading",
          "settings": {
            "text": "“The care sector has been our life for two decades and we have such a close connection to the area, so this nursing home means so much to us. We’re delighted with the service and value that Furncare have provided and can’t wait to welcome our first residents.”",
            "heading_level": "h2",
            "heading_style": "title-lg"
          },
          "blocks": {}
        },
        "tagline_xjRgwb": {
          "type": "tagline",
          "settings": {
            "content": "Kathy Ragunathan, Ashton Group Director",
            "tagline_style": "body-md"
          },
          "blocks": {}
        },
        "tagline_73JinG": {
          "type": "tagline",
          "name": "Tagline",
          "settings": {
            "content": "<em>Kathy Ragunathan is a chartered accountant and Director of Ashton Group and controlled many of the financial and operational aspects of the new build. Along with her husband Gaj, both are experienced elderly care providers with a growing portfolio of premium care homes in West Sussex and Surrey.</em>",
            "tagline_style": "body-sm"
          },
          "blocks": {}
        }
      },
      "block_order": [
        "heading_FhVTAz",
        "tagline_xjRgwb",
        "tagline_73JinG"
      ],
      "name": "Rich Text",
      "settings": {
        "id_anchor": "",
        "max_width_desktop": 100,
        "section_padding": "--spacing-4xl",
        "text_alignment": "center",
        "colour_scheme": "warm-stone",
        "enable_animation": false,
        "optional_richtext": "",
        "small_container": false,
        "enable_see_more": false,
