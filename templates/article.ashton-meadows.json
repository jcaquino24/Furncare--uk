      }
    },
    "image_text_Rr8iJJ": {
      "type": "image-text",
      "blocks": {
        "images_NXFXtC": {
          "type": "images",
          "settings": {
            "image_one": "shopify://shop_images/Lounge_Two_13.jpg"
          }
        },
        "content_c9CaD6": {
          "type": "content",
          "settings": {
            "title": "",
            "title_size": "xl",
            "text": "The Ashton Group employs around 360 staff across their various sites, including the new Ashton Meadows Nursing Home. Gaj Ragunathan was born in neighbouring Kingston Hospital and attended Tiffin’s Grammar School just a few hundred metres from the new nursing home.\n\n\nAward-winning, multi-disciplined studio, DesignLSM, were commissioned to design the interiors, boasting a glowing reputation of delivering inspiring concepts within the hospitality, leisure and senior living industries over the last 36 years.",
            "button_style": "underline",
            "button_text": "",
            "button_url": ""
          }
        }
      },
      "block_order": [
        "images_NXFXtC",
        "content_c9CaD6"
      ],
      "name": "Image - Text",
      "settings": {
        "colour_scheme": "base-white-01",
        "section_padding": "--spacing-2xl",
        "enable_reveal": true,
        "reveal_distance": 32,
        "reveal_duration": 760
      }
    },
    "richtext_EW6cqY": {
      "type": "richtext",
      "blocks": {
        "heading_C9ihxn": {
          "type": "heading",
          "settings": {
            "text": "“Blending our vast experience in hospitality and senior living design, Ashton Meadows is set to present residents and staff with a beautiful home to enjoy – showcasing a luxurious concept that embodies tranquility, freshness and refinement.”",
            "heading_level": "h2",
            "heading_style": "title-lg"
          },
          "blocks": {}
        },
        "tagline_JPEfFQ": {
          "type": "tagline",
          "settings": {
            "content": "Taryn Kallie, DesignLSM, Interior Designer",
            "tagline_style": "body-md"
          },
          "blocks": {}
        }
      },
      "block_order": [
        "heading_C9ihxn",
        "tagline_JPEfFQ"
      ],
      "name": "Rich Text",
      "settings": {
        "id_anchor": "",
        "max_width_desktop": 100,
        "section_padding": "--spacing-4xl",
        "text_alignment": "center",
        "colour_scheme": "warm-stone",
        "enable_animation": false,
        "optional_richtext": "",
        "small_container": false,
        "enable_see_more": false,
        "see_more_max_height": 400
      }
    },
    "image_text_ACHkic": {
      "type": "image-text",
      "blocks": {
        "content_TRjRpz": {
          "type": "content",
          "settings": {
            "title": "",
            "title_size": "xl",
            "text": "DesignLSM were already developing early concepts for the project when Bincy Mathew of the Ashton Group visited the Brighton Care Show in 2022. Having met Sheldon Southall on the Furncare stand, further meetings were arranged in London and Kingston over the next few months. A Furncare delivery vehicle loaded with sample furniture was taken to the site for first-hand assessment. Final specifications, bespoke upholstery designs, soft furnishings and budgets were then agreed. The final order was placed at the end of 2023, scheduled for spring and summer deliveries in time for an official opening event at the home in June this year.",
            "button_style": "primary",
            "button_text": "",
            "button_url": ""
          }
        },
        "images_Q4GCPV": {
          "type": "images",
          "settings": {
            "image_one": "shopify://shop_images/Bedrooms_11.jpg"
          }
        }
      },
      "block_order": [
        "content_TRjRpz",
        "images_Q4GCPV"
      ],
      "name": "Image - Text",
      "settings": {
        "colour_scheme": "base-white-01",
        "section_padding": "--spacing-2xl",
        "enable_reveal": true,
        "reveal_distance": 32,
        "reveal_duration": 760
      }
    },
    "richtext_znBbzx": {
      "type": "richtext",
      "blocks": {
        "heading_qBVQQe": {
          "type": "heading",
          "settings": {
            "text": "“You can’t beat trying out the furniture itself. Taking actual samples to Kathy and Gaj took all the hassle out of the process for them. Our show van enables us to take furniture from our showroom to customers, no matter where they are in the UK.”",
            "heading_level": "h2",
            "heading_style": "title-md"
          },
          "blocks": {}
        },
        "tagline_DLcG7y": {
          "type": "tagline",
          "settings": {
            "content": "Sheldon Southall, Head of Business Development, Furncare",
            "tagline_style": "body-md"
