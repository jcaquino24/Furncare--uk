    "image_text_zXnynf": {
      "type": "image-text",
      "blocks": {
        "images_Qdr4kx": {
          "type": "images",
          "settings": {
            "image_one": "shopify://shop_images/P1049349_eb211818-047b-45ed-b949-0ceb5363ed4c.jpg"
          }
        },
        "content_bWjPrR": {
          "type": "content",
          "settings": {
            "title": "Our Approach",
            "title_size": "display",
            "text": "When Manor Park Care Home was handed over as a newbuild, the structure was complete, but the character of the home was still to be defined. Our role was to bring that character to life — shaping interiors that support everyday living and balance the practical demands of care with spaces that feel calm, welcoming and familiar.\n<br>\n<br>\nWorking closely with the project team, we delivered a complete FF&E package designed to support wellbeing and daily living across the home. Every element was chosen with comfort, durability and purpose in mind, ensuring bedrooms, lounges and dining spaces function seamlessly while still feeling warm and homely.\n<br>\n<br>\nThrough thoughtful, purposeful solutions, we helped these care environments feel more homely, supportive and uplifting, balancing practical requirements with warmth and familiarity. In doing so, we delivered on our commitment to transforming spaces and elevating lives, shaping environments that support wellbeing, dignity and everyday comfort within care settings.",
            "button_style": "primary",
            "button_text": "",
            "button_url": ""
          }
        }
      },
      "block_order": [
        "images_Qdr4kx",
        "content_bWjPrR"
      ],
      "name": "Image - Text",
      "settings": {
        "colour_scheme": "base-white-01",
        "section_padding": "--spacing-2xl",
        "enable_reveal": true,
        "reveal_distance": 32,
        "reveal_duration": 760
      }
    },
    "image_text_nRYrfd": {
      "type": "image-text",
      "blocks": {
        "content_6rxGTr": {
          "type": "content",
          "settings": {
            "title": "What We Delivered",
            "title_size": "display",
            "text": "<div style=\"white-space: pre-wrap; white-space: pre-line;\">◦ Fully furnished bedrooms, including cabinet furniture, seating, and soft furnishings.\n\n◦ Lounge and dining spaces designed for comfort, social interaction, and ease of movement.\n\n◦ Reception, staff, and office areas fitted out for daily use.\n\n◦ Curtains and drapes adding warmth and style throughout the home.\n\n◦ Finishing touches including artwork, accessories, and even eating utensils to bring Manor Park to life.</div>",
            "button_style": "primary",
            "button_text": "",
            "button_url": ""
          }
        },
        "images_gHUjBg": {
          "type": "images",
          "settings": {
            "image_one": "shopify://shop_images/P1049441_35830580-50e2-4588-8056-275f4c6fe18a.jpg"
          }
        }
      },
      "block_order": [
        "content_6rxGTr",
        "images_gHUjBg"
      ],
      "name": "Image - Text",
      "settings": {
        "colour_scheme": "base-white-01",
        "section_padding": "--spacing-2xl",
        "enable_reveal": true,
        "reveal_distance": 32,
        "reveal_duration": 760
      }
    },
    "image_text_FgCCAX": {
      "type": "image-text",
      "blocks": {
        "images_bkFGjK": {
          "type": "images",
          "settings": {
            "image_one": "shopify://shop_images/P1049337_57e9db70-175a-48b4-9875-c2985e6f8181.jpg"
          }
        },
        "content_ckY3Hk": {
          "type": "content",
          "settings": {
            "title": "Seamless Execution",
            "title_size": "display",
            "text": "From early planning through to final styling, our aim at Manor Park was to create a dementia-friendly environment that felt warm, calm and intuitive to navigate, without ever appearing clinical. Ahead of installation, we supported the client with site visits to previously completed projects alongside a full sampling process, helping shape a consistent look and feel across the 80-bedroom home — from communal areas through to staff offices. Working within a live newbuild meant close coordination with other trades throughout the installation. During installation, a Project Manager and Deputy Project Manager were on site throughout, overseeing a white glove fit-out that saw 5,500 items placed across the home in just 10 days, with zero damages. Our delivery team averaged 17,000 steps per person per day, placing each piece exactly where it was needed. \n<br>\n Beyond furniture supply, we completed the final layers too — installing curtains, artwork and accessories — transforming Manor Park from a blank canvas into a fully functioning, welcoming home ready to receive residents from day one.",
            "button_style": "underline",
            "button_text": "Our Delivery Service",
            "button_url": "shopify://pages/delivery"
          }
        }
      },
      "block_order": [
        "images_bkFGjK",
        "content_ckY3Hk"
      ],
      "name": "Image - Text",
      "settings": {
        "colour_scheme": "base-white-01",
        "section_padding": "--spacing-2xl",
        "enable_reveal": true,
        "reveal_distance": 32,
        "reveal_duration": 760
      }
    },
