      "type": "richtext",
      "blocks": {
        "heading_UzRMmX": {
          "type": "heading",
          "settings": {
            "text": "The newbuild was transformed into a welcoming, homely environment ready to receive residents immediately. The finished interior supports both quality of life and operational efficiency, helping Manor Park set a strong foundation for exceptional care from day one.",
            "heading_level": "h2",
            "heading_style": "title-lg"
          },
          "blocks": {}
        }
