        "heading_C9ihxn": {
          "type": "heading",
          "disabled": true,
          "settings": {
            "text": "“Bright Bay Design’s involvement across the full project process, from initial building design through to final fit-out, enabled us to create a care home that stands out in so many ways, and we were delighted to include Furncare’s specialist furniture which, with their excellent service, helped us realise our and Forest Care’s vision for Elm Lodge.”",
            "heading_level": "h2",
            "heading_style": "title-lg"
          },
          "blocks": {}
        },
        "tagline_JPEfFQ": {
          "type": "tagline",
          "settings": {
            "content": "As this group wanted to provide a touch of luxury, as well as comfort, to the home, all the bedrooms feature a range of woven fabrics along with items from our Liberta Vie collection, including the Dawson bedroom furniture range and also the Loren divan bed base and Alina headboard both in neutral mushroom faux leather.",
            "tagline_style": "body-xl"
          },
          "blocks": {}
