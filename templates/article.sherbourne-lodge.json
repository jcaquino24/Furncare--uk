    "richtext_EW6cqY": {
      "type": "richtext",
      "blocks": {
        "heading_C9ihxn": {
          "type": "heading",
          "settings": {
            "text": "“We were determined to apply the same premium standards to Sherbourne Lodge as in our luxury boutique hotels. The user experience is everything to us, and Furncare were instrumental in helping us to create our first fantastic premium care environment for our residents.”",
            "heading_level": "h2",
            "heading_style": "title-lg"
          },
          "blocks": {}
        },
        "tagline_JPEfFQ": {
