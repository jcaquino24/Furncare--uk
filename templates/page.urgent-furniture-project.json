    "faqs_dhnxRC": {
      "type": "faqs",
      "blocks": {
        "faq_CwmHFc": {
          "type": "faq",
          "settings": {
            "question": "How quickly can you deliver?",
            "answer": "<p>Delivery times can vary depending on the products you need, quantities, finishes and delivery location. Our standard terms state a minimum lead time of 1 - 5 working days, however, If you have an urgent requirement, our team can help you understand what may be available sooner and guide you towards suitable options.</p>"
          }
        },
        "faq_DdVAmr": {
          "type": "faq",
          "settings": {
            "question": "What types of care home furniture are available for quicker delivery?",
            "answer": "<p>This can vary, but we hold a range of bedroom furniture, care home chairs, dining furniture, occasional furniture and soft furnishings in stock.</p>"
          }
        },
        "faq_NNbnEP": {
          "type": "faq",
          "settings": {
            "question": "Can you support larger urgent requirements?",
            "answer": "<p>Yes, depending on availability and project details. If you need furniture for multiple rooms, several spaces or a wider care home requirement, we can review what is possible and help you plan a practical route forward.</p>"
          }
        },
        "faq_6fk6pT": {
          "type": "faq",
          "settings": {
            "question": "Can I request a quote for quick delivery furniture?",
            "answer": "<p>Yes. Share your requirements, quantities, location and timeline, and our team can advise on suitable furniture options and provide a quote where possible.</p>"
          }
        },
        "faq_dQBXCQ": {
          "type": "faq",
          "settings": {
            "question": "Are quick delivery options suitable for all care environments?",
            "answer": "<p>Yes. Our quick delivery range includes furniture for a wide span of specialist environments, including care homes, later living settings, challenging environments and extreme mental health spaces.</p>"
          }
        }
      },
