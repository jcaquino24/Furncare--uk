    "review_blocks_AJT339": {
      "type": "review-blocks",
      "blocks": {
        "review_zYHwj3": {
          "type": "review",
          "settings": {
            "rating": 5,
            "headline": "met our expectations and more",
            "body": "I have recently purchased furniture for a care home where durability and is a key factor as well as being easy to clean, the furniture met our expectations and more and the sales rep Declan was a delight to work with. Big thumbs up from me and we will be coming back for more.",
            "reviewer_name": "Jamie",
            "meta": ""
          }
        },
        "review_zDQnj7": {
          "type": "review",
          "settings": {
            "rating": 5,
            "headline": "excellent communication",
            "body": "Furncare were a delight to deal with start to finish, offering site visits to previously completed projects, design support and excellent communication throughout. The physical fit out went well, and the aftercare has been second to none.",
            "reviewer_name": "Gareth Rogers",
            "meta": ""
          }
        },
        "review_hhtPwH": {
          "type": "review",
          "settings": {
            "rating": 5,
            "headline": "Amazing",
            "body": "This is our second order with Furncare and there is a reason we picked them again. The customer service is fantastic. The delivery driver even built the furniture for us. Highly recommend",
            "reviewer_name": "Elmbrook Court",
            "meta": ""
          }
        },
        "review_GnX8p6": {
          "type": "review",
          "settings": {
            "rating": 5,
            "headline": "Great Furniture, Great Service!",
            "body": "The quality of the furniture excellent, delivery times are fast. The products were unpacked, assembled in the rooms of our choosing in a professional and timely manner, with the packaging removed too.",
            "reviewer_name": "Silver Birch Care",
            "meta": ""
          }
        },
        "review_NgEpzj": {
          "type": "review",
          "settings": {
            "rating": 5,
            "headline": "Thank you!",
            "body": "They delivered carefully and unpacked all the items and disposed of all the packaging. A very big thank you for moving an old piece of furniture for me. It’s that personal touch and helpfulness that makes all the difference.",
            "reviewer_name": "Bill Woolliscroft",
            "meta": ""
          }
        },
        "review_cdLCMi": {
          "type": "review",
          "settings": {
            "rating": 5,
            "headline": "5/5 experience",
            "body": "Ian and Ollie were great at supporting delivering the furniture in the home and assembling this straight away! Friendly, kind and considerate of residents in the home. Thankyou!",
            "reviewer_name": "Ces",
            "meta": ""
          }
        },
        "review_qPxryt": {
          "type": "review",
          "settings": {
            "rating": 5,
            "headline": "Furncare Have been amazing",
            "body": "Furncare have been amazing in supporting us to furnish our 3-bed childrens home. The quality of the furniture is great and the communication between Declan and us has been amazing. I would highly recommend this company",
            "reviewer_name": "Damini Rura",
            "meta": ""
          }
        },
        "review_jeUyLA": {
          "type": "review",
          "settings": {
            "rating": 5,
            "headline": "Furncare came to the rescue!",
            "body": "Furncare came to the rescue with an express delivery for bespoke furniture for one of our services! They assembled on delivery which was also a huge help and we're impressed with the quality of the furniture. Thanks Furncare, you never fail to assist when needed. We'll be ordering again soon :)",
            "reviewer_name": "Emma",
            "meta": ""
          }
        }
      },
