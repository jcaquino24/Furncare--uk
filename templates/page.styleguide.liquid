<div class="styleguide container">
  <table class="styleguide__table">
    <thead>
      <tr class="styleguide__table-row">
        <td class="styleguide__table-item">Typography</td>
        <td class="styleguide__table-item">Example</td>
        <td class="styleguide__table-item">Class</td>
      </tr>
    </thead>

    <tbody>
      <!-- Headings -->
      <tr class="styleguide__table-row">
        <td class="styleguide__table-item">Display Title</td>
        <td class="styleguide__table-item">
          <div class="title-display">Display Title</div>
        </td>
        <td class="styleguide__table-item"><code>.title-display</code></td>
      </tr>

      <tr class="styleguide__table-row">
        <td class="styleguide__table-item">Heading 1 / Title XL</td>
        <td class="styleguide__table-item">
          <h1 class="title-xl">Heading 1</h1>
        </td>
        <td class="styleguide__table-item"><code>h1, .title-xl</code></td>
      </tr>

      <tr class="styleguide__table-row">
        <td class="styleguide__table-item">Heading 2 / Title LG</td>
        <td class="styleguide__table-item">
          <h2 class="title-lg">Heading 2</h2>
        </td>
        <td class="styleguide__table-item"><code>h2, .title-lg</code></td>
      </tr>

      <tr class="styleguide__table-row">
        <td class="styleguide__table-item">Heading 3 / Title MD</td>
        <td class="styleguide__table-item">
          <h3 class="title-md">Heading 3</h3>
        </td>
        <td class="styleguide__table-item"><code>h3, .title-md</code></td>
      </tr>

      <tr class="styleguide__table-row">
        <td class="styleguide__table-item">Heading 4 / Title SM</td>
        <td class="styleguide__table-item">
          <h4 class="title-sm">Heading 4</h4>
        </td>
        <td class="styleguide__table-item"><code>h4, .title-sm</code></td>
      </tr>

      <tr class="styleguide__table-row">
        <td class="styleguide__table-item">Heading 5 / Title XS</td>
        <td class="styleguide__table-item">
          <h5 class="title-xs">Heading 5</h5>
        </td>
        <td class="styleguide__table-item"><code>h5, .title-xs</code></td>
      </tr>

      <tr class="styleguide__table-row">
        <td class="styleguide__table-item">Heading 6 / Title 2XS</td>
        <td class="styleguide__table-item">
          <h6 class="title-2xs">Heading 6</h6>
        </td>
        <td class="styleguide__table-item"><code>h6, .title-2xs</code></td>
      </tr>

      <!-- Body Text -->
      <tr class="styleguide__table-row">
        <td class="styleguide__table-item">Body XL</td>
        <td class="styleguide__table-item">
          <div class="body-xl">Body text extra large</div>
          <div class="body-xl body-xl--bold">Body text extra large bold</div>
        </td>
        <td class="styleguide__table-item">
          <code>.body-xl, .body-xl--bold</code>
        </td>
      </tr>

      <tr class="styleguide__table-row">
        <td class="styleguide__table-item">Body LG</td>
        <td class="styleguide__table-item">
          <div class="body-lg">Body text large</div>
          <div class="body-lg body-lg--bold">Body text large bold</div>
        </td>
        <td class="styleguide__table-item">
          <code>.body-lg, .body-lg--bold</code>
        </td>
      </tr>

      <tr class="styleguide__table-row">
        <td class="styleguide__table-item">Body MD (Default)</td>
        <td class="styleguide__table-item">
          <div class="body-md">Body text medium (default paragraph)</div>
          <div class="body-md body-md--bold">Body text medium bold</div>
        </td>
        <td class="styleguide__table-item">
          <code>p, .body-md, .body-md--bold</code>
        </td>
      </tr>

      <tr class="styleguide__table-row">
        <td class="styleguide__table-item">Body SM</td>
        <td class="styleguide__table-item">
          <div class="body-sm">Body text small</div>
          <div class="body-sm body-sm--bold">Body text small bold</div>
        </td>
        <td class="styleguide__table-item">
          <code>.body-sm, .body-sm--bold</code>
        </td>
      </tr>

      <tr class="styleguide__table-row">
        <td class="styleguide__table-item">Body XS</td>
        <td class="styleguide__table-item">
          <div class="body-xs">Body text extra small</div>
          <div class="body-xs body-xs--bold">Body text extra small bold</div>
        </td>
        <td class="styleguide__table-item">
          <code>.body-xs, .body-xs--bold</code>
        </td>
      </tr>

      <!-- Eyebrow Text -->
      <tr class="styleguide__table-row">
        <td class="styleguide__table-item">Eyebrow MD</td>
        <td class="styleguide__table-item">
          <div class="eyebrow-md">Eyebrow Medium</div>
          <div class="eyebrow-md eyebrow-md--bold">Eyebrow Medium Bold</div>
        </td>
        <td class="styleguide__table-item">
          <code>.eyebrow-md, .eyebrow-md--bold</code>
        </td>
      </tr>

      <tr class="styleguide__table-row">
        <td class="styleguide__table-item">Eyebrow SM</td>
        <td class="styleguide__table-item">
          <div class="eyebrow-sm">Eyebrow Small</div>
          <div class="eyebrow-sm eyebrow-sm--bold">Eyebrow Small Bold</div>
        </td>
        <td class="styleguide__table-item">
          <code>.eyebrow-sm, .eyebrow-sm--bold</code>
        </td>
      </tr>

      <tr class="styleguide__table-row">
        <td class="styleguide__table-item">Eyebrow XS</td>
        <td class="styleguide__table-item">
          <div class="eyebrow-xs">Eyebrow Extra Small</div>
          <div class="eyebrow-xs eyebrow-xs--bold">
            Eyebrow Extra Small Bold
          </div>
        </td>
        <td class="styleguide__table-item">
          <code>.eyebrow-xs, .eyebrow-xs--bold</code>
        </td>
      </tr>

      <tr class="styleguide__table-row">
        <td class="styleguide__table-item">Eyebrow 2XS</td>
        <td class="styleguide__table-item">
          <div class="eyebrow-2xs">Eyebrow 2X Small</div>
          <div class="eyebrow-2xs eyebrow-2xs--bold">Eyebrow 2X Small Bold</div>
        </td>
        <td class="styleguide__table-item">
          <code>.eyebrow-2xs, .eyebrow-2xs--bold</code>
        </td>
      </tr>

      {% comment %} Button Text {% endcomment %}
      <tr class="styleguide__table-row">
        <td class="styleguide__table-item">Button MD</td>
        <td class="styleguide__table-item">
          <div class="button--md">Button Medium</div>
        </td>
        <td class="styleguide__table-item"><code>.button-md</code></td>
      </tr>

      <tr class="styleguide__table-row">
        <td class="styleguide__table-item">Button SM</td>
        <td class="styleguide__table-item">
          <div class="button--sm">Button Small</div>
        </td>
        <td class="styleguide__table-item"><code>.button-sm</code></td>
      </tr>

      <tr class="styleguide__table-row">
        <td class="styleguide__table-item">Button XS</td>
        <td class="styleguide__table-item">
          <div class="button--xs">Button Extra Small</div>
        </td>
        <td class="styleguide__table-item"><code>.button-xs</code></td>
      </tr>
    </tbody>
  </table>

  {% comment %}
    Buttons
  {% endcomment %}
  <table class="styleguide__table">
    <thead>
      <tr class="styleguide__table-row">
        <td class="styleguide__table-item"></td>
        <td class="styleguide__table-item">Default, hover, active</td>
        <td class="styleguide__table-item">Disabled</td>
      </tr>
    </thead>

    <tbody>
      <tr class="styleguide__table-row">
        <td class="styleguide__table-item">Primary</td>

        <td class="styleguide__table-item">
          {% render 'button', style: 'primary', label: 'Primary' %}
        </td>

        <td class="styleguide__table-item">
          {% render 'button',
            style: 'primary',
            label: 'Primary',
            attributes: 'disabled'
          %}
        </td>
      </tr>

      <tr class="styleguide__table-row">
        <td class="styleguide__table-item">Primary with Icon</td>

        <td class="styleguide__table-item">
          {% render 'button',
            style: 'primary',
            label: 'Primary Icon',
            icon: 'cart'
          %}
        </td>

        <td class="styleguide__table-item">
          {% render 'button',
            style: 'primary',
            label: 'Primary Icon',
            attributes: 'disabled',
            icon: 'cart'
          %}
        </td>
      </tr>

      <tr class="styleguide__table-row">
        <td class="styleguide__table-item">Primary Icon only</td>

        <td class="styleguide__table-item">
          {% render 'button',
            style: 'primary',
            icon_only: true,
            label: 'Primary Icon only',
            icon: 'cart'
          %}
        </td>

        <td class="styleguide__table-item">
          {% render 'button',
            style: 'primary',
            icon_only: true,
            label: 'Primary Icon only',
            attributes: 'disabled',
            icon: 'cart'
          %}
        </td>
      </tr>

      <tr class="styleguide__table-row">
        <td class="styleguide__table-item">Secondary</td>

        <td class="styleguide__table-item">
          {% render 'button', style: 'secondary', label: 'Secondary' %}
        </td>

        <td class="styleguide__table-item">
          {% render 'button',
            style: 'secondary',
            label: 'Secondary',
            attributes: 'disabled'
          %}
        </td>
      </tr>

      <tr class="styleguide__table-row">
        <td class="styleguide__table-item">Secondary with Icon</td>

        <td class="styleguide__table-item">
          {% render 'button',
            style: 'secondary',
            label: 'Secondary Icon',
            icon: 'cart'
          %}
        </td>

        <td class="styleguide__table-item">
          {% render 'button',
            style: 'secondary',
            label: 'Secondary Icon',
            attributes: 'disabled',
            icon: 'cart'
          %}
        </td>
      </tr>

      <tr class="styleguide__table-row">
        <td class="styleguide__table-item">Secondary Icon only</td>

        <td class="styleguide__table-item">
          {% render 'button',
            style: 'secondary',
            icon_only: true,
            label: 'Secondary Icon only',
            icon: 'cart'
          %}
        </td>

        <td class="styleguide__table-item">
          {% render 'button',
            style: 'secondary',
            icon_only: true,
            label: 'Secondary Icon only',
            attributes: 'disabled',
            icon: 'cart'
          %}
        </td>
      </tr>

      <tr class="styleguide__table-row">
        <td class="styleguide__table-item">Underline</td>

        <td class="styleguide__table-item">
          {% render 'button', style: 'underline', label: 'Underline' %}
        </td>

        <td class="styleguide__table-item">
          {% render 'button',
            style: 'underline',
            label: 'Underline',
            attributes: 'disabled'
          %}
        </td>
      </tr>

      <tr class="styleguide__table-row">
        <td class="styleguide__table-item">Underline Icon</td>

        <td class="styleguide__table-item">
          {% render 'button',
            style: 'underline',
            label: 'Underline Icon',
            icon: 'arrow-right'
          %}
        </td>

        <td class="styleguide__table-item">
          {% render 'button',
            style: 'underline',
            label: 'Underline Icon',
            attributes: 'disabled',
            icon: 'arrow-right'
          %}
        </td>
      </tr>
    </tbody>
  </table>

  {% comment %}
    Form elements
  {% endcomment %}
  <table class="styleguide__table">
    <thead>
      <tr class="styleguide__table-row">
        <td class="styleguide__table-item"></td>
        <td class="styleguide__table-item">Default, hover, active</td>
        <td class="styleguide__table-item">Disabled</td>
      </tr>
    </thead>

    <tbody>
      <tr class="styleguide__table-row">
        <td class="styleguide__table-item">Checkbox</td>

        <td class="styleguide__table-item">
          {% render 'input-checkbox',
            id: '123',
            name: 'default-checkbox',
            value: 'test'
          %}
        </td>

        <td class="styleguide__table-item">
          {% render 'input-checkbox',
            id: '321',
            name: 'disabled-checkbox',
            value: 'test',
            attributes: 'disabled'
          %}
        </td>
      </tr>

      <tr class="styleguide__table-row">
        <td class="styleguide__table-item">Radio</td>

        <td class="styleguide__table-item">
          <div style="display: flex; align-items: center; gap: 1rem;">
            {% render 'input-radio',
              id: '132',
              name: 'default-radio',
              value: 'test'
            %}

            {% render 'input-radio',
              id: '132-1',
              name: 'default-radio',
              value: 'test-1'
            %}
          </div>
        </td>

        <td class="styleguide__table-item">
          {% render 'input-radio',
            id: '231',
            name: 'disabled-radio',
            value: 'test',
            attributes: 'disabled'
          %}
        </td>
      </tr>

      <tr class="styleguide__table-row">
        <td class="styleguide__table-item">Switch</td>

        <td class="styleguide__table-item">
          {% render 'input-switch',
            id: 'switch',
            name: 'default-switch',
            value: 'test'
          %}
        </td>

        <td class="styleguide__table-item">
          {% render 'input-switch',
            id: 'switch-disabled',
            name: 'disabled-switch',
            value: 'test',
            attributes: 'disabled'
          %}
        </td>
      </tr>

      <tr class="styleguide__table-row">
        <td class="styleguide__table-item">Input</td>

        <td class="styleguide__table-item">
          <div style="display: flex; flex-direction: column; gap: 1rem;">
            {% render 'input-field',
              id: 'input',
              name: 'default-input',
              help_text: 'Default',
              placeholder: 'Placeholder',
              label: 'Label'
            %}

            {% render 'input-field',
              id: 'input',
              name: 'default-input',
              help_text: 'Error',
              placeholder: 'Enter invalid email for error state',
              label: 'Label',
              value: 'na@me@example.com',
              input_type: 'email',
              error: 'Invalid email address'
            %}
          </div>
        </td>

        <td class="styleguide__table-item">
          {% render 'input-field',
            id: 'input-disabled',
            name: 'disabled-input',
            label: 'Label',
            help_text: 'Disabled',
            attributes: 'disabled'
          %}
        </td>
      </tr>

      <tr class="styleguide__table-row">
        <td class="styleguide__table-item">Textarea</td>

        <td class="styleguide__table-item">
          {% render 'input-field',
            id: 'textarea',
            name: 'default-textarea',
            input_type: 'textarea',
            help_text: 'Default',
            placeholder: 'Placeholder',
            label: 'Label'
          %}
        </td>

        <td class="styleguide__table-item">
          {% render 'input-field',
            id: 'textarea-disabled',
            name: 'disabled-textarea',
            input_type: 'textarea',
            label: 'Label',
            help_text: 'Disabled',
            attributes: 'disabled'
          %}
        </td>
      </tr>

      <tr class="styleguide__table-row">
        <td class="styleguide__table-item">Select</td>

        {%- capture country_options -%}
          <button
            type="button"
            js-input-select="option"
            class="input-select__option body-md"
            role="option"
            aria-selected="false"
            data-value="US"
            data-default
          >
            United States
          </button>

          <button
            type="button"
            js-input-select="option"
            class="input-select__option body-md"
            role="option"
            aria-selected="false"
            data-value="CA"
          >
            Canada
          </button>

          <button
            type="button"
            js-input-select="option"
            class="input-select__option body-md"
            role="option"
            aria-selected="false"
            data-value="GB"
          >
            United Kingdom
          </button>
        {%- endcapture -%}

        <td class="styleguide__table-item">
          {% render 'input-select',
            id: 'country-select',
            name: 'properties[country]',
            label: 'Select Country',
            help_text: 'Choose your shipping country',
            options: country_options
          %}
        </td>

        <td class="styleguide__table-item">
          {% render 'input-select',
            id: 'country-select',
            name: 'properties[country]',
            label: 'Select Country',
            help_text: 'Disabled',
            options: country_options,
            dropdown_class: 'is-disabled'
          %}
        </td>
      </tr>

      <tr class="styleguide__table-row">
        <td class="styleguide__table-item">Slider</td>

        <td class="styleguide__table-item">
          {% render 'input-slider',
            id: 'slider',
            label: 'Slider',
            help_text: 'Description',
            min: 0,
            max: 100,
            value: '25 - 70',
            value_prefix: '$'
          %}
        </td>

        <td class="styleguide__table-item">
          {% render 'input-slider',
            id: 'slider',
            label: 'Slider',
            help_text: 'Disabled',
            min: 0,
            max: 100,
            value: '25 - 70',
            value_prefix: '$',
            disabled: true
          %}
        </td>
      </tr>

      <tr class="styleguide__table-row">
        <td class="styleguide__table-item">Search</td>

        <td class="styleguide__table-item">
          <form action="{{ routes.search_url }}" method="get">
            {% render 'input-search',
              id: 'header-search',
              placeholder: 'Search',
              in_form: true,
              name: 'products'
            %}
          </form>
        </td>

        <td class="styleguide__table-item"></td>
      </tr>

      <tr class="styleguide__table-row">
        <td class="styleguide__table-item">Breadcrumbs</td>

        <td class="styleguide__table-item">
          <form action="{{ routes.search_url }}" method="get">
            {% render 'breadcrumbs' %}
          </form>
        </td>

        <td class="styleguide__table-item"></td>
      </tr>

      <tr class="styleguide__table-row">
        <td class="styleguide__table-item">Accordions</td>

        <td class="styleguide__table-item">
          {% render 'accordion',
            title: 'Accordion',
            content: 'Lorem ipsum dolor sit amet consectetur, adipisicing elit. Error, nobis.'
          %}
        </td>

        <td class="styleguide__table-item"></td>
      </tr>

      <tr class="styleguide__table-row">
        <td class="styleguide__table-item">Swatch</td>

        <td class="styleguide__table-item">
          <div style="display: flex; align-items: center; gap: 1rem;">
            {% render 'color-swatch',
              id: 'dsa',
              name: 'product-swatch',
              color: 'blue',
              value: 'test'
            %}

            {% render 'color-swatch',
              id: 'asd',
              name: 'product-swatch',
              color: 'red',
              value: 'test-1'
            %}
          </div>
        </td>

        <td class="styleguide__table-item">
          <div>
            {% render 'color-swatch',
              id: 'das',
              name: 'product-swatch',
              color: 'red',
              value: 'test-12',
              attributes: 'disabled'
            %}
          </div>
        </td>
      </tr>

      <tr class="styleguide__table-row">
        <td class="styleguide__table-item">Quantity selector</td>

        <td class="styleguide__table-item">
          {% render 'quantity-selector', value: 1 %}
        </td>

        <td class="styleguide__table-item">
          {% render 'quantity-selector', value: 1, is_disabled: true %}
        </td>
      </tr>

      <tr class="styleguide__table-row">
        <td class="styleguide__table-item">Badge</td>

        <td class="styleguide__table-item">
          <div style="display: flex; align-items: center; gap: 1rem;">
            {% render 'badge', text: 'Badge' %}

            {% render 'badge', text: 'Badge', icon: 'tag' %}
          </div>
        </td>

        <td class="styleguide__table-item"></td>
      </tr>
    </tbody>
  </table>
</div>
