        "content_68CTk6": {
          "type": "content",
          "disabled": true,
          "settings": {
            "title": "Every Detail Matters",
            "title_size": "display",
            "text": "Designed to suit high-end interiors, the Grayson range is a unique solid wood dining table range, exclusive to Furncare. Available in a choice of sizes, each table features a beautifully crafted solid wood top with a refined under-chamfered edge, enhancing its elegant, contemporary profile. Choose from two distinctive pedestal base options: the straight cross base offers a classic, timeless aesthetic, while the thicker curved base presents a more contemporary interpretation, with sculpted lines that create a lighter, more open silhouette. Combining elegant design with exceptional stability, the curved base delivers a premium statement piece for today's interiors.\n<br><br>",
            "button_style": "primary",
            "button_text": "View the range",
            "button_action": "link",
            "button_url": "https://www.furncare.co.uk/products/ryker-large-sideboard"
          }
        }
