    "furncare_case_study_eU7UHK": {
      "type": "furncare-case-study",
      "blocks": {
        "case_9Ejkmw": {
          "type": "case",
          "settings": {
            "tab_label": "Letcombe Regis",
            "kicker": "CASE STUDIES",
            "title": "Letcombe Regis",
            "copy": "Letcombe Regis brings together dementia, nursing and respite care within Bupa’s Richmond Villages setting in the Oxfordshire countryside. Designed by Vogue Living, the home includes private ensuite bedrooms alongside premium shared spaces such as a swimming pool, gym, restaurant, licensed bar, library, lounges and accessible grounds. <br>\n<br>\nFurncare supplied furniture and upholstery across the scheme, with pieces chosen to sit naturally within Vogue Living’s warm, opulent interior style. The upholstery colours were carefully paired with the furniture shapes and finishes, helping each bedroom, lounge and shared area feel coordinated, comfortable and in keeping with the premium feel of Richmond Villages Letcombe Regis.",
            "metric_1": "",
            "metric_label_1": "",
            "metric_2": "",
            "metric_label_2": "",
            "metric_3": "",
            "metric_label_3": "",
            "metric_4": "",
            "metric_label_4": "",
            "image": "shopify://shop_images/Untitled_-_June_18_2026_at_08.20.35_1_5dc2ba04-6c4f-4e88-91e8-e33cfd868774.png",
            "quote": "",
            "source": "",
            "metrics_layout": "repeat(2, 1fr)",
            "reverse_layout": false
          }
        },
        "case_x33G3z": {
          "type": "case",
          "settings": {
            "tab_label": "The Chestnuts",
            "kicker": "CASE STUDY",
            "title": "The Chestnuts",
            "copy": "The Chestnuts’ latest extension added eleven new bedrooms, a luxury lounge and dining room, and a spacious new reception area, continuing a relationship with Furncare that first began back in 2016. For this phase, the team worked closely with owner Arnas Mauremootoo and deputy manager Stacey to shape the interior themes, fabrics and finishes, using the Liberta Vie Grandios and Remini ranges alongside Karsson cabinetry. With calm neutral upholstery, rust-toned accents and a carefully scheduled installation to align with building works, the finished spaces feel warm, coordinated and ready for residents to settle into.",
            "metric_1": "",
            "metric_label_1": "",
            "metric_2": "",
            "metric_label_2": "",
            "metric_3": "",
            "metric_label_3": "",
            "metric_4": "",
            "metric_label_4": "",
            "image": "shopify://shop_images/Lounge_12_of_53.jpg",
            "quote": "“You’ve managed to really understand what we are after and have transformed our thoughts into something really special.”",
            "source": "Arnas Mauremootoo, Owner",
            "metrics_layout": "repeat(2, 1fr)",
            "reverse_layout": false
          }
        }
      },
