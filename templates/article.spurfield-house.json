    },
    "image_text_nRYrfd": {
      "type": "image-text",
      "blocks": {
        "content_6rxGTr": {
          "type": "content",
          "settings": {
            "title": "Bedrooms that support everyday living",
            "title_size": "display",
            "text": "Bedroom furniture supplied by Furncare was used throughout the accommodation, creating spaces that feel comfortable and personal while meeting the practical demands of a complex care setting.\n<br>\n<br>\nFor residents, bedrooms are more than somewhere to sleep. They provide an important private space within the home, particularly within an environment designed to help individuals develop confidence, establish routines and progress at their own pace.\n<br>\n<br>\nThe furniture was therefore selected to balance durability and practicality with a softer, more residential aesthetic, complementing Spurfield House's modern approach to care.",
            "button_style": "primary",
            "button_text": "",
            "button_action": "link",
            "button_url": ""
          }
        },
        "images_gHUjBg": {
          "type": "images",
