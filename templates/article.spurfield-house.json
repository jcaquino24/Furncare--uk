    "image_text_FgCCAX": {
      "type": "image-text",
      "blocks": {
        "images_bkFGjK": {
          "type": "images",
          "settings": {
            "image_one": "shopify://shop_images/mh-dining-107.jpg"
          }
        },
        "content_ckY3Hk": {
          "type": "content",
          "settings": {
            "title": "Creating communal spaces",
            "title_size": "display",
            "text": "Alongside the bedrooms, Furncare supplied dining furniture for the communal areas.\n<br>\n<br>\nShared dining spaces form an important part of daily life at Spurfield House, providing somewhere for residents to eat, spend time together and develop everyday skills within a supportive environment.\n<br>\n<br>\nThe dining furniture helps create welcoming, functional spaces suited to regular use, while sitting comfortably within the wider interior scheme.",
            "button_style": "underline",
            "button_text": "",
            "button_action": "link",
            "button_url": "shopify://pages/delivery"
          }
        }
      },
