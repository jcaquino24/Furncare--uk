    "image_text_zXnynf": {
      "type": "image-text",
      "blocks": {
        "images_Qdr4kx": {
          "type": "images",
          "settings": {
            "image_one": "shopify://shop_images/donkey-117.jpg"
          }
        },
        "content_bWjPrR": {
          "type": "content",
          "settings": {
            "title": "A home designed around different needs",
            "title_size": "display",
            "text": "Spurfield House combines a restored Grade II listed building with purpose-built accommodation, creating 24 bedrooms across three distinct areas.\n<br>\n<br>\nThe Main House retains the character of the original building, with a combination of bedrooms and shared communal spaces, while Meadow Wing provides fully accessible accommodation for individuals with higher physical support needs.\n<br>\n<br>\nOrchard Wing takes a more independent approach, with self-contained studio apartments designed to give residents greater autonomy while maintaining access to support when needed.\n<br>\n<br>\nAt the centre of the development sits a landscaped courtyard, connecting the different areas of the home and creating an inviting outdoor space.\n<br>\n<br>\nWith each area serving a different purpose, the furniture needed to work across a varied environment while contributing to a consistent, considered feel throughout the development.",
            "button_style": "primary",
            "button_text": "",
            "button_action": "link",
            "button_url": ""
          }
        }
      },
      "block_order": [
        "images_Qdr4kx",
        "content_bWjPrR"
      ],
