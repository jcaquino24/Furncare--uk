    "image_text_jMhbQd": {
      "type": "image-text",
      "blocks": {
        "content_rqMaM4": {
          "type": "content",
          "settings": {
            "title": "More than a traditional care environment",
            "title_size": "display",
            "text": "Throughout Spurfield House, the focus extends beyond providing a safe place to live.\n\nDedicated areas including The Nest, a social hub; The Hive, an activity and learning space; and The Nook, a quieter setting for reflection and support, give residents opportunities to engage with daily life in different ways.\n<br>\n<br>\nCombined with its landscaped courtyard and close connection to the wider Exminster community, the result is an environment designed to support each individual as they build confidence and move towards greater independence.\n<br>\n<br>\nFor Furncare, the project was about supplying furniture that complemented that vision: practical enough for the demands of complex care, while helping Spurfield House feel considered, contemporary and welcoming.",
            "button_style": "underline",
            "button_text": "",
            "button_action": "link",
            "button_url": "shopify://pages/delivery"
          }
        },
        "images_QGgj9d": {
