  {
    "name": "Fonts",
    "settings": [
      {
        "type": "header",
        "content": "Site fonts"
      },
      {
        "type": "font_picker",
        "id": "type_body_font",
        "default": "red_hat_display_n4",
        "label": "Body Font",
        "info": "Select a font for body and content text"
      }
    ]
  },
  {
    "name": "Product",
    "settings": [
      {
        "type": "image_picker",
        "id": "delivered_within_icon",
        "label": "Delivered within icon"
      }
    ]
  },
  {
    "name": "Instant Search",
    "settings": [
      {
        "type": "text",
        "id": "search_suggestions",
        "label": "Search suggestions",
        "default": "Angus Medium Back 2 Seater Sofa, Darius 3 Seater Sofa, Gino Tub Chair",
        "info": "Comma separated list of terms to show as suggestions in the search results"
      },
      {
        "type": "text",
        "id": "search_popular_searches",
        "label": "Popular searches",
        "default": "Dining Chair, 2 Seater Sofa, Table, Cabinet Furniture",
        "info": "Comma separated list of terms to show as popular searches in the search results"
      },
      {
        "type": "checkbox",
        "id": "instant_search_allow_suggestions",
        "label": "Allow suggestions in results",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "instant_search_allow_collections",
        "label": "Allow collections in results",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "instant_search_allow_pages",
        "label": "Allow pages in results",
        "default": true
      }
    ]
  },
