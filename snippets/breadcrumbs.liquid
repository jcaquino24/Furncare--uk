{% liquid
  assign show_home = show_home | default: true, allow_false: true

  # Same portal-company check used in the product section
  assign portal_company_names = settings.portal_company_name | default: 'Furncare Test' | split: ','
  assign current_company_name = customer.current_company.name | downcase | strip
  assign is_portal_company = false
  if request.design_mode
    assign is_portal_company = true
  else
    for portal_company_name in portal_company_names
      assign normalized_company_name = portal_company_name | downcase | strip
      if current_company_name != blank and current_company_name == normalized_company_name
        assign is_portal_company = true
        break
      endif
    endfor
  endif
%}

<nav class="breadcrumbs" role="navigation" aria-label="breadcrumbs">
  <ol class="breadcrumbs__list">
    {% if show_home %}
      <li class="breadcrumbs__item">
        <a class="breadcrumbs__link eyebrow-2xs" href="/">Home</a>
      </li>
    {% endif %}

    {%- case template.name -%}
      {%- when 'page' -%}
        <li class="breadcrumbs__item">
          {% render 'icons', icon: 'chevron-right' %}

          <a
            class="breadcrumbs__link eyebrow-2xs"
            href="{{ page.url }}"
            aria-current="page"
          >
            {{- page.title -}}
          </a>
        </li>
      {%- when 'product' -%}
        {%- liquid
          assign custom_breadcrumbs = product.metafields.custom.breadcrumbs.value
        -%}

        {%- if custom_breadcrumbs != blank -%}
          {%- comment -%} Render custom breadcrumbs from metaobjects {%- endcomment -%}
          {%- for breadcrumb_item in custom_breadcrumbs -%}
            <li class="breadcrumbs__item eyebrow-2xs">
              {% render 'icons', icon: 'chevron-right' %}

              <a
                class="breadcrumbs__link eyebrow-2xs"
                href="{{ breadcrumb_item.url }}"
              >
                {{- breadcrumb_item.text -}}
              </a>
            </li>
          {%- endfor -%}
        {%- else -%}
          {%- comment -%} Fallback to collection if no custom breadcrumbs {%- endcomment -%}
          {%- if collection.url -%}
            <li class="breadcrumbs__item eyebrow-2xs">
              {% render 'icons', icon: 'chevron-right' %}

              {{
                collection.title
                | link_to: collection.url,
                  class: 'breadcrumbs__link eyebrow-2xs'
              }}
            </li>
          {%- endif -%}
        {%- endif -%}

        {%- comment -%} Always show product name as last item {%- endcomment -%}
        <li class="breadcrumbs__item eyebrow-2xs">
          {% render 'icons', icon: 'chevron-right' %}

          <a
            class="breadcrumbs__link eyebrow-2xs"
            href="{{ product.url | split: '?' | first }}"
            aria-current="page"
          >
            {{- product.title | split: '|' | first -}}
          </a>
        </li>
      {%- when 'collection' -%}
        {%- if current_tags -%}
          <li class="breadcrumbs__item">
            {% render 'icons', icon: 'chevron-right' %}

            {{ collection.title | link_to: collection.url }}
          </li>
          <li class="breadcrumbs__item">
            {% render 'icons', icon: 'chevron-right' %}

            {%- capture tag_url -%}{{ collection.url }}/{{ current_tags | join: "+" }}{%- endcapture -%}
            <a
              class="breadcrumbs__link eyebrow-2xs"
              href="{{ tag_url }}"
              aria-current="page"
            >
              {{- current_tags | join: ' + ' -}}
            </a>
          </li>
        {%- else -%}
          <li class="breadcrumbs__item">
            {% render 'icons', icon: 'chevron-right' %}

            <a
              class="breadcrumbs__link eyebrow-2xs"
              href="{{ collection.url }}"
              aria-current="page"
            >
              {{- collection.title -}}
            </a>
          </li>
        {%- endif -%}
      {%- when 'blog' -%}
        {%- if current_tags -%}
          <li class="breadcrumbs__item">
            {% render 'icons', icon: 'chevron-right' %}

            {{ blog.title | link_to: blog.url }}
          </li>
          <li class="breadcrumbs__item">
            {% render 'icons', icon: 'chevron-right' %}

            {%- capture tag_url -%}{{ blog.url }}/tagged/{{ current_tags | join: "+" }}{%- endcapture -%}
            <a
              class="breadcrumbs__link eyebrow-2xs"
              href="{{ tag_url }}"
              aria-current="page"
            >
              {{- current_tags | join: ' + ' -}}
            </a>
          </li>

        {%- else -%}
          <li class="breadcrumbs__item">
            {% render 'icons', icon: 'chevron-right' %}

            <a
              class="breadcrumbs__link eyebrow-2xs"
              href="{{ blog.url }}"
              aria-current="page"
            >
              {{- blog.title -}}
            </a>
          </li>
        {%- endif -%}
      {%- when 'article' -%}
        <li class="breadcrumbs__item">
          {% render 'icons', icon: 'chevron-right' %}

          <a
            class="breadcrumbs__link eyebrow-2xs"
            href="{{ blog.url }}"
            aria-current="page"
            >Blog</a
          >
        </li>

        <li class="breadcrumbs__item">
          {% render 'icons', icon: 'chevron-right' %}

          <span>{{ article.title }}</span>
        </li>
      {%- else -%}
        <li class="breadcrumbs__item">
          {% render 'icons', icon: 'chevron-right' %}

          <a
            class="breadcrumbs__link eyebrow-2xs"
            href="{{ request.path }}"
            aria-current="page"
          >
            {{- page_title -}}
          </a>
        </li>
    {%- endcase -%}
  </ol>
</nav>

{%- comment -%}
  Remember where the visitor came from, so the product page can show it.

  1) On collection and page templates, store the current page (url + title)
     for this browser tab only (sessionStorage).
  2) On the product page, for portal companies only, if the visitor really
     arrived from that stored page (checked with document.referrer), replace
     the middle breadcrumb(s) with it:  Home > [portal page] > Product.
     Anyone else, and anyone arriving from anywhere else (search, direct link,
     bookmark), keeps the normal breadcrumbs above.
{%- endcomment -%}
{%- if template.name == 'collection' or template.name == 'page' -%}
  {%- assign origin_title = collection.title | default: page.title -%}
  {%- assign origin_url = collection.url | default: page.url -%}
  <script>
    try {
      sessionStorage.setItem(
        'breadcrumbOrigin',
        JSON.stringify({ url: {{ origin_url | json }}, title: {{ origin_title | json }} })
      );
    } catch (e) {}
  </script>
{%- elsif template.name == 'product' and is_portal_company -%}
  <script>
    (function () {
      try {
        var nav = document.currentScript.previousElementSibling;
        var list = nav && nav.querySelector('.breadcrumbs__list');
        var raw = sessionStorage.getItem('breadcrumbOrigin');
        if (!list || !raw || !document.referrer) return;

        var origin = JSON.parse(raw);
        var ref = new URL(document.referrer);
        if (ref.origin !== location.origin || ref.pathname !== origin.url) return;

        var items = Array.prototype.slice.call(list.querySelectorAll('.breadcrumbs__item'));
        var last = items[items.length - 1];
        if (!last) return;

        // Remove everything between Home (the item without a chevron) and the product
        items.forEach(function (item, index) {
          var isHome = index === 0 && !item.querySelector('svg');
          if (item !== last && !isHome) item.remove();
        });

        var li = document.createElement('li');
        li.className = 'breadcrumbs__item eyebrow-2xs';

        var icon = last.querySelector('svg');
        if (icon) li.appendChild(icon.cloneNode(true));

        var link = document.createElement('a');
        link.className = 'breadcrumbs__link eyebrow-2xs';
        link.href = origin.url;
        link.textContent = origin.title;
        li.appendChild(link);

        list.insertBefore(li, last);
      } catch (e) {}
    })();
  </script>
{%- endif -%}