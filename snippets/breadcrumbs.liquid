{% liquid
  assign show_home = show_home | default: true, allow_false: true

%}

<nav class="breadcrumbs" role="navigation" aria-label="breadcrumbs">
  <ol class="breadcrumbs__list">
    {% if show_home %}
      <li class="breadcrumbs__item">
        <a class="breadcrumbs__link eyebrow-2xs" href="/">Home</a>
      </li>
    {% endif %}

    {%- case template.name -%}
      {%- when 'page' -%}
        <li class="breadcrumbs__item">
          {% render 'icons', icon: 'chevron-right' %}

          <a
            class="breadcrumbs__link eyebrow-2xs"
            href="{{ page.url }}"
            aria-current="page"
          >
            {{- page.title -}}
          </a>
        </li>
      {%- when 'product' -%}
        {%- liquid
          assign custom_breadcrumbs = product.metafields.custom.breadcrumbs.value
        -%}

        {%- if custom_breadcrumbs != blank -%}
          {%- comment -%} Render custom breadcrumbs from metaobjects {%- endcomment -%}
          {%- for breadcrumb_item in custom_breadcrumbs -%}
            <li class="breadcrumbs__item eyebrow-2xs">
              {% render 'icons', icon: 'chevron-right' %}

              <a
                class="breadcrumbs__link eyebrow-2xs"
                href="{{ breadcrumb_item.url }}"
              >
                {{- breadcrumb_item.text -}}
              </a>
            </li>
          {%- endfor -%}
        {%- else -%}
          {%- comment -%} Fallback to collection if no custom breadcrumbs {%- endcomment -%}
          {%- if collection.url -%}
            <li class="breadcrumbs__item eyebrow-2xs">
              {% render 'icons', icon: 'chevron-right' %}

              {{
                collection.title
                | link_to: collection.url,
                  class: 'breadcrumbs__link eyebrow-2xs'
              }}
            </li>
          {%- endif -%}
        {%- endif -%}

        {%- comment -%} Always show product name as last item {%- endcomment -%}
        <li class="breadcrumbs__item eyebrow-2xs">
          {% render 'icons', icon: 'chevron-right' %}

          <a
            class="breadcrumbs__link eyebrow-2xs"
            href="{{ product.url | split: '?' | first }}"
            aria-current="page"
          >
            {{- product.title | split: '|' | first -}}
          </a>
        </li>
      {%- when 'collection' -%}
        {%- if current_tags -%}
          <li class="breadcrumbs__item">
            {% render 'icons', icon: 'chevron-right' %}

            {{ collection.title | link_to: collection.url }}
          </li>
          <li class="breadcrumbs__item">
            {% render 'icons', icon: 'chevron-right' %}

            {%- capture tag_url -%}{{ collection.url }}/{{ current_tags | join: "+" }}{%- endcapture -%}
            <a
              class="breadcrumbs__link eyebrow-2xs"
              href="{{ tag_url }}"
              aria-current="page"
            >
              {{- current_tags | join: ' + ' -}}
            </a>
          </li>
        {%- else -%}
          <li class="breadcrumbs__item">
            {% render 'icons', icon: 'chevron-right' %}

            <a
              class="breadcrumbs__link eyebrow-2xs"
              href="{{ collection.url }}"
              aria-current="page"
            >
              {{- collection.title -}}
            </a>
          </li>
        {%- endif -%}
      {%- when 'blog' -%}
        {%- if current_tags -%}
          <li class="breadcrumbs__item">
            {% render 'icons', icon: 'chevron-right' %}

            {{ blog.title | link_to: blog.url }}
          </li>
          <li class="breadcrumbs__item">
            {% render 'icons', icon: 'chevron-right' %}

            {%- capture tag_url -%}{{ blog.url }}/tagged/{{ current_tags | join: "+" }}{%- endcapture -%}
            <a
              class="breadcrumbs__link eyebrow-2xs"
              href="{{ tag_url }}"
              aria-current="page"
            >
              {{- current_tags | join: ' + ' -}}
            </a>
          </li>

        {%- else -%}
          <li class="breadcrumbs__item">
            {% render 'icons', icon: 'chevron-right' %}

            <a
              class="breadcrumbs__link eyebrow-2xs"
              href="{{ blog.url }}"
              aria-current="page"
            >
              {{- blog.title -}}
            </a>
          </li>
        {%- endif -%}
      {%- when 'article' -%}
        <li class="breadcrumbs__item">
          {% render 'icons', icon: 'chevron-right' %}

          <a
            class="breadcrumbs__link eyebrow-2xs"
            href="{{ blog.url }}"
            aria-current="page"
            >Blog</a
          >
        </li>

        <li class="breadcrumbs__item">
          {% render 'icons', icon: 'chevron-right' %}

          <span>{{ article.title }}</span>
        </li>
      {%- else -%}
        <li class="breadcrumbs__item">
          {% render 'icons', icon: 'chevron-right' %}

          <a
            class="breadcrumbs__link eyebrow-2xs"
            href="{{ request.path }}"
            aria-current="page"
          >
            {{- page_title -}}
          </a>
        </li>
    {%- endcase -%}
  </ol>
</nav>

{%- comment -%}
  Portal breadcrumbs.

  When a visitor reaches a product from a page or collection of this store
  (e.g. the portal landing page), the first crumb "Home" becomes a fixed label
  linking back to that page, instead of showing the page's own title
  (for example "Welcome, <name>"):

    All Catalogs > [category] > Product

  [category] is whatever the product page already shows (custom breadcrumbs
  metafield, or the collection in the URL). If there is none, the product's
  first collection is used. Search, bookmarks, other sites and the home page
  keep the normal breadcrumbs.
{%- endcomment -%}
{%- if template.name == 'product' -%}
  {%- liquid
    assign portal_root_label = 'All Catalogs'
    assign fallback_title = ''
    assign fallback_url = ''
    for product_collection in product.collections
      unless product_collection.handle == 'all' or product_collection.handle == 'frontpage'
        assign fallback_title = product_collection.title
        assign fallback_url = product_collection.url
        break
      endunless
    endfor
  -%}
  <script>
    (function () {
      var ROOT_LABEL = {{ portal_root_label | json }};
      var FALLBACK_TITLE = {{ fallback_title | json }};
      var FALLBACK_URL = {{ fallback_url | json }};

      function run() {
        try {
          // Look the list up each time: the swatch component replaces the
          // breadcrumbs markup when the visitor switches product.
          var list = document.querySelector('.breadcrumbs__list');
          if (!list || list.dataset.originApplied || !document.referrer) return;

          var ref = new URL(document.referrer);
          if (ref.origin !== location.origin) return;
          if (!/\/(pages|collections)\//.test(ref.pathname) || ref.pathname.indexOf('/products/') !== -1) return;

          var items = Array.prototype.slice.call(list.querySelectorAll('.breadcrumbs__item'));
          var home = items[0];
          var last = items[items.length - 1];
          if (!home || !last || home === last || home.querySelector('svg')) return;

          var homeLink = home.querySelector('a');
          if (!homeLink) return;
          homeLink.textContent = ROOT_LABEL;
          homeLink.href = ref.pathname;

          var middle = items.slice(1, -1);

          // Drop a leading duplicate of the root label (e.g. already in the metafield)
          if (middle.length && (middle[0].textContent || '').trim().toLowerCase() === ROOT_LABEL.toLowerCase()) {
            middle[0].remove();
            middle.shift();
          }

          // No category shown yet: use the product's collection
          if (!middle.length && FALLBACK_TITLE && FALLBACK_URL) {
            var li = document.createElement('li');
            li.className = 'breadcrumbs__item eyebrow-2xs';

            var icon = last.querySelector('svg');
            if (icon) li.appendChild(icon.cloneNode(true));

            var link = document.createElement('a');
            link.className = 'breadcrumbs__link eyebrow-2xs';
            link.href = FALLBACK_URL;
            link.textContent = FALLBACK_TITLE;
            li.appendChild(link);

            list.insertBefore(li, last);
          }

          list.dataset.originApplied = 'true';
        } catch (e) {}
      }

      run();

      // The swatch component swaps products without a page load and then fires this event.
      window.addEventListener('product:changed', run);
    })();
  </script>
{%- endif -%}