{% liquid
  assign show_home = show_home | default: true, allow_false: true

%}

<nav class="breadcrumbs" role="navigation" aria-label="breadcrumbs">
  <ol class="breadcrumbs__list">
    {% if show_home %}
      <li class="breadcrumbs__item">
        <a class="breadcrumbs__link eyebrow-2xs" href="/">Home</a>
      </li>
    {% endif %}

    {%- case template.name -%}
      {%- when 'page' -%}
        <li class="breadcrumbs__item">
          {% render 'icons', icon: 'chevron-right' %}

          <a
            class="breadcrumbs__link eyebrow-2xs"
            href="{{ page.url }}"
            aria-current="page"
          >
            {{- page.title -}}
          </a>
        </li>
      {%- when 'product' -%}
        {%- liquid
          assign custom_breadcrumbs = product.metafields.custom.breadcrumbs.value
        -%}

        {%- if custom_breadcrumbs != blank -%}
          {%- comment -%} Render custom breadcrumbs from metaobjects {%- endcomment -%}
          {%- for breadcrumb_item in custom_breadcrumbs -%}
            <li class="breadcrumbs__item eyebrow-2xs">
              {% render 'icons', icon: 'chevron-right' %}

              <a
                class="breadcrumbs__link eyebrow-2xs"
                href="{{ breadcrumb_item.url }}"
              >
                {{- breadcrumb_item.text -}}
              </a>
            </li>
          {%- endfor -%}
        {%- else -%}
          {%- comment -%} Fallback to collection if no custom breadcrumbs {%- endcomment -%}
          {%- if collection.url -%}
            <li class="breadcrumbs__item eyebrow-2xs">
              {% render 'icons', icon: 'chevron-right' %}

              {{
                collection.title
                | link_to: collection.url,
                  class: 'breadcrumbs__link eyebrow-2xs'
              }}
            </li>
          {%- endif -%}
        {%- endif -%}

        {%- comment -%} Always show product name as last item {%- endcomment -%}
        <li class="breadcrumbs__item eyebrow-2xs">
          {% render 'icons', icon: 'chevron-right' %}

          <a
            class="breadcrumbs__link eyebrow-2xs"
            href="{{ product.url | split: '?' | first }}"
            aria-current="page"
          >
            {{- product.title | split: '|' | first -}}
          </a>
        </li>
      {%- when 'collection' -%}
        {%- if current_tags -%}
          <li class="breadcrumbs__item">
            {% render 'icons', icon: 'chevron-right' %}

            {{ collection.title | link_to: collection.url }}
          </li>
          <li class="breadcrumbs__item">
            {% render 'icons', icon: 'chevron-right' %}

            {%- capture tag_url -%}{{ collection.url }}/{{ current_tags | join: "+" }}{%- endcapture -%}
            <a
              class="breadcrumbs__link eyebrow-2xs"
              href="{{ tag_url }}"
              aria-current="page"
            >
              {{- current_tags | join: ' + ' -}}
            </a>
          </li>
        {%- else -%}
          <li class="breadcrumbs__item">
            {% render 'icons', icon: 'chevron-right' %}

            <a
              class="breadcrumbs__link eyebrow-2xs"
              href="{{ collection.url }}"
              aria-current="page"
            >
              {{- collection.title -}}
            </a>
          </li>
        {%- endif -%}
      {%- when 'blog' -%}
        {%- if current_tags -%}
          <li class="breadcrumbs__item">
            {% render 'icons', icon: 'chevron-right' %}

            {{ blog.title | link_to: blog.url }}
          </li>
          <li class="breadcrumbs__item">
            {% render 'icons', icon: 'chevron-right' %}

            {%- capture tag_url -%}{{ blog.url }}/tagged/{{ current_tags | join: "+" }}{%- endcapture -%}
            <a
              class="breadcrumbs__link eyebrow-2xs"
              href="{{ tag_url }}"
              aria-current="page"
            >
              {{- current_tags | join: ' + ' -}}
            </a>
          </li>

        {%- else -%}
          <li class="breadcrumbs__item">
            {% render 'icons', icon: 'chevron-right' %}

            <a
              class="breadcrumbs__link eyebrow-2xs"
              href="{{ blog.url }}"
              aria-current="page"
            >
              {{- blog.title -}}
            </a>
          </li>
        {%- endif -%}
      {%- when 'article' -%}
        <li class="breadcrumbs__item">
          {% render 'icons', icon: 'chevron-right' %}

          <a
            class="breadcrumbs__link eyebrow-2xs"
            href="{{ blog.url }}"
            aria-current="page"
            >Blog</a
          >
        </li>

        <li class="breadcrumbs__item">
          {% render 'icons', icon: 'chevron-right' %}

          <span>{{ article.title }}</span>
        </li>
      {%- else -%}
        <li class="breadcrumbs__item">
          {% render 'icons', icon: 'chevron-right' %}

          <a
            class="breadcrumbs__link eyebrow-2xs"
            href="{{ request.path }}"
            aria-current="page"
          >
            {{- page_title -}}
          </a>
        </li>
    {%- endcase -%}
  </ol>
</nav>

{%- comment -%}
  Show the page the visitor came from in the product breadcrumbs.

  On the product page, if the visitor arrived from a page or collection on this
  store (document.referrer), the middle of the trail is replaced with it:
    Home > [page they came from] > Product

  The title comes from sessionStorage when the previous page rendered this
  snippet, otherwise it is read from the previous page itself (so portal
  templates that do not render breadcrumbs still work). Arrivals from search,
  bookmarks, other sites or the home page keep the normal breadcrumbs.
{%- endcomment -%}
{%- if template.name == 'collection' or template.name == 'page' -%}
  {%- assign origin_title = collection.title | default: page.title -%}
  {%- assign origin_url = collection.url | default: page.url -%}
  <script>
    try {
      sessionStorage.setItem(
        'breadcrumbOrigin',
        JSON.stringify({ url: {{ origin_url | json }}, title: {{ origin_title | json }} })
      );
    } catch (e) {}
  </script>
{%- elsif template.name == 'product' -%}
  <script>
    (function () {
      var cachedTitle = null;

      function run() {
        try {
          // Look the list up each time: the swatch component replaces the
          // breadcrumbs markup when the visitor switches product.
          var list = document.querySelector('.breadcrumbs__list');
          if (!list || list.dataset.originApplied || !document.referrer) return;

          var ref = new URL(document.referrer);
          if (ref.origin !== location.origin) return;
          if (!/\/(pages|collections)\//.test(ref.pathname) || ref.pathname.indexOf('/products/') !== -1) return;

          function apply(title) {
            var current = document.querySelector('.breadcrumbs__list');
            if (!current || current.dataset.originApplied || !title) return;

            var items = Array.prototype.slice.call(current.querySelectorAll('.breadcrumbs__item'));
            var last = items[items.length - 1];
            if (!last) return;

            // Remove everything between Home (the item without a chevron) and the product
            items.forEach(function (item, index) {
              var isHome = index === 0 && !item.querySelector('svg');
              if (item !== last && !isHome) item.remove();
            });

            var li = document.createElement('li');
            li.className = 'breadcrumbs__item eyebrow-2xs';

            var icon = last.querySelector('svg');
            if (icon) li.appendChild(icon.cloneNode(true));

            var link = document.createElement('a');
            link.className = 'breadcrumbs__link eyebrow-2xs';
            link.href = ref.pathname;
            link.textContent = title;
            li.appendChild(link);

            current.insertBefore(li, last);
            current.dataset.originApplied = 'true';
          }

          if (cachedTitle) {
            apply(cachedTitle);
            return;
          }

          var stored = null;
          try { stored = JSON.parse(sessionStorage.getItem('breadcrumbOrigin') || 'null'); } catch (e) {}
          if (stored && stored.url === ref.pathname && stored.title) {
            cachedTitle = stored.title;
            apply(cachedTitle);
            return;
          }

          // Previous page did not store its title: read it from the page itself
          fetch(ref.pathname, { credentials: 'same-origin' })
            .then(function (response) { return response.ok ? response.text() : ''; })
            .then(function (html) {
              if (!html) return;
              var doc = new DOMParser().parseFromString(html, 'text/html');
              var heading = doc.querySelector('main h1, #MainContent h1') || doc.querySelector('h1');
              cachedTitle = (heading && heading.textContent.trim()) || (doc.title || '').split(/\s[–|-]\s/)[0].trim();
              apply(cachedTitle);
            })
            .catch(function () {});
        } catch (e) {}
      }

      run();

      // The swatch component swaps products without a page load and then fires this event.
      window.addEventListener('product:changed', run);
    })();
  </script>
{%- endif -%}