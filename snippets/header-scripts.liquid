<script>
  (function () {
    function extractSearchIconMarkup(suggestionsResults) {
      const firstSuggestion = suggestionsResults.querySelector('a');

      if (!firstSuggestion) return '';

      const clone = firstSuggestion.cloneNode(true);
      const textNode = clone.querySelector('span');

      if (textNode) {
        textNode.remove();
      } else {
        clone.textContent = '';
      }

      return clone.innerHTML.trim();
    }

    function collectProductSuggestions(productsResults) {
      const cards = productsResults.querySelectorAll('.product-card');
      const results = [];

      cards.forEach(function (card) {
        const titleLink = card.querySelector('.product-card__title a');

        if (!titleLink) return;

        const title = (titleLink.textContent || '').trim();
        const href = titleLink.getAttribute('href') || '';

        if (!title || !href) return;

        const exists = results.some(function (item) {
          return item.title.toLowerCase() === title.toLowerCase();
        });

        if (!exists) {
          results.push({ title: title, href: href });
        }
      });

      return results;
    }

    function syncSuggestionsWithProductCards(root) {
      const productsResults = root.querySelector(
        "[js-instant-search='products'] .instant-search-results__results"
      );
      const suggestionsResults = root.querySelector(
        "[js-instant-search='suggestions'] .instant-search-results__results"
      );

      if (!productsResults || !suggestionsResults) return;

      const productSuggestions = collectProductSuggestions(productsResults);

      if (!productSuggestions.length) return;

      const iconMarkup = extractSearchIconMarkup(suggestionsResults);

      suggestionsResults.replaceChildren();

      productSuggestions.slice(0, 3).forEach(function (item) {
        const anchor = document.createElement('a');
        const titleSpan = document.createElement('span');

        anchor.href = item.href;
        anchor.className = 'instant-search-results__result button button--text';
        anchor.setAttribute('data-suggestion-text', item.title);

        if (iconMarkup) {
          anchor.insertAdjacentHTML('beforeend', iconMarkup);
        }

        titleSpan.textContent = item.title;
        anchor.appendChild(titleSpan);
        suggestionsResults.appendChild(anchor);
      });
    }

    function setupSearchRoot(root) {
      if (!root || root.dataset.furncareSearchSync === 'true') return;

      const productsResults = root.querySelector(
        "[js-instant-search='products'] .instant-search-results__results"
      );

      if (!productsResults) return;

      root.dataset.furncareSearchSync = 'true';

      const observer = new MutationObserver(function () {
        syncSuggestionsWithProductCards(root);
      });

      observer.observe(productsResults, { childList: true, subtree: true });

      const searchInput = root.querySelector("[js-search-input='input']");
      if (searchInput) {
        searchInput.addEventListener('input', function () {
          window.setTimeout(function () {
            syncSuggestionsWithProductCards(root);
          }, 380);
        });
      }

      syncSuggestionsWithProductCards(root);
    }

    function initSearchSuggestionSync() {
      document.querySelectorAll('uwp-search-input').forEach(setupSearchRoot);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initSearchSuggestionSync);
    } else {
      initSearchSuggestionSync();
    }
  })();
</script>