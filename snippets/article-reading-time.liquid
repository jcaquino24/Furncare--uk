<span class="reading-time" title="Estimated read time">
  {% liquid
    assign article_words = content | strip_html | split: ' ' | size
    assign article_reading_time = article_words | divided_by: 180 | round
    if article_reading_time < 2
      echo 'blogs.article.one_min_read' | t
    else
      echo 'blogs.article.min_read' | t: content: article_reading_time
    endif
  %}
</span>
