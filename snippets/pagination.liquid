{%- if paginate.pages > 1 -%}
  <nav class="pagination" role="navigation">
    <ol class="pagination__list">
      {%- if paginate.previous -%}
        <li class="pagination__item--arrow">
          <a
            href="{{ paginate.previous.url }}"
            class="pagination__link button button--icon-only button--secondary"
          >
            {% render 'icons', icon: 'arrow-left' %}
          </a>
        </li>

      {%- else -%}
        <li class="pagination__item--arrow disabled">
          <span class="button--icon-only button button--secondary">
            {% render 'icons', icon: 'arrow-left' %}
          </span>
        </li>
      {%- endif -%}

      {%- for part in paginate.parts -%}
        {%- if part.is_link -%}
          <li class="pagination__item">
            <a href="{{ part.url }}" class="pagination__link body-md">
              {{ part.title }}
            </a>
          </li>

        {%- else -%}
          {%- if part.title == paginate.current_page -%}
            <li class="pagination__item body-md is-active" aria-current="page">
              {{ part.title }}
            </li>

          {%- else -%}
            <li class="pagination__item body-md">
              {{ part.title }}
            </li>
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}

      {%- if paginate.next -%}
        <li class="pagination__item--arrow">
          <a
            href="{{ paginate.next.url }}"
            class="pagination__link button button--icon-only button--secondary"
            aria-label="{{ 'blogs.accessibility.next_page' | t }}"
          >
            {% render 'icons', icon: 'arrow-right' %}
          </a>
        </li>

      {%- else -%}
        <li class="pagination__item--arrow disabled">
          <span class="button--icon-only button button--secondary">
            {% render 'icons', icon: 'arrow-right' %}
          </span>
        </li>
      {%- endif -%}
    </ol>
  </nav>
{% endif %}
