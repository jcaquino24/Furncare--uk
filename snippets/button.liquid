{% doc %}
  A reusable button component with different states, styles and sizes.
  This component can be used as a button or a link, depending on the provided parameters.

  @param {string} label - The button text
  @param {string} [size] - Optional size of the button (xs, sm, md)
  @param {string} [style] - Optional style of the button (primary, secondary, underline, custom)
  @param {string} [link] - Optional URL to link to
  @param {string} [target] - Optional target for the link (e.g., _blank)
  @param {boolean} [new_tab] - Opens the link in a new tab when set to true
  @param {number} [button_font_size] - Optional font size in px for the custom button style
  @param {string} [button_font_color] - Optional font color for the custom button style
  @param {string} [button_background] - Optional background for the custom button style
  @param {string} [button_border_color] - Optional border color for the custom button style
  @param {number} [button_border_width] - Optional border width in px for the custom button style
  @param {number} [button_padding] - Optional padding in px for the custom button style
  @param {string} [icon] - Optional icon to display, refer to icons.liquid snippet and pass in the icon name only
  @param {boolean} [icon_only] - Toggle to show only the icon without text. A label is still required for accessibility. Only for primary and secondary styles.
  @param {string} [button_type] - Optional button type (button, submit, reset)
  @param {string} [attributes] - Optional HTML additional attributes for the button. Capture value in Liquid if it needs to be dynamic
  @param {string} [class] - Optional additional classes for the button
  @param {string} [scheme] - Optional colour scheme for the button (base-white-01, base-white-02, warm-stone, green-01, green-02)

  @example
  {% render 'button', label: 'Button', style: 'primary', size: 'md', icon: 'arrow-right', scheme: 'green-01' %}
{% enddoc %}

{%- liquid
  if label == blank
    continue
  endif

  if scheme == blank
    assign scheme = section.settings.colour_scheme
  endif
  
  if scheme contains 'green'
    assign scheme_class = 'dark'
  endif

  if class contains 'button--light'
    assign scheme_class = 'light'
  endif

  assign element = 'button'

  assign size = size | default: 'md'
  assign icon_only = icon_only | default: false
  assign style = style | default: 'primary'
  assign target = target | default: null
  assign icon = icon | default: null
  assign button_type = button_type | default: 'button'
  assign button_font_size = button_font_size | default: 16
  assign button_font_color = button_font_color | default: 'var(--color-text-primary, #111111)'
  assign button_background = button_background | default: 'transparent'
  assign button_border_color = button_border_color | default: 'transparent'
  assign button_border_width = button_border_width | default: 1
  assign button_padding = button_padding | default: 12

  if link != blank
    assign element = 'a'
  endif

  if new_tab == true and target == blank and link != blank
    assign target = '_blank'
  endif

  if icon != blank and icon_only == false and style == 'underline'
    assign class = class | append: ' button--underline-with-svg'
  endif
-%}

{%- assign custom_styles = blank -%}
{%- if style == 'custom' -%}
  {%- assign custom_styles = 'font-size: ' | append: button_font_size | append: 'px; color: ' | append: button_font_color | append: '; background: ' | append: button_background | append: '; border: ' | append: button_border_width | append: 'px solid ' | append: button_border_color | append: '; padding: ' | append: button_padding | append: 'px;' -%}
{%- endif -%}

<{{ element }}
  class="button button--{{ style }}{% if scheme_class != blank %} button--{{ scheme_class }}{% endif %} button--{{ size }}{% if style == 'custom' %} button--custom{% endif %}{% if icon_only %} button--icon-only{% endif %} {{ class }}"
  {%- if element == 'a' -%}
    href="{{- link -}}"
    {%- if target -%}
      target="{{- target -}}"
    {%- endif -%}
  {%- else -%}
    type="{{- button_type -}}"
  {%- endif -%}
  {%- if icon_only -%}
    aria-label="{{- label -}}"
  {%- endif -%}
  {%- if custom_styles != blank -%}
    style="{{- custom_styles -}}"
  {%- endif -%}
  {{- attributes -}}
>
  {%- unless icon_only -%}
    {{- label -}}
  {%- endunless -%}

  {%- if icon -%}
    {%- render 'icons', icon: icon -%}
  {%- endif -%}
</{{ element }}>
