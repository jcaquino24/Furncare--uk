{% liquid
  assign element = 'div'
  if link != blank
    assign element = 'a'
  endif
  
  assign overlay_classes = 'content-block-item__content--overlay-' | append: gradient_overlay

  if image_mobile == blank
    assign image_mobile = image
  endif

  if video_mobile == blank
    assign video_mobile = video
  endif

  assign rich_styles = ''

  if richtext_font_size != blank
    assign rich_styles = rich_styles | append: 'font-size:' | append: richtext_font_size | append: ';'
  endif

  if richtext_font_weight != blank
    assign rich_styles = rich_styles | append: 'font-weight:' | append: richtext_font_weight | append: ';'
  endif

  if richtext_color != blank
    assign rich_styles = rich_styles | append: 'color:' | append: richtext_color | append: ';'
  endif

  if richtext_letter_spacing != blank and richtext_letter_spacing != 'normal'
    assign rich_styles = rich_styles | append: 'letter-spacing:' | append: richtext_letter_spacing | append: ';'
  endif

  if richtext_text_transform != blank and richtext_text_transform != 'none'
    assign rich_styles = rich_styles | append: 'text-transform:' | append: richtext_text_transform | append: ';'
  endif


%}

<{{ element }}
  class="content-block-item "
  {% if link != blank %}href="{{ link }}"{% endif %}
  data-image-index="{{ image_index }}"
>
  <div class="content-block-item__image">
    {% if image != blank %}
      {{ image | image_url: width: 1100, height: 664 | image_tag: class: 'content-block-item__image-desktop hide-on-mobile' }}
      {% if image_mobile != blank %}
        {{ image_mobile | image_url: width: 400, height: 500 | image_tag: class: 'content-block-item__image-mobile hide-on-desktop' }}
      {% endif %}
    {% else %}
      {% render 'placeholder-image', aspect_ratio: 1 %}
    {% endif %}
  </div>

  {% if video != blank %}
    <div class="content-block-item__video">
      {{ video | video_tag: width: 1100, height: 664, class: 'content-block-item__video-desktop hide-on-mobile', muted }}
      {% if video_mobile != blank %}
        {{ video_mobile | video_tag: width: 400, height: 500, class: 'content-block-item__video-mobile hide-on-desktop', muted }}
      {% endif %}
    </div>
  {% endif %}

  {% if text != blank or richtext != blank %}
    <div class="content-block-item__content {{ overlay_classes }}">
      {% if text != blank %}
        <p class="content-block-item__title title-xs">{{ text }}
          {% if link != blank %}
            <span class="content-block-item__link button button--primary button--icon-only">
              {% render 'icons', icon: 'arrow-right' %}
            </span>
          {% endif %}
        </p>
      {% endif %}

      {% if richtext != blank %}
        <div class="content-block-item__richtext rte" {% if rich_styles != blank %}style="{{ rich_styles }}"{% endif %}>{{ richtext }}</div>
      {% endif %}
    </div>
  {% endif %}
</{{ element }}> 

<style>
.content-block-item__richtext,
.content-block-item__richtext * {
  color: inherit;
  font-size: inherit;
  font-weight: inherit;
  text-transform: inherit;
  letter-spacing: inherit;
}

</style>