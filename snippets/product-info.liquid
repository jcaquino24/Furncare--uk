{% doc %}
  Product Information Component

  Renders complete product information including badges, title, price, description, USPs, and form.

  @param {product} product - Product object (required)
  @param {string} section_id - Section ID for unique form IDs
  @param {section} section - Section object for accessing settings

  @example
  {% render 'product-info', product: product, section_id: section.id, section: section %}
{% enddoc %}

{%- liquid
  assign section_id = section_id | default: 'product'
-%}

<div class="product-info">
  {% comment %} Badges {% endcomment %}
  {% render 'badge', product: product %}

  {% if section.settings.show_sku and product.selected_or_first_available_variant.sku != blank %}
    <div class="product-info__sku eyebrow-2xs">
      {{ 'product.product_sku' | t }}: {{ product.selected_or_first_available_variant.sku }}
    </div>
  {% endif %}

  {% comment %} Title {% endcomment %}
  {% if product.title %}
    <h1 class="product-info__title title-sm">
      {{ product.title | split: '|' | first }}
    </h1>
  {% endif %}

  {% comment %} Price {% endcomment %}
  {%- assign has_swatch_collections = product.metafields.custom.swatch_collections.value -%}
  {% if section.settings.show_price %}
    {% render 'price',
      product: product,
      use_variant: true,
      show_compare_at_price: true,
      show_vat_badge: section.settings.show_vat_badge,
      show_free_sample_label: section.settings.show_free_sample_label,
      force_from_price: has_swatch_collections
    %}
  {% endif %}

  {% comment %} Description {% endcomment %}
  {% if product.description != blank %}
    <div class="product-info__description-wrapper">
      <div
        class="product-info__description body-md rte"
        js-product-info="description"
      >
        {{ product.description }}
      </div>
    </div>
  {% endif %}

  

  {% comment %} Product Swatch Information - Show if hubspot_form exists and not bespoke {% endcomment %}
  {% liquid
    assign has_hubspot_form = false
    assign is_bespoke = false

    if product.metafields.custom.hubspot_form != blank
      assign has_hubspot_form = true
    endif

    if product.metafields.custom.is_bespoke_product.value == true
      assign is_bespoke = true
    endif
  %}

  {% if has_hubspot_form
    and is_bespoke == false
    and section.settings.product_swatch_information != blank
  %}
    <div class="product-info__swatch-information body-sm body-sm--bold rte">
      {{ section.settings.product_swatch_information }}
    </div>
  {% endif %}
  
{% if section.settings.show_call_to_action %}
  {% comment %} Lead time {% endcomment %}

  {% if product.metafields.custom.delivered_within.value != blank %}
    <div class="delivered-within">
    
    {% if section.settings.lead_time_icon != blank %}
      <div>

        <img src="{{ section.settings.lead_time_icon | image_url: width: 40 }}" 
          alt="Delivery Icon" 
          loading="lazy"
          width=""
          height="" 
        >

      </div>
    {% endif %}

    <div class="eyebrow-2xs">
      {{  section.settings.lead_time_text }} {{ product.metafields.custom.delivered_within.value }}
    </div>

    </div>
  {% endif %}


{%- for block in section.blocks -%}
{%- case block.type -%}
{%- when 'cross_sell' %}
{% render 'product-cross-sell', product: product, block: block, section: section.id %}
{%- endcase -%}
{%- endfor -%}

  {% comment %} End of lead time code {% endcomment %}

  {% comment %} Product Form {% endcomment %}
    {% unless product.template_suffix == 'no-price' %}
      {% render 'product-form', product: product, section_id: section_id, section: section %}
      
    {% endunless %}
{% endif %}

{% if customer %}  {% if customer.id == 11696191635792 or customer.id == 11063103160656 %}
<button
  id="mprfq-quote-{{ product.id }}"
  product-handle="{{ product.handle }}"
  class="mprfq-add-to-quote-button-pdp mprfq-btn-hidden"
  type="button"
  onclick="
    this.disabled = true;
    this.setAttribute('loading', 'true');
    document.dispatchEvent(new CustomEvent('mprfq:rfq_add_product_to_quote', {
      detail: {
        buttonId: this.id,
        productHandle: this.getAttribute('product-handle'),
        variantPriceHidden: false,
        eligibleVariantIds: []
      }
    }));
  "
>
  Add to Quote
</button>
{% endif %}
{% endif %}

  {% comment %} USPs {% endcomment %}
  {% render 'product-usp', product: product %}

   {% unless product.template_suffix == 'no-price' %}
    {% comment %} Action Buttons {% endcomment %}
    <uwp-product-actions
      role="region"
      aria-label="Product actions"
      aria-roledescription="region"
    >
      {% render 'product-actions', product: product, section: section %}
    </uwp-product-actions>
  {% endunless %}
    
  
</div>
