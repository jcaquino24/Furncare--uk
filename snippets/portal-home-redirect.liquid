{%- comment -%} Sends portal company members from the homepage (e.g. account "Shop now") to the portal, once per session. {%- endcomment -%}
{%- assign portal_company_names = settings.portal_company_name | default: 'Furncare Test' | split: ',' -%}
{%- assign current_company_name = customer.current_company.name | downcase | strip -%}
{%- assign is_portal_company = false -%}
{%- for portal_company_name in portal_company_names -%}
  {%- assign portal_company_name = portal_company_name | downcase | strip -%}
  {%- if current_company_name != blank and current_company_name == portal_company_name -%}
    {%- assign is_portal_company = true -%}
    {%- break -%}
  {%- endif -%}
{%- endfor -%}
{%- if template.name == 'index' and is_portal_company and pages['portal-home'] != blank -%}
  <script>
    (function () {
      try {
        if (sessionStorage.getItem('portalRedirected')) return;
        sessionStorage.setItem('portalRedirected', '1');
      } catch (e) {}
      if (!(window.Shopify && Shopify.designMode)) {
        window.location.replace({{ pages['portal-home'].url | json }});
      }
    })();
  </script>
{%- endif -%}
