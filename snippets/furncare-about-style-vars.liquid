{%- liquid
  assign bg_gradient = section_settings.background_gradient
  assign bg_color = section_settings.background_color | default: '#ffffff'

  assign heading_line_height = section_settings.heading_line_height | default: 100 | divided_by: 100.0
  assign copy_line_height = section_settings.copy_line_height | default: 170 | divided_by: 100.0
  assign card_copy_line_height = section_settings.card_copy_line_height | default: 170 | divided_by: 100.0

  assign overlay_strength = section_settings.overlay_opacity | default: 90 | divided_by: 100.0
  assign radial_opacity = section_settings.radial_opacity | default: 100 | divided_by: 100.0
  assign card_shadow_opacity = section_settings.card_shadow_opacity | default: 6 | divided_by: 100.0
  assign card_hover_shadow_opacity = section_settings.card_hover_shadow_opacity | default: 14 | divided_by: 100.0
  assign panel_shadow_opacity = section_settings.panel_shadow_opacity | default: 6 | divided_by: 100.0
  assign button_hover_shadow_opacity = section_settings.button_hover_shadow_opacity | default: 12 | divided_by: 100.0
  assign secondary_bg_alpha = section_settings.secondary_button_bg_opacity | default: 12 | divided_by: 100.0
  assign secondary_bg_color = section_settings.secondary_button_bg | default: '#ffffff'

  assign alignment = section_settings.text_alignment | default: 'left'
  assign content_margin_left = '0'
  assign content_margin_right = 'auto'
  assign inner_margin_left = '0'
  assign inner_margin_right = '0'
  assign buttons_justify = 'flex-start'
  if alignment == 'center'
    assign content_margin_left = 'auto'
    assign content_margin_right = 'auto'
    assign inner_margin_left = 'auto'
    assign inner_margin_right = 'auto'
    assign buttons_justify = 'center'
  elsif alignment == 'right'
    assign content_margin_left = 'auto'
    assign content_margin_right = '0'
    assign inner_margin_left = 'auto'
    assign inner_margin_right = '0'
    assign buttons_justify = 'flex-end'
  endif

  assign mobile_button_direction = 'column'
  assign mobile_button_width = '100%'
  if section_settings.buttons_full_width_mobile == false
    assign mobile_button_direction = 'row'
    assign mobile_button_width = 'auto'
  endif
-%}

{%- if section_settings.heading_font != blank -%}
  {%- unless section_settings.heading_font.system? -%}
    {{ section_settings.heading_font | font_face: font_display: 'swap' }}
  {%- endunless -%}
{%- endif -%}
{%- if section_settings.body_font != blank -%}
  {%- unless section_settings.body_font.system? -%}
    {{ section_settings.body_font | font_face: font_display: 'swap' }}
  {%- endunless -%}
{%- endif -%}

{{ selector }} {
  {% if bg_gradient != blank %}
    --fa-bg: {{ bg_gradient }};
  {% else %}
    --fa-bg: {{ bg_color }};
  {% endif %}
  --fa-text-color: {{ section_settings.text_color | default: '#0c0a09' }};
  --fa-heading-color: {{ section_settings.heading_color | default: '#0c0a09' }};
  --fa-copy-color: {{ section_settings.copy_color | default: '#57534e' }};
  --fa-eyebrow-color: {{ section_settings.eyebrow_color | default: '#78716c' }};

  {% if section_settings.heading_font != blank %}
    --fa-heading-font-family: {{ section_settings.heading_font.family }}, {{ section_settings.heading_font.fallback_families }};
    --fa-heading-font-style: {{ section_settings.heading_font.style }};
  {% endif %}
  {% if section_settings.body_font != blank %}
    --fa-body-font-family: {{ section_settings.body_font.family }}, {{ section_settings.body_font.fallback_families }};
    --fa-body-font-style: {{ section_settings.body_font.style }};
  {% endif %}

  --fa-heading-size: {{ section_settings.heading_size_desktop | default: 64 }}px;
  --fa-heading-weight: {{ section_settings.heading_weight | default: 700 }};
  --fa-heading-line-height: {{ heading_line_height }};
  --fa-heading-letter-spacing: {{ section_settings.heading_letter_spacing | default: -3 }}px;
  --fa-heading-max-width: {{ section_settings.heading_max_width | default: 1100 }}px;
  --fa-copy-size: {{ section_settings.copy_size_desktop | default: 18 }}px;
  --fa-copy-weight: {{ section_settings.copy_weight | default: 400 }};
  --fa-copy-line-height: {{ copy_line_height }};
  --fa-copy-max-width: {{ section_settings.copy_max_width | default: 760 }}px;
  --fa-copy-margin-top: {{ section_settings.copy_margin_top | default: 28 }}px;
  --fa-eyebrow-size: {{ section_settings.eyebrow_size | default: 13 }}px;
  --fa-eyebrow-weight: {{ section_settings.eyebrow_weight | default: 700 }};
  --fa-eyebrow-letter-spacing: {{ section_settings.eyebrow_letter_spacing | default: 22 | divided_by: 100.0 }}em;
  --fa-eyebrow-transform: {{ section_settings.eyebrow_transform | default: 'uppercase' }};
  --fa-eyebrow-margin-bottom: {{ section_settings.eyebrow_margin_bottom | default: 16 }}px;

  --fa-max-width: {{ section_settings.max_width | default: 1280 }}px;
  --fa-gutter: {{ section_settings.gutter_desktop | default: 24 }}px;
  --fa-padding-top: {{ section_settings.padding_top | default: 96 }}px;
  --fa-padding-bottom: {{ section_settings.padding_bottom | default: 96 }}px;
  --fa-section-gap: {{ section_settings.section_gap | default: 48 }}px;
  --fa-header-max-width: {{ section_settings.header_max_width | default: 780 }}px;
  --fa-content-max-width: {{ section_settings.content_max_width | default: 960 }}px;
  --fa-content-margin-left: {{ content_margin_left }};
  --fa-content-margin-right: {{ content_margin_right }};
  --fa-inner-margin-left: {{ inner_margin_left }};
  --fa-inner-margin-right: {{ inner_margin_right }};
  --fa-text-align: {{ alignment }};
  --fa-buttons-justify: {{ buttons_justify }};
  --fa-section-border-color: {{ section_settings.section_border_color | default: 'transparent' }};
  --fa-section-border-top-width: {{ section_settings.border_top_width | default: 0 }}px;
  --fa-section-border-bottom-width: {{ section_settings.border_bottom_width | default: 0 }}px;

  --fa-card-bg: {{ section_settings.card_background | default: '#ffffff' }};
  --fa-card-heading-color: {{ section_settings.card_heading_color | default: '#0c0a09' }};
  --fa-card-copy-color: {{ section_settings.card_copy_color | default: '#57534e' }};
  --fa-card-border: {{ section_settings.card_border_color | default: '#e7e5e4' }};
  --fa-card-border-width: {{ section_settings.card_border_width | default: 1 }}px;
  --fa-card-radius: {{ section_settings.card_radius | default: 32 }}px;
  --fa-card-padding: {{ section_settings.card_padding | default: 28 }}px;
  --fa-card-shadow-opacity: {{ card_shadow_opacity }};
  --fa-card-hover-shadow-opacity: {{ card_hover_shadow_opacity }};
  --fa-card-hover-lift: {{ section_settings.card_hover_lift | default: 4 }}px;
  --fa-card-title-size: {{ section_settings.card_title_size | default: 20 }}px;
  --fa-card-title-weight: {{ section_settings.card_title_weight | default: 700 }};
  --fa-card-copy-size: {{ section_settings.card_copy_size | default: 15 }}px;
  --fa-card-copy-line-height: {{ card_copy_line_height }};
  --fa-card-copy-margin-top: {{ section_settings.card_copy_margin_top | default: 16 }}px;
  --fa-grid-gap: {{ section_settings.grid_gap | default: 20 }}px;
  --fa-grid-columns-desktop: {{ section_settings.columns_desktop | default: 4 }};
  --fa-grid-columns-tablet: {{ section_settings.columns_tablet | default: 2 }};
  --fa-grid-columns-mobile: {{ section_settings.columns_mobile | default: 1 }};

  --fa-icon-bg: {{ section_settings.icon_background | default: '#f5f5f4' }};
  --fa-icon-color: {{ section_settings.icon_color | default: '#292524' }};
  --fa-icon-size: {{ section_settings.icon_size | default: 48 }}px;
  --fa-icon-svg-size: {{ section_settings.icon_svg_size | default: 23 }}px;
  --fa-icon-radius: {{ section_settings.icon_radius | default: 16 }}px;
  --fa-icon-margin-bottom: {{ section_settings.icon_margin_bottom | default: 32 }}px;
  --fa-icon-hover-scale: {{ section_settings.icon_hover_scale | default: 108 | divided_by: 100.0 }};

  --fa-panel-bg: {{ section_settings.panel_background | default: '#ffffff' }};
  --fa-panel-border: {{ section_settings.panel_border_color | default: 'transparent' }};
  --fa-panel-border-width: {{ section_settings.panel_border_width | default: 0 }}px;
  --fa-panel-radius: {{ section_settings.panel_radius | default: 32 }}px;
  --fa-panel-padding: {{ section_settings.panel_padding | default: 40 }}px;
  --fa-panel-shadow-opacity: {{ panel_shadow_opacity }};

  --fa-button-radius: {{ section_settings.button_radius | default: 999 }}px;
  --fa-button-padding-x: {{ section_settings.button_padding_x | default: 24 }}px;
  --fa-button-padding-y: {{ section_settings.button_padding_y | default: 14 }}px;
  --fa-button-min-height: {{ section_settings.button_min_height | default: 54 }}px;
  --fa-button-font-size: {{ section_settings.button_font_size | default: 16 }}px;
  --fa-button-weight: {{ section_settings.button_weight | default: 700 }};
  --fa-button-gap: {{ section_settings.button_gap | default: 12 }}px;
  --fa-button-margin-top: {{ section_settings.button_margin_top | default: 32 }}px;
  --fa-button-text-transform: {{ section_settings.button_text_transform | default: 'none' }};
  --fa-button-border-width: {{ section_settings.button_border_width | default: 1 }}px;
  --fa-button-hover-lift: {{ section_settings.button_hover_lift | default: 1 }}px;
  --fa-button-hover-shadow-opacity: {{ button_hover_shadow_opacity }};
  --fa-button-primary-bg: {{ section_settings.primary_button_bg | default: '#ffffff' }};
  --fa-button-primary-color: {{ section_settings.primary_button_color | default: '#0c0a09' }};
  --fa-button-primary-border: {{ section_settings.primary_button_border | default: 'transparent' }};
  --fa-button-primary-hover-bg: {{ section_settings.primary_button_hover_bg | default: '#e7e5e4' }};
  --fa-button-primary-hover-color: {{ section_settings.primary_button_hover_color | default: '#0c0a09' }};
  --fa-button-primary-hover-border: {{ section_settings.primary_button_hover_border | default: 'transparent' }};
  --fa-button-secondary-bg: {{ secondary_bg_color | color_modify: 'alpha', secondary_bg_alpha }};
  --fa-button-secondary-color: {{ section_settings.secondary_button_color | default: '#ffffff' }};
  --fa-button-secondary-border: {{ section_settings.secondary_button_border | default: '#ffffff' }};
  --fa-button-secondary-hover-bg: {{ section_settings.secondary_button_hover_bg | default: '#ffffff' }};
  --fa-button-secondary-hover-color: {{ section_settings.secondary_button_hover_color | default: '#0c0a09' }};
  --fa-button-secondary-hover-border: {{ section_settings.secondary_button_hover_border | default: '#ffffff' }};
  --fa-mobile-button-direction: {{ mobile_button_direction }};
  --fa-mobile-button-width: {{ mobile_button_width }};

  {% if section_settings.background_image != blank %}
    --fa-bg-image: url('{{ section_settings.background_image | image_url: width: 2400 }}');
  {% elsif section_settings.fallback_image_url != blank %}
    --fa-bg-image: url('{{ section_settings.fallback_image_url | escape }}');
  {% endif %}
  --fa-bg-position: {{ section_settings.background_position | default: 'center center' }};
  --fa-bg-size: {{ section_settings.background_size | default: 'cover' }};
  --fa-hero-height: {{ section_settings.min_height | default: 100 }}vh;
  --fa-hero-height-mobile: {{ section_settings.min_height_mobile | default: 80 }}vh;
  --fa-hero-vertical-align: {{ section_settings.content_vertical_position | default: 'center' }};
  --fa-overlay-color: {{ section_settings.overlay_color | default: '#1c1917' }};
  --fa-overlay-color-2: {{ section_settings.overlay_color_2 | default: '#1c1917' }};
  --fa-overlay-strength: {{ overlay_strength }};
  --fa-overlay-angle: {{ section_settings.overlay_angle | default: 120 }}deg;
  --fa-radial-color: {{ section_settings.radial_color | default: '#ffffff' }};
  --fa-radial-opacity: {{ radial_opacity }};
  --fa-radial-x: {{ section_settings.radial_x | default: 20 }}%;
  --fa-radial-y: {{ section_settings.radial_y | default: 10 }}%;
  --fa-radial-size: {{ section_settings.radial_size | default: 28 }}%;
  --fa-rotator-line-color: {{ section_settings.rotator_line_color | default: '#e7e5e4' }};
  --fa-rotator-bg: {{ section_settings.rotator_background | default: '#ffffff' | color_modify: 'alpha', 0.15 }};
  --fa-rotator-color: {{ section_settings.rotator_text_color | default: '#ffffff' }};
  --fa-rotator-font-size: {{ section_settings.rotator_font_size | default: 16 }}px;
  --fa-rotator-min-width: {{ section_settings.rotator_min_width | default: 138 }}px;
  --fa-rotator-height: {{ section_settings.rotator_height | default: 34 }}px;
  --fa-rotator-radius: {{ section_settings.rotator_radius | default: 999 }}px;
  --fa-rotator-padding-x: {{ section_settings.rotator_padding_x | default: 16 }}px;
  --fa-rotator-margin-top: {{ section_settings.rotator_margin_top | default: 36 }}px;
  --fa-reveal-distance: {{ section_settings.reveal_distance | default: 32 }}px;
  --fa-reveal-duration: {{ section_settings.reveal_duration | default: 760 }}ms;
}

@media (max-width: 749px) {
  {{ selector }} {
    --fa-gutter: {{ section_settings.gutter_mobile | default: 16 }}px;
    --fa-padding-top: {{ section_settings.padding_mobile | default: 72 }}px;
    --fa-padding-bottom: {{ section_settings.padding_bottom_mobile | default: 72 }}px;
    --fa-heading-size: {{ section_settings.heading_size_mobile | default: 40 }}px;
    --fa-copy-size: {{ section_settings.copy_size_mobile | default: 16 }}px;
    --fa-card-padding: {{ section_settings.card_padding_mobile | default: 24 }}px;
    --fa-section-gap: {{ section_settings.section_gap_mobile | default: 36 }}px;
  }
}
