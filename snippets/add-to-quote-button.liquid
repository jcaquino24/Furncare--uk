{%- doc -%}
  Add to Quote button. Adds the current product (variant, quantity, Room Number)
  to the cart / quote list and stays on the product page.
  Styled like the Add to cart button. Render INSIDE the product <form>.

  @param {string} [label] - Button label
  @param {string} [added_label] - Label shown briefly after a successful add

  @example
  {% render 'add-to-quote-button' %}
{%- enddoc -%}

<button
  type="button"
  class="product__atc-button button button--primary button--full-width button--md"
  data-add-to-quote
  data-added-label="{{ added_label | default: 'Added to quote' }}"
>
  <span style="justify-content:center;" data-add-to-quote-label>
    {{ label | default: 'Add to quote' }}
    {% render 'icons', icon: 'cart' %}
  </span>
</button>

<p class="add-to-quote__message body-sm body-sm--bold" role="status" aria-live="polite" hidden data-add-to-quote-message></p>

<script>
  (function () {
    if (window.__addToQuoteInit) return;
    window.__addToQuoteInit = true;

    document.addEventListener('submit', function (event) {
      var btn = event.target.querySelector('[data-add-to-quote]');
      if (!btn) return;
      event.preventDefault();
      event.stopImmediatePropagation();
      if (!btn.disabled) btn.click();
    }, true);

    document.addEventListener('click', async function (event) {
      var btn = event.target.closest('[data-add-to-quote]');
      if (!btn) return;

      event.preventDefault();
      event.stopPropagation();

      var form = btn.closest('form');
      if (!form) return;

      var message = form.querySelector('[data-add-to-quote-message]');
      var labelEl = btn.querySelector('[data-add-to-quote-label]');
      var originalHtml = labelEl.innerHTML;

      function showMessage(text, isError) {
        if (!message) return;
        message.textContent = text;
        message.hidden = false;
        message.style.color = isError ? '#b42318' : 'inherit';
      }

      if (message) message.hidden = true;

      // Enforces the required Room Number input
      if (!form.reportValidity()) return;

      btn.disabled = true;

      try {
        var response = await fetch('{{ routes.cart_add_url }}.js', {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' }
        });
        var result = await response.json();

        if (!response.ok) {
          throw new Error(result.description || result.message || 'Could not add to quote.');
        }

        labelEl.textContent = btn.dataset.addedLabel;
        showMessage(btn.dataset.addedLabel + ' ✓', false);
        setTimeout(function () {
          labelEl.innerHTML = originalHtml;
          btn.disabled = false;
          if (message) message.hidden = true;
        }, 2500);
      } catch (err) {
        showMessage(err.message, true);
        btn.disabled = false;
      }
    });
  })();
</script>