{%- comment -%}
  Variant swatches + "Available in N variant options" for product cards (Colour/Fabric/Finish options).
  Params: product, limit (default 5)
{%- endcomment -%}
{%- assign swatch_limit = limit | default: 5 -%}
{%- assign variant_option_count = 0 -%}

{%- for swatch_option in product.options_with_values -%}
  {%- liquid
    assign option_name = swatch_option.name | downcase
    assign is_swatch_option = false
    if option_name contains 'finish'
      assign is_swatch_option = true
    endif
    if option_name contains 'colo'
      assign is_swatch_option = true
    endif
    if option_name contains 'fabric'
      assign is_swatch_option = true
    endif
    assign option_index = swatch_option.position | minus: 1
  -%}

  {%- if is_swatch_option and swatch_option.values.size > 1 -%}
    {%- if variant_option_count == 0 -%}
      {%- assign variant_option_count = swatch_option.values.size -%}
    {%- endif -%}
    <div class="product-card__variants" aria-label="{{ swatch_option.name | escape }}">
      {%- for value in swatch_option.values limit: swatch_limit -%}
        {%- liquid
          assign swatch_variant = null
          for variant in product.variants
            assign variant_value = variant.options[option_index]
            if variant_value == value.name
              assign swatch_variant = variant
              break
            endif
          endfor

          assign swatch_image = value.swatch.image
          if swatch_image == blank and value.swatch.color == blank
            assign swatch_image = swatch_variant.featured_image
          endif
          if swatch_image == blank and value.swatch.color == blank and swatch_variant.image != blank
            assign swatch_image = swatch_variant.image
          endif
        -%}
        <a
          class="product-card__variant{% if value.selected %} is-selected{% endif %}{% if swatch_image == blank and value.swatch.color == blank %} product-card__variant--text{% endif %}"
          href="{{ product.url | split: '?' | first }}?variant={{ swatch_variant.id }}"
          title="{{ value.name | escape }}"
          aria-label="{{ value.name | escape }}"
          {%- if swatch_variant.featured_image != blank %}
          data-card-image-src="{{ swatch_variant.featured_image | image_url: width: 800 }}"
          data-card-image-srcset="{{ swatch_variant.featured_image | image_url: width: 400 }} 400w, {{ swatch_variant.featured_image | image_url: width: 800 }} 800w"
          {%- endif %}
        >
          {%- if swatch_image != blank -%}
            {{ swatch_image | image_url: width: 64 | image_tag: width: 32, height: 32, loading: 'lazy', alt: value.name }}
          {%- elsif value.swatch.color != blank -%}
            <span class="product-card__variant-color" style="background-color: {{ value.swatch.color }}"></span>
          {%- else -%}
            {{ value.name }}
          {%- endif -%}
        </a>
      {%- endfor -%}
      {%- assign extra_swatches = swatch_option.values.size | minus: swatch_limit -%}
      {%- if extra_swatches > 0 -%}
        <span class="product-card__variants-more body-sm">+{{ extra_swatches }}</span>
      {%- endif -%}
    </div>
  {%- endif -%}
{%- endfor -%}

{%- if variant_option_count > 0 -%}
  <div class="product-card__available-in eyebrow-2xs">
    Available in {{ variant_option_count }} variant option{% if variant_option_count > 1 %}s{% endif %}
  </div>
{%- endif -%}

<script>
  (function () {
    if (window.__cardVariantSwap) return;
    window.__cardVariantSwap = true;
    document.addEventListener('click', function (event) {
      var swatch = event.target.closest('.product-card__variant[data-card-image-src]');
      if (!swatch) return;
      var card = swatch.closest('.product-card');
      var img = card && card.querySelector('.product-card__original-image img');
      if (!img) return;
      event.preventDefault();
      img.src = swatch.dataset.cardImageSrc;
      img.srcset = swatch.dataset.cardImageSrcset;
      card.querySelectorAll('.product-card__variant').forEach(function (el) {
        el.classList.toggle('is-selected', el === swatch);
      });
      card.querySelectorAll('.product-card__image a, .product-card__title a').forEach(function (link) {
        link.href = swatch.href;
      });
    });
  })();
</script>

{% stylesheet %}
  .product-card__variants {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    margin-top: var(--spacing-2xs, 8px);
  }

  .product-card__variant {
    display: block;
    width: 28px;
    height: 28px;
    border: 1px solid rgb(0 0 0 / 0.2);
    border-radius: 2px;
    overflow: hidden;
  }

  .product-card__variant.product-card__variant--text {
    width: auto;
    height: auto;
    padding: 2px 8px;
    font-size: 12px;
    line-height: 1.4;
    white-space: nowrap;
    text-decoration: none;
  }

  .product-card__variant.is-selected,
  .product-card__variant:hover {
    border-color: currentcolor;
  }

  .product-card__variant img,
  .product-card__variant-color {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
{% endstylesheet %}
