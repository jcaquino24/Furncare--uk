{%- comment -%}
  Variant swatches + "Available in N variant options" for product cards.
{%- endcomment -%}
{%- assign swatch_limit = limit | default: 5 -%}
{%- assign variant_option_count = 0 -%}

{%- for swatch_option in product.options_with_values -%}
  {%- liquid
    assign option_name = swatch_option.name | downcase
    assign is_swatch_option = false
    if option_name contains 'finish' or option_name contains 'colo' or option_name contains 'fabric'
      assign is_swatch_option = true
    endif
    assign option_index = swatch_option.position | minus: 1
    assign is_custom_swatch_option = false
    if option_name contains 'finish' or option_name contains 'colo' or option_name contains 'fabric'
      assign is_custom_swatch_option = true
    endif
  -%}

  {%- if is_swatch_option and swatch_option.values.size > 1 -%}
    {%- if variant_option_count == 0 -%}
      {%- assign variant_option_count = swatch_option.values.size -%}
    {%- endif -%}
    <div class="product-card__variants" aria-label="{{ swatch_option.name | escape }}">
      {%- for value in swatch_option.values limit: swatch_limit -%}
        {%- liquid
          assign swatch_variant = null
          for variant in product.variants
            assign variant_value = variant.options[option_index]
            if variant_value == value.name
              assign swatch_variant = variant
              break
            endif
          endfor

          assign swatch_color = blank
          assign swatch_image = blank
          assign swatch_mapping_found = false

          if is_custom_swatch_option
            assign value_key = value.name | downcase | strip
            for swatch_block in swatch_blocks
              assign block_key = swatch_block.settings.value_name | downcase | strip
              if swatch_block.type == 'swatch_colour' and block_key == value_key
                assign swatch_mapping_found = true
                if swatch_block.settings.swatch_type == 'image'
                  assign swatch_image = swatch_block.settings.swatch_image
                else
                  assign swatch_color = swatch_block.settings.colour
                endif
                break
              endif
            endfor
          endif

          unless swatch_mapping_found
            assign swatch_color = value.swatch.color
            assign swatch_image = value.swatch.image
          endunless

          if swatch_color == blank and swatch_image == blank
            assign swatch_image = swatch_variant.featured_image | default: swatch_variant.image
          endif
        -%}
        <a
          class="product-card__variant{% if value.selected %} is-selected{% endif %}{% if swatch_image == blank and swatch_color == blank %} product-card__variant--text{% endif %}"
          href="{{ product.url | split: '?' | first }}?variant={{ swatch_variant.id }}"
          title="{{ value.name | escape }}"
          aria-label="{{ value.name | escape }}"
        >
          {%- if swatch_image != blank -%}
            {{ swatch_image | image_url: width: 64 | image_tag: width: 32, height: 32, loading: 'lazy', alt: value.name }}
          {%- elsif swatch_color != blank -%}
            <span class="product-card__variant-color" style="background-color: {{ swatch_color }}"></span>
          {%- else -%}
            {{ value.name }}
          {%- endif -%}
        </a>
      {%- endfor -%}
      {%- assign extra_swatches = swatch_option.values.size | minus: swatch_limit -%}
      {%- if extra_swatches > 0 -%}
        <span class="product-card__variants-more body-sm">+{{ extra_swatches }}</span>
      {%- endif -%}
    </div>
  {%- endif -%}
{%- endfor -%}

{%- if variant_option_count > 0 -%}
  <div class="product-card__available-in eyebrow-2xs">
    Available in {{ variant_option_count }} variant option{% if variant_option_count > 1 %}s{% endif %}
  </div>
{%- endif -%}

{% stylesheet %}
  .product-card__variants {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    margin-top: var(--spacing-2xs, 8px);
  }

  .product-card__variant {
    display: block;
    width: 28px;
    height: 28px;
    border: 1px solid rgb(0 0 0 / 0.2);
    border-radius: 2px;
    overflow: hidden;
  }

  .product-card__variant.product-card__variant--text {
    width: auto;
    height: auto;
    padding: 2px 8px;
    font-size: 12px;
    line-height: 1.4;
    white-space: nowrap;
    text-decoration: none;
  }

  .product-card__variant.is-selected,
  .product-card__variant:hover {
    border-color: currentcolor;
  }

  .product-card__variant img,
  .product-card__variant-color {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
{% endstylesheet %}
