{% assign wishlist_products = customer.metafields.custom.wishlist.value | default: empty %}
{% assign wishlist_product_ids = wishlist_products | map: 'id' %}
<button
  type="button"
  class="wishlist-button"
  data-wishlist-button
  data-product-id="{{ product.id }}"
  aria-label="{% if wishlist_product_ids contains product.id %}Remove {{ product.title | escape }} from wishlist{% else %}Add {{ product.title | escape }} to wishlist{% endif %}"
  aria-pressed="{% if wishlist_product_ids contains product.id %}true{% else %}false{% endif %}"
  {% unless customer %}data-requires-login="true"{% endunless %}
>
  <span class="visually-hidden">Wishlist</span>
  <span data-wishlist-icon="empty">{% render 'icons', icon: 'wishlist' %}</span>
  <span data-wishlist-icon="filled">{% render 'icons', icon: 'wishlist-fill' %}</span>
</button>