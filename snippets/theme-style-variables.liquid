{% comment %}
  Handles converting theme settings to theme styles via seting CSS variables.
  Main source of truth for the theme's design system.
  All CSS variables should be set, edited and maintained here - unless creating
  them dynamically in liquid from section settings, or via JS in scripts.
{% endcomment %}

{% style %}
  {%- liquid
    assign font_body = settings.type_body_font | font_modify: 'weight', '300'
    assign font_body_medium = settings.type_body_font | font_modify: 'weight', '400'
    assign font_body_semibold = settings.type_body_font | font_modify: 'weight', '500'
    assign font_body_bold = settings.type_body_font | font_modify: 'weight', '700'
    assign font_body_italic = settings.type_body_font | font_modify: 'style', 'italic'
    assign font_body_bold_italic = font_body_bold | font_modify: 'style', 'italic'
  -%}

  {{ font_body | font_face: font_display: 'swap' }}
  {{ font_body_medium | font_face: font_display: 'swap' }}
  {{ font_body_semibold | font_face: font_display: 'swap' }}
  {{ font_body_bold | font_face: font_display: 'swap' }}
  {{ font_body_italic | font_face: font_display: 'swap' }}
  {{ font_body_bold_italic | font_face: font_display: 'swap' }}

  /* =========================================================================
     Custom Big Caslon Fonts
  ========================================================================= */
  @font-face {
    font-family: 'Big Caslon';
    src: url('{{ 'Big_Caslon_Medium.woff' | asset_url }}') format('woff');
    font-weight: 500;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: 'Big Caslon';
    src: url('{{ 'Big_Caslon_Bold.woff' | asset_url }}') format('woff');
    font-weight: 700;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: 'Big Caslon';
    src: url('{{ 'Big_Caslon_Black.woff' | asset_url }}') format('woff');
    font-weight: 900;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: 'Big Caslon';
    src: url('{{ 'Big_Caslon_Italic.woff' | asset_url }}') format('woff');
    font-weight: 500;
    font-style: italic;
    font-display: swap;
  }

  @font-face {
    font-family: 'Big Caslon';
    src: url('{{ 'Big_Caslon_Bold_Italic.woff' | asset_url }}') format('woff');
    font-weight: 700;
    font-style: italic;
    font-display: swap;
  }

  @font-face {
    font-family: 'Big Caslon';
    src: url('{{ 'Big_Caslon_Black_Italic.woff' | asset_url }}') format('woff');
    font-weight: 900;
    font-style: italic;
    font-display: swap;
  }

  :root {
    /* =========================================================================
     Typography
    ========================================================================= */
    /* Custom font families */
    --font-big-caslon: 'Big Caslon', serif;

    --font-body-family: {{ font_body.family }}, {{ font_body.fallback_families }};
    --font-body-style: {{ font_body.style }};
    --font-body-weight: {{ font_body.weight }};
    --font-body-line-height: 1.4;
    --font-body-letter-spacing: 0;

    --font-heading-family: var(--font-big-caslon);
    --font-heading-weight: 500;
    --font-heading-line-height: 1.2;
    --font-heading-letter-spacing: 0;

    --font-size-title-2xs: 1rem;              /* 16px */
    --font-size-title-xs: 1.125rem;           /* 18px */
    --font-size-title-sm: 1.25rem;            /* 20px */
    --font-size-title-md: 1.375rem;           /* 22px */
    --font-size-title-lg: 1.5rem;             /* 24px */
    --font-size-title-xl: 1.75rem;            /* 28px */
    --font-size-title-display: 1.875rem;      /* 30px */
    @media (width >= 768px) {
      --font-size-title-2xs: 1.125rem;        /* 18px */
      --font-size-title-xs: 1.25rem;          /* 20px */
      --font-size-title-sm: 1.375rem;         /* 22px */
      --font-size-title-md: 1.5rem;           /* 24px */
      --font-size-title-lg: 1.75rem;          /* 28px */
      --font-size-title-xl: 2rem;             /* 32px */
      --font-size-title-display: 2.5rem;      /* 40px */
    }
    @media (width >= 1600px) {
      --font-size-title-2xs: 1.25rem;         /* 20px */
      --font-size-title-xs: 1.375rem;         /* 22px */
      --font-size-title-sm: 1.5rem;           /* 24px */
      --font-size-title-md: 1.75rem;          /* 28px */
      --font-size-title-lg: 2rem;             /* 32px */
      --font-size-title-xl: 2.5rem;           /* 40px */
      --font-size-title-display: 3rem;        /* 48px */
    }

    --font-size-body-xs: 0.6875rem;           /* 11px */
    --font-size-body-sm: 0.75rem;             /* 12px */
    --font-size-body-md: 0.875rem;            /* 14px */
    --font-size-body-lg: 1rem;                /* 16px */
    --font-size-body-xl: 1.0625rem;           /* 17px */
    @media (width >= 768px) {
      --font-size-body-xl: 1.125rem;          /* 18px */
    }
    @media (width >= 1600px) {
      --font-size-body-xs: 0.875rem;          /* 14px */
      --font-size-body-sm: 1rem;              /* 16px */
      --font-size-body-md: 1.125rem;          /* 18px */
      --font-size-body-lg: 1.25rem;           /* 20px */
      --font-size-body-xl: 1.375rem;          /* 22px */
    }

    --font-size-eyebrow-2xs: 0.5938rem;       /* 9.5px */
    --font-size-eyebrow-xs: 0.6875rem;        /* 11px */
    --font-size-eyebrow-sm: 0.8125rem;        /* 13px */
    --font-size-eyebrow-md: 0.875rem;         /* 14px */
    @media (width >= 768px) {
      --font-size-eyebrow-2xs: 0.625rem;      /* 10px */
      --font-size-eyebrow-xs: 0.75rem;        /* 12px */
      --font-size-eyebrow-sm: 0.8125rem;      /* 13px */
      --font-size-eyebrow-md: 1rem;           /* 16px */
    }
    @media (width >= 1600px) {
      --font-size-eyebrow-2xs: 0.6875rem;     /* 11px */
      --font-size-eyebrow-xs: 0.875rem;       /* 14px */
      --font-size-eyebrow-sm: 1rem;           /* 16px */
      --font-size-eyebrow-md: 1.125rem;       /* 18px */
    }

    --button-xs: 0.6875rem;                   /* 11px */
    --button-sm: 0.625rem;                    /* 10px */
    --button-md: 0.75rem;                     /* 12px */
    @media (width >= 768px) {
      --button-xs: 0.6875rem;                 /* 11px */
      --button-sm: 0.75rem;                   /* 12px */
      --button-md: 0.8125rem;                 /* 13px */
    }
    @media (width >= 1600px) {
      --button-xs: 0.75rem;                   /* 12px */
      --button-sm: 0.8125rem;                 /* 13px */
      --button-md: 0.875rem;                  /* 14px */
    }

    /**
    * Font Weight
    *
    * If you need to use different font weights, create the font faces for them.
    * Example:
    *
    * {%- raw -%}
    *   {{ font_body_300 | font-modify: 'weight', '300' }}
    *   {{ font_body_300 | font_face: font_display: 'swap' }}
    * {%- endraw -%}
    */
    --font-weight-regular: 300;
    --font-weight-medium: 400;
    --font-weight-semibold: 500;
    --font-weight-bold: 700;

    /**
    * Line heights
    */
    --line-height-tight: 1;
    --line-height-default: 1.2;
    --line-height-normal: 1.3;
    --line-height-loose: 1.4;

    /* =========================================================================
      Colors
    ========================================================================= */
    /**
    * Core brand colors
    */
    --color-brand-01: #f9f7f0;
    --color-brand-02: #243222;
    --color-brand-03: #998c4d;
    --color-brand-04: #859488;
    --color-brand-05: #c3c0b0;
    --color-brand-06: #261520;
    --color-brand-07: #fFFEF8;
    --color-brand-08: #32412F;

    /**
    * Grayscale and neutral tones
    */
    --color-white-00: #FFFFFF;
    --color-neutral-05: #FAFAFA;
    --color-neutral-10: #F6F6F6;
    --color-neutral-20: #E4E3E3;
    --color-neutral-30: #D5D5D5;
    --color-neutral-40: #A1A1A1;
    --color-neutral-50: #767676;
    --color-neutral-60: #606060;
    --color-neutral-70: #4D4D4D;
    --color-neutral-80: #434343;
    --color-neutral-90: #1A1A1A;
    --color-black-100: #000000;

    /**
    * Status colors
    */
    --color-error-light: #AF2A1A;
    --color-error-dark: #E34935;
    --color-success-light: #1D6E4F;
    --color-success-dark: #C9F0C7;
    --color-sale: #B1001D;

    /**
    * Text colors
    */
    --color-text-primary: var(--color-black-100);
    --color-text-secondary: var(--color-brand-06);
    --color-text-brand: var(--color-brand-02);
    --color-text-invert: var(--color-white-00);

    /**
    * Background colors
    */
    --color-surface-primary: var(--color-white-00);
    --color-surface-secondary: var(--color-neutral-10);
    --color-surface-brand: var(--color-brand-01);
    --color-surface-brand-light: var(--color-brand-07);
    --color-surface-invert: var(--color-brand-06);

    /**
    * Border colors
    */
    --color-border-primary: var(--color-brand-06);
    --color-border-secondary: var(--color-brand-04);
    --color-border-invert: var(--color-neutral-10);

    /* =========================================================================
      Spacing
    ========================================================================= */
    /**
    * Default browser font size: 16px = 1rem
    */
    --spacing-5xs: 0.188rem;  /* 3px */
    --spacing-4xs: 0.25rem;   /* 4px */
    --spacing-3xs: 0.5rem;    /* 8px */
    --spacing-2xs: 0.75rem;   /* 12px */
    --spacing-xs: 1rem;       /* 16px */
    --spacing-sm: 1.25rem;    /* 20px */
    --spacing-md: 1.5rem;     /* 24px */
    --spacing-lg: 2rem;       /* 32px */
    --spacing-xl: 2.5rem;     /* 40px */
    --spacing-2xl: 3rem;      /* 48px */
    --spacing-3xl: 4.5rem;    /* 72px */
    --spacing-4xl: 5rem;      /* 80px */
    --spacing-5xl: 6rem;      /* 96px */
    --spacing-6xl: 7.5rem;    /* 120px */

    /* =========================================================================
      Borders
    ========================================================================= */
    --border-sm: 1px;
    --border-md: 2px;
    --border-lg: 4px;
    --radius-none: 0px;
    --radius-sm: 4px;
    --radius-md: 8px;
    --radius-lg: 16px;
    --radius-xl: 32px;
    --radius-2xl: 128px;
    --radius-full: 360px;

    /* =========================================================================
      Containers
    ========================================================================= */
    --container-width: 100%;
    --container-max-width: 1440px;
    --container-medium-max-width: 1276px;
    --container-small-max-width: 890px;
    --container-xsmall-max-width: 600px;
    --container-margin: 0 auto;
    --container-padding-mobile: var(--spacing-sm);
    --container-padding-desktop: var(--spacing-2xl);

    @media (width >= 1600px) {
      --container-max-width: 1800px;
    }

    /* =========================================================================
      Animations and Transitions
    ========================================================================= */
    --duration-short: 0.2s;
    --duration-normal: 0.4s;
    --duration-long: 0.8s;

    /* =========================================================================
      Shadows
    ========================================================================= */
    --shadow-xs: 0 2px 4px 0 rgba(0, 0, 0, 0.04);
    --shadow-sm: 0 4px 16px -8px rgba(0, 0, 0, 0.06);
    --shadow-md: 0 12px 18px -12px rgba(0, 0, 0, 0.08);
    --shadow-lg: 0 24px 28px -16px rgba(0, 0, 0, 0.10);
    --shadow-xl: 0 48px 64px -24px rgba(0, 0, 0, 0.12);

    /* =========================================================================
      Layout
    ========================================================================= */
    --z-index-back: -1;
    --z-index-default: 0;
    --z-index-foreground: 1;
    --z-index-overlay: 2;
    --z-index-dropdown: 100;
    --z-index-sticky: 200;
    --z-index-fixed: 300;
    --z-index-modal-overlay: 400;
    --z-index-modal: 500;
    --z-index-popover: 600;
    --z-index-tooltip: 700;
  }

  /* =========================================================================
     Color Scheme Overrides
  ========================================================================= */

  /* Brand 01 - White background */
  .colour-scheme--base-white-01,
  .colour-scheme--light {
    --color-surface-primary: var(--color-brand-01);
    --color-text-primary: var(--color-brand-06);
    --color-text-secondary: var(--color-brand-06);
    --color-border-primary: var(--color-brand-06);
    --color-button-underline: var(--color-brand-06);
    --color-brand-icon-only: var(--color-brand-04);
  }

  /* Brand 07 - White light background */
  .colour-scheme--base-white-02 {
    --color-surface-primary: var(--color-brand-07);
    --color-text-primary: var(--color-brand-06);
    --color-text-secondary: var(--color-brand-06);
    --color-border-primary: var(--color-brand-06);
    --color-button-underline: var(--color-brand-06);
    --color-brand-icon-only: var(--color-brand-04);
  }

  /* Brand 05 - Warm stone background */
  .colour-scheme--warm-stone {
    --color-surface-primary: var(--color-brand-05);
    --color-text-primary: var(--color-brand-06);
    --color-text-secondary: var(--color-brand-06);
    --color-border-primary: var(--color-brand-06);
    --color-button-underline: var(--color-brand-06);
    --color-brand-icon-only: var(--color-brand-04);

    &.content-blocks {
      --color-surface-primary: #DBD9D0;
    }
  }

  /* Brand 04 - Duck egg background */
  .colour-scheme--duck-egg {
    --color-surface-primary: var(--color-brand-04);
    --color-text-primary: var(--color-brand-06);
    --color-text-secondary: var(--color-brand-06);
    --color-border-primary: var(--color-brand-06);
    --color-button-underline: var(--color-brand-06);
    --color-brand-icon-only: var(--color-text-primary);
    --color-brand-icon-only: var(--color-surface-primary);
    --color-brand-icon-only: var(--color-text-primary);
    --color-brand-icon-only: var(--color-surface-primary);

    &.content-blocks {
      --color-surface-primary: #B6BFB8;
    }
  }

  /* Brand 08-01 - Furncare green background with stone text */
  .colour-scheme--green-01 {
    --color-surface-primary: var(--color-brand-08);
    --color-text-primary: var(--color-brand-05);
    --color-text-secondary: var(--color-brand-05);
    --color-border-primary: var(--color-brand-05);
    --color-button-underline: var(--color-brand-05);
    --color-brand-icon-only: var(--color-surface-primary);
  }

  /* Brand 08-02 - Furncare green background with white text */
  .colour-scheme--green-02,
  .colour-scheme--dark {
    --color-surface-primary: var(--color-brand-08);
    --color-text-primary: var(--color-brand-01);
    --color-text-secondary: var(--color-brand-01);
    --color-border-primary: var(--color-brand-01);
    --color-button-underline: var(--color-brand-01);
    --color-brand-icon-only: var(--color-surface-primary);
  }
{% endstyle %}
