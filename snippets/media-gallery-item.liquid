{% comment %}
  Renders a single media gallery block: an image, optionally paired with a heading/description.
  Accepts: image, image_mobile, heading, description, description_position, enable_lightbox,
  lightbox_id, slide_index, aspect_ratio, block (for per-block text size/alignment settings).
{% endcomment %}

{% liquid
  if image_mobile == blank
    assign image_mobile = image
  endif

  assign heading_style = ''
  if block.settings.heading_size > 0
    assign heading_style = heading_style | append: 'font-size: ' | append: block.settings.heading_size | append: 'px;'
  endif
  if block.settings.heading_align != blank
    assign heading_style = heading_style | append: 'text-align: ' | append: block.settings.heading_align | append: ';'
  endif

  assign description_style = ''
  if block.settings.description_size > 0
    assign description_style = description_style | append: 'font-size: ' | append: block.settings.description_size | append: 'px;'
  endif
  if block.settings.description_align != blank
    assign description_style = description_style | append: 'text-align: ' | append: block.settings.description_align | append: ';'
  endif

  assign has_description = false
  if description != blank
    assign has_description = true
  endif
%}

<div
  class="
    media-gallery__item media-gallery__item--{{ description_position }}
    {% unless has_description or heading != blank %} media-gallery__item--image-only{% endunless %}
  "
>
  <div class="media-gallery__media">
    {% if enable_lightbox and image != blank %}
      <button
        type="button"
        class="media-gallery__zoom-trigger"
        data-media-gallery-open="{{ lightbox_id }}"
        data-media-gallery-index="{{ slide_index }}"
        aria-label="{{ 'accessibility.view_larger_image' | t }}"
      >
    {% endif %}

    {% render 'responsive-image',
      image: image,
      aspect_ratio: aspect_ratio,
      block_class: 'media-gallery__image hide-on-mobile',
      image_class: 'media-gallery__image-el',
      sizes: '(max-width: 749px) 100vw, 33vw'
    %}
    {% render 'responsive-image',
      image: image_mobile,
      aspect_ratio: aspect_ratio,
      block_class: 'media-gallery__image hide-on-desktop',
      image_class: 'media-gallery__image-el',
      sizes: '100vw'
    %}

    {% if enable_lightbox and image != blank %}
        <span class="media-gallery__zoom-icon" aria-hidden="true">
          {% render 'icons', icon: 'expand' %}
        </span>
      </button>
    {% endif %}
  </div>

  {% if heading != blank or has_description %}
    <div class="media-gallery__content">
      {% if heading != blank %}
        <h3 class="media-gallery__item-heading title-2xs" {% if heading_style != blank %}style="{{ heading_style }}"{% endif %}>{{ heading }}</h3>
      {% endif %}
      {% if has_description %}
        <div class="media-gallery__description body-md" {% if description_style != blank %}style="{{ description_style }}"{% endif %}>{{ description }}</div>
      {% endif %}
    </div>
  {% endif %}
</div>
