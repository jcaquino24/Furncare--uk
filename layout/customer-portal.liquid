{% liquid
  assign portal_company_names = settings.portal_company_name | default: 'Furncare Test' | split: ','
  assign current_company_name = customer.current_company.name | downcase | strip
  assign is_portal_company = false
  for portal_company_name in portal_company_names
    assign normalized_company_name = portal_company_name | downcase | strip
    if current_company_name != blank and current_company_name == normalized_company_name
      assign is_portal_company = true
      break
    endif
  endfor
  assign hide_portal_chrome = false
  if settings.hide_portal_header_footer and is_portal_company
    assign hide_portal_chrome = true
  endif
%}
<!doctype html>
<html lang="{{ shop.locale }}">
  <head>
    {% render 'portal-access-gate' %}

    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="noindex, nofollow">
    <title>{{ page_title | escape }}</title>

    <script type="importmap">
      {
        "imports": {
          "@theme/critical": "{{ 'critical.js' | asset_url }}",
          "@theme/component": "{{ 'component.js' | asset_url }}",
          "@theme/dialog": "{{ 'dialog.js' | asset_url }}",
          "@theme/events": "{{ 'events.js' | asset_url }}",
          "@theme/focus": "{{ 'focus.js' | asset_url }}",
          "@theme/morph": "{{ 'morph.js' | asset_url }}",
          "@theme/paginated-list": "{{ 'paginated-list.js' | asset_url }}",
          "@theme/recently-viewed-products": "{{ 'recently-viewed-products.js' | asset_url }}",
          "@theme/section-renderer": "{{ 'section-renderer.js' | asset_url }}",
          "@theme/utilities": "{{ 'utilities.js' | asset_url }}"
        }
      }
    </script>

    {%- liquid
      render 'vite-tag' with 'critical.css', preload_stylesheet: true
      render 'vite-tag' with 'main.css'
      render 'vite-tag' with 'main.ts'
    -%}

    {% if settings.favicon != null %}
      <link rel="shortcut icon" href="{{ settings.favicon | image_url: width: 32 }}" type="image/png">
    {% endif %}

    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>

    {% render 'header-scripts' %}
    {% render 'theme-variables' %}
    {% render 'theme-style-variables' %}
    {% unless theme.role == 'development' %}
      <style>
        {{ 'uwp.critical.css' | inline_asset_content }}
      </style>
    {% endunless %}

    {{ content_for_header }}
  </head>

  <body class="template-{{ template.name }} customer-portal">
    <a class="visually-hidden focusable skip-link" href="#main-content">
      {{ 'accessibility.skip_to_content' | t }}
    </a>

    {% unless is_portal_company %}
      <uwp-cart role="region" aria-label="Cart" aria-roledescription="region"></uwp-cart>
    {% endunless %}

    {% if hide_portal_chrome %}
      <header class="portal-brand-header">
        <div class="portal-brand-header__logos">
          <a class="portal-brand-header__link" href="{{ routes.root_url }}" aria-label="Furncare home">
            {{ images['icon-logo.svg'] | image_url: width: 400 | image_tag: class: 'portal-brand-header__logo portal-brand-header__logo--furncare', alt: 'Furncare' }}
          </a>
          {{ images['careuk.png'] | image_url: width: 400 | image_tag: class: 'portal-brand-header__logo portal-brand-header__logo--partner', alt: 'Care UK' }}
        </div>
      </header>
      <style>
        .portal-brand-header { display: flex; justify-content: center; padding: 40px 24px; }
        .portal-brand-header__logos { display: flex; align-items: center; justify-content: center; gap: 40px; min-height: 40px; }
        .portal-brand-header__link { display: flex; align-items: center; }
        .portal-brand-header__logo { display: block; width: auto; height: auto; max-height: 40px; object-fit: contain; }
        .portal-brand-header__logo--furncare { max-width: 150px; }
        .portal-brand-header__logo--partner { max-width: 130px; }
        @media (max-width: 480px) {
          .portal-brand-header { padding: 28px 16px; }
          .portal-brand-header__logos { gap: 24px; }
          .portal-brand-header__logo { max-height: 34px; }
          .portal-brand-header__logo--furncare { max-width: 128px; }
          .portal-brand-header__logo--partner { max-width: 112px; }
        }
      </style>
    {% endif %}

{% comment %}
    {% if hide_portal_chrome %}
      <nav class="portal-quote-navigation" aria-label="Portal actions">
        <a href="{{ routes.cart_url }}?view=print" aria-label="Quote basket" title="Quote basket">
          {% render 'icons', icon: 'basket' %}
          <span>Quote basket</span>
        </a>
      </nav>
      <style>
        .portal-quote-navigation { display: flex; justify-content: flex-end; max-width: 1400px; margin: 0 auto; padding: 16px 24px; }
        .portal-quote-navigation a { display: inline-flex; align-items: center; gap: 8px; color: inherit; text-decoration: none; }
        .portal-quote-navigation a:hover { text-decoration: underline; }
      </style>
    {% endif %}
{% endcomment %}

    {% unless hide_portal_chrome %}
      {% render 'search-modal' %}
      {% sections 'header-group' %}
      <div class="megamenu-overlay" js-megamenu="overlay"></div>
    {% endunless %}

    <main id="main-content" role="main" tabindex="-1">
      {% if is_portal_company or request.design_mode %}
        {{ content_for_layout }}
      {% endif %}
    </main>

    {% unless hide_portal_chrome %}
      {% sections 'footer-group' %}
    {% endunless %}
  </body>
</html>
