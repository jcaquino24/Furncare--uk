<script>
function cleanUrlObject(url) {
  const paramsToRemove = [
    '_pos',
    '_sid',
    '_ss',
    'fid', // ✅ THIS is your missing one
    'pr_prod_strat',
    'pr_rec_id',
    'pr_rec_pid',
    'pr_ref_pid',
    'pr_seq'
  ];

  paramsToRemove.forEach(p => url.searchParams.delete(p));

  return url.pathname + (url.search ? url.search : '');
}

// ✅ Clean current URL
function cleanCurrentUrl() {
  try {
    const url = new URL(window.location.href);
    const clean = cleanUrlObject(url);

    if (window.location.pathname + window.location.search !== clean) {
      window.history.replaceState({}, '', clean);
    }
  } catch(e) {}
}

function cleanLinks() {
  document.querySelectorAll('a[href]').forEach(link => {
    const href = link.getAttribute('href');
    if (!href) return;

    // ✅ Skip special protocols
    if (/^(tel:|mailto:|sms:|javascript:)/i.test(href)) return;

    try {
      const url = new URL(href, window.location.origin);

      // ✅ Skip external domains (IMPORTANT FIX)
      if (url.origin !== window.location.origin) return;

      link.href = cleanUrlObject(url);

    } catch(e) {}
  });
}



document.addEventListener('click', function(e) {
  const link = e.target.closest('a[href]');
  if (!link) return;

  const href = link.getAttribute('href');
  if (!href) return;

  // ✅ Ignore tel, mail, etc.
  if (/^(tel:|mailto:|sms:|javascript:)/i.test(href)) return;

  try {
    const url = new URL(href, window.location.origin);

    // ✅ Ignore external links (Instagram, Facebook, etc.)
    if (url.origin !== window.location.origin) return;

    if (url.pathname.includes('/products/')) {
      e.preventDefault();
      window.location.href = cleanUrlObject(url);
    }

  } catch(e) {}
}, true);



// ✅ Init
document.addEventListener("DOMContentLoaded", () => {
  cleanLinks();
  cleanCurrentUrl();
});

// ✅ Observe dynamic Shopify content
const observer = new MutationObserver(cleanLinks);
observer.observe(document.body, {
  childList: true,
  subtree: true
});

// ✅ Handle back/forward
window.addEventListener('popstate', cleanCurrentUrl);
</script>



  </body>
</html>
