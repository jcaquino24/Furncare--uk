<!doctype html>
<html lang="{{ shop.locale }}">
  <head>

    <meta property="og:site_name" content="Furncare">
    <meta property="og:title" content="{{ page_title | escape }}">
    <meta property="og:description" content="{{ page_description | strip_html | escape }}">
    <meta property="og:url" content="{{ canonical_url }}">
    <meta property="og:type" content="website">
    
    <meta name="google-site-verification" content="3WxPCBxGx_eEs9TQPNr7Y7NEikX3_-Z3a5A1PYrve2k" />
    {% if page_image %}
    <meta property="og:image" content="https:{{ page_image | image_url: width: 1200 }}">
    {% elsif settings.logo %}
    <meta property="og:image" content="https:{{ settings.logo | image_url: width: 1200 }}">
    {% endif %}

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ page_title | escape }}">
    <meta name="twitter:description" content="{{ page_description | strip_html | escape }}">

    {% if page_image %}
    <meta name="twitter:image" content="https:{{ page_image | image_url: width: 1200 }}">
    {% elsif settings.logo %}
    <meta name="twitter:image" content="https:{{ settings.logo | image_url: width: 1200 }}">
    {% endif %}

    {% comment %} Meta information {% endcomment %}
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="{{ page_description }}">

    {% if collection.handle == 'all' %}
    <meta name="robots" content="noindex,follow">
    {% endif %}

    {% if request.page_type == 'search' %}
    <meta name="robots" content="noindex,follow">
    {% endif %}

    {%- liquid
      render 'vite-tag' with 'critical.css', preload_stylesheet: true
      render 'vite-tag' with 'main.css', preload_stylesheet: false
      render 'vite-tag' with 'main.ts'
    -%}

    {% if settings.favicon != null %}
      <link
        rel="shortcut icon"
        href="{{ settings.favicon | image_url: width: 32 }}"
        type="image/png"
      >
      <link
        rel="apple-touch-icon"
        href="{{ settings.favicon | image_url: width: 180 }}"
      >
    {% endif %}

    {% comment %} Preconnects {% endcomment %}
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>

    {%- unless settings.type_body_font.system? -%}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
    {%- endunless -%}

    {% comment %} Preloads {% endcomment %}
    {%- unless settings.type_body_font.system? -%}
      {{ settings.type_body_font | font_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
    {%- endunless -%}

    {% comment %} Big Caslon font preloads {% endcomment %}
    {{ 'Big_Caslon_Medium.woff' | asset_url | preload_tag: as: 'font', type: 'font/woff', crossorigin: 'anonymous' }}
    {{ 'Big_Caslon_Bold.woff' | asset_url | preload_tag: as: 'font', type: 'font/woff', crossorigin: 'anonymous' }}

    {% comment %} Scripts and utils {% endcomment %}
    {% render 'header-scripts' %}

    {% comment %} Theme variables {% endcomment %}
    {% render 'theme-variables' %}
    {% render 'theme-style-variables' %}
    <script src="{{ 'wishlist.js' | asset_url }}" defer></script>
    {% unless theme.role == 'development' %}
      <style>
        {{ 'uwp.critical.css' | inline_asset_content }}
      </style>
    {% endunless %}

    {% comment %} Required header content (trekkie etc) {% endcomment %}
    {{ content_for_header }}

    {% render 'furncare-seo-schema' %}
  </head>
  <body class="template-{{ template.name }}">
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-5745TTG"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    <a class="visually-hidden focusable skip-link" href="#main-content">
      {{ 'accessibility.skip_to_content' | t }}
    </a>

    <uwp-cart
      role="region"
      aria-label="Cart"
      aria-roledescription="region"
    ></uwp-cart>
    {% sections 'header-group' %}

    <!-- Megamenu overlay -->
    <div class="megamenu-overlay" js-megamenu="overlay"></div>

    <main id="main-content" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% comment %} Global drawers - rendered at root level to avoid z-index issues {% endcomment %}
    <div id="global-drawers">
      {% if template.name == 'product'
        and product.metafields.custom.related_package != blank
      %}
        {% render 'related-package-drawer',
          package: product.metafields.custom.related_package.value
        %}
      {% endif %}
    </div>

  </body>
</html>
