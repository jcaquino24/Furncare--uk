{%- liquid
  assign portal_company_names = settings.portal_company_name | default: 'Furncare Test' | split: ','
  assign current_company_name = customer.current_company.name | downcase | strip
  assign is_portal_company = false
  for portal_company_name in portal_company_names
    assign normalized_company_name = portal_company_name | downcase | strip
    if current_company_name != blank and current_company_name == normalized_company_name
      assign is_portal_company = true
      break
    endif
  endfor
  assign is_cart_print_template = false
  if template.name == 'cart' and template.suffix == 'print'
    assign is_cart_print_template = true
  endif
-%}
<!doctype html>
<html lang="{{ shop.locale }}">
  <head>
    {% render 'portal-home-redirect' %}

    <meta property="og:site_name" content="Furncare">
    <meta property="og:title" content="{{ page_title | escape }}">
    <meta property="og:description" content="{{ page_description | strip_html | escape }}">
    <meta property="og:url" content="{{ canonical_url }}">
    <meta property="og:type" content="website">
    
    <meta name="google-site-verification" content="3WxPCBxGx_eEs9TQPNr7Y7NEikX3_-Z3a5A1PYrve2k" />
    {% if page_image %}
    <meta property="og:image" content="https:{{ page_image | image_url: width: 1200 }}">
    {% elsif settings.logo %}
    <meta property="og:image" content="https:{{ settings.logo | image_url: width: 1200 }}">
    {% endif %}

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ page_title | escape }}">
    <meta name="twitter:description" content="{{ page_description | strip_html | escape }}">

    {% if page_image %}
    <meta name="twitter:image" content="https:{{ page_image | image_url: width: 1200 }}">
    {% elsif settings.logo %}
    <meta name="twitter:image" content="https:{{ settings.logo | image_url: width: 1200 }}">
    {% endif %}

    <script src="https://panel.testerify.com/testerify.js"
        data-tfy-key="d65b9e5f0e54bd024cd2d833099b430c1a6019a7e9c6e63172c5a14a5d5cb87e" defer></script>
    <script type="text/javascript">
    (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
    })(window, document, "clarity", "script", "wxmb2evbaq");
</script>

    {% comment %} Meta information {% endcomment %}
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="{{ page_description }}">

    <script type="importmap">
      {
        "imports": {
          "@theme/critical": "{{ 'critical.js' | asset_url }}",
          "@theme/component": "{{ 'component.js' | asset_url }}",
          "@theme/dialog": "{{ 'dialog.js' | asset_url }}",
          "@theme/events": "{{ 'events.js' | asset_url }}",
          "@theme/focus": "{{ 'focus.js' | asset_url }}",
          "@theme/morph": "{{ 'morph.js' | asset_url }}",
          "@theme/paginated-list": "{{ 'paginated-list.js' | asset_url }}",
          "@theme/recently-viewed-products": "{{ 'recently-viewed-products.js' | asset_url }}",
          "@theme/section-renderer": "{{ 'section-renderer.js' | asset_url }}",
          "@theme/utilities": "{{ 'utilities.js' | asset_url }}"
        }
      }
    </script>

    <script src="{{ 'search-query-fix.js' | asset_url }}" defer></script>

    {%- liquid
      render 'vite-tag' with 'critical.css', preload_stylesheet: true
      render 'vite-tag' with 'main.css'
      render 'vite-tag' with 'main.ts'
    -%}

    {% if settings.favicon != null %}
      <link
        rel="shortcut icon"
        href="{{ settings.favicon | image_url: width: 32 }}"
        type="image/png"
      >
      <link
        rel="apple-touch-icon"
        href="{{ settings.favicon | image_url: width: 180 }}"
      >
    {% endif %}

    {% comment %} Preconnects {% endcomment %}
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>

    {%- unless settings.type_body_font.system? -%}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
    {%- endunless -%}

    {% comment %} Preloads {% endcomment %}
    {%- unless settings.type_body_font.system? -%}
      <link
        rel="preload"
        as="font"
        href="{{ settings.type_body_font | font_url }}"
        type="font/woff2"
        crossorigin
      >
    {%- endunless -%}

    {% comment %} Big Caslon font preloads {% endcomment %}
    <link
      rel="preload"
      as="font"
      href="{{ 'Big_Caslon_Medium.woff' | asset_url }}"
      type="font/woff"
      crossorigin
    >
    <link
      rel="preload"
      as="font"
      href="{{ 'Big_Caslon_Bold.woff' | asset_url }}"
      type="font/woff"
      crossorigin
    >

    {% comment %} Scripts and utils {% endcomment %}
    {% render 'header-scripts' %}

    {% comment %} Theme variables {% endcomment %}
    {% render 'theme-variables' %}
    {% render 'theme-style-variables' %}
    {% unless theme.role == 'development' %}
      <style>
        {{ 'uwp.critical.css' | inline_asset_content }}
      </style>
    {% endunless %}

    {% comment %} Required header content (trekkie etc) {% endcomment %}
    {{ content_for_header }}

    {% render 'furncare-seo-schema' %}
  </head>
  
  <body class="template-{{ template.name }}">
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-5745TTG"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    <a class="visually-hidden focusable skip-link" href="#main-content">
      {{ 'accessibility.skip_to_content' | t }}
    </a>

    {% unless is_portal_company or is_cart_print_template %}
      <uwp-cart
        role="region"
        aria-label="Cart"
        aria-roledescription="region"
      ></uwp-cart>
    {% endunless %}
    {% if is_portal_company %}
      <header class="portal-brand-header">
        <div class="portal-brand-header__logos">
          <a class="portal-brand-header__link" href="{{ routes.root_url }}" aria-label="Furncare home">
            {{ images['icon-logo.svg'] | image_url: width: 400 | image_tag: class: 'portal-brand-header__logo portal-brand-header__logo--furncare', alt: 'Furncare' }}
          </a>
          {{ images['careuk.png'] | image_url: width: 400 | image_tag: class: 'portal-brand-header__logo portal-brand-header__logo--partner', alt: 'Care UK' }}
        </div>
      </header>
      <style>
        .portal-brand-header { display: flex; justify-content: center; padding: 40px 24px; }
        .portal-brand-header__logos { display: flex; align-items: center; justify-content: center; gap: 40px; min-height: 40px; }
        .portal-brand-header__link { display: flex; align-items: center; }
        .portal-brand-header__logo { display: block; width: auto; height: auto; max-height: 40px; object-fit: contain; }
        .portal-brand-header__logo--furncare { max-width: 150px; }
        .portal-brand-header__logo--partner { max-width: 130px; }
        @media (max-width: 480px) {
          .portal-brand-header { padding: 28px 16px; }
          .portal-brand-header__logos { gap: 24px; }
          .portal-brand-header__logo { max-height: 34px; }
          .portal-brand-header__logo--furncare { max-width: 128px; }
          .portal-brand-header__logo--partner { max-width: 112px; }
        }
      </style>
    {% endif %}
    {% unless is_portal_company %}
      {% render 'search-modal' %}
      {% sections 'header-group' %}
    {% endunless %}

    {% unless is_cart_print_template %}
      <div class="megamenu-overlay" js-megamenu="overlay"></div>
    {% endunless %}

    <main id="main-content" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% unless is_portal_company %}
      {% sections 'footer-group' %}
    {% endunless %}

    {% comment %} Global drawers - rendered at root level to avoid z-index issues {% endcomment %}
    <div id="global-drawers">
      {% if template.name == 'product'
        and product.metafields.custom.related_package != blank
      %}
        {% render 'related-package-drawer',
          package: product.metafields.custom.related_package.value
        %}
      {% endif %}
    </div>

