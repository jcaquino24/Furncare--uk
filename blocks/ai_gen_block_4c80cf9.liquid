{% doc %}
  @prompt
    a place to put the addresses of our showroom and distribution centre - with a map on on the left
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-locations-container-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
  }

  .ai-locations-wrapper-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: {{ block.settings.gap }}px;
    align-items: stretch;
  }

  .ai-locations-map-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    min-height: {{ block.settings.min_height }}px;
    border-radius: {{ block.settings.border_radius }}px;
    overflow: hidden;
  }

  .ai-locations-map-{{ ai_gen_id }} iframe {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }

  .ai-locations-addresses-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.address_gap }}px;
  }

  .ai-locations-address-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    padding: {{ block.settings.card_padding }}px;
    border-radius: {{ block.settings.border_radius }}px;
    border: 1px solid {{ block.settings.card_border_color }};
  }

  .ai-locations-address-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    font-weight: 600;
    color: {{ block.settings.title_color }};
    margin: 0 0 {{ block.settings.title_margin }}px 0;
  }

  .ai-locations-address-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    color: {{ block.settings.text_color }};
    line-height: 1.6;
    margin: 0;
  }

  .ai-locations-address-text-{{ ai_gen_id }} p {
    margin: 0 0 8px 0;
  }

  .ai-locations-address-text-{{ ai_gen_id }} p:last-child {
    margin-bottom: 0;
  }

  @media screen and (max-width: 749px) {
    .ai-locations-wrapper-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }

    .ai-locations-map-{{ ai_gen_id }} {
      order: {{ block.settings.mobile_map_position }};
      min-height: 300px;
    }

    .ai-locations-addresses-{{ ai_gen_id }} {
      order: {{ block.settings.mobile_addresses_position }};
    }
  }
{% endstyle %}

<location-map-{{ ai_gen_id }}
  class="ai-locations-container-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-locations-wrapper-{{ ai_gen_id }}">
    <div class="ai-locations-map-{{ ai_gen_id }}">
      {% if block.settings.map_embed_url != blank %}
        {{ block.settings.map_embed_url }}
      {% else %}
        <div style="background-color: #f4f4f4; width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; color: #666; font-size: 14px; text-align: center; padding: 20px;">
          Add your map embed code in the block settings
        </div>
      {% endif %}
    </div>

    <div class="ai-locations-addresses-{{ ai_gen_id }}">
      {% if block.settings.location_1_enabled %}
        <div class="ai-locations-address-card-{{ ai_gen_id }}">
          {% if block.settings.location_1_title != blank %}
            <h3 class="ai-locations-address-title-{{ ai_gen_id }}">{{ block.settings.location_1_title }}</h3>
          {% endif %}
          {% if block.settings.location_1_address != blank %}
            <div class="ai-locations-address-text-{{ ai_gen_id }}">
              {{ block.settings.location_1_address }}
            </div>
          {% endif %}
        </div>
      {% endif %}

      {% if block.settings.location_2_enabled %}
        <div class="ai-locations-address-card-{{ ai_gen_id }}">
          {% if block.settings.location_2_title != blank %}
            <h3 class="ai-locations-address-title-{{ ai_gen_id }}">{{ block.settings.location_2_title }}</h3>
          {% endif %}
          {% if block.settings.location_2_address != blank %}
            <div class="ai-locations-address-text-{{ ai_gen_id }}">
              {{ block.settings.location_2_address }}
            </div>
          {% endif %}
        </div>
      {% endif %}
    </div>
  </div>
</location-map-{{ ai_gen_id }}>

<script>
  (function() {
    class LocationMap{{ai_gen_id}} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.style.display = 'block';
      }
    }

    customElements.define('location-map-{{ ai_gen_id }}', LocationMap{{ai_gen_id}});
  })();
</script>

{% schema %}
{
  "name": "Location addresses",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Map"
    },
    {
      "type": "html",
      "id": "map_embed_url",
      "label": "Map embed code",
      "info": "Paste your Google Maps iframe embed code here"
    },
    {
      "type": "range",
      "id": "min_height",
      "label": "Minimum height",
      "min": 300,
      "max": 800,
      "step": 50,
      "unit": "px",
      "default": 500
    },
    {
      "type": "header",
      "content": "Location 1"
    },
    {
      "type": "checkbox",
      "id": "location_1_enabled",
      "label": "Enable location 1",
      "default": true
    },
    {
      "type": "text",
      "id": "location_1_title",
      "label": "Title",
      "default": "Showroom"
    },
    {
      "type": "richtext",
      "id": "location_1_address",
      "label": "Address",
      "default": "<p>123 High Street<br>London<br>SW1A 1AA<br>United Kingdom</p>"
    },
    {
      "type": "header",
      "content": "Location 2"
    },
    {
      "type": "checkbox",
      "id": "location_2_enabled",
      "label": "Enable location 2",
      "default": true
    },
    {
      "type": "text",
      "id": "location_2_title",
      "label": "Title",
      "default": "Distribution Centre"
    },
    {
      "type": "richtext",
      "id": "location_2_address",
      "label": "Address",
      "default": "<p>456 Industrial Park<br>Manchester<br>M1 1AA<br>United Kingdom</p>"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap between map and addresses",
      "min": 10,
      "max": 80,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "address_gap",
      "label": "Gap between address cards",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "select",
      "id": "mobile_map_position",
      "label": "Mobile map position",
      "options": [
        {
          "value": "1",
          "label": "Top"
        },
        {
          "value": "2",
          "label": "Bottom"
        }
      ],
      "default": "1"
    },
    {
      "type": "select",
      "id": "mobile_addresses_position",
      "label": "Mobile addresses position",
      "options": [
        {
          "value": "1",
          "label": "Top"
        },
        {
          "value": "2",
          "label": "Bottom"
        }
      ],
      "default": "2"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_border_color",
      "label": "Card border color",
      "default": "#e5e5e5"
    },
    {
      "type": "range",
      "id": "card_padding",
      "label": "Card padding",
      "min": 15,
      "max": 50,
      "step": 5,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Title size",
      "min": 14,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "title_margin",
      "label": "Title bottom margin",
      "min": 5,
      "max": 30,
      "step": 5,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Text size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#333333"
    }
  ],
  "presets": [
    {
      "name": "Location addresses"
    }
  ]
}
{% endschema %}
