{% doc %}
  @prompt
    generate a quick add to cart block - so i can link it to a product and the user simply has to click it to add the product to basket
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-quick-add-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
  }

  .ai-quick-add-button-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
    padding: {{ block.settings.button_padding }}px {{ block.settings.button_padding | times: 1.5 }}px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    border: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
    border-radius: {{ block.settings.border_radius }}px;
    font-size: {{ block.settings.font_size }}px;
    font-weight: {{ block.settings.font_weight }};
    cursor: pointer;
    transition: all 0.3s ease;
    text-decoration: none;
  }

  .ai-quick-add-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
    color: {{ block.settings.button_hover_text_color }};
    border-color: {{ block.settings.border_hover_color }};
  }

  .ai-quick-add-button-{{ ai_gen_id }}:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .ai-quick-add-icon-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    flex-shrink: 0;
  }

  .ai-quick-add-icon-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
  }

  .ai-quick-add-spinner-{{ ai_gen_id }} {
    display: none;
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    border: 2px solid {{ block.settings.button_text_color }};
    border-top-color: transparent;
    border-radius: 50%;
    animation: ai-quick-add-spin-{{ ai_gen_id }} 0.6s linear infinite;
  }

  .ai-quick-add-button-{{ ai_gen_id }}.loading .ai-quick-add-spinner-{{ ai_gen_id }} {
    display: block;
  }

  .ai-quick-add-button-{{ ai_gen_id }}.loading .ai-quick-add-icon-{{ ai_gen_id }} {
    display: none;
  }

  .ai-quick-add-success-{{ ai_gen_id }} {
    display: none;
    color: {{ block.settings.success_color }};
    font-size: 14px;
    margin-top: 8px;
    text-align: center;
  }

  .ai-quick-add-success-{{ ai_gen_id }}.active {
    display: block;
  }

  .ai-quick-add-error-{{ ai_gen_id }} {
    display: none;
    color: {{ block.settings.error_color }};
    font-size: 14px;
    margin-top: 8px;
    text-align: center;
  }

  .ai-quick-add-error-{{ ai_gen_id }}.active {
    display: block;
  }

  @keyframes ai-quick-add-spin-{{ ai_gen_id }} {
    to {
      transform: rotate(360deg);
    }
  }
{% endstyle %}

<quick-add-to-cart-{{ ai_gen_id }}
  class="ai-quick-add-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
  data-product-id="{{ block.settings.product.id }}"
  data-variant-id="{% if block.settings.product.selected_or_first_available_variant %}{{ block.settings.product.selected_or_first_available_variant.id }}{% endif %}"
>
  {% if block.settings.product %}
    <button
      type="button"
      class="ai-quick-add-button-{{ ai_gen_id }}"
      {% unless block.settings.product.selected_or_first_available_variant.available %}disabled{% endunless %}
    >
      {% if block.settings.show_icon %}
        <span class="ai-quick-add-icon-{{ ai_gen_id }}">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="9" cy="21" r="1"></circle>
            <circle cx="20" cy="21" r="1"></circle>
            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
          </svg>
        </span>
      {% endif %}
      <span class="ai-quick-add-spinner-{{ ai_gen_id }}"></span>
      <span class="ai-quick-add-text-{{ ai_gen_id }}">
        {% if block.settings.product.selected_or_first_available_variant.available %}
          {{ block.settings.button_text }}
        {% else %}
          {{ block.settings.sold_out_text }}
        {% endif %}
      </span>
    </button>

    <div class="ai-quick-add-success-{{ ai_gen_id }}">
      {{ block.settings.success_message }}
    </div>

    <div class="ai-quick-add-error-{{ ai_gen_id }}">
      {{ block.settings.error_message }}
    </div>
  {% else %}
    <div style="padding: 20px; text-align: center; color: #666; font-size: 14px; border: 1px dashed #ccc; border-radius: 8px;">
      Next, select a product to enable quick add to cart
    </div>
  {% endif %}
</quick-add-to-cart-{{ ai_gen_id }}>

<script>
  (function() {
    class QuickAddToCart{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.button = this.querySelector('.ai-quick-add-button-{{ ai_gen_id }}');
        this.successMessage = this.querySelector('.ai-quick-add-success-{{ ai_gen_id }}');
        this.errorMessage = this.querySelector('.ai-quick-add-error-{{ ai_gen_id }}');
      }

      connectedCallback() {
        if (this.button) {
          this.button.addEventListener('click', this.handleAddToCart.bind(this));
        }
      }

      async handleAddToCart(event) {
        event.preventDefault();

        const variantId = this.dataset.variantId;
        if (!variantId) {
          this.showError();
          return;
        }

        this.button.classList.add('loading');
        this.button.disabled = true;
        this.hideMessages();

        try {
          const response = await fetch('/cart/add.js', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({
              items: [{
                id: variantId,
                quantity: 1
              }]
            })
          });

          if (!response.ok) {
            throw new Error('Failed to add to cart');
          }

          const data = await response.json();

          this.showSuccess();

          const cartUpdateEvent = new CustomEvent('cart:updated', {
            bubbles: true,
            detail: { cart: data }
          });
          document.dispatchEvent(cartUpdateEvent);

          setTimeout(() => {
            this.hideMessages();
          }, 3000);

        } catch (error) {
          this.showError();
          setTimeout(() => {
            this.hideMessages();
          }, 3000);
        } finally {
          this.button.classList.remove('loading');
          this.button.disabled = false;
        }
      }

      showSuccess() {
        this.successMessage.classList.add('active');
      }

      showError() {
        this.errorMessage.classList.add('active');
      }

      hideMessages() {
        this.successMessage.classList.remove('active');
        this.errorMessage.classList.remove('active');
      }
    }

    customElements.define('quick-add-to-cart-{{ ai_gen_id }}', QuickAddToCart{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Quick add to cart",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Product"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Product"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Add to cart"
    },
    {
      "type": "text",
      "id": "sold_out_text",
      "label": "Sold out text",
      "default": "Sold out"
    },
    {
      "type": "checkbox",
      "id": "show_icon",
      "label": "Show cart icon",
      "default": true
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size",
      "min": 12,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Font size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "Font weight",
      "options": [
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi-bold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ],
      "default": "600"
    },
    {
      "type": "range",
      "id": "button_padding",
      "label": "Padding",
      "min": 8,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 4
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "Border width",
      "min": 0,
      "max": 4,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_hover_bg_color",
      "label": "Hover background",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "button_hover_text_color",
      "label": "Hover text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "border_hover_color",
      "label": "Hover border",
      "default": "#333333"
    },
    {
      "type": "header",
      "content": "Messages"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "Added to cart successfully!"
    },
    {
      "type": "text",
      "id": "error_message",
      "label": "Error message",
      "default": "Unable to add to cart. Please try again."
    },
    {
      "type": "color",
      "id": "success_color",
      "label": "Success color",
      "default": "#008060"
    },
    {
      "type": "color",
      "id": "error_color",
      "label": "Error color",
      "default": "#D82C0D"
    }
  ],
  "presets": [
    {
      "name": "Quick add to cart"
    }
  ]
}
{% endschema %}
