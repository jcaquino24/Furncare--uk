{% liquid
  assign image = block.settings.image
  assign aspect_ratio = block.settings.aspect_ratio
%}
<div class="media">
  {% render 'responsive-image', image: image, aspect_ratio: aspect_ratio %}
</div>

{% schema %}
{
  "name": "Media",
  "tag": null,
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "Aspect ratio",
      "default": "1/1",
      "options": [
        {
          "value": "1/1",
          "label": "1:1"
        },
        {
          "value": "2/1",
          "label": "2:1"
        },
        {
          "value": "1/2",
          "label": "1:2"
        },
        {
          "value": "3/2",
          "label": "3:2"
        },
        {
          "value": "2/3",
          "label": "2:3"
        },
        {
          "value": "4/3",
          "label": "4:3"
        },
        {
          "value": "3/4",
          "label": "3:4"
        },
        {
          "value": "5/4",
          "label": "5:4"
        },
        {
          "value": "4/5",
          "label": "4:5"
        },
        {
          "value": "16/9",
          "label": "16:9"
        },
        {
          "value": "9/16",
          "label": "9:16"
        },
        {
          "value": "16/10",
          "label": "16:10"
        },
        {
          "value": "10/16",
          "label": "10:16"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Media",
      "settings": {
        "aspect_ratio": "5/4"
      }
    }
  ]
}
{% endschema %}
