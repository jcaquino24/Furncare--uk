{% doc %}
  @prompt
    Create a simple form embed block that allows merchants to paste flipbook embed code (like publuu or other third-party forms) without any rich text content. 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-embed-container-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
  }

  .ai-embed-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    min-height: {{ block.settings.min_height }}px;
  }

  .ai-embed-content-{{ ai_gen_id }} {
    width: 100%;
  }

  .ai-embed-content-{{ ai_gen_id }} iframe {
    width: 100%;
    border: none;
  }

  .ai-embed-placeholder-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: {{ block.settings.min_height }}px;
    background-color: #f4f4f4;
    border: 2px dashed #cccccc;
    border-radius: 8px;
    padding: 40px 20px;
    text-align: center;
  }

  .ai-embed-placeholder-text-{{ ai_gen_id }} {
    color: #666666;
    font-size: 14px;
    max-width: 400px;
  }

  @media screen and (max-width: 749px) {
    .ai-embed-container-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-embed-wrapper-{{ ai_gen_id }} {
      min-height: {{ block.settings.mobile_min_height }}px;
    }

    .ai-embed-placeholder-{{ ai_gen_id }} {
      min-height: {{ block.settings.mobile_min_height }}px;
    }
  }
{% endstyle %}

<div class="ai-embed-container-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-embed-wrapper-{{ ai_gen_id }}">
    {% if block.settings.embed_code != blank %}
      <div class="ai-embed-content-{{ ai_gen_id }}">
        {{ block.settings.embed_code }}
      </div>
    {% else %}
      <div class="ai-embed-placeholder-{{ ai_gen_id }}">
        <div class="ai-embed-placeholder-text-{{ ai_gen_id }}">
          Paste your embed code in the block settings to display your flipbook, form, or other third-party content here.
        </div>
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Embed code",
  "settings": [
    {
      "type": "html",
      "id": "embed_code",
      "label": "Embed code"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "min_height",
      "label": "Minimum height on desktop",
      "min": 300,
      "max": 1000,
      "step": 50,
      "unit": "px",
      "default": 600
    },
    {
      "type": "range",
      "id": "mobile_min_height",
      "label": "Minimum height on mobile",
      "min": 300,
      "max": 800,
      "step": 50,
      "unit": "px",
      "default": 500
    }
  ],
  "presets": [
    {
      "name": "Embed code"
    }
  ]
}
{% endschema %}
