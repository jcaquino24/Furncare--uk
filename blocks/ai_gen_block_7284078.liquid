{% doc %}
  @prompt
    Create a self-contained Shopify OS 2.0 theme block with a button labelled "Request a Package Quote" (editable in theme editor settings). When the button is clicked, a modal/popup overlay appears centred on screen containing an embedded form via a customisable HTML embed code textarea setting (for third-party forms like Typeform, HubSpot, Calendly etc). The form should NOT be visible on the page by default — it only appears inside the modal when the button is clicked. The modal should have a close button (X) in the top right corner and close when clicking outside the overlay. Styling should be clean, minimal and premium to suit a luxury furniture brand. All text and embed code should be editable via theme editor settings.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-quote-modal-trigger-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
  }

  .ai-quote-modal-button-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    border: {{ block.settings.button_border_width }}px solid {{ block.settings.button_border_color }};
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: {{ block.settings.button_font_weight }};
    text-decoration: none;
    cursor: pointer;
    transition: all 0.3s ease;
    font-family: {{ block.settings.button_font.family }}, {{ block.settings.button_font.fallback_families }};
    font-weight: {{ block.settings.button_font.weight }};
    letter-spacing: {{ block.settings.button_letter_spacing }}px;
    text-transform: {{ block.settings.button_text_transform }};
  }

  .ai-quote-modal-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
    color: {{ block.settings.button_hover_text_color }};
    border-color: {{ block.settings.button_hover_border_color }};
    transform: translateY(-1px);
  }

  .ai-quote-modal-overlay-{{ ai_gen_id }} {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.overlay_bg_color }};
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
    padding: 20px;
  }

  .ai-quote-modal-overlay-{{ ai_gen_id }}.active {
    opacity: 1;
    visibility: visible;
  }

  .ai-quote-modal-container-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    max-width: {{ block.settings.modal_max_width }}px;
    max-height: 90vh;
    background-color: {{ block.settings.modal_bg_color }};
    border-radius: {{ block.settings.modal_border_radius }}px;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.2);
    overflow: hidden;
    transform: scale(0.9);
    transition: transform 0.3s ease;
  }

  .ai-quote-modal-overlay-{{ ai_gen_id }}.active .ai-quote-modal-container-{{ ai_gen_id }} {
    transform: scale(1);
  }

  .ai-quote-modal-header-{{ ai_gen_id }} {
    position: relative;
    padding: {{ block.settings.modal_padding }}px;
    border-bottom: 1px solid {{ block.settings.modal_border_color }};
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .ai-quote-modal-title-{{ ai_gen_id }} {
    margin: 0;
    font-size: {{ block.settings.modal_title_size }}px;
    color: {{ block.settings.modal_text_color }};
    font-weight: 600;
    font-family: {{ block.settings.button_font.family }}, {{ block.settings.button_font.fallback_families }};
  }

  .ai-quote-modal-close-{{ ai_gen_id }} {
    position: relative;
    width: 32px;
    height: 32px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: {{ block.settings.modal_text_color }};
    opacity: 0.6;
    transition: opacity 0.2s ease, transform 0.2s ease;
    flex-shrink: 0;
  }

  .ai-quote-modal-close-{{ ai_gen_id }}:hover {
    opacity: 1;
    transform: rotate(90deg);
  }

  .ai-quote-modal-close-{{ ai_gen_id }} svg {
    width: 20px;
    height: 20px;
  }

  .ai-quote-modal-body-{{ ai_gen_id }} {
    padding: {{ block.settings.modal_padding }}px;
    overflow-y: auto;
    max-height: calc(90vh - 100px);
  }

  .ai-quote-modal-embed-{{ ai_gen_id }} {
    width: 100%;
    min-height: {{ block.settings.embed_min_height }}px;
  }

  .ai-quote-modal-embed-{{ ai_gen_id }} iframe {
    width: 100%;
    border: none;
  }

  .ai-quote-modal-empty-{{ ai_gen_id }} {
    padding: 60px 20px;
    text-align: center;
    color: {{ block.settings.modal_text_color }};
    opacity: 0.5;
    font-size: 14px;
  }

  @media screen and (max-width: 749px) {
    .ai-quote-modal-container-{{ ai_gen_id }} {
      max-width: 100%;
      max-height: 95vh;
      border-radius: {{ block.settings.modal_border_radius | divided_by: 2 }}px;
    }

    .ai-quote-modal-header-{{ ai_gen_id }},
    .ai-quote-modal-body-{{ ai_gen_id }} {
      padding: {{ block.settings.modal_padding | times: 0.7 }}px;
    }

    .ai-quote-modal-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.modal_title_size | times: 0.85 }}px;
    }

    .ai-quote-modal-button-{{ ai_gen_id }} {
      width: 100%;
      justify-content: center;
    }
  }
{% endstyle %}

<quote-modal-{{ ai_gen_id }}
  class="ai-quote-modal-trigger-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <button
    class="ai-quote-modal-button-{{ ai_gen_id }}"
    aria-label="{{ block.settings.button_text }}"
    type="button"
  >
    {{ block.settings.button_text }}
  </button>

  <div
    class="ai-quote-modal-overlay-{{ ai_gen_id }}"
    role="dialog"
    aria-modal="true"
    aria-labelledby="modal-title-{{ ai_gen_id }}"
  >
    <div class="ai-quote-modal-container-{{ ai_gen_id }}">
      <div class="ai-quote-modal-header-{{ ai_gen_id }}">
        <h2
          id="modal-title-{{ ai_gen_id }}"
          class="ai-quote-modal-title-{{ ai_gen_id }}"
        >
          {{ block.settings.modal_title }}
        </h2>
        <button
          class="ai-quote-modal-close-{{ ai_gen_id }}"
          aria-label="Close modal"
          type="button"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>
      <div class="ai-quote-modal-body-{{ ai_gen_id }}">
        {% if block.settings.embed_code != blank %}
          <div class="ai-quote-modal-embed-{{ ai_gen_id }}">
            {{ block.settings.embed_code }}
          </div>
        {% else %}
          <div class="ai-quote-modal-empty-{{ ai_gen_id }}">
            Next, add your embed code in the theme editor settings
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</quote-modal-{{ ai_gen_id }}>

<script>
  (function() {
    class QuoteModal{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.button = this.querySelector('.ai-quote-modal-button-{{ ai_gen_id }}');
        this.overlay = this.querySelector('.ai-quote-modal-overlay-{{ ai_gen_id }}');
        this.closeButton = this.querySelector('.ai-quote-modal-close-{{ ai_gen_id }}');
        this.container = this.querySelector('.ai-quote-modal-container-{{ ai_gen_id }}');
      }

      connectedCallback() {
        this.setupEventListeners();
      }

      setupEventListeners() {
        this.button.addEventListener('click', () => this.openModal());
        this.closeButton.addEventListener('click', () => this.closeModal());
        this.overlay.addEventListener('click', (e) => {
          if (e.target === this.overlay) {
            this.closeModal();
          }
        });

        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && this.overlay.classList.contains('active')) {
            this.closeModal();
          }
        });
      }

      openModal() {
        this.overlay.classList.add('active');
        document.body.style.overflow = 'hidden';
        this.closeButton.focus();
      }

      closeModal() {
        this.overlay.classList.remove('active');
        document.body.style.overflow = '';
        this.button.focus();
      }
    }

    customElements.define('quote-modal-{{ ai_gen_id }}', QuoteModal{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Quote request modal",
  "settings": [
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Request a Package Quote"
    },
    {
      "type": "font_picker",
      "id": "button_font",
      "label": "Font",
      "default": "red_hat_display_n4"
    },
    {
      "type": "range",
      "id": "button_font_size",
      "label": "Font size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "select",
      "id": "button_text_transform",
      "label": "Text transform",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "uppercase",
          "label": "Uppercase"
        },
        {
          "value": "lowercase",
          "label": "Lowercase"
        },
        {
          "value": "capitalize",
          "label": "Capitalize"
        }
