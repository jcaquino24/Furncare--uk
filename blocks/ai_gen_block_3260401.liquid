{% doc %}
  @prompt
    Create a simple spacer section that adds vertical spacing between sections. The spacer should have customizable height settings (small, medium, large) so the merchant can control how much space is added. Keep it minimal and clean.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-spacer-{{ ai_gen_id }} {
    display: block;
    width: 100%;
  }

  .ai-spacer-{{ ai_gen_id }}--small {
    height: {{ block.settings.small_height }}px;
  }

  .ai-spacer-{{ ai_gen_id }}--medium {
    height: {{ block.settings.medium_height }}px;
  }

  .ai-spacer-{{ ai_gen_id }}--large {
    height: {{ block.settings.large_height }}px;
  }

  @media screen and (max-width: 749px) {
    .ai-spacer-{{ ai_gen_id }}--small {
      height: {{ block.settings.small_height_mobile }}px;
    }

    .ai-spacer-{{ ai_gen_id }}--medium {
      height: {{ block.settings.medium_height_mobile }}px;
    }

    .ai-spacer-{{ ai_gen_id }}--large {
      height: {{ block.settings.large_height_mobile }}px;
    }
  }
{% endstyle %}

<div
  class="ai-spacer-{{ ai_gen_id }} ai-spacer-{{ ai_gen_id }}--{{ block.settings.spacing_size }}"
  {{ block.shopify_attributes }}
></div>

{% schema %}
{
  "name": "Spacer",
  "settings": [
    {
      "type": "select",
      "id": "spacing_size",
      "label": "Spacing size",
      "options": [
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ],
      "default": "medium"
    },
    {
      "type": "header",
      "content": "Desktop spacing"
    },
    {
      "type": "range",
      "id": "small_height",
      "label": "Small height",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "medium_height",
      "label": "Medium height",
      "min": 10,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "large_height",
      "label": "Large height",
      "min": 10,
      "max": 200,
      "step": 5,
      "unit": "px",
      "default": 100
    },
    {
      "type": "header",
      "content": "Mobile spacing"
    },
    {
      "type": "range",
      "id": "small_height_mobile",
      "label": "Small height",
      "min": 10,
      "max": 80,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "medium_height_mobile",
      "label": "Medium height",
      "min": 10,
      "max": 120,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "large_height_mobile",
      "label": "Large height",
      "min": 10,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "Spacer"
    }
  ]
}
{% endschema %}
