{% doc %}
  @prompt
    Create a simple form embed block that allows merchants to paste form embed code (like HubSpot or other third-party forms) without any rich text content. The block should have a text area setting for the form embed code and basic styling options like width, alignment, and padding controls.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-form-embed-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding-top: {{ block.settings.padding_top }}px;
    padding-bottom: {{ block.settings.padding_bottom }}px;
  }

  .ai-form-embed-wrapper-{{ ai_gen_id }} {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin-left: {% if block.settings.alignment == 'left' %}0{% elsif block.settings.alignment == 'center' %}auto{% else %}auto{% endif %};
    margin-right: {% if block.settings.alignment == 'right' %}0{% elsif block.settings.alignment == 'center' %}auto{% else %}auto{% endif %};
  }

  .ai-form-embed-content-{{ ai_gen_id }} {
    width: 100%;
  }

  .ai-form-embed-placeholder-{{ ai_gen_id }} {
    background-color: #f4f4f4;
    border: 2px dashed #cccccc;
    border-radius: 8px;
    padding: 40px 20px;
    text-align: center;
    color: #666666;
  }

  .ai-form-embed-placeholder-icon-{{ ai_gen_id }} {
    width: 48px;
    height: 48px;
    margin: 0 auto 16px;
    opacity: 0.5;
  }

  .ai-form-embed-placeholder-title-{{ ai_gen_id }} {
    font-size: 16px;
    font-weight: 600;
    margin: 0 0 8px;
    color: #333333;
  }

  .ai-form-embed-placeholder-text-{{ ai_gen_id }} {
    font-size: 14px;
    margin: 0;
    color: #666666;
  }

  @media screen and (max-width: 749px) {
    .ai-form-embed-wrapper-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-form-embed-{{ ai_gen_id }} {
      padding-top: {{ block.settings.padding_top | times: 0.7 | round }}px;
      padding-bottom: {{ block.settings.padding_bottom | times: 0.7 | round }}px;
    }
  }
{% endstyle %}

<div class="ai-form-embed-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-form-embed-wrapper-{{ ai_gen_id }}">
    {% if block.settings.form_embed_code != blank %}
      <div class="ai-form-embed-content-{{ ai_gen_id }}">
        {{ block.settings.form_embed_code }}
      </div>
    {% else %}
      <div class="ai-form-embed-placeholder-{{ ai_gen_id }}">
        <div class="ai-form-embed-placeholder-icon-{{ ai_gen_id }}">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
            <polyline points="14 2 14 8 20 8"></polyline>
            <line x1="12" y1="18" x2="12" y2="12"></line>
            <line x1="9" y1="15" x2="15" y2="15"></line>
          </svg>
        </div>
        <p class="ai-form-embed-placeholder-title-{{ ai_gen_id }}">Form embed code needed</p>
        <p class="ai-form-embed-placeholder-text-{{ ai_gen_id }}">Paste your HubSpot or third-party form embed code in the block settings</p>
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Form embed",
  "settings": [
    {
      "type": "header",
      "content": "Form code"
    },
    {
      "type": "html",
      "id": "form_embed_code",
      "label": "Form embed code",
      "info": "Paste your complete form embed code from HubSpot or other form providers"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Form embed"
    }
  ]
}
{% endschema %}
