{% doc %}
  @prompt
    Create an auto-scrolling marquee image section that continuously and smoothly scrolls a row of images horizontally in an infinite loop, with no user interaction required. The images should loop seamlessly, pause on hover, and be configurable in speed and number of images. Match the premium, minimal aesthetic of a luxury furniture brand.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-marquee-container-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    overflow: hidden;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.vertical_padding }}px 0;
  }

  .ai-marquee-wrapper-{{ ai_gen_id }} {
    display: flex;
    width: fit-content;
    animation: ai-marquee-scroll-{{ ai_gen_id }} {{ block.settings.scroll_speed }}s linear infinite;
  }

  .ai-marquee-container-{{ ai_gen_id }}:hover .ai-marquee-wrapper-{{ ai_gen_id }} {
    animation-play-state: paused;
  }

  .ai-marquee-track-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.image_gap }}px;
    flex-shrink: 0;
  }

  .ai-marquee-image-wrapper-{{ ai_gen_id }} {
    width: {{ block.settings.image_width }}px;
    height: {{ block.settings.image_height }}px;
    flex-shrink: 0;
    overflow: hidden;
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-marquee-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-marquee-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-marquee-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  @keyframes ai-marquee-scroll-{{ ai_gen_id }} {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-marquee-image-wrapper-{{ ai_gen_id }} {
      width: {{ block.settings.image_width | times: 0.7 }}px;
      height: {{ block.settings.image_height | times: 0.7 }}px;
    }
  }
{% endstyle %}

<marquee-scroller-{{ ai_gen_id }}
  class="ai-marquee-container-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-marquee-wrapper-{{ ai_gen_id }}">
    <div class="ai-marquee-track-{{ ai_gen_id }}">
      {% for i in (1..12) %}
        {% liquid
          assign image_key = 'image_' | append: i
          assign image = block.settings[image_key]
        %}
        <div class="ai-marquee-image-wrapper-{{ ai_gen_id }}">
          {% if image %}
            <img
              src="{{ image | image_url: width: 800 }}"
              alt="{{ image.alt | escape }}"
              loading="lazy"
              width="{{ block.settings.image_width }}"
              height="{{ block.settings.image_height }}"
              class="ai-marquee-image-{{ ai_gen_id }}"
            >
          {% else %}
            <div class="ai-marquee-placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
    <div class="ai-marquee-track-{{ ai_gen_id }}" aria-hidden="true">
      {% for i in (1..12) %}
        {% liquid
          assign image_key = 'image_' | append: i
          assign image = block.settings[image_key]
        %}
        <div class="ai-marquee-image-wrapper-{{ ai_gen_id }}">
          {% if image %}
            <img
              src="{{ image | image_url: width: 800 }}"
              alt="{{ image.alt | escape }}"
              loading="lazy"
              width="{{ block.settings.image_width }}"
              height="{{ block.settings.image_height }}"
              class="ai-marquee-image-{{ ai_gen_id }}"
            >
          {% else %}
            <div class="ai-marquee-placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</marquee-scroller-{{ ai_gen_id }}>

<script>
  (function() {
    class MarqueeScroller{{ai_gen_id}} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.adjustAnimation();
      }

      adjustAnimation() {
        const wrapper = this.querySelector('.ai-marquee-wrapper-{{ ai_gen_id }}');
        const track = this.querySelector('.ai-marquee-track-{{ ai_gen_id }}');
        
        if (wrapper && track) {
          const trackWidth = track.offsetWidth;
          wrapper.style.setProperty('--track-width', `${trackWidth}px`);
        }
      }
    }

    customElements.define('marquee-scroller-{{ ai_gen_id }}', MarqueeScroller{{ai_gen_id}});
  })();
</script>

