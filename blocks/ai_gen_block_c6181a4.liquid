{% doc %}
  @prompt
    An interactive before/after image slider. It should show 2 images overlapped that can be compared by dragging the slider.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-before-after-slider-{{ ai_gen_id }} {
    display: block;
    position: relative;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    overflow: hidden;
    border-radius: {{ block.settings.border_radius }}px;
    user-select: none;
    touch-action: none;
  }

  .ai-before-after-slider__container-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: 0;
    padding-bottom: {{ block.settings.aspect_ratio }}%;
    background-color: #f4f4f4;
  }

  .ai-before-after-slider__image-wrapper-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  .ai-before-after-slider__image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-before-after-slider__after-{{ ai_gen_id }} {
    clip-path: inset(0 0 0 var(--ai-slider-position-{{ ai_gen_id }}));
  }

  .ai-before-after-slider__divider-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--ai-slider-position-{{ ai_gen_id }});
    width: {{ block.settings.divider_width }}px;
    background-color: {{ block.settings.divider_color }};
    cursor: ew-resize;
    transform: translateX(-50%);
    z-index: 3;
  }

  .ai-before-after-slider__handle-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: {{ block.settings.handle_size }}px;
    height: {{ block.settings.handle_size }}px;
    background-color: {{ block.settings.handle_color }};
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
  }

  .ai-before-after-slider__handle-icon-{{ ai_gen_id }} {
    width: calc({{ block.settings.handle_size }}px * 0.5);
    height: calc({{ block.settings.handle_size }}px * 0.5);
    color: {{ block.settings.handle_icon_color }};
  }

  .ai-before-after-slider__label-{{ ai_gen_id }} {
    position: absolute;
    top: {{ block.settings.label_position_top }}%;
    padding: 8px 16px;
    background-color: {{ block.settings.label_bg_color }};
    color: {{ block.settings.label_text_color }};
    font-size: {{ block.settings.label_font_size }}px;
    font-weight: 600;
    border-radius: 4px;
    z-index: 2;
    pointer-events: none;
  }

  .ai-before-after-slider__label--before-{{ ai_gen_id }} {
    left: {{ block.settings.label_offset }}px;
  }

  .ai-before-after-slider__label--after-{{ ai_gen_id }} {
    right: {{ block.settings.label_offset }}px;
  }

  .ai-before-after-slider__placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-before-after-slider__placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 300px;
    max-height: 300px;
  }

  .ai-before-after-slider__empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  @media screen and (max-width: 749px) {
    .ai-before-after-slider-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-before-after-slider__label-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.label_font_size }}px * 0.85);
      padding: 6px 12px;
    }

    .ai-before-after-slider__handle-{{ ai_gen_id }} {
      width: calc({{ block.settings.handle_size }}px * 0.85);
      height: calc({{ block.settings.handle_size }}px * 0.85);
    }
  }
{% endstyle %}

<before-after-slider-{{ ai_gen_id }}
  class="ai-before-after-slider-{{ ai_gen_id }}"
  style="--ai-slider-position-{{ ai_gen_id }}: {{ block.settings.initial_position }}%;"
  {{ block.shopify_attributes }}
>
  <div class="ai-before-after-slider__container-{{ ai_gen_id }}">
    {% if block.settings.before_image != blank or block.settings.after_image != blank %}
      <div class="ai-before-after-slider__image-wrapper-{{ ai_gen_id }}">
        {% if block.settings.before_image != blank %}
          <img
            src="{{ block.settings.before_image | image_url: width: 2000 }}"
            alt="{{ block.settings.before_image.alt | default: 'Before image' | escape }}"
            loading="lazy"
            width="{{ block.settings.before_image.width }}"
            height="{{ block.settings.before_image.height }}"
            class="ai-before-after-slider__image-{{ ai_gen_id }}"
          >
        {% else %}
          <div class="ai-before-after-slider__placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
          </div>
        {% endif %}

        {% if block.settings.after_image != blank %}
          <img
            src="{{ block.settings.after_image | image_url: width: 2000 }}"
            alt="{{ block.settings.after_image.alt | default: 'After image' | escape }}"
            loading="lazy"
            width="{{ block.settings.after_image.width }}"
            height="{{ block.settings.after_image.height }}"
            class="ai-before-after-slider__image-{{ ai_gen_id }} ai-before-after-slider__after-{{ ai_gen_id }}"
          >
        {% else %}
          <div class="ai-before-after-slider__placeholder-{{ ai_gen_id }} ai-before-after-slider__after-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
          </div>
        {% endif %}
      </div>

      {% if block.settings.show_labels %}
        {% if block.settings.before_label != blank %}
          <div class="ai-before-after-slider__label-{{ ai_gen_id }} ai-before-after-slider__label--before-{{ ai_gen_id }}">
            {{ block.settings.before_label }}
          </div>
        {% endif %}
        {% if block.settings.after_label != blank %}
          <div class="ai-before-after-slider__label-{{ ai_gen_id }} ai-before-after-slider__label--after-{{ ai_gen_id }}">
            {{ block.settings.after_label }}
          </div>
        {% endif %}
      {% endif %}

      <div class="ai-before-after-slider__divider-{{ ai_gen_id }}" role="separator" aria-label="Image comparison slider">
        <div class="ai-before-after-slider__handle-{{ ai_gen_id }}">
          <svg
            class="ai-before-after-slider__handle-icon-{{ ai_gen_id }}"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <polyline points="15 18 9 12 15 6"></polyline>
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </div>
      </div>
    {% else %}
      <div class="ai-before-after-slider__placeholder-{{ ai_gen_id }}">
        {{ 'image' | placeholder_svg_tag }}
        <div class="ai-before-after-slider__empty-state-{{ ai_gen_id }}">
          Next, add before and after images
        </div>
      </div>
    {% endif %}
  </div>
</before-after-slider-{{ ai_gen_id }}>

<script>
  (function() {
    class BeforeAfterSlider{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.isDragging = false;
        this.container = null;
        this.divider = null;
      }

      connectedCallback() {
        this.container = this.querySelector('.ai-before-after-slider__container-{{ ai_gen_id }}');
        this.divider = this.querySelector('.ai-before-after-slider__divider-{{ ai_gen_id }}');

        if (!this.container || !this.divider) return;

        this.setupEventListeners();
      }

      setupEventListeners() {
        this.divider.addEventListener('mousedown', this.startDrag.bind(this));
        this.divider.addEventListener('touchstart', this.startDrag.bind(this), { passive: true });

        document.addEventListener('mousemove', this.onDrag.bind(this));
        document.addEventListener('touchmove', this.onDrag.bind(this), { passive: false });

        document.addEventListener('mouseup', this.stopDrag.bind(this));
        document.addEventListener('touchend', this.stopDrag.bind(this));
      }

      startDrag(e) {
        this.isDragging = true;
        this.divider.style.transition = 'none';
      }

      stopDrag() {
        this.isDragging = false;
      }

      onDrag(e) {
        if (!this.isDragging) return;

        e.preventDefault();

        const rect = this.container.getBoundingClientRect();
        const clientX = e.type.includes('touch') ? e.touches[0].clientX : e.clientX;
        const offsetX = clientX - rect.left;
        const percentage = Math.max(0, Math.min(100, (offsetX / rect.width) * 100));

        this.style.setProperty('--ai-slider-position-{{ ai_gen_id }}', percentage + '%');
      }
    }

    customElements.define('before-after-slider-{{ ai_gen_id }}', BeforeAfterSlider{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Before/after slider",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "before_image",
      "label": "Before image"
    },
    {
      "type": "image_picker",
      "id": "after_image",
      "label": "After image"
    },
    {
      "type": "range",
      "id": "aspect_ratio",
      "label": "Aspect ratio",
      "min": 30,
      "max": 150,
      "step": 5,
      "unit": "%",
      "default": 75
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Slider"
    },
    {
      "type": "range",
      "id": "initial_position",
      "label": "Initial position",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 50
    },
    {
      "type": "range",
      "id": "divider_width",
      "label": "Divider width",
      "min": 1,
      "max": 6,
      "step": 1,
      "unit": "px",
      "default": 3
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Divider color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "handle_size",
      "label": "Handle size",
      "min": 30,
      "max": 80,
      "step": 5,
      "unit": "px",
      "default": 50
    },
    {
      "type": "color",
      "id": "handle_color",
      "label": "Handle color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "handle_icon_color",
      "label": "Handle icon color",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Labels"
    },
    {
      "type": "checkbox",
      "id": "show_labels",
      "label": "Show labels",
      "default": true
    },
    {
      "type": "text",
      "id": "before_label",
      "label": "Before label",
      "default": "Before"
    },
    {
      "type": "text",
      "id": "after_label",
      "label": "After label",
      "default": "After"
    },
    {
      "type": "range",
      "id": "label_font_size",
      "label": "Font size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "label_position_top",
      "label": "Vertical position",
      "min": 5,
      "max": 95,
      "step": 5,
      "unit": "%",
      "default": 10
    },
    {
      "type": "range",
      "id": "label_offset",
      "label": "Horizontal offset",
      "min": 10,
      "max": 50,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "color",
      "id": "label_bg_color",
      "label": "Background color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "label_text_color",
      "label": "Text color",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Before/after slider"
    }
  ]
}
{% endschema %}
