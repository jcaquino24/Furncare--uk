{% doc %}
  @prompt
    liquid code / script text field for a button to have this 
    
    
    <script src="https://js-eu1.hsforms.net/forms/embed/145723791.js" defer></script>
    <div class="hs-form-frame" data-region="eu1" data-form-id="09631399-dabb-4b06-95ad-b7723e4d52c2" data-portal-id="145723791"></div>
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-embed-container-{{ ai_gen_id }} {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.padding }}px;
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
    display: block;
  }

  .ai-embed-content-{{ ai_gen_id }} {
    width: 100%;
  }

  @media screen and (max-width: 749px) {
    .ai-embed-container-{{ ai_gen_id }} {
      width: 100%;
      padding: {{ block.settings.padding | times: 0.75 }}px;
    }
  }
{% endstyle %}

<div class="ai-embed-container-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-embed-content-{{ ai_gen_id }}">
    {{ block.settings.custom_liquid }}
  </div>
</div>

{% schema %}
{
  "name": "Custom embed",
  "settings": [
    {
      "type": "header",
      "content": "Embed code"
    },
    {
      "type": "liquid",
      "id": "custom_liquid",
      "label": "Custom Liquid or HTML"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding",
      "label": "Padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Custom embed"
    }
  ]
}
{% endschema %}
