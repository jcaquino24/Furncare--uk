{% doc %}
  @prompt
    Add a slide-in drawer that contains a contact form, triggered by the primary button in the "Furncare hero advanced" hero section (section ID: template--26558791844176__hero). The drawer should slide in from the right, contain fields for name, email, phone, and message, include a submit button, and have a close button. The drawer should have a premium, minimal aesthetic with a dark overlay backdrop. The primary hero button should open this drawer on click instead of navigating to a URL.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-contact-drawer-trigger-{{ ai_gen_id }} {
    display: none;
  }

  .ai-contact-drawer-overlay-{{ ai_gen_id }} {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, {{ block.settings.overlay_opacity }});
    z-index: 9998;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }

  .ai-contact-drawer-overlay-{{ ai_gen_id }}.active {
    opacity: 1;
    visibility: visible;
  }

  .ai-contact-drawer-container-{{ ai_gen_id }} {
    position: fixed;
    top: 0;
    right: 0;
    width: 100%;
    max-width: {{ block.settings.drawer_width }}px;
    height: 100%;
    background-color: {{ block.settings.drawer_bg_color }};
    z-index: 9999;
    transform: translateX(100%);
    transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    overflow-y: auto;
    box-shadow: -4px 0 24px rgba(0, 0, 0, 0.15);
    display: block;
  }

  .ai-contact-drawer-container-{{ ai_gen_id }}.active {
    transform: translateX(0);
  }

  .ai-contact-drawer-header-{{ ai_gen_id }} {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: {{ block.settings.padding }}px;
    border-bottom: 1px solid {{ block.settings.border_color }};
  }

  .ai-contact-drawer-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    font-weight: 600;
    color: {{ block.settings.text_color }};
    margin: 0;
    font-family: {{ block.settings.title_font.family }}, {{ block.settings.title_font.fallback_families }};
    font-weight: {{ block.settings.title_font.weight }};
  }

  .ai-contact-drawer-close-{{ ai_gen_id }} {
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
    color: {{ block.settings.text_color }};
    transition: opacity 0.2s ease;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-contact-drawer-close-{{ ai_gen_id }}:hover {
    opacity: 0.7;
  }

  .ai-contact-drawer-close-{{ ai_gen_id }} svg {
    width: 24px;
    height: 24px;
  }

  .ai-contact-drawer-content-{{ ai_gen_id }} {
    padding: {{ block.settings.padding }}px;
  }

  .ai-contact-drawer-description-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    margin-bottom: 32px;
    font-size: {{ block.settings.description_size }}px;
    line-height: 1.6;
  }

  .ai-contact-drawer-form-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .ai-contact-drawer-field-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .ai-contact-drawer-label-{{ ai_gen_id }} {
    font-size: {{ block.settings.label_size }}px;
    font-weight: 500;
    color: {{ block.settings.text_color }};
  }

  .ai-contact-drawer-input-{{ ai_gen_id }},
  .ai-contact-drawer-textarea-{{ ai_gen_id }} {
    padding: 14px 16px;
    border: 1px solid {{ block.settings.input_border_color }};
    border-radius: {{ block.settings.input_border_radius }}px;
    font-size: {{ block.settings.input_size }}px;
    color: {{ block.settings.text_color }};
    background-color: {{ block.settings.input_bg_color }};
    transition: border-color 0.2s ease;
    font-family: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
  }

  .ai-contact-drawer-input-{{ ai_gen_id }}:focus,
  .ai-contact-drawer-textarea-{{ ai_gen_id }}:focus {
    outline: none;
    border-color: {{ block.settings.input_focus_color }};
  }

  .ai-contact-drawer-textarea-{{ ai_gen_id }} {
    min-height: 120px;
    resize: vertical;
  }

  .ai-contact-drawer-submit-{{ ai_gen_id }} {
    padding: 16px 32px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    border: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_size }}px;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.2s ease, transform 0.1s ease;
    margin-top: 8px;
  }

  .ai-contact-drawer-submit-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_color }};
  }

  .ai-contact-drawer-submit-{{ ai_gen_id }}:active {
    transform: scale(0.98);
  }

  .ai-contact-drawer-message-{{ ai_gen_id }} {
    padding: 16px;
    border-radius: {{ block.settings.input_border_radius }}px;
    margin-bottom: 20px;
    font-size: {{ block.settings.input_size }}px;
  }

  .ai-contact-drawer-success-{{ ai_gen_id }} {
    background-color: {{ block.settings.success_bg_color }};
    color: {{ block.settings.success_text_color }};
    border: 1px solid {{ block.settings.success_border_color }};
  }

  .ai-contact-drawer-error-{{ ai_gen_id }} {
    background-color: {{ block.settings.error_bg_color }};
    color: {{ block.settings.error_text_color }};
    border: 1px solid {{ block.settings.error_border_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-contact-drawer-container-{{ ai_gen_id }} {
      max-width: 100%;
    }

    .ai-contact-drawer-header-{{ ai_gen_id }},
    .ai-contact-drawer-content-{{ ai_gen_id }} {
      padding: {{ block.settings.padding | times: 0.7 }}px;
    }

    .ai-contact-drawer-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.85 }}px;
    }
  }
{% endstyle %}

<contact-drawer-{{ ai_gen_id }}
  class="ai-contact-drawer-trigger-{{ ai_gen_id }}"
  data-hero-section-id="{{ block.settings.hero_section_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-contact-drawer-overlay-{{ ai_gen_id }}"></div>

  <div class="ai-contact-drawer-container-{{ ai_gen_id }}">
    <div class="ai-contact-drawer-header-{{ ai_gen_id }}">
      <h2 class="ai-contact-drawer-title-{{ ai_gen_id }}">{{ block.settings.drawer_title }}</h2>
      <button
        type="button"
        class="ai-contact-drawer-close-{{ ai_gen_id }}"
        aria-label="Close contact form"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <div class="ai-contact-drawer-content-{{ ai_gen_id }}">
      {% if block.settings.drawer_description != blank %}
        <div class="ai-contact-drawer-description-{{ ai_gen_id }}">
          {{ block.settings.drawer_description }}
        </div>
      {% endif %}

      {%- form 'contact' -%}
        {% if form.posted_successfully? %}
          <div class="ai-contact-drawer-message-{{ ai_gen_id }} ai-contact-drawer-success-{{ ai_gen_id }}">
            {{ block.settings.success_message }}
          </div>
        {% endif %}

        {% if form.errors %}
          <div class="ai-contact-drawer-message-{{ ai_gen_id }} ai-contact-drawer-error-{{ ai_gen_id }}">
            {{ form.errors | default_errors }}
          </div>
        {% endif %}

        <div class="ai-contact-drawer-form-{{ ai_gen_id }}">
          <div class="ai-contact-drawer-field-{{ ai_gen_id }}">
            <label for="contact-name-{{ ai_gen_id }}" class="ai-contact-drawer-label-{{ ai_gen_id }}">
              {{ block.settings.name_label }}
              {% if block.settings.name_required %}*{% endif %}
            </label>
            <input
              type="text"
              id="contact-name-{{ ai_gen_id }}"
              name="contact[name]"
              class="ai-contact-drawer-input-{{ ai_gen_id }}"
              placeholder="{{ block.settings.name_placeholder }}"
              {% if block.settings.name_required %}required{% endif %}
            >
          </div>

          <div class="ai-contact-drawer-field-{{ ai_gen_id }}">
            <label for="contact-email-{{ ai_gen_id }}" class="ai-contact-drawer-label-{{ ai_gen_id }}">
              {{ block.settings.email_label }}*
            </label>
            <input
              type="email"
              id="contact-email-{{ ai_gen_id }}"
              name="contact[email]"
              class="ai-contact-drawer-input-{{ ai_gen_id }}"
              placeholder="{{ block.settings.email_placeholder }}"
              autocomplete="email"
              required
            >
          </div>

          {% if block.settings.show_phone %}
            <div class="ai-contact-drawer-field-{{ ai_gen_id }}">
              <label for="contact-phone-{{ ai_gen_id }}" class="ai-contact-drawer-label-{{ ai_gen_id }}">
                {{ block.settings.phone_label }}
                {% if block.settings.phone_required %}*{% endif %}
              </label>
              <input
                type="tel"
                id="contact-phone-{{ ai_gen_id }}"
                name="contact[phone]"
                class="ai-contact-drawer-input-{{ ai_gen_id }}"
                placeholder="{{ block.settings.phone_placeholder }}"
                autocomplete="tel"
                {% if block.settings.phone_required %}required{% endif %}
              >
            </div>
          {% endif %}

          <div class="ai-contact-drawer-field-{{ ai_gen_id }}">
            <label for="contact-message-{{ ai_gen_id }}" class="ai-contact-drawer-label-{{ ai_gen_id }}">
              {{ block.settings.message_label }}
              {% if block.settings.message_required %}*{% endif %}
            </label>
            <textarea
              id="contact-message-{{ ai_gen_id }}"
              name="contact[body]"
              class="ai-contact-drawer-textarea-{{ ai_gen_id }}"
              placeholder="{{ block.settings.message_placeholder }}"
              {% if block.settings.message_required %}required{% endif %}
            ></textarea>
          </div>

          <button type="submit" class="ai-contact-drawer-submit-{{ ai_gen_id }}">
            {{ block.settings.submit_button_text }}
          </button>
        </div>
      {%- endform -%}
    </div>
  </div>
</contact-drawer-{{ ai_gen_id }}>

<script>
  (function() {
    class ContactDrawer{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.overlay = this.querySelector('.ai-contact-drawer-overlay-{{ ai_gen_id }}');
        this.container = this.querySelector('.ai-contact-drawer-container-{{ ai_gen_id }}');
        this.closeButton = this.querySelector('.ai-contact-drawer-close-{{ ai_gen_id }}');
        this.heroSectionId = this.dataset.heroSectionId;
      }

      connectedCallback() {
        this.setupEventListeners();
        this.findAndAttachHeroButton();
      }

      findAndAttachHeroButton() {
        if (!this.heroSectionId) return;

        const heroSection = document.querySelector(`[data-section-id="${this.heroSectionId}"]`);
        if (!heroSection) return;

        const primaryButton = heroSection.querySelector('[data-primary-button]');
        if (primaryButton) {
          primaryButton.addEventListener('click', (e) => {
            e.preventDefault();
            this.openDrawer();
          });
        }
      }

      setupEventListeners() {
        this.closeButton.addEventListener('click', () => this.closeDrawer());
        this.overlay.addEventListener('click', () => this.closeDrawer());

        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && this.container.classList.contains('active')) {
            this.closeDrawer();
          }
        });
      }

      openDrawer() {
        this.overlay.classList.add('active');
        this.container.classList.add('active');
        document.body.style.overflow = 'hidden';
        this.container.querySelector('input').focus();
      }

      closeDrawer() {
        this.overlay.classList.remove('active');
        this.container.classList.remove('active');
        document.body.style.overflow = '';
      }
    }

    customElements.define('contact-drawer-{{ ai_gen_id }}', ContactDrawer{{ ai_gen_id }});
  })();
</script>

