{% doc %}
  @prompt
    Create a compact custom Liquid block that embeds a HubSpot form. Load the HubSpot script from https://js-eu1.hsforms.net/forms/embed/145723791.js with defer attribute. Render the form using a div with class "hs-form-frame" and the following data attributes: data-region="eu1", data-form-id="4b643ffe-2b73-47b6-96c2-c0694276b3e6", data-portal-id="145723791". The block should be visually compact and small in size, designed to sit alongside other content blocks inside an Image with Text section without taking up excessive vertical space., it needs to take the maximum width of the page, can i have the option for a rich text block on the left please
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-hubspot-form-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.padding }}px;
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-hubspot-form-container-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.column_gap }}px;
    align-items: flex-start;
  }

  .ai-hubspot-form-text-{{ ai_gen_id }} {
    flex: 0 0 {{ block.settings.text_width }}%;
    color: {{ block.settings.text_color }};
  }

  .ai-hubspot-form-text-{{ ai_gen_id }} h1,
  .ai-hubspot-form-text-{{ ai_gen_id }} h2,
  .ai-hubspot-form-text-{{ ai_gen_id }} h3,
  .ai-hubspot-form-text-{{ ai_gen_id }} h4,
  .ai-hubspot-form-text-{{ ai_gen_id }} h5,
  .ai-hubspot-form-text-{{ ai_gen_id }} h6 {
    margin-top: 0;
  }

  .ai-hubspot-form-text-{{ ai_gen_id }} p:last-child {
    margin-bottom: 0;
  }

  .ai-hubspot-form-wrapper-{{ ai_gen_id }} {
    flex: 1;
    width: 100%;
  }

  .ai-hubspot-form-{{ ai_gen_id }} .hs-form-frame {
    min-height: auto;
  }

  .ai-hubspot-form-{{ ai_gen_id }} iframe {
    width: 100%;
    border: none;
  }

  @media screen and (max-width: 749px) {
    .ai-hubspot-form-{{ ai_gen_id }} {
      width: 100%;
      padding: {{ block.settings.padding | times: 0.75 }}px;
    }

    .ai-hubspot-form-container-{{ ai_gen_id }} {
      flex-direction: column;
      gap: {{ block.settings.column_gap | times: 0.75 }}px;
    }

    .ai-hubspot-form-text-{{ ai_gen_id }} {
      flex: 0 0 100%;
    }
  }
{% endstyle %}

<hubspot-form-{{ ai_gen_id }}
  class="ai-hubspot-form-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-hubspot-form-container-{{ ai_gen_id }}">
    {% if block.settings.text_content != blank %}
      <div class="ai-hubspot-form-text-{{ ai_gen_id }}">
        {{ block.settings.text_content }}
      </div>
    {% endif %}
    
    <div class="ai-hubspot-form-wrapper-{{ ai_gen_id }}">
      <div
        class="hs-form-frame"
        data-region="eu1"
        data-form-id="4b643ffe-2b73-47b6-96c2-c0694276b3e6"
        data-portal-id="145723791"
      ></div>
    </div>
  </div>
</hubspot-form-{{ ai_gen_id }}>

<script>
  (function() {
    class HubSpotForm{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.scriptLoaded = false;
      }

      connectedCallback() {
        this.loadHubSpotScript();
      }

      loadHubSpotScript() {
        if (this.scriptLoaded || document.querySelector('script[src="https://js-eu1.hsforms.net/forms/embed/v3.js"]')) {
          return;
        }

        const script = document.createElement('script');
        script.src = 'https://js-eu1.hsforms.net/forms/embed/v3.js';
        script.defer = true;
        script.onload = () => {
          this.scriptLoaded = true;
        };
        document.head.appendChild(script);
      }
    }

    customElements.define('hubspot-form-{{ ai_gen_id }}', HubSpotForm{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "HubSpot form",
  "settings": [
    {
      "type": "header",
      "content": "Text content"
    },
    {
      "type": "richtext",
      "id": "text_content",
      "label": "Text"
    },
    {
      "type": "range",
      "id": "text_width",
      "label": "Text width",
      "min": 30,
      "max": 60,
      "step": 5,
      "unit": "%",
      "default": 40
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Column gap",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding",
      "label": "Padding",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "HubSpot form"
    }
  ]
}
{% endschema %}
